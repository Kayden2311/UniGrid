@page
@model unigrid.Pages.Admin.FederationsModel
@{
    ViewData["Title"] = "Federation Management";
}

<div class="space-y-8 max-w-7xl mx-auto" x-data="{ showCreateModal: false, activeFedId: null }">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight font-display">Federations Control</h1>
            <p class="text-slate-500 text-sm mt-1">Configure multi-workspace portals, logical integrations, and organization bindings.</p>
        </div>
        <div class="flex gap-3">
            <button @@click="showCreateModal = true" class="px-4 py-2.5 bg-indigo-600 text-white rounded-xl text-xs font-bold shadow-lg shadow-indigo-100 hover:bg-indigo-700 transition-all flex items-center gap-1.5 cursor-pointer">
                <i data-lucide="plus" class="w-4 h-4"></i>
                Create Federation
            </button>
            <a href="/Admin/Index" class="px-4 py-2.5 bg-white border border-slate-200 text-slate-700 hover:text-indigo-600 rounded-xl text-xs font-bold transition-all shadow-sm flex items-center gap-2">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["FedSuccess"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-100 text-emerald-600 rounded-2xl text-xs font-bold flex items-center gap-2 shadow-sm">
            <i data-lucide="check-circle" class="w-4 h-4 shrink-0"></i>
            <span>@TempData["FedSuccess"]</span>
        </div>
    }
    @if (TempData["FedError"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-100 text-rose-600 rounded-2xl text-xs font-bold flex items-center gap-2 shadow-sm">
            <i data-lucide="alert-triangle" class="w-4 h-4 shrink-0"></i>
            <span>@TempData["FedError"]</span>
        </div>
    }

    <!-- Federations Accordion Grid -->
    <div class="grid grid-cols-1 gap-6">
        @if (Model.FederationsList.Count == 0)
        {
            <div class="glass p-12 text-center text-xs text-slate-400 font-bold italic flex flex-col items-center gap-3">
                <i data-lucide="globe-2" class="w-12 h-12 text-slate-350"></i>
                No federations registered in the system.
            </div>
        }
        else
        {
            @foreach (var fed in Model.FederationsList)
            {
                <div class="glass p-6 rounded-[2.5rem] border border-slate-100 shadow-sm flex flex-col justify-between transition-all duration-300">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-100">
                        <div class="flex items-center gap-4">
                            <div class="h-12 w-12 bg-gradient-to-tr from-violet-500 to-indigo-500 text-white rounded-2xl flex items-center justify-center text-sm font-black shadow-md shadow-violet-100">
                                @fed.Name.Substring(0, 1).ToUpper()
                            </div>
                            <div>
                                <h3 class="text-lg font-black text-slate-800 font-display flex items-center gap-2">
                                    @fed.Name
                                    <span class="px-2 py-0.5 bg-violet-50 text-violet-650 rounded text-[9px] font-black uppercase tracking-wider">@fed.JoinCode</span>
                                </h3>
                                <p class="text-xs text-slate-400 mt-0.5">Created on: @fed.CreatedAt.ToLocalTime().ToString("g")</p>
                            </div>
                        </div>

                        <!-- Owner Detail -->
                        <div class="flex items-center gap-3">
                            <div class="text-left md:text-right">
                                <div class="text-xs font-black text-slate-700">Owner: @fed.OwnerName</div>
                                <div class="text-[10px] text-slate-400">@fed.OwnerEmail</div>
                            </div>
                            <form method="post" asp-page-handler="DeleteFederation" class="inline-block">
                                <input type="hidden" name="federationId" value="@fed.FederationId">
                                <button type="submit" onclick="return confirm('Are you sure you want to delete this federation? All workspace mappings will be unlinked.')"
                                        class="p-2 border border-slate-200 text-rose-500 hover:bg-rose-50 rounded-xl transition-all shadow-sm">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Workspaces Connected -->
                    <div class="mt-4 space-y-3">
                        <div class="flex justify-between items-center">
                            <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Linked Workspaces (@fed.LinkedWorkspaces.Count)</h4>
                            <button @@click="activeFedId = (activeFedId === '@fed.FederationId' ? null : '@fed.FederationId')"
                                    class="text-xs font-bold text-indigo-650 hover:text-indigo-850 transition-colors flex items-center gap-1 cursor-pointer">
                                <span x-text="activeFedId === '@fed.FederationId' ? 'Hide Workspaces' : 'View Workspaces'">View Workspaces</span>
                                <i data-lucide="chevron-down" class="w-3.5 h-3.5 transition-transform" :class="activeFedId === '@fed.FederationId' ? 'rotate-180' : ''"></i>
                            </button>
                        </div>

                        <div x-show="activeFedId === '@fed.FederationId'" x-transition class="pt-2 space-y-2">
                            @if (fed.LinkedWorkspaces.Count == 0)
                            {
                                <div class="p-4 bg-slate-50 rounded-2xl text-xs text-slate-400 italic font-medium">
                                    No workspaces linked to this federation yet.
                                </div>
                            }
                            else
                            {
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    @foreach (var ws in fed.LinkedWorkspaces)
                                    {
                                        <div class="p-4 bg-slate-50 border border-slate-100 rounded-[1.5rem] flex items-center justify-between shadow-sm">
                                            <div>
                                                <div class="text-xs font-bold text-slate-800">@ws.Name</div>
                                                <div class="text-[10px] text-slate-400 mt-0.5">Type: @ws.Type | Owner: @ws.OwnerName</div>
                                            </div>
                                            <form method="post" asp-page-handler="UnlinkWorkspace" class="inline-block">
                                                <input type="hidden" name="workspaceId" value="@ws.WorkspaceId">
                                                <button type="submit" onclick="return confirm('Are you sure you want to unlink this workspace from the federation?')"
                                                        class="px-2.5 py-1.5 border border-slate-200 text-slate-650 hover:bg-slate-100 rounded-lg text-[10px] font-black uppercase tracking-wider transition-all">
                                                    Unlink
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- POPUP MODAL: CREATE FEDERATION -->
    <div x-show="showCreateModal" x-transition x-cloak class="fixed inset-0 z-50 overflow-y-auto flex items-center justify-center p-4">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" @@click="showCreateModal = false"></div>
        
        <!-- Modal Content -->
        <div class="bg-white rounded-[2.5rem] border border-slate-100 p-8 shadow-2xl relative z-10 w-full max-w-lg transform transition-all duration-300">
            <button @@click="showCreateModal = false" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            
            <form method="post" asp-page-handler="CreateFederation" class="space-y-6">
                <div>
                    <h3 class="text-2xl font-black text-slate-800 tracking-tight">Create workspace federation</h3>
                    <p class="text-sm text-slate-500 mt-1">Configure a logical combined portal to link autonomous workspaces.</p>
                </div>
                
                <!-- Name -->
                <div class="space-y-1.5">
                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Federation Name</label>
                    <input type="text" name="name" required placeholder="e.g., FPT Software Store Portal" 
                           class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all">
                </div>

                <!-- Join Code -->
                <div class="space-y-1.5">
                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Join Code (Unique)</label>
                    <input type="text" name="joinCode" required placeholder="e.g., FED-STORE" 
                           class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all">
                </div>

                <!-- Owner Email -->
                <div class="space-y-1.5">
                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Owner Email (Must exist in database)</label>
                    <input type="email" name="ownerEmail" required placeholder="e.g., alice@student.edu" 
                           class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all">
                </div>
                
                <div class="flex gap-4 pt-4 border-t border-slate-100">
                    <button type="button" @@click="showCreateModal = false" class="flex-1 py-3.5 bg-slate-100 text-slate-700 font-bold rounded-2xl hover:bg-slate-200 transition-all">Cancel</button>
                    <button type="submit" class="flex-1 py-3.5 bg-indigo-600 text-white font-bold rounded-2xl shadow-lg shadow-indigo-100 hover:bg-indigo-700 transition-all">Create Portal</button>
                </div>
            </form>
        </div>
    </div>
</div>
