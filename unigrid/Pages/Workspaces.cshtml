@page
@model unigrid.Pages.WorkspacesModel
@{
    ViewData["Title"] = "Workspaces";
}

<div class="space-y-8" x-data="{ searchQuery: '', createOpen: false }">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div>
            <h1 class="text-3xl font-bold font-display text-slate-800 tracking-tight">Workspaces</h1>
            <p class="text-slate-500 text-sm mt-1">All workspaces you are a member or manager of.</p>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <div class="relative">
                <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                <input type="text" x-model="searchQuery" placeholder="Search workspaces..." 
                       class="pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none w-full sm:w-64 transition-all shadow-sm">
            </div>
            <button @@click="createOpen = true" 
                    class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-indigo-100 hover:shadow-indigo-200 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                Create Workspace
            </button>
        </div>
    </div>

    <!-- Workspaces Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (!Model.UserWorkspaces.Any())
        {
            <div class="col-span-full text-center py-20 bg-white/60 border border-slate-100 backdrop-blur-md rounded-3xl">
                <svg class="w-12 h-12 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776"></path></svg>
                <p class="text-slate-400 font-bold text-base">You haven't joined any workspaces yet.</p>
                <button @@click="createOpen = true" class="text-indigo-600 hover:text-indigo-700 text-sm font-semibold mt-2 underline">Create one now</button>
            </div>
        }
        
        @foreach (var ws in Model.UserWorkspaces)
        {
            var totalTasks = ws.Tasks.Count;
            var completedTasks = ws.Tasks.Count(t => t.Status == 3);
            var pct = totalTasks > 0 ? (int)((double)completedTasks / totalTasks * 100) : 0;
            var dueThisWeek = ws.Tasks.Count(t => t.Status != 3 && t.DueDate.HasValue && t.DueDate.Value >= DateTime.UtcNow && t.DueDate.Value <= DateTime.UtcNow.AddDays(7));

            <div onclick="window.location.href='/WorkspaceDetail/@ws.JoinCode'"
                 class="group cursor-pointer transition-all duration-300 hover:shadow-xl hover:shadow-indigo-500/5 hover:border-indigo-500/30 border border-slate-100 rounded-3xl bg-white p-6 relative overflow-hidden flex flex-col justify-between h-full shadow-sm"
                 x-show="searchQuery == '' || '@ws.Name.ToLower()'.includes(searchQuery.toLowerCase())">
                
                <div class="absolute -right-8 -top-8 h-24 w-24 bg-indigo-500/5 rounded-full group-hover:scale-150 transition-transform duration-700"></div>
                
                <div>
                    <!-- Header -->
                    <div class="flex items-start justify-between mb-4 relative">
                        <div class="h-12 w-12 rounded-2xl bg-indigo-600 flex items-center justify-center text-white shadow-md shadow-indigo-100">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                        </div>
                        <div class="flex flex-col items-end gap-1.5">
                            <span class="px-2.5 py-0.5 bg-indigo-50 text-indigo-600 text-[10px] font-bold rounded-full uppercase tracking-wider">@ws.PackageTier</span>
                            <span class="text-[10px] font-bold text-slate-400 font-mono">#@ws.JoinCode</span>
                        </div>
                    </div>

                    <!-- Title & Fallback Description -->
                    <div class="flex items-start justify-between gap-2">
                        <h3 class="text-lg font-bold text-slate-800 group-hover:text-indigo-600 transition-colors line-clamp-1">@ws.Name</h3>
                        <svg class="h-4 w-4 text-slate-400 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-x-[-4px] group-hover:translate-x-0 shrink-0 mt-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </div>
                    <p class="text-xs text-slate-400 mt-1 line-clamp-2">Active project workspace for @ws.Name.</p>

                    <!-- Member Avatars Stack -->
                    <div class="flex items-center gap-2 mt-4">
                        <div class="flex -space-x-2">
                            @foreach(var member in ws.WorkspaceMembers.Take(5))
                            {
                                var initials = string.Concat(member.User.FullName.Split(' ').Select(n => n[0]));
                                var colorIndex = Math.Abs(member.User.FullName.GetHashCode()) % 6;
                                var bgColors = new[] { "bg-indigo-600 text-white", "bg-purple-600 text-white", "bg-amber-600 text-white", "bg-rose-600 text-white", "bg-emerald-600 text-white", "bg-slate-600 text-white" };
                                var bgColor = bgColors[colorIndex];
                                <div class="h-7 w-7 rounded-full border-2 border-white @bgColor flex items-center justify-center text-[10px] font-black" title="@member.User.FullName">
                                    @initials
                                </div>
                            }
                        </div>
                        @if (ws.WorkspaceMembers.Count > 5)
                        {
                            <span class="text-[11px] text-slate-400 font-semibold ml-1">+@(ws.WorkspaceMembers.Count - 5) members</span>
                        }
                    </div>

                    <!-- Color-Coded Progress Bar -->
                    <div class="mt-4">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-[11px] text-slate-400 font-semibold">Progress</span>
                            <span class="text-xs font-black text-slate-700">@pct%</span>
                        </div>
                        <div class="h-2 w-full overflow-hidden rounded-full bg-slate-100">
                            @{
                                var progressColor = pct >= 80 ? "bg-emerald-500" : pct >= 50 ? "bg-indigo-600" : pct >= 25 ? "bg-amber-500" : "bg-rose-500";
                            }
                            <div class="h-full rounded-full transition-all duration-500 @progressColor" style="width: @pct%"></div>
                        </div>
                    </div>
                </div>

                <!-- Stats Row -->
                <div class="flex gap-4 text-[11px] font-semibold mt-4 pt-4 border-t border-slate-100">
                    <span class="flex items-center gap-1 text-slate-400">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        @totalTasks tasks
                    </span>
                    <span class="flex items-center gap-1 text-emerald-600">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        @completedTasks done
                    </span>
                    @{
                        var clockColor = dueThisWeek > 3 ? "text-rose-500 font-bold animate-pulse" : "text-amber-500";
                    }
                    <span class="flex items-center gap-1 @clockColor">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        @dueThisWeek due
                    </span>
                </div>
            </div>
        }
    </div>

    <!-- Create Workspace Modal -->
    <div x-show="createOpen" 
         class="fixed inset-0 z-50 overflow-y-auto"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         style="display: none;">
        
        <!-- Backdrop overlay -->
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" @@click="createOpen = false"></div>
        
        <!-- Modal Content Container -->
        <div class="flex min-h-full items-center justify-center p-4 text-center">
            <div x-show="createOpen"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 scale-95"
                 x-transition:enter-end="opacity-100 scale-100"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100 scale-100"
                 x-transition:leave-end="opacity-0 scale-95"
                 class="relative transform overflow-hidden rounded-3xl bg-white p-6 text-left shadow-2xl transition-all w-full max-w-md border border-slate-100">
                 
                <div class="flex items-center justify-between mb-5">
                    <h3 class="text-xl font-bold text-slate-800 font-display">Create Workspace</h3>
                    <button @@click="createOpen = false" class="text-slate-400 hover:text-slate-600 transition-colors p-1 rounded-lg hover:bg-slate-50">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                
                <form method="post" asp-page-handler="CreateWorkspace" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Workspace Name</label>
                        <input type="text" name="NewWorkspaceName" required placeholder="e.g. Software Engineering Project"
                               class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none transition-all">
                    </div>
                    
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Description (Optional)</label>
                        <textarea name="NewWorkspaceDesc" rows="3" placeholder="Describe the goals of this workspace..."
                                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none transition-all"></textarea>
                    </div>
                    
                    <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-100">
                        <button type="button" @@click="createOpen = false" 
                                class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-all">
                            Cancel
                        </button>
                        <button type="submit" 
                                class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-bold shadow-lg shadow-indigo-100 hover:shadow-indigo-200 transition-all">
                            Create Workspace
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

