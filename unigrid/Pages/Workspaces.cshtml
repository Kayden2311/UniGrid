@page
@model unigrid.Pages.WorkspacesModel
@{
    ViewData["Title"] = "Workspaces";
}

<div class="space-y-8" 
     x-data="{ 
        searchQuery: '', 
        createOpen: false, 
        joinFedOpen: false, 
        joinWorkspaceOpen: false
     }" 
     x-init="
        $watch('globalSearchQuery', value => searchQuery = value); 
     ">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div>
            <h1 class="text-3xl font-bold font-display text-slate-800 tracking-tight">Workspaces</h1>
            <p class="text-slate-500 text-sm mt-1">All workspaces you are a member or manager of.</p>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <div class="relative flex-1 sm:flex-initial">
                    <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <input type="text" x-model="searchQuery" placeholder="Search workspaces..." 
                           class="pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none w-full sm:w-48 md:w-64 transition-all shadow-sm">
                </div>
            </div>
            <button @@click="joinWorkspaceOpen = true" 
                    class="bg-white hover:bg-slate-50 text-emerald-600 border border-emerald-250 px-5 py-2.5 rounded-xl text-sm font-bold shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                Join Workspace
            </button>
            <button @@click="joinFedOpen = true" 
                    class="bg-white hover:bg-slate-50 text-indigo-600 border border-indigo-200 px-5 py-2.5 rounded-xl text-sm font-bold shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"></path></svg>
                Connect Federation
            </button>
            <button @@click="createOpen = true" 
                    class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-indigo-100 hover:shadow-indigo-200 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                Create Workspace
            </button>
        </div>
    </div>

    <!-- Alerts Notification -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200/50 backdrop-blur-md flex items-center gap-3 text-emerald-800 text-sm font-semibold shadow-sm animate-fade-in" x-data="{ show: true }" x-show="show" x-transition>
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="flex-grow text-left">@TempData["SuccessMessage"]</span>
            <button @@click="show = false" class="text-emerald-500 hover:text-emerald-700 p-1 hover:bg-emerald-100 rounded-lg transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200/50 backdrop-blur-md flex items-center gap-3 text-rose-800 text-sm font-semibold shadow-sm animate-fade-in" x-data="{ show: true }" x-show="show" x-transition>
            <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            <span class="flex-grow text-left">@TempData["ErrorMessage"]</span>
            <button @@click="show = false" class="text-rose-500 hover:text-rose-700 p-1 hover:bg-rose-100 rounded-lg transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
    }

    <!-- Federated Workspaces Section -->
    @if (Model.UserFederations.Any())
    {
        <div>
            <div class="flex items-center gap-2 mb-4">
                <div class="h-2 w-2 rounded-full bg-indigo-500 animate-pulse"></div>
                <h2 class="text-xl font-bold font-display text-slate-800 tracking-tight">Active Federations</h2>
                <span class="px-2 py-0.5 bg-indigo-50 text-indigo-600 text-[10px] font-bold rounded-full uppercase tracking-wider">Workspace Federation</span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var fed in Model.UserFederations)
                {
                    var accountIdStr = User.FindFirst("AccountId")?.Value;
                    Guid currentAccountId = Guid.Empty;
                    Guid.TryParse(accountIdStr, out currentAccountId);
                    var currentUserMemberRecord = fed.WorkspaceFederationMembers.FirstOrDefault(m => m.User != null && m.User.AccountId == currentAccountId);
                    bool isFedOwner = fed.Owner != null && fed.Owner.AccountId == currentAccountId;
                    
                    <div class="group border border-slate-100 rounded-3xl bg-gradient-to-br from-white to-slate-50/50 p-6 relative overflow-hidden flex flex-col justify-between h-full shadow-sm hover:shadow-xl hover:shadow-indigo-500/5 hover:border-indigo-500/20 transition-all duration-300"
                         x-show="searchQuery == '' || '@Html.Raw(fed.Name.Replace("'", "\\'").Replace("\"", "\\\"").ToLower())'.includes(searchQuery.toLowerCase())">
                        <div class="absolute -right-8 -top-8 h-24 w-24 bg-indigo-500/5 rounded-full group-hover:scale-150 transition-transform duration-700"></div>
                        
                        <div>
                            <!-- Header -->
                            <div class="flex items-start justify-between mb-4 relative">
                                <div class="h-12 w-12 rounded-2xl bg-indigo-600 flex items-center justify-center text-white shadow-md shadow-indigo-100">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9s2.015-9 4.5-9m0 0a9.003 9.003 0 018.716 2.253M12 3a9.003 9.003 0 00-8.716 2.253M12 12h.01M12 12h.01m-1.01 0c0-1.657 1.343-3 3-3s3 1.343 3 3-1.343 3-3 3-3-1.343-3-3z"></path></svg>
                                </div>
                                <div class="flex flex-col items-end gap-1.5">
                                    <span class="px-2.5 py-0.5 bg-gradient-to-r from-indigo-500 to-purple-600 text-white text-[9px] font-extrabold rounded-full uppercase tracking-wider shadow-sm shadow-indigo-100">🌐 FEDERATION</span>
                                    <span class="text-[10px] font-bold text-slate-400 font-mono">#@fed.JoinCode</span>
                                </div>
                            </div>

                            <!-- Title & Owner -->
                            <h3 class="text-lg font-bold text-slate-800 group-hover:text-indigo-600 transition-colors line-clamp-1">@fed.Name</h3>
                            <div class="flex items-center justify-between gap-2 mt-0.5 mb-2">
                                <p class="text-[11px] text-slate-400">Founded by <span class="font-bold text-slate-600">@(fed.Owner?.FullName ?? "Unknown")</span></p>
                                <p class="text-[10px] text-slate-400 flex items-center gap-1 font-semibold whitespace-nowrap shrink-0">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-linecap="round" stroke-linejoin="round"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    @fed.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                </p>
                            </div>
                            
                            <!-- Linked Personal Workspace Info -->
                            @if (currentUserMemberRecord?.PersonalWorkspace != null)
                            {
                                <div class="mt-4 p-3.5 bg-indigo-50/40 border border-indigo-100/40 rounded-2xl">
                                    <div class="text-[10px] font-bold text-indigo-500 uppercase tracking-wider mb-1">Your Connected Portal:</div>
                                    <a href="/WorkspaceDetail/@currentUserMemberRecord.PersonalWorkspace.JoinCode" class="flex items-center justify-between text-xs font-bold text-indigo-700 hover:text-indigo-900 group/link">
                                        <span class="line-clamp-1 font-semibold">@currentUserMemberRecord.PersonalWorkspace.Name</span>
                                        <svg class="w-3.5 h-3.5 group-hover/link:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path></svg>
                                    </a>
                                </div>
                            }
                            
                            <!-- Federation Members -->
                            <div class="mt-4">
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">Connected Members:</div>
                                <div class="flex items-center gap-2">
                                    <div class="flex -space-x-2">
                                        @foreach(var member in fed.WorkspaceFederationMembers.Take(5))
                                        {
                                            if (member.User == null) continue;
                                            var initials = string.Concat((member.User.FullName ?? "User").Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "U"));
                                            var colorIndex = Math.Abs((member.User.FullName ?? "User").GetHashCode()) % 6;
                                            var bgColors = new[] { "bg-indigo-600 text-white", "bg-purple-600 text-white", "bg-amber-600 text-white", "bg-rose-600 text-white", "bg-emerald-600 text-white", "bg-slate-600 text-white" };
                                            var bgColor = bgColors[colorIndex];
                                            var workspaceInfoName = member.PersonalWorkspace?.Name ?? "No Personal Portal Linked";
                                            <div class="h-7 w-7 rounded-full border-2 border-white @bgColor flex items-center justify-center text-[10px] font-black" title="@member.User.FullName (@workspaceInfoName)">
                                                @initials
                                            </div>
                                        }
                                    </div>
                                    @if (fed.WorkspaceFederationMembers.Count > 5)
                                    {
                                        <span class="text-[10px] text-slate-400 font-semibold ml-1">+@(fed.WorkspaceFederationMembers.Count - 5) connections</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Footer Actions -->
                        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                            <span class="text-[11px] font-bold text-slate-400 flex items-center gap-1">
                                <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                                @fed.WorkspaceFederationMembers.Count member connections
                            </span>
                            @if (isFedOwner || currentUserMemberRecord != null)
                            {
                                <a href="/FederationDetail?joinCode=@fed.JoinCode" class="text-xs font-bold text-indigo-600 hover:text-indigo-700 flex items-center gap-1">
                                    Enter Federation
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
            
            <div class="h-px bg-slate-100 my-8"></div>
        </div>
    }


    <!-- Workspaces Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (!Model.UserWorkspaces.Any())
        {
            <div class="col-span-full text-center py-20 bg-white/60 border border-slate-100 backdrop-blur-md rounded-3xl">
                <svg class="w-12 h-12 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776"></path></svg>
                <p class="text-slate-400 font-bold text-base">You haven't joined any workspaces yet.</p>
                <button @@click="createOpen = true" class="text-indigo-600 hover:text-indigo-700 text-sm font-semibold mt-2 underline">Create one now</button>
            </div>
        }
        
        @foreach (var ws in Model.UserWorkspaces)
        {
            var totalTasks = ws.Tasks.Count;
            var completedTasks = ws.Tasks.Count(t => t.Status == 3);
            var pct = totalTasks > 0 ? (int)((double)completedTasks / totalTasks * 100) : 0;
            var dueThisWeek = ws.Tasks.Count(t => t.Status != 3 && t.DueDate.HasValue && t.DueDate.Value >= DateTime.UtcNow && t.DueDate.Value <= DateTime.UtcNow.AddDays(7));

            <div onclick="window.location.href='/WorkspaceDetail/@ws.JoinCode'"
                 class="group cursor-pointer transition-all duration-300 hover:shadow-xl hover:shadow-indigo-500/5 hover:border-indigo-500/30 border border-slate-100 rounded-3xl bg-white p-6 relative overflow-hidden flex flex-col justify-between h-full shadow-sm"
                 x-show="searchQuery == '' || '@Html.Raw(ws.Name.Replace("'", "\\'").Replace("\"", "\\\"").ToLower())'.includes(searchQuery.toLowerCase())">
                
                <div class="absolute -right-8 -top-8 h-24 w-24 bg-indigo-500/5 rounded-full group-hover:scale-150 transition-transform duration-700"></div>
                
                <div>
                    <!-- Header -->
                    <div class="flex items-start justify-between mb-4 relative">
                        <div class="h-12 w-12 rounded-2xl bg-indigo-600 flex items-center justify-center text-white shadow-md shadow-indigo-100">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                        </div>
                        <div class="flex flex-col items-end gap-1.5">
                            <span class="px-2.5 py-0.5 bg-indigo-50 text-indigo-600 text-[10px] font-bold rounded-full uppercase tracking-wider">@ws.PackageTier</span>
                            <span class="text-[10px] font-bold text-slate-400 font-mono">#@ws.JoinCode</span>
                        </div>
                    </div>

                    <!-- Title & Fallback Description -->
                    <div class="flex items-start justify-between gap-2">
                        <h3 class="text-lg font-bold text-slate-800 group-hover:text-indigo-600 transition-colors line-clamp-1">@ws.Name</h3>
                        <svg class="h-4 w-4 text-slate-400 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-x-[-4px] group-hover:translate-x-0 shrink-0 mt-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </div>
                    @if (ws.CreatedAt.HasValue)
                    {
                        <p class="text-[10px] text-slate-400 mt-1 flex items-center gap-1 font-semibold">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-linecap="round" stroke-linejoin="round"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            Created on @ws.CreatedAt.Value.ToLocalTime().ToString("MMM dd, yyyy")
                        </p>
                    }
                    <p class="text-xs text-slate-400 mt-1.5 line-clamp-2">Active project workspace for @ws.Name.</p>

                    <!-- Member Avatars Stack -->
                    <div class="flex items-center gap-2 mt-4">
                        <div class="flex -space-x-2">
                            @foreach(var member in ws.WorkspaceMembers.Take(5))
                            {
                                var initials = string.Concat(member.User.FullName.Split(' ').Select(n => n[0]));
                                var colorIndex = Math.Abs(member.User.FullName.GetHashCode()) % 6;
                                var bgColors = new[] { "bg-indigo-600 text-white", "bg-purple-600 text-white", "bg-amber-600 text-white", "bg-rose-600 text-white", "bg-emerald-600 text-white", "bg-slate-600 text-white" };
                                var bgColor = bgColors[colorIndex];
                                <div class="h-7 w-7 rounded-full border-2 border-white @bgColor flex items-center justify-center text-[10px] font-black" title="@member.User.FullName">
                                    @initials
                                </div>
                            }
                        </div>
                        @if (ws.WorkspaceMembers.Count > 5)
                        {
                            <span class="text-[11px] text-slate-400 font-semibold ml-1">+@(ws.WorkspaceMembers.Count - 5) members</span>
                        }
                    </div>

                    <!-- Color-Coded Progress Bar -->
                    <div class="mt-4">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-[11px] text-slate-400 font-semibold">Progress</span>
                            <span class="text-xs font-black text-slate-700">@pct%</span>
                        </div>
                        <div class="h-2 w-full overflow-hidden rounded-full bg-slate-100">
                            @{
                                var progressColor = pct >= 80 ? "bg-emerald-500" : pct >= 50 ? "bg-indigo-600" : pct >= 25 ? "bg-amber-500" : "bg-rose-500";
                            }
                            <div class="h-full rounded-full transition-all duration-500 @progressColor" style="width: @pct%"></div>
                        </div>
                    </div>
                </div>

                <!-- Stats Row -->
                <div class="flex gap-4 text-[11px] font-semibold mt-4 pt-4 border-t border-slate-100">
                    <span class="flex items-center gap-1 text-slate-400">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        @totalTasks tasks
                    </span>
                    <span class="flex items-center gap-1 text-emerald-600">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        @completedTasks done
                    </span>
                    @{
                        var clockColor = dueThisWeek > 3 ? "text-rose-500 font-bold animate-pulse" : "text-amber-500";
                    }
                    <span class="flex items-center gap-1 @clockColor">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        @dueThisWeek due
                    </span>
                </div>
            </div>
        }
    </div>

    <!-- Create Workspace Modal -->
    <div x-show="createOpen" 
         class="fixed inset-0 z-50 overflow-y-auto"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         style="display: none;">
        
        <!-- Backdrop overlay -->
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" @@click="createOpen = false"></div>
        
        <!-- Modal Content Container -->
        <div class="flex min-h-full items-center justify-center p-4 text-center">
            <div x-show="createOpen"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 scale-95"
                 x-transition:enter-end="opacity-100 scale-100"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100 scale-100"
                 x-transition:leave-end="opacity-0 scale-95"
                 class="relative transform overflow-hidden rounded-3xl bg-white p-6 text-left shadow-2xl transition-all w-full max-w-md border border-slate-100">
                 
                <div class="flex items-center justify-between mb-5">
                    <h3 class="text-xl font-bold text-slate-800 font-display">Create Workspace</h3>
                    <button @@click="createOpen = false" class="text-slate-400 hover:text-slate-600 transition-colors p-1 rounded-lg hover:bg-slate-50">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                
                <form method="post" asp-page-handler="CreateWorkspace" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Workspace Name</label>
                        <input type="text" name="NewWorkspaceName" required placeholder="e.g. Software Engineering Project"
                               class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none transition-all">
                    </div>
                    
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Description (Optional)</label>
                        <textarea name="NewWorkspaceDesc" rows="3" placeholder="Describe the goals of this workspace..."
                                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none transition-all"></textarea>
                    </div>
                    
                    <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-100">
                        <button type="button" @@click="createOpen = false" 
                                class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-all">
                            Cancel
                        </button>
                        <button type="submit" 
                                class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-bold shadow-lg shadow-indigo-100 hover:shadow-indigo-200 transition-all">
                            Create Workspace
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Join Federation Modal -->
    <div x-show="joinFedOpen" 
         class="fixed inset-0 z-50 overflow-y-auto"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         style="display: none;">
        
        <!-- Backdrop overlay -->
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" @@click="joinFedOpen = false"></div>
        
        <!-- Modal Content Container -->
        <div class="flex min-h-full items-center justify-center p-4 text-center">
            <div x-show="joinFedOpen"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 scale-95"
                 x-transition:enter-end="opacity-100 scale-100"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100 scale-100"
                 x-transition:leave-end="opacity-0 scale-95"
                 class="relative transform overflow-hidden rounded-3xl bg-white p-6 text-left shadow-2xl transition-all w-full max-w-md border border-slate-100">
                 
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <h3 class="text-xl font-bold text-slate-800 font-display flex items-center gap-2">
                            <span class="text-indigo-600">🌐</span> Connect to Federation
                        </h3>
                        <p class="text-slate-400 text-xs mt-1">Consolidate individual workspaces into a large unified federation space.</p>
                    </div>
                    <button @@click="joinFedOpen = false" class="text-slate-400 hover:text-slate-600 transition-colors p-1 rounded-lg hover:bg-slate-50">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                
                <form method="post" asp-page-handler="JoinFederation" class="space-y-4">
                    @Html.AntiForgeryToken()
                    
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Federation Join Code</label>
                        <input type="text" name="FedJoinCode" required placeholder="e.g. FED-STORE"
                               class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none transition-all uppercase placeholder:normal-case font-semibold tracking-wider text-slate-700">
                    </div>
                    
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Select Personal Workspace to Connect</label>
                        <div class="relative">
                            <select name="SelectedPersonalWorkspaceId" required
                                    class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none transition-all text-slate-700 appearance-none font-semibold">
                                <option value="" disabled selected>-- Select Workspace --</option>
                                @foreach (var ws in Model.PersonalWorkspaces)
                                {
                                    <option value="@ws.Id">@ws.Name (#@ws.JoinCode)</option>
                                }
                            </select>
                            <svg class="absolute right-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1.5 leading-relaxed">
                            💡 Public files in the selected Workspace will automatically be visible in the Federation Portal.
                        </p>
                    </div>
                    
                    <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-100">
                        <button type="button" @@click="joinFedOpen = false" 
                                class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-all">
                            Cancel
                        </button>
                        <button type="submit" 
                                class="px-5 py-2.5 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white rounded-xl text-sm font-bold shadow-lg shadow-indigo-100 hover:shadow-indigo-200 transition-all">
                            Establish Connection
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Join Workspace by Invite Code Modal -->
    <div x-show="joinWorkspaceOpen" 
         class="fixed inset-0 z-50 overflow-y-auto"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         style="display: none;"
         x-cloak>
        
        <!-- Backdrop overlay -->
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" @@click="joinWorkspaceOpen = false"></div>
        
        <!-- Modal Content Container -->
        <div class="flex min-h-full items-center justify-center p-4 text-center">
            <div x-show="joinWorkspaceOpen"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 scale-95"
                 x-transition:enter-end="opacity-100 scale-100"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100 scale-100"
                 x-transition:leave-end="opacity-0 scale-95"
                 class="relative transform overflow-hidden rounded-3xl bg-white p-6 text-left shadow-2xl transition-all w-full max-w-md border border-slate-100">
                 
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <h3 class="text-xl font-bold text-slate-800 font-display flex items-center gap-2">
                            <span class="text-emerald-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></span> Join Workspace
                        </h3>
                        <p class="text-slate-400 text-xs mt-1">Enter a secure invitation code to join another member's Workspace.</p>
                    </div>
                    <button @@click="joinWorkspaceOpen = false" class="text-slate-400 hover:text-slate-600 transition-colors p-1 rounded-lg hover:bg-slate-50 cursor-pointer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                
                <form method="post" asp-page-handler="JoinWorkspaceByInviteCode" class="space-y-4">
                    @Html.AntiForgeryToken()
                    
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Secure Invite Code</label>
                        <input type="text" name="WorkspaceInviteCodeInput" required placeholder="e.g. 12345678-abcd-1234-abcd-1234567890ab"
                               class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none transition-all font-mono text-slate-700">
                    </div>
                    
                    <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-100">
                        <button type="button" @@click="joinWorkspaceOpen = false" 
                                class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-all cursor-pointer">
                            Cancel
                        </button>
                        <button type="submit" 
                                class="px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-sm font-bold shadow-lg transition-all cursor-pointer">
                            Join
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

