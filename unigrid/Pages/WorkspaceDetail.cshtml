                                                      </button>
                                                      <span class="text-xs font-black text-slate-800" x-text="getMonthName(calendarMonth) + ' ' + calendarYear"></span>
                                                      <button type="button" @@click="nextMonth()" class="p-1 rounded-lg hover:bg-slate-100 text-slate-500 hover:text-slate-700 transition-colors cursor-pointer">
