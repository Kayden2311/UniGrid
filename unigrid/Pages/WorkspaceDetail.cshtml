@page "{joinCode}"
@model unigrid.Pages.WorkspaceDetailModel
@{
    ViewData["Title"] = Model.Workspace.Name;
    Layout = "_Layout";

    // Compute Metrics
    var totalTasks = Model.WorkspaceTasks.Count;
    var inProgressTasks = Model.WorkspaceTasks.Count(t => t.Status == 1);
    var reviewTasks = Model.WorkspaceTasks.Count(t => t.Status == 2);
    var completedTasks = Model.WorkspaceTasks.Count(t => t.Status == 3);
    var todoTasks = Model.WorkspaceTasks.Count(t => t.Status == 0);
    var overdueTasks = Model.WorkspaceTasks.Count(t => t.Status != 3 && t.DueDate < DateTime.UtcNow);

    // Dynamic Color Palette for SVGs
    var todoColor = "#94a3b8"; // Slate
    var inProgressColor = "#4f46e5"; // Indigo
    var reviewColor = "#a855f7"; // Purple
    var doneColor = "#22c55e"; // Green

    // Member data serialization for charts
    var memberChartData = Model.Members.Select(m => {
        var assigned = Model.WorkspaceTasks.Count(t => t.AssigneeId == m.UserId);
        var completed = Model.WorkspaceTasks.Count(t => t.AssigneeId == m.UserId && t.Status == 3);
        var rate = assigned > 0 ? (int)Math.Round((double)completed / assigned * 100) : 0;
        return new {
            Name = m.User.FullName.Split(' ')[0],
            FullName = m.User.FullName,
            Assigned = assigned,
            Completed = completed,
            Rate = rate,
            Initials = string.Concat(m.User.FullName.Split(' ').Select(n => n[0]))
        };
    }).OrderByDescending(m => m.Completed).ToList();

    // Compile Workspace Activity Logs dynamically from databases
    var activities = new List<dynamic>();

    foreach (var task in Model.WorkspaceTasks)
    {
        // 1. Task created activity
        activities.Add(new {
            Type = "task_created",
            User = task.Assignee?.FullName ?? Model.Workspace.Owner.FullName,
            Description = $"created task \"{task.Title}\"",
            Time = task.CreatedAt,
            Icon = "clipboard-list",
            Color = "text-indigo-600 bg-indigo-50 border-indigo-100"
        });

        // 2. Comments posted
        foreach (var comment in task.TaskComments)
        {
            activities.Add(new {
                Type = "comment_added",
                User = comment.User.FullName,
                Description = $"commented on \"{task.Title}\": \"{comment.Content}\"",
                Time = comment.CreatedAt,
                Icon = "message-square",
                Color = "text-purple-600 bg-purple-50 border-purple-100"
            });
        }
    }

    // 3. File uploads
    foreach (var file in Model.Files)
    {
        activities.Add(new {
            Type = "file_uploaded",
            User = file.User.FullName,
            Description = $"uploaded file \"{file.FileName}\"",
            Time = file.CreatedAt ?? DateTime.UtcNow.AddDays(-1),
            Icon = "file-text",
            Color = "text-emerald-600 bg-emerald-50 border-emerald-100"
        });
    }

    // Sort by time descending and take top 10
    var sortedActivities = activities
        .OrderByDescending(a => a.Time)
        .Take(10)
        .ToList();

    // Storage Calculations
    string packageTier = Model.Workspace.PackageTier ?? "Free";
    bool isIndividualStorage = (packageTier == "Personal");
    bool isGroupTier = packageTier != "Personal";
    bool isPersonalWs = (Model.Workspace.WorkspaceType == "Personal" || packageTier == "Personal") && !isGroupTier;
    long totalStorageUsed = isIndividualStorage 
        ? Model.Files.Where(f => f.UserId == Model.CurrentUser.Id).Sum(f => f.FileSize) 
        : Model.Files.Sum(f => f.FileSize);

    long maxStorageLimit = 0;
    if (packageTier == "Personal")
    {
        string userTier = Model.CurrentUser.SubscriptionTier ?? "Free";
        if (userTier == "Personal") maxStorageLimit = 2L * 1024 * 1024 * 1024; // 2 GB
        else if (userTier == "Pro") maxStorageLimit = 20L * 1024 * 1024 * 1024; // 20 GB
        else if (userTier == "ProPlus") maxStorageLimit = 40L * 1024 * 1024 * 1024; // 40 GB
        else if (userTier == "Business") maxStorageLimit = 80L * 1024 * 1024 * 1024; // 80 GB
        else maxStorageLimit = 0;
    }
    else if (packageTier == "Pro")
    {
        maxStorageLimit = 20L * 1024 * 1024 * 1024; // 20 GB
    }
    else if (packageTier == "ProPlus")
    {
        maxStorageLimit = 40L * 1024 * 1024 * 1024; // 40 GB
    }
    else if (packageTier == "Business")
    {
        maxStorageLimit = 80L * 1024 * 1024 * 1024; // 80 GB
    }

    double storagePercent = maxStorageLimit > 0 ? ((double)totalStorageUsed / maxStorageLimit) * 100 : (packageTier == "Free" || (isIndividualStorage && maxStorageLimit <= 0) ? 100.0 : 0.0);

    string usedStorageStr = "";
    if (totalStorageUsed >= 1024L * 1024 * 1024) {
        usedStorageStr = $"{(totalStorageUsed / (1024.0 * 1024 * 1024)):F1} GB";
    } else {
        usedStorageStr = $"{(totalStorageUsed / (1024.0 * 1024)):F1} MB";
    }

    string limitStr = maxStorageLimit >= 1024L * 1024 * 1024 
        ? $"{(maxStorageLimit / (1024L * 1024 * 1024))} GB" 
        : "0 GB";
}

<div class="space-y-6" 
     x-data="workspaceDetail"
     @@open-task-detail.window="
        const matchedTask = workspaceTasks.find(t => t.id === $event.detail);
        if (matchedTask) {
            const selector = `[draggable='true'][@@dragstart*='${$event.detail}']`;
            const card = document.querySelector(selector);
            if (card) {
                card.click();
            } else {
                alert('Open task detail: ' + matchedTask.title);
            }
        }
     ">

    <!-- Alerts Notification -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200/50 flex items-center gap-3 text-rose-800 text-sm font-semibold shadow-sm animate-fade-in" x-data="{ show: true }" x-show="show" x-transition>
            <i data-lucide="alert-triangle" class="w-5 h-5 text-rose-600 shrink-0"></i>
            <span class="flex-grow text-left">@TempData["ErrorMessage"]</span>
            <button @@click="show = false" class="text-rose-500 hover:text-rose-700 p-1 hover:bg-rose-100 rounded-lg transition-colors cursor-pointer">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200/50 flex items-center gap-3 text-emerald-800 text-sm font-semibold shadow-sm animate-fade-in" x-data="{ show: true }" x-show="show" x-transition>
            <i data-lucide="check-circle" class="w-5 h-5 text-emerald-600 shrink-0"></i>
            <span class="flex-grow text-left">@TempData["SuccessMessage"]</span>
            <button @@click="show = false" class="text-emerald-500 hover:text-emerald-700 p-1 hover:bg-emerald-100 rounded-lg transition-colors cursor-pointer">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    <!-- ─── Workspace Header ─── -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="h-14 w-14 rounded-2xl bg-indigo-600 flex items-center justify-center text-white shadow-lg shadow-indigo-200">
                <i data-lucide="layers" class="w-8 h-8"></i>
            </div>
            <div>
                <h2 class="text-3xl font-black text-slate-800 tracking-tight">@Model.Workspace.Name</h2>
                <div class="flex items-center gap-2 mt-1 text-slate-500 text-sm">
                    <span class="font-bold text-slate-400 font-mono">#@Model.Workspace.JoinCode</span>
                    <span>•</span>
                    <span>Owner: <strong>@Model.Workspace.Owner.FullName</strong></span>
                    <span>•</span>
                    <span class="px-2 py-0.5 bg-indigo-50 text-indigo-600 text-[10px] font-black rounded-full uppercase tracking-wider">@Model.Workspace.PackageTier Plan</span>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="/Pricing?joinCode=@Model.Workspace.JoinCode" class="bg-gradient-to-r from-amber-500 to-orange-500 text-white px-4 py-2.5 rounded-xl text-xs font-black shadow-lg shadow-orange-100 hover:shadow-orange-200 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-2">
                <i data-lucide="crown" class="w-4 h-4"></i> Upgrade Package
            </a>
            @if (!isPersonalWs)
            {
                <button @@click="inviteOpen = true" class="bg-indigo-600 text-white px-4 py-2.5 rounded-xl text-xs font-black shadow-lg shadow-indigo-100 hover:bg-indigo-700 transition-all flex items-center gap-2">
                    <i data-lucide="user-plus" class="w-4 h-4"></i> Invite Member
                </button>
            }
        </div>
    </div>

    <!-- ─── View Tabs ─── -->
    <div class="flex items-center gap-1 border-b border-slate-200 scrollbar-none overflow-x-auto whitespace-nowrap">
        <button @@click="activeTab = 'dashboard'"
                :class="activeTab === 'dashboard' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-800'"
                class="flex items-center gap-2 px-6 py-4 text-sm font-bold border-b-2 transition-all">
            <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard
        </button>
        <button @@click="activeTab = 'tasks'"
                :class="activeTab === 'tasks' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-800'"
                class="flex items-center gap-2 px-6 py-4 text-sm font-bold border-b-2 transition-all">
            <i data-lucide="kanban-square" class="w-4 h-4"></i> Tasks
        </button>
        @if (!isPersonalWs)
        {
            <button @@click="activeTab = 'chat'"
                    :class="activeTab === 'chat' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-800'"
                    class="flex items-center gap-2 px-6 py-4 text-sm font-bold border-b-2 transition-all relative">
                <i data-lucide="messages-square" class="w-4 h-4"></i> Chat
                <span class="absolute top-2.5 right-1 w-2 h-2 bg-indigo-600 rounded-full"></span>
            </button>
        }
        @if (!isPersonalWs)
        {
            <button @@click="activeTab = 'members'"
                    :class="activeTab === 'members' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-800'"
                    class="flex items-center gap-2 px-6 py-4 text-sm font-bold border-b-2 transition-all">
                <i data-lucide="users" class="w-4 h-4"></i> Members
            </button>
        }
        <button @@click="activeTab = 'files'"
                :class="activeTab === 'files' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-800'"
                class="flex items-center gap-2 px-6 py-4 text-sm font-bold border-b-2 transition-all">
            <i data-lucide="folder-open" class="w-4 h-4"></i> Files
        </button>
        @if (packageTier == "Business" || Model.Workspace.FederationId != null)
        {
            <button @@click="activeTab = 'kpi'"
                    :class="activeTab === 'kpi' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-800'"
                    class="flex items-center gap-2 px-6 py-4 text-sm font-bold border-b-2 transition-all">
                <i data-lucide="bar-chart-3" class="w-4 h-4"></i> KPI Dashboard
            </button>
        }
    </div>

    <!-- ════════════════════════════════════════ -->
    <!-- ─── TAB 1: DASHBOARD ─── -->
    <!-- ════════════════════════════════════════ -->
    <div x-show="activeTab === 'dashboard'" class="space-y-6" x-transition>
        <!-- Metric Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <!-- Total Tasks -->
            <div class="bg-white py-3 px-5 rounded-2xl border border-slate-150 border-l-[4px] border-l-slate-400 flex items-center justify-between shadow-xs">
                <div>
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Total Tasks</p>
                    <h4 class="text-2xl font-black text-slate-800 tracking-tight mt-0.5">@totalTasks</h4>
                </div>
                <div class="h-8 w-8 rounded-lg bg-slate-50 flex items-center justify-center text-slate-500">
                    <i data-lucide="target" class="w-4 h-4"></i>
                </div>
            </div>
            <!-- In Progress -->
            <div class="bg-white py-3 px-5 rounded-2xl border border-slate-150 border-l-[4px] border-l-indigo-600 flex items-center justify-between shadow-xs">
                <div>
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-wider">In Progress</p>
                    <h4 class="text-2xl font-black text-indigo-600 tracking-tight mt-0.5">@inProgressTasks</h4>
                </div>
                <div class="h-8 w-8 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-600">
                    <i data-lucide="play" class="w-4 h-4"></i>
                </div>
            </div>
            <!-- Completed -->
            <div class="bg-white py-3 px-5 rounded-2xl border border-slate-150 border-l-[4px] border-l-green-500 flex items-center justify-between shadow-xs">
                <div>
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Completed</p>
                    <h4 class="text-2xl font-black text-green-500 tracking-tight mt-0.5">@completedTasks</h4>
                </div>
                <div class="h-8 w-8 rounded-lg bg-green-50 flex items-center justify-center text-green-500">
                    <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                </div>
            </div>
            <!-- Overdue -->
            <div class="bg-white py-3 px-5 rounded-2xl border border-slate-150 border-l-[4px] border-l-rose-500 flex items-center justify-between shadow-xs">
                <div>
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Overdue</p>
                    <h4 class="text-2xl font-black text-rose-500 tracking-tight mt-0.5">@overdueTasks</h4>
                </div>
                <div class="h-8 w-8 rounded-lg bg-rose-50 flex items-center justify-center text-rose-500">
                    <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- 1. Task Distribution Semi-Circle Donut Chart -->
            <div class="glass p-6 rounded-[2.5rem] shadow-sm flex flex-col justify-between relative overflow-hidden transition-all duration-300 transform hover:scale-[1.03] hover:-translate-y-1 hover:shadow-lg cursor-pointer border border-transparent hover:border-indigo-200 select-none">
                <div class="flex items-center gap-2 mb-4">
                    <i data-lucide="bar-chart-3" class="w-5 h-5 text-indigo-600"></i>
                    <h3 class="text-base font-black text-slate-800">Task Distribution</h3>
                </div>
                
                <div class="flex items-center justify-center py-4 relative">
                    <!-- Centered Donut Pop-up Tooltip -->
                    <div class="absolute bg-white border border-slate-150 shadow-lg px-6 py-3.5 rounded-2xl text-center z-10 text-xs font-black text-slate-800 transition-all duration-300 pointer-events-none select-none"
                         style="top: 48%; left: 50%; transform: translate(-50%, -50%); min-width: 140px; border-radius: 1rem;"
                         x-show="hoveredSegment !== ''" x-transition x-cloak>
                         <span x-text="hoveredSegment"></span>
                    </div>

                    <!-- Rotated 135deg clockwise so the 25% gap is perfectly centered at the bottom -->
                    <svg viewBox="0 0 42 42" class="w-60 h-60 transform rotate-[135deg]">
                        <!-- Background arc (75% length, 25% gap at bottom) -->
                        <circle cx="21" cy="21" r="15.915" fill="none" stroke="#f1f5f9" stroke-width="4.2" stroke-dasharray="75 25" stroke-dashoffset="0"></circle>
                        
                        @{
                            double total = totalTasks == 0 ? 1 : totalTasks;
                            // Scale active segments within the 75 units active arc
                            double pTodo = ((double)todoTasks / total) * 75;
                            double pInProg = ((double)inProgressTasks / total) * 75;
                            double pReview = ((double)reviewTasks / total) * 75;
                            double pDone = ((double)completedTasks / total) * 75;

                            double offset = 0;
                        }

                        @if (todoTasks > 0)
                        {
                            <circle cx="21" cy="21" r="15.915" fill="none" stroke="@todoColor" stroke-width="4.2" 
                                    stroke-dasharray="@pTodo @(100 - pTodo)" stroke-dashoffset="@offset"
                                    class="cursor-pointer transition-all duration-300 hover:stroke-[5.5]"
                                    @@mouseenter="hoveredSegment = 'To Do : @todoTasks'"
                                    @@mouseleave="hoveredSegment = ''"></circle>
                            offset -= pTodo;
                        }
                        @if (inProgressTasks > 0)
                        {
                            <circle cx="21" cy="21" r="15.915" fill="none" stroke="@inProgressColor" stroke-width="4.2" 
                                    stroke-dasharray="@pInProg @(100 - pInProg)" stroke-dashoffset="@offset"
                                    class="cursor-pointer transition-all duration-300 hover:stroke-[5.5]"
                                    @@mouseenter="hoveredSegment = 'In Progress : @inProgressTasks'"
                                    @@mouseleave="hoveredSegment = ''"></circle>
                            offset -= pInProg;
                        }
                        @if (reviewTasks > 0)
                        {
                            <circle cx="21" cy="21" r="15.915" fill="none" stroke="@reviewColor" stroke-width="4.2" 
                                    stroke-dasharray="@pReview @(100 - pReview)" stroke-dashoffset="@offset"
                                    class="cursor-pointer transition-all duration-300 hover:stroke-[5.5]"
                                    @@mouseenter="hoveredSegment = 'Review : @reviewTasks'"
                                    @@mouseleave="hoveredSegment = ''"></circle>
                            offset -= pReview;
                        }
                        @if (completedTasks > 0)
                        {
                            <circle cx="21" cy="21" r="15.915" fill="none" stroke="@doneColor" stroke-width="4.2" 
                                    stroke-dasharray="@pDone @(100 - pDone)" stroke-dashoffset="@offset"
                                    class="cursor-pointer transition-all duration-300 hover:stroke-[5.5]"
                                    @@mouseenter="hoveredSegment = 'Done : @completedTasks'"
                                    @@mouseleave="hoveredSegment = ''"></circle>
                        }
                    </svg>
                </div>
                
                <!-- Legend -->
                <div class="flex items-center justify-center gap-4 text-xs font-bold text-slate-500 mt-4">
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-slate-400"></span> To Do</span>
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-indigo-500"></span> In Progress</span>
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-purple-500"></span> Review</span>
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-green-500"></span> Done</span>
                </div>
            </div>

            <!-- Member Contributions Chart -->
            <div class="glass p-6 rounded-[2.5rem] shadow-sm flex flex-col justify-between transition-all duration-300 transform hover:scale-[1.03] hover:-translate-y-1 hover:shadow-lg cursor-pointer border border-transparent hover:border-indigo-200 select-none relative">
                <div class="flex items-center gap-2 mb-4">
                    <i data-lucide="trending-up" class="w-5 h-5 text-indigo-600"></i>
                    <h3 class="text-base font-black text-slate-800">Member Contributions</h3>
                </div>
                
                <!-- Floating tooltip pop-up style box -->
                <div class="absolute bg-white border border-slate-150 shadow-xl p-4 rounded-2xl transition-all duration-300 pointer-events-none z-20 w-44 flex flex-col gap-1 text-left"
                     x-show="hoveredMemberIndex !== null"
                     :style="'left: calc(' + ((55 + hoveredMemberIndex * 48) / 300 * 100) + '% - 88px); top: 50px; border-radius: 1rem;'"
                     x-transition x-cloak>
                     <p class="text-xs font-black text-slate-700" x-text="hoveredMemberText"></p>
                     <p class="text-[11px] font-bold text-indigo-650 flex justify-between mt-1.5">
                         <span>Assigned :</span>
                         <span x-text="hoveredMemberAssigned"></span>
                     </p>
                     <p class="text-[11px] font-bold text-emerald-600 flex justify-between">
                         <span>Completed :</span>
                         <span x-text="hoveredMemberCompleted"></span>
                     </p>
                </div>

                <div class="flex-1 flex flex-col justify-center py-2">
                    @{
                        int maxTasks = memberChartData.Any() ? memberChartData.Max(m => Math.Max(m.Assigned, 1)) : 5;
                    }
                    <svg viewBox="0 0 300 200" class="w-full h-60">
                        <!-- Grid Lines -->
                        <line x1="30" y1="30" x2="280" y2="30" stroke="#e2e8f0" stroke-dasharray="3" stroke-width="0.75" />
                        <line x1="30" y1="70" x2="280" y2="70" stroke="#e2e8f0" stroke-dasharray="3" stroke-width="0.75" />
                        <line x1="30" y1="110" x2="280" y2="110" stroke="#e2e8f0" stroke-dasharray="3" stroke-width="0.75" />
                        <line x1="30" y1="150" x2="280" y2="150" stroke="#cbd5e1" stroke-width="1.5" />
                        
                        <!-- Y-Axis Labels -->
                        <text x="20" y="34" text-anchor="end" class="text-[9px] font-bold text-slate-400 fill-current">@maxTasks</text>
                        <text x="20" y="74" text-anchor="end" class="text-[9px] font-bold text-slate-400 fill-current">@(maxTasks * 3 / 4)</text>
                        <text x="20" y="114" text-anchor="end" class="text-[9px] font-bold text-slate-400 fill-current">@(maxTasks / 2)</text>
                        <text x="20" y="154" text-anchor="end" class="text-[9px] font-bold text-slate-400 fill-current">0</text>
                        
                        @for (int i = 0; i < Math.Min(memberChartData.Count, 5); i++)
                        {
                            var m = memberChartData[i];
                            double hAssigned = ((double)m.Assigned / maxTasks) * 120;
                            double hCompleted = ((double)m.Completed / maxTasks) * 120;
                            
                            double xBase = 55 + i * 48;
                            string xLabelStr = xBase.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
                            string nameStr = m.Name;
                            
                            <!-- Column Hover Background (Gray highlight) -->
                            <rect x="@(xBase - 18)" y="15" width="36" height="135" fill="#e2e8f0" rx="4"
                                  class="transition-opacity duration-200 pointer-events-none"
                                  :style="hoveredMemberIndex === @i ? 'opacity: 0.6;' : 'opacity: 0;'" />

                            <!-- Assigned Bar (Indigo) -->
                            <rect x="@(xBase - 8)" y="@(150 - hAssigned)" width="10" height="@hAssigned" fill="#4f46e5" rx="1.5"
                                  class="transition-all duration-300 pointer-events-none" />
                            
                            <!-- Completed Bar (Green) -->
                            <rect x="@(xBase + 4)" y="@(150 - hCompleted)" width="10" height="@hCompleted" fill="#22c55e" rx="1.5"
                                  class="transition-all duration-300 pointer-events-none" />

                            <!-- Column Hover Target (Transparent overlay for massive hover area) -->
                            <rect x="@(xBase - 18)" y="15" width="36" height="150" fill="transparent" class="cursor-pointer"
                                  @@mouseenter="hoveredMemberIndex = @i; hoveredMemberText = '@m.FullName'; hoveredMemberAssigned = @m.Assigned; hoveredMemberCompleted = @m.Completed"
                                  @@mouseleave="hoveredMemberIndex = null" />

                            <!-- X Axis Label (First Name) -->
                            @Html.Raw("<text x='" + xLabelStr + "' y='166' text-anchor='middle' class='text-[9px] font-bold text-slate-500 fill-current'>" + nameStr + "</text>")
                        }
                    </svg>
                </div>
                <!-- Legend -->
                <div class="flex items-center gap-4 mt-2 justify-center text-[10px] font-bold text-slate-500">
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-indigo-600 inline-block"></span> Assigned</span>
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span> Completed</span>
                </div>
            </div>
        </div>

        <!-- Completion Rate by Member Spanning Full-Width Bottom Row -->
        <div class="bg-white p-8 rounded-[2.5rem] border border-slate-200 shadow-sm flex flex-col justify-between transition-all duration-300 transform hover:scale-[1.01] hover:-translate-y-1 hover:shadow-lg cursor-pointer hover:border-indigo-200 select-none relative">
            <div class="flex items-center gap-2 mb-6">
                <i data-lucide="activity" class="w-6 h-6 text-indigo-600"></i>
                <h3 class="text-lg font-black text-slate-800">Completion Rate by Member</h3>
            </div>
            
            <!-- Floating tooltip pop-up style box for completion rate -->
            <div class="absolute bg-white border border-slate-150 shadow-xl p-4 rounded-2xl transition-all duration-300 pointer-events-none z-20 w-40 flex flex-col gap-1 text-left"
                 x-show="hoveredRateIndex !== null"
                 :style="'left: calc(' + ((100 + hoveredRateIndex * 200) / 1000 * 100) + '% - 80px); top: 85px; border-radius: 1rem;'"
                 x-transition x-cloak>
                 <p class="text-xs font-black text-slate-700" x-text="hoveredRateName"></p>
                 <p class="text-[11px] font-bold text-indigo-650 flex justify-between mt-1.5">
                     <span>rate :</span>
                     <span x-text="hoveredRatePercent + '%'"></span>
                 </p>
            </div>

            <div class="w-full">
                <svg viewBox="0 0 1000 240" class="w-full h-72">
                    <defs>
                        <linearGradient id="fullRateGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#4f46e5" stop-opacity="0.25" />
                            <stop offset="100%" stop-color="#4f46e5" stop-opacity="0.0" />
                        </linearGradient>
                    </defs>

                    <!-- Grid Lines -->
                    <line x1="80" y1="30" x2="950" y2="30" stroke="#e2e8f0" stroke-dasharray="4" stroke-width="1" />
                    <line x1="80" y1="72" x2="950" y2="72" stroke="#e2e8f0" stroke-dasharray="4" stroke-width="1" />
                    <line x1="80" y1="115" x2="950" y2="115" stroke="#e2e8f0" stroke-dasharray="4" stroke-width="1" />
                    <line x1="80" y1="157" x2="950" y2="157" stroke="#e2e8f0" stroke-dasharray="4" stroke-width="1" />
                    <line x1="80" y1="200" x2="950" y2="200" stroke="#cbd5e1" stroke-width="2" />
                    
                    <!-- Y-Axis Labels -->
                    <text x="60" y="34" text-anchor="end" class="text-[11px] font-bold text-slate-400 fill-current">100</text>
                    <text x="60" y="76" text-anchor="end" class="text-[11px] font-bold text-slate-400 fill-current">75</text>
                    <text x="60" y="119" text-anchor="end" class="text-[11px] font-bold text-slate-400 fill-current">50</text>
                    <text x="60" y="161" text-anchor="end" class="text-[11px] font-bold text-slate-400 fill-current">25</text>
                    <text x="60" y="204" text-anchor="end" class="text-[11px] font-bold text-slate-400 fill-current">0</text>

                    @{
                        var fullRatePoints = new List<string>();
                        var fullRateAreaPoints = new List<string>();
                        int fullMemberCount = Math.Min(memberChartData.Count, 5);
                        
                        double fullStartX = 100;
                        double fullSpacing = 200;
                        
                        if (fullMemberCount > 0) {
                            double firstY = 200 - ((double)memberChartData[0].Rate / 100) * 170;
                            fullRateAreaPoints.Add($"{fullStartX.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)},200");
                            fullRateAreaPoints.Add($"{fullStartX.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)},{firstY.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}");
                            fullRatePoints.Add($"{fullStartX.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)},{firstY.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}");
                            
                            for (int i = 1; i < fullMemberCount; i++)
                            {
                                var prevM = memberChartData[i - 1];
                                var currM = memberChartData[i];
                                
                                double prevX = fullStartX + (i - 1) * fullSpacing;
                                double prevY = 200 - ((double)prevM.Rate / 100) * 170;
                                
                                double currX = fullStartX + i * fullSpacing;
                                double currY = 200 - ((double)currM.Rate / 100) * 170;
                                
                                // Perfect bezier control coordinates for wide smooth spline curve
                                double cp1X = prevX + (fullSpacing / 2.2);
                                double cp1Y = prevY;
                                double cp2X = currX - (fullSpacing / 2.2);
                                double cp2Y = currY;

                                string seg = $"C {cp1X.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)},{cp1Y.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)} {cp2X.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)},{cp2Y.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)} {currX.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)},{currY.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}";
                                fullRatePoints.Add(seg);
                                fullRateAreaPoints.Add(seg);
                            }
                            
                            double lastX = fullStartX + (fullMemberCount - 1) * fullSpacing;
                            fullRateAreaPoints.Add($"L {lastX.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)},200");
                        }
                        
                        var fullPathStr = string.Join(" ", fullRatePoints);
                        var fullAreaStr = string.Join(" ", fullRateAreaPoints);
                    }

                    @if (fullMemberCount > 0)
                    {
                        <!-- Area Fill -->
                        <path d="M @fullAreaStr Z" fill="url(#fullRateGradient)" />
                        
                        <!-- Top Stroke line -->
                        <path d="M @fullPathStr" fill="none" stroke="#4f46e5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                        
                        @for (int i = 0; i < fullMemberCount; i++)
                        {
                            var m = memberChartData[i];
                            double xVal = fullStartX + i * fullSpacing;
                            double yVal = 200 - ((double)m.Rate / 100) * 170;
                            string xStr = xVal.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
                            string yStr = (yVal - 12).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
                            string rateStrStr = m.Rate.ToString();
                            string nameStr = m.FullName.Split(' ')[0];
                            
                            <!-- Vertical Guideline -->
                            <line x1="@xVal" y1="30" x2="@xVal" y2="200" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="3"
                                  class="transition-opacity duration-200 pointer-events-none"
                                  :style="hoveredRateIndex === @i ? 'opacity: 0.8;' : 'opacity: 0;'" />

                            <!-- Circular point -->
                            <circle cx="@xVal" cy="@yVal" fill="#ffffff" stroke="#4f46e5" stroke-width="3.5"
                                    class="cursor-pointer transition-all duration-300 hover:fill-indigo-50"
                                    :r="hoveredRateIndex === @i ? 8 : 5"
                                    @@mouseenter="hoveredRateIndex = @i; hoveredRateName = '@m.FullName'; hoveredRatePercent = @m.Rate"
                                    @@mouseleave="hoveredRateIndex = null" />
                            
                            <!-- Rate Text label above point -->
                            @Html.Raw("<text x='" + xStr + "' y='" + yStr + "' text-anchor='middle' class='text-[10px] font-black text-indigo-600 fill-current'>" + rateStrStr + "%</text>")

                            <!-- Full First name label at bottom -->
                            @Html.Raw("<text x='" + xStr + "' y='220' text-anchor='middle' class='text-[11px] font-bold text-slate-500 fill-current'>" + nameStr + "</text>")
                        }
                    }
                </svg>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Priority Tasks -->
            <div class="glass p-6 rounded-[2.5rem] shadow-sm flex flex-col">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2">
                        <i data-lucide="flag" class="w-5 h-5 text-rose-500"></i>
                        <h3 class="text-base font-black text-slate-800">Critical Priority Tasks</h3>
                    </div>
                    <span class="px-2.5 py-1 bg-rose-50 text-rose-600 text-[10px] font-black rounded-full uppercase tracking-wider">High</span>
                </div>
                <div class="space-y-3 max-h-[300px] overflow-y-auto pr-1">
                    @{
                        var highPriority = Model.WorkspaceTasks.Where(t => t.Priority == 3 && t.Status != 3).OrderBy(t => t.DueDate).ToList();
                    }
                    @if (!highPriority.Any())
                    {
                        <div class="text-center py-12 text-slate-400 font-bold">
                            No high priority tasks remaining. Good job!
                        </div>
                    }
                    @foreach (var task in highPriority)
                    {
                        <div @@click="selectTask('@Model.SerializeTaskBase64(task)')"
                             class="p-4 bg-white/60 hover:bg-white border border-slate-100 rounded-2xl flex items-center justify-between shadow-sm cursor-pointer hover:shadow transition-all group">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="h-9 w-9 rounded-xl bg-rose-50 flex items-center justify-center text-rose-500 shrink-0">
                                    <i data-lucide="alert-circle" class="w-5 h-5"></i>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-sm font-bold text-slate-700 truncate group-hover:text-indigo-600 transition-colors">@task.Title</p>
                                    <p class="text-xs text-slate-400 font-medium">Assigned to: @(task.Assignee?.FullName ?? "Unassigned")</p>
                                </div>
                            </div>
                            <div class="text-right shrink-0">
                                <span class="px-2 py-0.5 bg-rose-50 text-rose-500 text-[9px] font-bold rounded uppercase">
                                    Due: @(task.DueDate?.ToString("MMM dd") ?? "N/A")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Upcoming Deadlines -->
            <div class="glass p-6 rounded-[2.5rem] shadow-sm flex flex-col">
                <div class="flex items-center gap-2 mb-4">
                    <i data-lucide="calendar" class="w-5 h-5 text-amber-500"></i>
                    <h3 class="text-base font-black text-slate-800">Upcoming Deadlines</h3>
                </div>
                <div class="space-y-3 max-h-[300px] overflow-y-auto pr-1">
                    @{
                        var upcoming = Model.WorkspaceTasks.Where(t => t.Status != 3 && t.DueDate.HasValue).OrderBy(t => t.DueDate).Take(5).ToList();
                    }
                    @if (!upcoming.Any())
                    {
                        <div class="text-center py-12 text-slate-400 font-bold">
                            No upcoming due dates.
                        </div>
                    }
                    @foreach (var task in upcoming)
                    {
                        var remainingDays = (task.DueDate.Value - DateTime.UtcNow).Days;
                        <div @@click="selectTask('@Model.SerializeTaskBase64(task)')"
                             class="p-4 bg-white/60 hover:bg-white border border-slate-100 rounded-2xl flex items-center justify-between shadow-sm cursor-pointer hover:shadow transition-all group">
                            <div class="min-w-0">
                                <p class="text-sm font-bold text-slate-700 truncate group-hover:text-indigo-600 transition-colors">@task.Title</p>
                                <p class="text-xs text-slate-400 font-medium">Assigned to: @(task.Assignee?.FullName ?? "Unassigned")</p>
                            </div>
                            <div class="text-right shrink-0">
                                @if (remainingDays < 0)
                                {
                                    <span class="text-xs font-black text-rose-500">Overdue by @Math.Abs(remainingDays)d</span>
                                }
                                else if (remainingDays == 0)
                                {
                                    <span class="text-xs font-black text-amber-500">Due Today</span>
                                }
                                else
                                {
                                    <span class="text-xs font-black text-slate-400">@remainingDays days left</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div> <!-- Restored Dashboard tab closing tag -->

        <style>
            /* Thin premium macOS-like scrollbar */
            .scrollbar-thin::-webkit-scrollbar {
                width: 5px;
                height: 5px;
            }
            .scrollbar-thin::-webkit-scrollbar-track {
                background: transparent;
            }
            .scrollbar-thin::-webkit-scrollbar-thumb {
                background: rgba(148, 163, 184, 0.15);
                border-radius: 99px;
            }
            .scrollbar-thin::-webkit-scrollbar-thumb:hover {
                background: rgba(148, 163, 184, 0.35);
            }
            .scrollbar-thin {
                scrollbar-width: thin;
                scrollbar-color: rgba(148, 163, 184, 0.15) transparent;
            }

            /* Completely hide scrollbars but keep scrolling active */
            .scrollbar-none::-webkit-scrollbar,
            .scrollbar-hidden::-webkit-scrollbar {
                display: none !important;
                width: 0 !important;
                height: 0 !important;
                background: transparent !important;
            }
            .scrollbar-none,
            .scrollbar-hidden {
                -ms-overflow-style: none !important;  /* IE and Edge */
                scrollbar-width: none !important;  /* Firefox */
            }
        </style>

        <!-- Tasks Tab -->
        <div x-show="activeTab === 'tasks'" class="space-y-6" x-transition>
            <!-- Search & Filter Controls -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="relative">
                            <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                            <input type="text" x-model="searchQuery" placeholder="Search tasks..." 
                                   class="pl-10 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none w-64 transition-all">
                        </div>
                        <!-- Combined Filter Button with Premium Dropdown matching Pic 1 -->
                        <div class="relative" x-data="{ filterDropdownOpen: false }">
                            <button type="button" @@click="filterDropdownOpen = !filterDropdownOpen" 
                                    :class="filterDropdownOpen || filterPriority !== '' || filterAssignee !== '' || filterDate !== '' ? 'border-indigo-650 text-indigo-650 bg-indigo-50/50' : 'border-slate-200 text-slate-600 hover:bg-slate-50'"
                                    class="px-4 py-2 bg-white border rounded-xl text-sm font-bold transition-all flex items-center gap-2 cursor-pointer outline-none">
                                <i data-lucide="filter" class="w-4 h-4"></i>
                                <span>Filter</span>
                                <!-- Small count indicator if filters are active -->
                                <template x-if="filterPriority !== '' || filterAssignee !== '' || filterDate !== ''">
                                    <span class="h-2 w-2 rounded-full bg-indigo-600 animate-pulse"></span>
                                </template>
                            </button>

                            <!-- Dropdown Card matching Pic 1 -->
                            <div x-show="filterDropdownOpen" 
                                 @@click.away="filterDropdownOpen = false" 
                                 x-transition x-cloak
                                 class="absolute left-0 mt-2 w-64 bg-white border border-slate-150 rounded-2xl shadow-xl z-50 p-2 flex flex-col select-none">
                                 
                                 <!-- Section 1: Priority -->
                                 <div class="p-2 space-y-1">
                                     <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block px-2 pb-1.5 border-b border-slate-100/50">Priority</span>
                                     <div class="space-y-0.5 pt-1.5">
                                         <!-- High -->
                                         <button type="button" @@click="filterPriority = (filterPriority === '3' ? '' : '3'); filterDropdownOpen = false"
                                                 :class="filterPriority === '3' ? 'bg-indigo-50 text-indigo-600 font-extrabold shadow-sm' : 'hover:bg-slate-50 text-slate-700'"
                                                 class="w-full text-left px-3 py-2 rounded-xl text-xs font-semibold flex items-center gap-2.5 transition-all">
                                             <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                                             <span>High</span>
                                         </button>
                                         <!-- Medium -->
                                         <button type="button" @@click="filterPriority = (filterPriority === '2' ? '' : '2'); filterDropdownOpen = false"
                                                 :class="filterPriority === '2' ? 'bg-indigo-50 text-indigo-600 font-extrabold shadow-sm' : 'hover:bg-slate-50 text-slate-700'"
                                                 class="w-full text-left px-3 py-2 rounded-xl text-xs font-semibold flex items-center gap-2.5 transition-all">
                                             <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                             <span>Medium</span>
                                         </button>
                                         <!-- Low -->
                                         <button type="button" @@click="filterPriority = (filterPriority === '1' ? '' : '1'); filterDropdownOpen = false"
                                                 :class="filterPriority === '1' ? 'bg-indigo-50 text-indigo-600 font-extrabold shadow-sm' : 'hover:bg-slate-50 text-slate-700'"
                                                 class="w-full text-left px-3 py-2 rounded-xl text-xs font-semibold flex items-center gap-2.5 transition-all">
                                             <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                                             <span>Low</span>
                                         </button>
                                     </div>
                                 </div>

                                 <!-- Divider -->
                                 <div class="h-px bg-slate-100 my-1 mx-2"></div>

                                 <!-- Section 2: Assignee -->
                                 <div class="p-2 space-y-1">
                                     <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block px-2 pb-1.5 border-b border-slate-100/50">Assignee</span>
                                     <div class="space-y-0.5 pt-1.5 max-h-40 overflow-y-auto pr-0.5 scrollbar-none">
                                         @foreach (var m in Model.Members)
                                         {
                                             <button type="button" @@click="filterAssignee = (filterAssignee === '@m.UserId' ? '' : '@m.UserId'); filterDropdownOpen = false"
                                                     :class="filterAssignee === '@m.UserId' ? 'bg-indigo-50 text-indigo-600 font-extrabold shadow-sm' : 'hover:bg-slate-50 text-slate-700'"
                                                     class="w-full text-left px-3 py-2 rounded-xl text-xs font-semibold flex items-center gap-2 transition-all">
                                                 <div class="h-5 w-5 rounded-full bg-slate-100 border flex items-center justify-center text-[7px] font-black uppercase text-slate-500 shrink-0">
                                                     @string.Concat(m.User.FullName.Split(' ').Select(n => n[0]))
                                                 </div>
                                                 <span class="truncate">@m.User.FullName</span>
                                             </button>
                                         }
                                     </div>
                                 </div>

                                 <!-- Divider -->
                                 <div class="h-px bg-slate-100 my-1 mx-2"></div>

                                 <!-- Section 3: Due Date -->
                                 <div class="p-2 space-y-1">
                                     <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block px-2 pb-1.5 border-b border-slate-100/50">Due Date</span>
                                     <div class="pt-1.5 px-2">
                                         <div class="relative" @@click.away="calendarOpen = false">
                                              <button type="button" @@click="calendarOpen = !calendarOpen" 
                                                      class="w-full bg-slate-50 hover:bg-slate-100 text-slate-650 border border-slate-200 px-3 py-2 rounded-xl text-xs font-semibold transition-all flex items-center justify-between gap-2 cursor-pointer"
                                                      :class="filterDate ? 'border-indigo-400 bg-indigo-50/30 text-indigo-750 font-bold' : ''">
                                                  <span x-text="filterDate ? filterDate : 'Select Date'" class="text-[11px]">Select Date</span>
                                                  <div class="flex items-center gap-1.5 shrink-0">
                                                      <svg class="w-3.5 h-3.5" :class="filterDate ? 'text-indigo-650' : 'text-slate-400'" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                                      <template x-if="filterDate">
                                                          <span @@click.stop="filterDate = ''" class="hover:text-rose-500 cursor-pointer flex items-center">
                                                              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
                                                          </span>
                                                      </template>
                                                  </div>
                                              </button>
                                              
                                              <!-- Side Calendar Popover -->
                                              <div x-show="calendarOpen"
