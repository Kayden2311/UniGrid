                                                          </button>
                                                      </template>
                                                  </div>
                                                  
                                                  <!-- Clear Row -->
                                                  <template x-if="filterDate">
                                                      <div class="mt-3 pt-2 border-t border-slate-100 flex justify-end">
                                                          <button type="button" @@click="filterDate = ''; calendarOpen = false" class="text-[10px] font-black text-rose-500 hover:text-rose-600 flex items-center gap-1 transition-colors cursor-pointer">
                                                              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
                                                              Clear Filter
                                                          </button>
                                                      </div>
                                                  </template>
                                              </div>
                                          </div>
                                          <input type="date" x-ref="taskDateInput" x-model="filterDate" class="absolute inset-0 opacity-0 pointer-events-none w-0 h-0">
                                     </div>
                                 </div>
                             </div>
                        </div>
                    </div>
 
                    <div class="flex items-center gap-2">
                        <button type="button" 
                                x-show="currentUserRole === 'Owner' || currentUserRole === 'Manager' || currentUserRole === 'Vice Manager'" 
                                @@click="manageCategoriesOpen = true" 
                                class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2.5 rounded-xl text-sm font-bold border border-slate-200 transition-all flex items-center gap-1.5 cursor-pointer">
                            <i data-lucide="tag" class="w-4 h-4 text-slate-500"></i> Categories
                        </button>
                        <button x-show="currentUserCanCreateTask" @@click="openCreateModal(0)" class="bg-indigo-600 text-white px-5 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-indigo-200 hover:bg-indigo-700 transition-all flex items-center gap-2">
                            <i data-lucide="plus" class="w-4 h-4"></i> Create Task
                        </button>
                    </div>
                </div>
 
                <!-- Flex Container for Kanban & Activity Log -->
                <div class="flex flex-col lg:flex-row gap-6 items-start w-full">
                    <!-- Left Kanban Board Area -->
                    <div class="flex-1 space-y-4 w-full">
                        <!-- 4-Column Kanban Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 min-h-[500px]">
                    @for (int colIndex = 0; colIndex < 4; colIndex++)
                    {
                        var colStatus = colIndex;
                        var colLabel = colStatus == 0 ? "To Do" : colStatus == 1 ? "In Progress" : colStatus == 2 ? "Review" : "Done";
                        var colBg = colStatus == 0 ? "bg-slate-50" : colStatus == 1 ? "bg-indigo-50/40" : colStatus == 2 ? "bg-purple-50/40" : "bg-green-50/40";
                        var colBorder = colStatus == 0 ? "border-slate-200" : colStatus == 1 ? "border-indigo-100" : colStatus == 2 ? "border-purple-100" : "border-green-100";
                        var colText = colStatus == 0 ? "text-slate-500" : colStatus == 1 ? "text-indigo-600" : colStatus == 2 ? "text-purple-600" : "text-green-600";
                        
                        var headerIcon = colStatus == 0 ? "clock" : colStatus == 1 ? "arrow-right-circle" : colStatus == 2 ? "eye" : "check-circle";
                        var headerIconColor = colStatus == 0 ? "text-slate-400" : colStatus == 1 ? "text-indigo-500 animate-pulse" : colStatus == 2 ? "text-purple-500" : "text-emerald-500";
                        
                        var statusTasks = Model.WorkspaceTasks.Where(t => t.Status == colStatus).ToList();
 
                        <div class="rounded-3xl p-4 @colBg border @colBorder flex flex-col gap-3"
                             @@dragover.prevent
                             @@drop="
                                  const taskId = draggedTaskId;
                                  if (taskId) {
                                      const tObj = workspaceTasks.find(t => t.id === taskId);
                                      const currentStatus = tObj ? tObj.status : null;
                                      
                                      if (currentUserRole !== 'Manager' && currentUserRole !== 'Vice Manager') {
                                          if (@colStatus === 3) {
                                              alert('Only Managers or Vice Managers have permission to approve and complete tasks!');
                                              draggedTaskId = null;
                                              return;
                                          }
                                          if (currentStatus === 3) {
                                              alert('Only Managers or Vice Managers have permission to rework completed tasks!');
                                              draggedTaskId = null;
                                              return;
                                          }
                                      }
                                      pendingKanbanTaskId = taskId;
                                      pendingKanbanStatus = @colStatus;
                                      pendingKanbanTaskTitle = draggedTaskTitle;
                                      confirmKanbanOpen = true;
                                      draggedTaskId = null;
                                  }
                              ">
                            <div class="flex items-center justify-between px-2 pb-1 border-b border-slate-100">
                                <div class="flex items-center gap-2">
                                    <i data-lucide="@headerIcon" class="w-4 h-4 shrink-0 @headerIconColor"></i>
                                    <span class="text-sm font-black @colText">@colLabel</span>
                                    <span class="px-2 py-0.5 rounded-full bg-white border border-slate-100 text-[10px] font-black text-slate-400">@statusTasks.Count</span>
                                </div>
                                <button x-show="currentUserCanCreateTask" @@click="openCreateModal(@colStatus)" class="h-6 w-6 rounded hover:bg-white/80 flex items-center justify-center text-slate-400">
                                    <i data-lucide="plus" class="w-4 h-4"></i>
                                </button>
                            </div>

                            <!-- Tasks Container -->
                            <div class="flex-1 space-y-3 overflow-y-auto max-h-[600px] pr-0.5 scrollbar-none">
                                @foreach (var task in statusTasks)
                                {
                                    var priorityLabel = task.Priority == 1 ? "Low" : task.Priority == 2 ? "Medium" : "High";
                                    var isOverdue = task.Status != 3 && task.DueDate < DateTime.UtcNow;

                                    // Solid left border priority styling matching Pic 2
                                    var priorityBorderColor = task.Priority == 1 ? "border-l-blue-400" : task.Priority == 2 ? "border-l-amber-500" : "border-l-rose-500";
                                    var remainingDays = task.DueDate.HasValue ? (task.DueDate.Value - DateTime.UtcNow).Days : 0;

                                    <div @@click="selectTask('@Model.SerializeTaskBase64(task)')"
                                         x-show="(searchQuery === '' || '@Html.Raw(task.Title.Replace("'", "\\'").Replace("\"", "\\\"").ToLower())'.includes(searchQuery.toLowerCase())) && 
                                                 (filterPriority === '' || '@task.Priority' === filterPriority) && 
                                                 (filterAssignee === '' || '@task.AssigneeId' === filterAssignee)"
                                         draggable="true"
                                         @@dragstart="
                                              if (currentUserRole !== 'Owner' && currentUserRole !== 'Manager') {
                                                  if ('@task.AssigneeId' !== currentUserId) {
                                                      alert('You can only move tasks assigned to yourself!');
                                                      $event.preventDefault();
                                                      return;
                                                  }
                                                  if (@task.Status === 3) {
                                                      alert('Only Managers or Owners have permission to rework completed tasks!');
                                                      $event.preventDefault();
                                                      return;
                                                  }
                                              }
                                              draggedTaskId = '@task.Id';
                                              draggedTaskTitle = '@Html.Raw(task.Title.Replace("'", "\\'").Replace("\"", "\\\""))';
                                         "
                                         class="bg-white p-3 rounded-[1.25rem] border border-slate-200 border-l-[4px] @priorityBorderColor shadow-sm hover:shadow-md cursor-pointer transition-all relative overflow-hidden flex flex-col justify-between h-[120px] w-full shrink-0">

                                          <!-- Row 1: Header Row (Title and Initials) -->
                                          <div class="flex items-center justify-between gap-2.5 h-[22px] overflow-hidden">
                                              <div class="flex items-center gap-1.5 min-w-0">
                                                  <i data-lucide="grip-vertical" class="w-4 h-4 text-slate-300 group-hover:text-slate-400 cursor-grab active:cursor-grabbing shrink-0"></i>
                                                  <span class="text-[12px] font-bold text-slate-800 tracking-tight leading-none truncate group-hover:text-indigo-600 transition-colors">@task.Title</span>
                                              </div>
                                              <div class="h-5 w-5 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-[8px] font-bold text-slate-500 shrink-0 uppercase select-none">
                                                  @(task.Assignee != null ? string.Concat(task.Assignee.FullName.Split(' ').Select(n => n[0])) : "??")
                                              </div>
                                          </div>

                                           <!-- Row 2: Description / Deliverable Row -->
                                           <div class="h-[16px] flex items-center overflow-hidden mt-0.5 select-none">
                                               @if (task.Status == 3 && task.WorkspaceFiles.Any())
                                               {
                                                   var firstFile = task.WorkspaceFiles.First();
                                                   <p class="text-[10px] text-emerald-600 font-bold truncate w-full flex items-center gap-1 animate-pulse" title="Completed Deliverable: @firstFile.FileName">
                                                       <i data-lucide="file-check" class="w-4 h-4 text-emerald-500 shrink-0"></i>
                                                       <span>Result: <span class="underline font-black">@firstFile.FileName</span></span>
                                                   </p>
                                               }
                                               else
                                               {
                                                   <p class="text-[10px] text-slate-400 truncate w-full">
                                                       @(string.IsNullOrWhiteSpace(task.Description) ? "No description provided." : task.Description)
                                                   </p>
                                               }
                                           </div>

                                          <!-- Row 3: Footer Row (Priority badge, due date, blocked/comments/files indicators) -->
                                          <div class="flex items-center justify-between pt-1.5 border-t border-slate-100 select-none h-[24px] mt-auto">
                                              @if (task.Priority == 1)
                                              {
                                                  <span class="px-2 py-0.5 rounded-md text-[8px] font-black uppercase tracking-wider bg-blue-50 text-blue-600 border border-blue-100/50 flex items-center gap-0.5">
                                                      <i data-lucide="flag" class="w-3 h-3 shrink-0"></i> Low
                                                  </span>
                                              }
                                              else if (task.Priority == 2)
                                              {
                                                  <span class="px-2 py-0.5 rounded-md text-[8px] font-black uppercase tracking-wider bg-amber-50 text-amber-600 border border-amber-100/50 flex items-center gap-0.5">
                                                      <i data-lucide="flag" class="w-3 h-3 shrink-0"></i> Med
                                                  </span>
                                              }
                                              else if (task.Priority == 3)
                                              {
                                                  <span class="px-2 py-0.5 rounded-md text-[8px] font-black uppercase tracking-wider bg-rose-50 text-rose-600 border border-rose-100/50 flex items-center gap-0.5">
                                                      <i data-lucide="flag" class="w-3 h-3 shrink-0"></i> High
                                                  </span>
                                              }
                                 <div class="flex items-center gap-2">
                                                  <!-- Blocked alert -->
                                                  @if (task.Title.Contains("API Documentation") || task.Title.Contains("Setup CI/CD Pipeline") || task.Title.Contains("Write Unit Tests"))
                                                  {
                                                      <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-500 shrink-0" title="Blocked task"></i>
                                                  }
                                                  
                                                  <!-- Comment and File Counts -->
                                                  <div class="flex items-center gap-1.5 text-[9px] text-slate-400 font-bold shrink-0">
                                                      <span id="task-comments-badge-@task.Id" class="flex items-center gap-0.5" style="@(task.TaskComments.Any() ? "" : "display: none;")">
                                                          <i data-lucide="message-square" class="w-3 h-3 text-slate-400"></i>
                                                          <span id="task-comments-count-@task.Id">@task.TaskComments.Count</span>
                                                      </span>
                                                      @if (task.WorkspaceFiles.Any())
                                                      {
                                                          <span class="flex items-center gap-0.5">
                                                              <i data-lucide="paperclip" class="w-3 h-3 text-slate-400"></i>
                                                              <span>@task.WorkspaceFiles.Count</span>
                                                          </span>
                                                      }
                                                  </div>

                                                  <!-- Due Date / Status -->
                                                  @if (task.Status == 3)
                                                  {
                                                      if (task.DueDate.HasValue && remainingDays < 0)
                                                      {
                                                          <span class="text-[9px] font-bold text-slate-400">-@Math.Abs(remainingDays)d</span>
                                                      }
                                                      else
                                                      {
                                                          <span class="text-[9px] font-bold text-emerald-600 flex items-center gap-0.5">
                                                              <i data-lucide="check-circle" class="w-3 h-3 text-emerald-600 shrink-0"></i> Done
                                                          </span>
                                                      }
                                                  }
                                                  else if (task.DueDate.HasValue)
                                                  {
                                                      var dateFormatted = task.DueDate.Value.ToString("MMM dd");
                                                      if (remainingDays < 0)
                                                      {
                                                          <span class="text-[9px] font-extrabold text-rose-500 uppercase tracking-tight flex items-center gap-0.5">
                                                              <i data-lucide="clock" class="w-3 h-3 text-rose-500 shrink-0"></i> @Math.Abs(remainingDays)d
                                                          </span>
                                                      }
                                                      else if (remainingDays == 0)
                                                      {
                                                          <span class="text-[9px] font-black text-amber-500 uppercase tracking-tight">Today</span>
                                                      }
                                                      else
                                                      {
                                                          <span class="text-[9px] font-bold text-slate-400">@dateFormatted</span>
                                                      }
                                                  }
                                                  else
                                                  {
                                                      <span class="text-[9px] font-bold text-slate-300 italic">No date</span>
                                                  }
                                              </div>
                                          </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Side: Workspace Activity Log Sidebar -->
            <div class="w-full lg:w-64 shrink-0 bg-white border border-slate-200 rounded-[2.5rem] p-5 shadow-sm flex flex-col self-stretch max-h-[660px] overflow-hidden">
                <div class="flex items-center gap-2 border-b border-slate-100 pb-4 mb-4 select-none">
                    <i data-lucide="history" class="w-5 h-5 text-indigo-600 animate-pulse"></i>
                    <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Workspace Activity</h3>
                </div>
                
                <div class="flex-1 overflow-y-auto space-y-4 pr-1 scrollbar-none">
                    @if (!sortedActivities.Any())
                    {
                        <div class="text-center py-12 text-slate-400 font-bold text-xs select-none">
                            No recent activity in this workspace.
                        </div>
                    }
                    else
                    {
                        @foreach (var act in sortedActivities)
                        {
                            var formattedTime = act.Time.ToString("MMM dd, h:mm tt");
                            
                            <div class="flex gap-3 text-xs">
                                <!-- Icon container -->
                                <div class="h-8 w-8 rounded-full border flex items-center justify-center shrink-0 @act.Color">
                                    <i data-lucide="@act.Icon" class="w-4 h-4"></i>
                                </div>
                                <!-- Activity Details -->
                                <div class="space-y-1 min-w-0 flex-1">
                                    <p class="font-bold text-slate-700 leading-snug break-words">
                                        <span class="text-indigo-600">@act.User</span> @act.Description
                                    </p>
                                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">@formattedTime</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════ -->
    <!-- ─── TAB 3: CHAT ROOM (DISCORD STYLE) ─── -->
    <!-- ════════════════════════════════════════ -->
    @if (!isPersonalWs)
    {
        <div x-show="activeTab === 'chat'" class="h-[calc(100vh-22rem)] min-h-[500px] border border-slate-200 rounded-[2.5rem] bg-white flex overflow-hidden shadow-sm" x-transition>
            <!-- Left panel - Channels (Discord Style) -->
            <div class="w-64 border-r border-slate-100 flex flex-col bg-slate-50/50 shrink-0 select-none">
                <div class="p-4 border-b border-slate-100 flex items-center justify-between">
                    <h3 class="text-sm font-black text-slate-700 flex items-center gap-1.5 uppercase tracking-wide">
                        <i data-lucide="message-square" class="w-4 h-4 text-indigo-500"></i>
                        <span>Workspace Chats</span>
                    </h3>
                    <template x-if="canCurrentUserCreateChannel">
                        <button type="button" @@click="createChannelOpen = true" class="h-6 w-6 rounded-lg hover:bg-slate-200/60 flex items-center justify-center text-slate-500 transition-colors" title="Create new channel">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                        </button>
                    </template>
                </div>
                <div class="flex-1 p-2 space-y-1 overflow-y-auto">
                    <template x-for="chan in visibleChannels" :key="chan">
                        <button type="button"
                                @@click="activeChannel = chan"
                                :class="activeChannel === chan ? 'bg-indigo-50 border-indigo-100/50 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-800 hover:bg-slate-100/50'"
                                class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl border text-left text-xs font-bold transition-all group">
                            <span class="flex items-center gap-2 truncate">
                                <template x-if="lockedChannels[chan]">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-500 shrink-0"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                </template>
                                <template x-if="!lockedChannels[chan]">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-slate-400 shrink-0"><line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/></svg>
                                </template>
                                <span class="truncate" x-text="chan"></span>
                            </span>
                            <template x-if="lockedChannels[chan]">
                                <span class="px-1.5 py-0.5 bg-amber-50 text-amber-600 rounded text-[8px] font-black uppercase tracking-wider">Private</span>
                            </template>
                        </button>
                    </template>
                </div>
            </div>

            <!-- Right panel - Chat Timeline -->
            <div class="flex-1 flex flex-col min-w-0 bg-white">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between flex-wrap gap-4">
                    <div class="flex items-center gap-2 flex-wrap">
                        <template x-if="lockedChannels[activeChannel]">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-amber-500 shrink-0"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </template>
                        <template x-if="!lockedChannels[activeChannel]">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-slate-400 shrink-0"><line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/></svg>
                        </template>
                        <span class="text-sm font-black text-slate-800" x-text="activeChannel"></span>
                        
                        <!-- Lock Indicator for normal users -->
                        <template x-if="lockedChannels[activeChannel]">
                            <span class="flex items-center gap-1 text-[9px] text-amber-600 bg-amber-50 border border-amber-100 px-2 py-0.5 rounded-md font-black uppercase tracking-wider">
                                Private
                            </span>
                        </template>

                        <!-- Lock / Unlock / Invite Controls for Workspace Owner/Managers or Channel Creator -->
                        <template x-if="(currentUserRole === 'Owner' || currentUserRole === 'Manager' || channelOwners[activeChannel] === currentUserId) && activeChannel !== 'general'">
                            <div class="flex items-center gap-1.5 ml-2 flex-wrap">
                                <!-- Lock/Unlock toggle -->
                                <button type="button" @@click="toggleChannelLock()" 
                                        :class="lockedChannels[activeChannel] ? 'bg-amber-50 text-amber-600 border-amber-200' : 'bg-slate-50 text-slate-500 border-slate-200'"
                                        class="h-7 px-2.5 rounded-xl border text-[9px] font-black transition-all flex items-center gap-1 cursor-pointer select-none"
                                        :title="lockedChannels[activeChannel] ? 'Unlock Channel (Make Public)' : 'Lock Channel (Make Private)'">
                                    <template x-if="lockedChannels[activeChannel]">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    </template>
                                    <template x-if="!lockedChannels[activeChannel]">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect width="18" height="10" x="3" y="11" rx="2" ry="2"/><path d="M12 2a5 5 0 0 0-5 5v4"/></svg>
                                    </template>
                                    <span x-text="lockedChannels[activeChannel] ? 'Private' : 'Public'"></span>
                                </button>
                                <!-- Invite members button -->
                                <template x-if="lockedChannels[activeChannel]">
                                    <button type="button" @@click="openChannelInvite()" 
                                            class="h-7 px-2.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-650 border border-indigo-200 rounded-xl text-[9px] font-black transition-all flex items-center gap-1 cursor-pointer select-none">
                                        <i data-lucide="user-plus" class="w-4 h-4"></i>
                                        <span>Manage Access</span>
                                    </button>
                                </template>
                            </div>
                        </template>
                    </div>
                    <span class="text-xs font-bold text-slate-400"><span x-text="workspaceMembers.length"></span> members active</span>
                </div>

                <!-- Messages Stream -->
                <div id="chat-messages-container" class="flex-1 p-6 overflow-y-auto space-y-4">
                    <!-- Empty state -->
                    <div x-show="filteredMessages.length === 0" class="text-center py-20 text-slate-400 transition-all">
                        <i data-lucide="messages-square" class="w-12 h-12 text-slate-300 mx-auto mb-3"></i>
                        <p class="font-bold" x-text="'No messages in channel #' + activeChannel + '...'"></p>
                        <p class="text-xs text-slate-400 mt-1">Start the first conversation in this channel!</p>
                    </div>

                    <template x-for="msg in filteredMessages" :key="msg.id">
                        <div class="group flex gap-3 max-w-[80%] transition-all" :class="msg.senderId === currentUserId ? 'ml-auto flex-row-reverse' : ''">
                            <div class="h-8 w-8 rounded-full bg-slate-100 border flex items-center justify-center text-[10px] font-bold text-slate-500 shrink-0 select-none" 
                                 x-text="msg.senderName.split(' ').map(n => n[0]).join('')">
                            </div>
                            <div class="space-y-1 min-w-0">
                                <template x-if="msg.senderId !== currentUserId">
                                    <p class="text-[10px] font-bold text-slate-400 flex items-center gap-1.5">
                                        <span x-text="msg.senderName"></span>
                                        <template x-if="msg.senderId.toLowerCase() === workspaceOwnerId.toLowerCase()">
                                            <span class="text-[8px] bg-amber-50 text-amber-600 border border-amber-250 px-1 py-0.2 rounded font-black uppercase inline-flex items-center gap-0.5" title="Workspace Owner">
                                                👑 Owner
                                            </span>
                                        </template>
                                        <template x-if="channelOwners[activeChannel]?.toLowerCase() === msg.senderId.toLowerCase() && activeChannel !== 'general' && msg.senderId.toLowerCase() !== workspaceOwnerId.toLowerCase()">
                                            <span class="text-[8px] bg-amber-50 text-amber-600 border border-amber-250 px-1 py-0.2 rounded font-black uppercase inline-flex items-center gap-0.5" title="Channel Owner">
                                                👑 Owner
                                            </span>
                                        </template>
                                        <template x-if="channelModerators[activeChannel] && channelModerators[activeChannel].map(id => id.toLowerCase()).includes(msg.senderId.toLowerCase()) && channelOwners[activeChannel]?.toLowerCase() !== msg.senderId.toLowerCase() && activeChannel !== 'general'">
                                            <span class="text-[8px] bg-indigo-50 text-indigo-655 border border-indigo-255 px-1 py-0.2 rounded font-black uppercase inline-flex items-center gap-0.5" title="Channel Moderator">
                                                🛡️ Mod
                                            </span>
                                        </template>
                                    </p>
                                </template>
                                <template x-if="msg.senderId === currentUserId">
                                    <p class="text-[10px] font-bold text-slate-400 text-right flex items-center justify-end gap-1.5">
                                        <template x-if="msg.senderId.toLowerCase() === workspaceOwnerId.toLowerCase()">
                                            <span class="text-[8px] bg-amber-50 text-amber-600 border border-amber-200 px-1 py-0.2 rounded font-black uppercase inline-flex items-center gap-0.5" title="Workspace Owner">
                                                👑 Owner
                                            </span>
                                        </template>
                                        <template x-if="channelOwners[activeChannel]?.toLowerCase() === msg.senderId.toLowerCase() && activeChannel !== 'general' && msg.senderId.toLowerCase() !== workspaceOwnerId.toLowerCase()">
                                            <span class="text-[8px] bg-amber-50 text-amber-600 border border-amber-200 px-1 py-0.2 rounded font-black uppercase inline-flex items-center gap-0.5" title="Channel Owner">
                                                👑 Owner
                                            </span>
                                        </template>
                                        <template x-if="channelModerators[activeChannel] && channelModerators[activeChannel].map(id => id.toLowerCase()).includes(msg.senderId.toLowerCase()) && channelOwners[activeChannel]?.toLowerCase() !== msg.senderId.toLowerCase() && activeChannel !== 'general'">
                                            <span class="text-[8px] bg-indigo-50 text-indigo-655 border border-indigo-255 px-1 py-0.2 rounded font-black uppercase inline-flex items-center gap-0.5" title="Channel Moderator">
                                                🛡️ Mod
                                            </span>
                                        </template>
                                        <span>Me</span>
                                    </p>
                                </template>
                                <div class="flex items-center gap-1.5" :class="msg.senderId === currentUserId ? 'flex-row-reverse' : ''">
                                    <div class="p-3.5 rounded-2xl text-sm leading-relaxed" 
                                         :class="msg.senderId === currentUserId ? 'bg-indigo-600 text-white rounded-tr-none' : 'bg-slate-100 text-slate-700 rounded-tl-none'">
                                        <div class="break-words" x-html="parseMessageContent(msg.content)"></div>
                                        
                                        <!-- Render Attachment Box if message has an attachment -->
                                        <template x-if="msg.attachment">
                                            <div class="mt-2.5 p-3 border rounded-xl flex items-center justify-between gap-4 max-w-sm"
                                                 :class="msg.senderId === currentUserId ? 'bg-white/15 border-white/10 text-white' : 'bg-white border-slate-200 text-slate-700'">
                                                <div class="flex items-center gap-2.5 min-w-0">
                                                    <div class="h-9 w-9 rounded-lg flex items-center justify-center shrink-0"
                                                         :class="msg.senderId === currentUserId ? 'bg-white/20 text-white' : 'bg-indigo-50 text-indigo-600'">
                                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                                                    </div>
                                                    <div class="min-w-0">
                                                        <p class="text-xs font-bold truncate" :class="msg.senderId === currentUserId ? 'text-white' : 'text-slate-800'" x-text="msg.attachment.fileName"></p>
                                                        <p class="text-[9px] font-bold uppercase" :class="msg.senderId === currentUserId ? 'text-white/70' : 'text-slate-400'" x-text="Math.round(msg.attachment.fileSize / 1024) + ' KB'"></p>
                                                    </div>
                                                </div>
                                                <a :href="'/' + msg.attachment.fileUrl" class="h-8 w-8 rounded-lg flex items-center justify-center shrink-0 transition-colors" 
                                                   :class="msg.senderId === currentUserId ? 'hover:bg-white/20 text-white' : 'hover:bg-slate-100 text-slate-400 hover:text-slate-600'" download>
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                                </a>
                                            </div>
                                        </template>
                                    </div>
                                    
                                    <!-- Hover Trash/Revoke Button -->
                                    <template x-if="!msg.rawContent.startsWith('[deleted_message]') && msg.senderId === currentUserId">
                                        <button type="button" @@click="deleteMessage(msg.id)" 
                                                class="opacity-0 group-hover:opacity-100 h-7 w-7 rounded-lg hover:bg-slate-100 hover:text-rose-600 flex items-center justify-center text-slate-400 transition-all shrink-0 cursor-pointer select-none"
                                                title="Revoke Message">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                        </button>
                                    </template>
                                </div>
                                <p class="text-[9px] text-slate-400 font-bold" :class="msg.senderId === currentUserId ? 'text-right' : ''" 
                                   x-text="formatTime(msg.sentAt)"></p>
                            </div>
                        </div>
                    </template>
                </div>

                <!-- Autocomplete Popover Box -->
                <div x-show="showSuggestions" 
                     class="mx-4 p-2 bg-white border border-slate-200 rounded-2xl shadow-xl flex flex-col gap-1.5 max-h-48 overflow-y-auto transition-all"
                     x-transition>
                    <div class="px-3 py-1 text-[9px] font-black text-slate-400 uppercase tracking-widest border-b border-slate-100">
                        Mentions suggestions (Type <span x-text="showSuggestions?.type"></span>)
                    </div>
                    <div class="space-y-0.5">
                        <!-- Member Suggestions -->
                        <template x-if="showSuggestions?.type === '@@' || showSuggestions?.type === '@@'">
                            <div>
                                <template x-for="member in filteredMembers" :key="member.id">
                                    <button type="button" 
                                            @@click="insertSuggestion('@@' + member.fullName)"
                                            class="w-full text-left px-3 py-2 text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 rounded-xl flex items-center gap-2 transition-all">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 opacity-60"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                        <span x-text="member.fullName"></span>
                                    </button>
                                </template>
                                <template x-if="filteredMembers.length === 0">
                                    <div class="px-3 py-2 text-xs font-bold text-slate-400 italic">No matching members found.</div>
                                </template>
                            </div>
                        </template>
                        
                        <!-- Task Suggestions -->
                        <template x-if="showSuggestions?.type === '#'">
                            <div>
                                <template x-for="task in filteredTasks" :key="task.id">
                                    <button type="button" 
                                            @@click="insertSuggestion('#' + task.title)"
                                            class="w-full text-left px-3 py-2 text-xs font-bold text-slate-700 hover:bg-amber-50 hover:text-amber-600 rounded-xl flex items-center gap-2 transition-all">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 opacity-60"><line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/></svg>
                                        <span x-text="task.title"></span>
                                    </button>
                                </template>
                                <template x-if="filteredTasks.length === 0">
                                    <div class="px-3 py-2 text-xs font-bold text-slate-400 italic">No matching tasks found.</div>
                                </template>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- File Attachments Selection Popover Panel -->
                <div x-show="attachFileOpen" 
                     class="mx-4 p-4 bg-white border border-slate-200 rounded-2xl shadow-xl space-y-3 transition-all"
                     x-transition>
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2 flex-wrap gap-2">
                        <span class="text-xs font-black text-slate-800 uppercase tracking-widest">Attach Workspace document</span>
                        <div class="flex items-center gap-2">
                            <!-- Direct File Upload Label/Input -->
                            <label class="cursor-pointer bg-indigo-600 hover:bg-indigo-750 text-white text-[9px] font-black px-2.5 py-1.5 rounded-lg flex items-center gap-1 select-none transition-all">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
                                <span>Upload New</span>
                                <input type="file" class="hidden" @@change="uploadFileDirectly($event)">
                            </label>
                            <button type="button" @@click="attachFileOpen = false" class="text-xs text-slate-400 hover:text-slate-600 font-black font-semibold cursor-pointer">Close</button>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-32 overflow-y-auto">
                        <template x-for="file in workspaceFiles" :key="file.id">
                            <button type="button" 
                                    @@click="selectedAttachmentId = file.id; selectedAttachmentName = file.fileName; attachFileOpen = false;"
                                    :class="selectedAttachmentId === file.id ? 'border-indigo-600 bg-indigo-50/50 text-indigo-700' : 'border-slate-100 bg-slate-50 hover:bg-slate-100 text-slate-700'"
                                    class="p-2.5 border rounded-xl flex items-center gap-2 text-left text-xs font-bold transition-all">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
                                <span class="truncate" x-text="file.fileName"></span>
                            </button>
                        </template>
                        <template x-if="workspaceFiles.length === 0">
                            <div class="col-span-2 text-center py-4 text-xs font-bold text-slate-400 italic">No documents in workspace. Click Upload New to attach files!</div>
                        </template>
                    </div>
                </div>

                <!-- Selected Attachment Status Indicator Box -->
                <div x-show="selectedAttachmentId" 
                     class="mx-4 p-2 bg-indigo-50 border border-indigo-100 rounded-xl flex items-center justify-between text-xs font-bold text-indigo-700 transition-all"
                     x-transition>
                    <span class="flex items-center gap-1.5 truncate">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-indigo-600"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9 15 2 2 4-4"/></svg>
                        <span>Attachment: </span>
                        <strong class="truncate" x-text="selectedAttachmentName"></strong>
                    </span>
                    <button type="button" @@click="selectedAttachmentId = null; selectedAttachmentName = '';" class="text-indigo-400 hover:text-indigo-600 transition-colors cursor-pointer flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>

                <!-- Message Input Area -->
                <div class="p-4 border-t border-slate-100">
                    <template x-if="currentUserRole !== 'Viewer'">
                        <form @@submit.prevent="sendChatMessageViaAjax()" class="flex gap-2">
                            <input type="hidden" name="activeChannel" :value="activeChannel">
                            <input type="hidden" name="selectedFileId" :value="selectedAttachmentId">
                            
                            <!-- Paperclip Button (Inline SVG to prevent icon missing) -->
                            <button type="button" 
                                    @@click="attachFileOpen = !attachFileOpen" 
                                    :class="attachFileOpen || selectedAttachmentId ? 'bg-indigo-50 text-indigo-600' : 'bg-slate-50 text-slate-400 hover:text-slate-600 border border-slate-200'"
                                    class="p-3 rounded-xl flex items-center justify-center transition-all shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                            </button>
                            
                            <input type="text" id="chat-input-field" asp-for="ChatContent" x-model="chatInput" autocomplete="off"
                                   :placeholder="'Message in #' + activeChannel + '...'" required
                                   class="flex-1 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                            
                            <!-- Send Button (Inline SVG to prevent icon missing) -->
                            <button type="submit" class="bg-indigo-600 text-white px-5 py-3 rounded-xl hover:bg-indigo-700 shadow shadow-indigo-100 flex items-center justify-center transition-all shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                            </button>
                        </form>
                    </template>
                    <template x-if="currentUserRole === 'Viewer'">
                        <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl text-center text-xs font-bold text-slate-400 italic">
                            You are viewing as a Viewer. Cannot send messages.
                        </div>
                    </template>
                </div>
            </div>
        </div>
    }

    <!-- ════════════════════════════════════════ -->
    <!-- ─── TAB 4: MEMBERS LIST ─── -->
    <!-- ════════════════════════════════════════ -->
    @if (!isPersonalWs)
    {
        <div x-show="activeTab === 'members'" class="space-y-4" x-transition>
        <div class="flex items-center justify-between mb-2">
            <div>
                <h3 class="text-lg font-black text-slate-800">Workspace Members</h3>
                <p class="text-xs text-slate-500 mt-0.5">Manage access, roles, and review contribution details.</p>
            </div>
            <button @@click="leaveDialogOpen = true" 
                    class="bg-rose-50 text-rose-600 border border-rose-200 hover:bg-rose-100 px-4 py-2 rounded-xl text-xs font-bold shadow-sm transition-all flex items-center gap-1.5 cursor-pointer">
                <i data-lucide="log-out" class="w-4 h-4"></i> Leave Workspace
            </button>
        </div>

        <div class="glass rounded-[2.5rem] overflow-visible border border-slate-200 shadow-sm">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 text-[10px] font-black text-slate-400 uppercase tracking-widest border-b border-slate-100">
                        <th class="px-6 py-4">Member Name</th>
                        <th class="px-6 py-4">Role Badge</th>
                        <th class="px-6 py-4 text-center">Assigned</th>
                        <th class="px-6 py-4 text-center text-green-600">Completed</th>
                        <th class="px-6 py-4 text-center text-indigo-600">Working</th>
                        <th class="px-6 py-4">Task Completion Rate</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm font-medium text-slate-600">
                    @foreach (var member in Model.Members)
                    {
                        var roleBadgeBg = member.Role == "Manager" ? "bg-amber-50 text-amber-600 border border-amber-200" 
                                           : member.Role == "Vice Manager" ? "bg-indigo-50 text-indigo-600 border border-indigo-200" 
                                           : member.Role == "Viewer" ? "bg-slate-50 text-slate-400 border border-slate-200"
                                           : "bg-blue-50 text-blue-600 border border-blue-200";

                        var initials = string.Concat(member.User.FullName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : ""));
                        var memberTasks = Model.WorkspaceTasks.Where(t => t.AssigneeId == member.UserId).ToList();
                        var assignedCount = memberTasks.Count;
                        var completedCount = memberTasks.Count(t => t.Status == 3);
                        var workingCount = memberTasks.Count(t => t.Status == 1);
                        var rate = assignedCount > 0 ? (int)Math.Round((double)completedCount / assignedCount * 100) : 0;

                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4 flex items-center gap-3">
                                <div class="h-9 w-9 rounded-full bg-slate-100 border flex items-center justify-center text-xs font-bold text-slate-500">
                                    @initials
                                </div>
                                <div>
                                    <p class="font-bold text-slate-700 flex items-center gap-2">
                                        @member.User.FullName
                                        @if (!string.IsNullOrEmpty(member.DisplayRole))
                                        {
                                            <span class="px-2 py-0.5 bg-indigo-50 text-[10px] font-bold text-indigo-650 rounded-md border border-indigo-150 uppercase tracking-wider">
                                                @member.DisplayRole
                                            </span>
                                        }
                                    </p>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                @if ((Model.CurrentUserRole == "Manager" && member.UserId != Model.CurrentUser.Id) || (member.UserId == Model.CurrentUser.Id))
                                {
                                    <div class="relative inline-block text-left" x-data="{ open: false, selectedRole: '@member.Role', tempDisplayRole: '@(Html.Raw(member.DisplayRole?.Replace("'", "\\'") ?? ""))', canDeleteFile: @(Model.IsMemberAllowed(member.UserId, "disabledDeleteFileUsers", member.Role) ? "true" : "false"), canCreateTask: @(Model.IsMemberAllowed(member.UserId, "disabledCreateTaskUsers", member.Role) ? "true" : "false"), canEditTask: @(Model.IsMemberAllowed(member.UserId, "disabledEditTaskUsers", member.Role) ? "true" : "false"), canCreateChannel: @(Model.IsMemberAllowed(member.UserId, "disabledCreateChannelUsers", member.Role) ? "true" : "false"), canDeleteTask: @(Model.IsMemberAllowed(member.UserId, "disabledDeleteTaskUsers", member.Role) ? "true" : "false") }">
                                        <button type="button" @@click="open = !open" 
                                                class="px-4 py-2 rounded-xl text-xs font-black transition-all flex items-center justify-between gap-2 cursor-pointer outline-none w-40 shadow-sm"
                                                :class="selectedRole === 'Manager' ? 'bg-amber-50 text-amber-600 border border-amber-200 hover:bg-amber-100/50' 
                                                       : selectedRole === 'Vice Manager' ? 'bg-indigo-50 text-indigo-600 border border-indigo-200 hover:bg-indigo-100/50' 
                                                       : selectedRole === 'Viewer' ? 'bg-slate-50 text-slate-400 border border-slate-200 hover:bg-slate-100/50' 
                                                       : 'bg-blue-50 text-blue-600 border border-blue-200 hover:bg-blue-100/50'">
                                            <span class="truncate" x-text="selectedRole"></span>
                                            <i data-lucide="chevron-down" class="w-4 h-4 transition-transform" :class="[open ? 'rotate-180' : '', selectedRole === 'Manager' ? 'text-amber-400' : selectedRole === 'Vice Manager' ? 'text-indigo-400' : selectedRole === 'Viewer' ? 'text-slate-400' : 'text-blue-400']"></i>
                                        </button>
                                        
                                        <!-- Dropdown Panel Matching Project Vibe -->
                                        <div x-show="open" @@click.away="open = false" x-transition x-cloak
                                             class="absolute left-0 mt-2 w-64 bg-white border border-slate-150 rounded-2xl shadow-xl z-50 p-4 flex flex-col gap-4">
                                            
                                            <!-- Section 1: Role -->
                                            @if (member.UserId != Model.CurrentUser.Id)
                                            {
                                                <div class="space-y-1.5">
                                                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block pb-1 border-b border-slate-100/50">Change Role</span>
                                                    
                                                    <div class="space-y-1 pt-1">
                                                        <!-- Vice Manager -->
                                                        <button type="button" 
                                                                @@click="selectedRole = 'Vice Manager'"
                                                                :class="selectedRole === 'Vice Manager' ? 'bg-indigo-50 text-indigo-655 font-extrabold shadow-sm' : 'hover:bg-slate-50 text-slate-700'" 
                                                                class="w-full text-left px-3 py-2 rounded-xl text-xs font-semibold flex items-center justify-between transition-all cursor-pointer">
                                                            <span>Vice Manager</span>
                                                            <span x-show="selectedRole === 'Vice Manager'">
                                                                <i data-lucide="check" class="w-4 h-4 text-indigo-600 shrink-0"></i>
                                                            </span>
                                                        </button>

                                                        <!-- Member -->
                                                        <button type="button" 
                                                                @@click="selectedRole = 'Member'"
                                                                :class="selectedRole === 'Member' ? 'bg-indigo-50 text-indigo-655 font-extrabold shadow-sm' : 'hover:bg-slate-50 text-slate-700'" 
                                                                class="w-full text-left px-3 py-2 rounded-xl text-xs font-semibold flex items-center justify-between transition-all cursor-pointer">
                                                            <span>Member</span>
                                                            <span x-show="selectedRole === 'Member'">
                                                                <i data-lucide="check" class="w-4 h-4 text-indigo-600 shrink-0"></i>
                                                            </span>
                                                        </button>

                                                        <!-- Viewer -->
                                                        <button type="button" 
                                                                @@click="selectedRole = 'Viewer'"
                                                                :class="selectedRole === 'Viewer' ? 'bg-indigo-50 text-indigo-655 font-extrabold shadow-sm' : 'hover:bg-slate-50 text-slate-700'" 
                                                                class="w-full text-left px-3 py-2 rounded-xl text-xs font-semibold flex items-center justify-between transition-all cursor-pointer">
                                                            <span>Viewer</span>
                                                            <span x-show="selectedRole === 'Viewer'">
                                                                <i data-lucide="check" class="w-4 h-4 text-indigo-600 shrink-0"></i>
                                                            </span>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                            
                                            <!-- Section 2: Permissions & Title -->
                                            <div class="space-y-3 pt-2 border-t border-slate-100">
                                                @if (member.UserId != Model.CurrentUser.Id)
                                                {
                                                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block pb-1 border-b border-slate-100/50">Permissions</span>
                                                    
                                                    <div class="space-y-2.5 pt-1">
                                                        <!-- Checkbox: Create Task -->
                                                        <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                                            <input type="checkbox" x-model="canCreateTask" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 h-4 w-4 cursor-pointer" />
                                                            <span class="text-xs font-bold text-slate-600">Create Task</span>
                                                        </label>
                                                        <!-- Checkbox: Edit Task -->
                                                        <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                                            <input type="checkbox" x-model="canEditTask" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 h-4 w-4 cursor-pointer" />
                                                            <span class="text-xs font-bold text-slate-600">Edit Task</span>
                                                        </label>
                                                        <!-- Checkbox: Delete Task -->
                                                        <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                                            <input type="checkbox" x-model="canDeleteTask" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 h-4 w-4 cursor-pointer" />
                                                            <span class="text-xs font-bold text-slate-600">Delete Task</span>
                                                        </label>
                                                        <!-- Checkbox: Delete File -->
                                                        <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                                            <input type="checkbox" x-model="canDeleteFile" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 h-4 w-4 cursor-pointer" />
                                                            <span class="text-xs font-bold text-slate-600">Delete File</span>
                                                        </label>
                                                        <!-- Checkbox: Create Chat -->
                                                        <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                                            <input type="checkbox" x-model="canCreateChannel" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 h-4 w-4 cursor-pointer" />
                                                            <span class="text-xs font-bold text-slate-600">Create Chat</span>
                                                        </label>
                                                    </div>
                                                }
                                                
                                                <div class="space-y-1.5 pt-2 border-t border-slate-100/50">
                                                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block pb-1">Display Role (Title)</span>
                                                    <form method="post" asp-page-handler="UpdateMemberRole" asp-route-joinCode="@Model.Workspace.JoinCode" class="space-y-2">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="memberId" value="@member.UserId" />
                                                        <input type="hidden" name="newRole" :value="selectedRole" />
                                                        <input type="hidden" name="canDeleteFile" :value="canDeleteFile" />
                                                        <input type="hidden" name="canCreateTask" :value="canCreateTask" />
                                                        <input type="hidden" name="canEditTask" :value="canEditTask" />
                                                        <input type="hidden" name="canCreateChannel" :value="canCreateChannel" />
                                                        <input type="hidden" name="canDeleteTask" :value="canDeleteTask" />
                                                        <input type="text" name="newDisplayRole" x-model="tempDisplayRole" placeholder="e.g. Tech Lead, BA" 
                                                               class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                                                        <button type="submit" class="w-full py-2 bg-indigo-600 text-white rounded-xl text-xs font-black shadow shadow-indigo-100 hover:bg-indigo-700 transition-all flex items-center justify-center gap-1 cursor-pointer">
                                                            <i data-lucide="save" class="w-4 h-4"></i> Save Changes
                                                        </button>
                                                    </form>
                                                </div>
                                                
                                                @if (Model.Workspace.OwnerId == Model.CurrentUser.Id && member.UserId != Model.CurrentUser.Id)
                                                {
                                                    <div class="space-y-1.5 pt-2 border-t border-slate-100/50">
                                                        <span class="text-[9px] font-black text-rose-500 uppercase tracking-widest block pb-1">Role Succession</span>
                                                        <form method="post" asp-page-handler="TransferOwnership" asp-route-joinCode="@Model.Workspace.JoinCode" onsubmit="return confirm('WARNING: Are you sure you want to appoint this member as the new Manager? This will transfer absolute ownership of the workspace to them, and demote your role to Vice Manager.')">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="newOwnerId" value="@member.UserId" />
                                                            <button type="submit" class="w-full py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-xl text-xs font-black shadow shadow-amber-100 flex items-center justify-center gap-1.5 cursor-pointer transition-all">
                                                                <i data-lucide="crown" class="w-4 h-4"></i> Appoint as Manager
                                                            </button>
                                                        </form>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold @roleBadgeBg">
                                        @member.Role
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-center font-bold text-slate-700">@assignedCount</td>
                            <td class="px-6 py-4 text-center font-bold text-green-600">@completedCount</td>
                            <td class="px-6 py-4 text-center font-bold text-indigo-600">@workingCount</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3 w-48">
                                    <div class="flex-1 h-2 bg-slate-100 rounded-full overflow-hidden">
                                        <div class="h-full bg-indigo-600 rounded-full" style="width: @rate%"></div>
                                    </div>
                                    <span class="text-xs font-bold text-slate-500 w-8 text-right">@rate%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    }

    <!-- ════════════════════════════════════════ -->
    <!-- ─── TAB 5: FILES REPOSITORY ─── -->
    <!-- ════════════════════════════════════════ -->
    <div x-show="activeTab === 'files'" class="h-[calc(100vh-22rem)] min-h-[500px] border border-slate-200 rounded-[2.5rem] bg-white flex overflow-hidden shadow-sm" x-transition>
        <!-- Left panel - Categories -->
        <div class="w-64 border-r border-slate-100 flex flex-col bg-slate-50/50 shrink-0">
            <div class="p-4 border-b border-slate-100">
                <h3 class="text-sm font-black text-slate-700">@(packageTier == "Personal" ? "Personal Storage" : "Workspace Storage")</h3>
            </div>
            <div class="flex-1 p-2 space-y-1">
                <button @@click="activeFileSection = 'files'" :class="activeFileSection === 'files' ? 'bg-indigo-50 border border-indigo-100/50 text-indigo-600' : 'text-slate-500 hover:bg-slate-100'" class="w-full flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-left text-xs font-bold transition-all">
                    <i data-lucide="folder" class="w-4 h-4"></i> My Workspace Files
                </button>
            </div>
            <!-- Progress Bar -->
            <div class="p-4 border-t border-slate-100 text-xs font-bold text-slate-400">
                <div class="flex justify-between mb-1.5">
                    <span>Usage</span>
                    <span class="text-slate-600">@usedStorageStr / @limitStr</span>
                </div>
                <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full bg-indigo-600 rounded-full" style="width: @(storagePercent > 100 ? "100" : storagePercent.ToString("F1"))%"></div>
                </div>
            </div>
        </div>

        <!-- Right panel - Repository Files List/Grid -->
        <div class="flex-1 flex flex-col min-w-0 bg-white">
            <!-- Upload Notification Feed -->
            @if (TempData["UploadError"] != null)
            {
                <div class="m-6 mb-0 p-4 bg-rose-50 border border-rose-100 text-rose-600 rounded-2xl text-xs font-bold flex items-center gap-2">
                    <i data-lucide="alert-triangle" class="w-4 h-4 shrink-0"></i>
                    <span>@TempData["UploadError"]</span>
                </div>
            }
            @if (TempData["UploadSuccess"] != null)
            {
                <div class="m-6 mb-0 p-4 bg-green-50 border border-green-100 text-green-600 rounded-2xl text-xs font-bold flex items-center gap-2">
                    <i data-lucide="check-circle" class="w-4 h-4 shrink-0"></i>
                    <span>@TempData["UploadSuccess"]</span>
                </div>
            }

            <!-- Toolbar -->
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                    <!-- Form for standard file upload -->
                    <form method="post" asp-page-handler="UploadFile" enctype="multipart/form-data" class="flex items-center gap-2">
                        <input type="file" asp-for="UploadedFile" class="hidden" id="real-file-upload" onchange="validateAndUploadFile(event)">
                        
                        <button x-show="currentUserRole !== 'Viewer'" type="button" onclick="document.getElementById('real-file-upload').click()" class="bg-indigo-600 text-white px-4 py-2.5 rounded-xl text-xs font-black shadow-lg shadow-indigo-100 hover:bg-indigo-700 transition-all flex items-center gap-2 cursor-pointer">
                            <i data-lucide="upload-cloud" class="w-4 h-4"></i> Pick & Upload Local File
                        </button>
                        <span x-show="currentUserRole !== 'Viewer'" class="text-[10px] text-slate-400 font-bold max-w-xs truncate italic" id="selected-file-label">No file selected. Only alphanumeric, space, dash, and underscore characters are allowed.</span>
                        
                        <div x-show="currentUserRole === 'Viewer'" class="text-xs font-bold text-slate-400 italic bg-slate-50 border border-slate-200 px-4 py-2 rounded-xl">
                            You are viewing as a Viewer. Cannot upload files.
                        </div>
                    </form>
                </div>

                <script>
                    function validateAndUploadFile(event) {
                        const input = event.target;
                        if (!input.files || input.files.length === 0) return;
                        
                        const file = input.files[0];
                        const fileName = file.name;
                        const label = document.getElementById('selected-file-label');
                        
                        // Extract base name without extension
                        const lastDotIndex = fileName.lastIndexOf('.');
                        if (lastDotIndex === -1) {
                            alert("Invalid file name. The file must have a valid extension.");
                            input.value = "";
                            label.innerText = "Invalid file selected.";
                            return;
                        }
                        
                        const baseName = fileName.substring(0, lastDotIndex);
                        
                        // Rule 1: No dots allowed in base name
                        if (baseName.includes('.')) {
                            alert("File name contains invalid characters. Multiple dots ('.') are not allowed in the file name.");
                            input.value = "";
                            label.innerText = "Upload failed: Invalid character '.' in file name.";
                            return;
                        }
                        
                        // Rule 2: Only alphanumeric, space, hyphens, and underscores allowed in base name (no regex characters)
                        const regex = /^[a-zA-Z0-9\s-_]+$/;
                        if (!regex.test(baseName)) {
                            alert("File name contains invalid characters. Only alphanumeric characters, spaces, hyphens, and underscores are allowed. Regex or special characters are not allowed.");
                            input.value = "";
                            label.innerText = "Upload failed: Regex/special characters not allowed in file name.";
                            return;
                        }
                        
                        // Successful validation: Update file label and auto-submit form!
                        label.innerText = "Uploading: " + fileName;
                        input.form.submit();
                    }
                </script>
                <!-- Layout switcher -->
                <div class="flex items-center border border-slate-200 rounded-xl overflow-hidden shrink-0">
                    <button @@click="viewMode = 'grid'" :class="viewMode === 'grid' ? 'bg-slate-100 text-slate-800' : 'text-slate-400 hover:text-slate-600'" class="p-2 transition-all">
                        <i data-lucide="grid-3x3" class="w-4 h-4"></i>
                    </button>
                    <button @@click="viewMode = 'list'" :class="viewMode === 'list' ? 'bg-slate-100 text-slate-800' : 'text-slate-400 hover:text-slate-600'" class="p-2 transition-all">
                        <i data-lucide="list" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>

            <!-- Documents Grid -->
            <div class="flex-1 p-6 overflow-y-auto">
                @if (!Model.Files.Any())
                {
                    <div class="text-center py-20 text-slate-400">
                        <i data-lucide="folder-open" class="w-12 h-12 text-slate-300 mx-auto mb-3"></i>
                        <p class="font-bold">No files uploaded yet.</p>
                        <p class="text-xs text-slate-400 mt-1">Simulate an upload above!</p>
                    </div>
                }

                <div x-show="viewMode === 'grid'" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                    @foreach (var file in Model.Files)
                    {
                        var icon = file.FileType == "pdf" ? "file-text" : file.FileType == "doc" ? "file-text" : file.FileType == "spreadsheet" ? "file-spreadsheet" : "image";
                        var iconColor = file.FileType == "pdf" ? "text-rose-500 bg-rose-50" : file.FileType == "doc" ? "text-indigo-600 bg-indigo-50" : file.FileType == "spreadsheet" ? "text-green-600 bg-green-50" : "text-purple-500 bg-purple-50";

                        <div @@click="previewFile = JSON.parse(atob('@Model.SerializeFileBase64(file)'))"
                             class="p-4 bg-white/60 hover:bg-white border border-slate-100 hover:border-slate-200 hover:shadow shadow-sm rounded-2xl flex flex-col items-center text-center cursor-pointer transition-all relative group">
                            
                            <div class="h-12 w-12 rounded-xl flex items-center justify-center mb-3 @iconColor">
                                <i data-lucide="@icon" class="w-6 h-6"></i>
                            </div>
                            <span class="text-xs font-bold text-slate-700 truncate w-full">@file.FileName</span>
                            <span class="text-[9px] font-bold text-slate-400 mt-1 uppercase">@(file.FileSize / 1024) KB</span>
                        </div>
                    }
                </div>

                <div x-show="viewMode === 'list'" class="glass rounded-[2rem] overflow-hidden border border-slate-100 shadow-sm" style="display: none;">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 text-[9px] font-black text-slate-400 uppercase tracking-widest border-b border-slate-100">
                                <th class="px-6 py-3">File Name</th>
                                <th class="px-6 py-3">Uploaded By</th>
                                <th class="px-6 py-3">Modified</th>
                                <th class="px-6 py-3">File Size</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-xs font-bold text-slate-500">
                            @foreach (var file in Model.Files)
                            {
                                <tr @@click="previewFile = JSON.parse(atob('@Model.SerializeFileBase64(file)'))" class="hover:bg-slate-50/50 transition-colors cursor-pointer">
                                    <td class="px-6 py-3 text-slate-700">
                                        <div class="flex items-center gap-2">
                                            <span>@file.FileName</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-3">@file.User.FullName</td>
                                    <td class="px-6 py-3">@(file.CreatedAt?.ToString("MMM dd, yyyy") ?? "Just now")</td>
                                    <td class="px-6 py-3 uppercase">@(file.FileSize / 1024) KB</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Preview Sidebar -->
        <div x-show="previewFile" x-transition class="w-72 border-l border-slate-100 bg-slate-50/30 flex flex-col shrink-0" style="display: none;">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                <span class="text-sm font-black text-slate-700">File Preview</span>
                <button @@click="previewFile = null" class="h-6 w-6 flex items-center justify-center rounded hover:bg-slate-100 text-slate-400">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
            <div class="flex-1 p-6 flex flex-col items-center">
                <div class="h-20 w-20 rounded-2xl bg-indigo-50 border flex items-center justify-center text-indigo-600 mb-4 shadow-sm">
                    <i data-lucide="file" class="w-10 h-10"></i>
                </div>
                <h4 class="text-sm font-black text-slate-700 text-center break-all" x-text="previewFile?.fileName"></h4>
                <div class="w-full mt-6 space-y-4 text-xs font-bold text-slate-500">
                    <div class="flex justify-between">
                        <span class="text-slate-400 uppercase tracking-wider">Type</span>
                        <span class="text-slate-700 uppercase" x-text="previewFile?.fileType"></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-400 uppercase tracking-wider">Size</span>
                        <span class="text-slate-700" x-text="Math.round(previewFile?.fileSize / 1024) + ' KB'"></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-400 uppercase tracking-wider">Uploaded</span>
                        <span class="text-slate-700" x-text="previewFile?.createdAt ? new Date(previewFile.createdAt).toLocaleDateString('en-US') : 'Just now'"></span>
                    </div>
                </div>
                <a :href="'/' + previewFile?.fileUrl" class="w-full py-3 mt-8 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 shadow shadow-indigo-100 flex items-center justify-center gap-2 transition-all" download>
                    <i data-lucide="download" class="w-4 h-4"></i> Download File
                </a>
                
                <template x-if="currentUserCanDeleteFile">
                    <form method="post" asp-page-handler="DeleteFile" asp-route-joinCode="@Model.Workspace.JoinCode" class="w-full mt-2" onsubmit="return confirm('Are you sure you want to delete this file? This action will permanently remove the file from the system.')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="fileId" :value="previewFile?.id" />
                        <button type="submit" class="w-full py-2.5 bg-rose-50 border border-rose-200 text-rose-600 rounded-xl font-bold hover:bg-rose-100/70 transition-all flex items-center justify-center gap-2 cursor-pointer text-xs">
                            <i data-lucide="trash-2" class="w-4 h-4"></i> Delete File Permanently
                        </button>
                    </form>
                </template>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════ -->
    <!-- ─── TASK DETAIL MODAL DIALOG ─── -->
    <!-- ════════════════════════════════════════ -->
    <div x-show="detailOpen" 
         class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" 
         style="display: none;"
         x-transition>
        
        <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-2xl w-full max-w-2xl max-h-[85vh] overflow-y-auto p-8 relative flex flex-col gap-6"
             @@click.away="detailOpen = false">
            
            <button @@click="detailOpen = false" class="absolute top-6 right-6 h-8 w-8 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 transition-all">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <!-- View Mode -->
            <div x-show="!isEditing" class="space-y-6">
                <!-- Dialog Header -->
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded text-[10px] font-black uppercase"
                              :class="selectedTask?.priority === 1 ? 'bg-blue-50 text-blue-600' : selectedTask?.priority === 2 ? 'bg-amber-50 text-amber-600' : 'bg-rose-50 text-rose-600'"
                              x-text="selectedTask?.priority === 1 ? 'Low' : selectedTask?.priority === 2 ? 'Medium' : 'High'"></span>
                        <span class="px-2.5 py-0.5 rounded text-[10px] font-black uppercase bg-indigo-50 text-indigo-600"
                              x-text="selectedTask?.status === 0 ? 'To Do' : selectedTask?.status === 1 ? 'In Progress' : selectedTask?.status === 2 ? 'Review' : 'Done'"></span>
                    </div>
                    <h3 class="text-xl font-black text-slate-800 flex items-center justify-between gap-4">
                        <span x-text="selectedTask?.title"></span>
                        <div class="flex items-center gap-2 shrink-0">
                            <button x-show="currentUserCanEditTask" @@click="isEditing = true" class="text-indigo-600 hover:text-indigo-700 text-xs font-bold flex items-center gap-1.5 bg-indigo-50 px-3 py-1.5 rounded-xl transition-all cursor-pointer">
                                <i data-lucide="edit-3" class="w-4 h-4"></i>
                                Edit Task
                            </button>
                            <button x-show="currentUserCanDeleteTask" @@click="deleteTask(selectedTask?.id)" class="text-rose-600 hover:text-rose-700 text-xs font-bold flex items-center gap-1.5 bg-rose-50 px-3 py-1.5 rounded-xl transition-all cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                                Delete Task
                            </button>
                        </div>
                    </h3>
                </div>

                <!-- Description -->
                <div class="space-y-1.5">
                    <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Description</h4>
                    <p class="text-sm text-slate-500 leading-relaxed bg-slate-50/50 p-4 rounded-2xl border border-slate-100" x-text="selectedTask?.description || 'No description provided.'"></p>
                </div>

                <!-- Task Metadata -->
                <div class="grid grid-cols-2 gap-6 py-4 border-y border-slate-100">
                    <div>
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Assignee</h4>
                        <p class="text-sm font-bold text-slate-700 mt-1" x-text="selectedTask?.assignee?.fullName || 'Unassigned'"></p>
                    </div>
                    <div>
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Due Date</h4>
                        <p class="text-sm font-bold text-slate-700 mt-1" x-text="selectedTask?.dueDate ? new Date(selectedTask.dueDate).toLocaleDateString('en-US', {month: 'long', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit'}) : 'No date set'"></p>
                    </div>
                </div>

                <!-- Task Attachments - hidden until file display is fixed
                <div x-show="selectedTask?.files && selectedTask.files.length > 0" class="space-y-2">
                    <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Attachments</h4>
                    <div class="space-y-1.5">
                        <template x-for="file in selectedTask?.files || []" :key="file.id">
                            <a :href="'/' + file.fileUrl" target="_blank" download
                               class="flex items-center gap-3 p-3 bg-slate-50 border border-slate-100 rounded-xl hover:bg-indigo-50 hover:border-indigo-100 transition-all group">
                                <div class="w-8 h-8 rounded-lg bg-white border border-slate-200 flex items-center justify-center shrink-0 group-hover:border-indigo-200">
                                    <i data-lucide="file-text" class="w-4 h-4 text-slate-400 group-hover:text-indigo-500"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-xs font-bold text-slate-700 truncate group-hover:text-indigo-600" x-text="file.fileName"></p>
                                    <p class="text-[10px] text-slate-400 font-medium" x-text="(file.fileSize / 1024).toFixed(1) + ' KB'"></p>
                                </div>
                                <i data-lucide="download" class="w-4 h-4 text-slate-300 group-hover:text-indigo-400 shrink-0"></i>
                            </a>
                        </template>
                    </div>
                </div>
                -->

                <!-- Review Actions (Available only for tasks in status = 2) -->
                <div x-show="selectedTask?.status === 2">
                    <template x-if="currentUserRole === 'Owner' || currentUserRole === 'Manager'">
                        <div class="p-4 bg-purple-50/50 rounded-2xl border border-purple-100 space-y-3">
                            <p class="text-xs font-black text-purple-700 flex items-center gap-1.5">
                                <i data-lucide="eye" class="w-4 h-4"></i> Approve Completion (Assurance Process)
                            </p>
                            <div class="flex gap-2">
                                <form method="post" asp-page-handler="UpdateTaskStatus" class="inline-block">
                                    <input type="hidden" name="taskId" :value="selectedTask?.id">
                                    <input type="hidden" name="status" value="3">
                                    <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-xl text-xs font-bold shadow shadow-green-100 transition-all flex items-center gap-1.5 cursor-pointer">
                                        <i data-lucide="check" class="w-4 h-4"></i> Approve & Complete
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="UpdateTaskStatus" class="inline-block">
                                    <input type="hidden" name="taskId" :value="selectedTask?.id">
                                    <input type="hidden" name="status" value="1">
                                    <button type="submit" class="border border-purple-300 text-purple-600 px-4 py-2 rounded-xl text-xs font-bold hover:bg-purple-100 transition-all flex items-center gap-1.5 cursor-pointer">
                                        <i data-lucide="rotate-ccw" class="w-4 h-4"></i> Request Rework
                                    </button>
                                </form>
                            </div>
                        </div>
                    </template>
                    <template x-if="currentUserRole !== 'Owner' && currentUserRole !== 'Manager'">
                        <div class="p-4 bg-slate-50 border border-slate-200 rounded-2xl flex items-start gap-2.5">
                            <i data-lucide="shield-alert" class="w-5 h-5 text-indigo-500 shrink-0 mt-0.5 animate-pulse"></i>
                            <div>
                                <p class="text-xs font-black text-slate-700">Waiting for Management Approval</p>
                                <p class="mt-0.5 text-[10px] text-slate-500 leading-normal font-semibold">This task has been submitted to the Review column and is waiting for the owner or manager to review quality (Assurance) and approve completion.</p>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Edit Mode -->
            <form method="post" asp-page-handler="EditTask" class="space-y-4" enctype="multipart/form-data" x-show="isEditing" x-cloak>
                <input type="hidden" name="editTaskId" :value="selectedTask?.id">
                
                <h3 class="text-xl font-black text-slate-800">Edit Task</h3>

                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Task Title</label>
                    <input type="text" name="editTaskTitle" x-model="selectedTask.title" required
                           :disabled="currentUserRole !== 'Owner' && currentUserRole !== 'Manager'"
                           class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all disabled:bg-slate-100 disabled:text-slate-500 disabled:cursor-not-allowed">
                </div>

                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Description</label>
                    <textarea name="editTaskDescription" x-model="selectedTask.description" rows="3"
                              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all"></textarea>
                </div>

                <!--
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Attachment</label>
                    <div class="relative group">
                        <input type="file" asp-for="EditTaskFile" 
                               class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 outline-none transition-all file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-[10px] file:font-black file:uppercase file:bg-indigo-50 file:text-indigo-600 file:hover:bg-indigo-100 cursor-pointer">
                    </div>
                </div>
                -->

                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Priority</label>
                        <select name="editTaskPriority" x-model="selectedTask.priority"
                                :disabled="currentUserRole !== 'Owner' && currentUserRole !== 'Manager'"
                                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all disabled:bg-slate-100 disabled:text-slate-500 disabled:cursor-not-allowed">
                            <option value="1">Low</option>
                            <option value="2">Medium</option>
                            <option value="3">High</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Due Date & Time</label>
                        <div class="grid grid-cols-2 gap-2">
                            <!-- Date Selection -->
                            <input type="date" x-model="selectedTask.dueDateDate"
                                   :disabled="currentUserRole !== 'Owner' && currentUserRole !== 'Manager'"
                                   class="w-full px-3 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all disabled:bg-slate-100 disabled:text-slate-500 disabled:cursor-not-allowed">
                            
                            <!-- Custom Premium Time Dropdown -->
                            <div class="relative" x-data="{ showDropdown: false }">
                                <button type="button" @@click="if (currentUserRole === 'Owner' || currentUserRole === 'Manager') showDropdown = !showDropdown"
                                        :disabled="currentUserRole !== 'Owner' && currentUserRole !== 'Manager'"
                                        class="w-full px-3 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 text-left focus:ring-2 focus:ring-indigo-500 outline-none transition-all flex items-center justify-between disabled:bg-slate-100 disabled:text-slate-500 disabled:cursor-not-allowed">
                                    <span x-text="formatTimeDisplay(selectedTask?.dueDateTime)"></span>
                                    <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
                                </button>
                                
                                <!-- Popover -->
                                <div x-show="showDropdown" @@click.away="showDropdown = false" x-transition
                                     class="absolute right-0 mt-2 p-4 bg-white border border-slate-200 rounded-2xl shadow-xl z-50 w-56 space-y-3">
                                    <div class="flex items-center justify-between border-b border-slate-100 pb-1.5 mb-1.5">
                                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Set Custom Time</span>
                                        <div class="flex gap-2">
                                            <button type="button" @@click="selectedTask.dueDateTime = ''; showDropdown = false" class="text-[9px] font-black text-rose-600 hover:text-rose-700 uppercase">Clear</button>
                                            <button type="button" @@click="showDropdown = false" class="text-[9px] font-black text-indigo-600 hover:text-indigo-700 uppercase">Done</button>
                                        </div>
                                    </div>
                                    
                                    <div class="flex items-center justify-center gap-2">
                                        <!-- Hours -->
                                        <div class="flex flex-col items-center">
                                            <button type="button" @@click="incrementHour(false)" class="p-1 hover:bg-slate-50 text-slate-500 rounded"><i data-lucide="chevron-up" class="w-4 h-4"></i></button>
                                            <span class="text-sm font-black text-slate-800 my-1" x-text="getDisplayHour(selectedTask?.dueDateTime)"></span>
                                            <button type="button" @@click="decrementHour(false)" class="p-1 hover:bg-slate-50 text-slate-500 rounded"><i data-lucide="chevron-down" class="w-4 h-4"></i></button>
                                        </div>
                                        <span class="text-slate-400 font-bold text-sm">:</span>
                                        <!-- Minutes -->
                                        <div class="flex flex-col items-center">
                                            <button type="button" @@click="incrementMinute(false)" class="p-1 hover:bg-slate-50 text-slate-500 rounded"><i data-lucide="chevron-up" class="w-4 h-4"></i></button>
                                            <span class="text-sm font-black text-slate-800 my-1" x-text="getDisplayMinute(selectedTask?.dueDateTime)"></span>
                                            <button type="button" @@click="decrementMinute(false)" class="p-1 hover:bg-slate-50 text-slate-500 rounded"><i data-lucide="chevron-down" class="w-4 h-4"></i></button>
                                        </div>
                                        
                                        <!-- AM / PM Selector strictly AM/PM -->
                                        <div class="flex flex-col justify-center ml-2 border border-slate-100 rounded-lg overflow-hidden bg-slate-50">
                                            <button type="button" @@click="setAM(false)" 
                                                    :class="isAM(selectedTask?.dueDateTime) ? 'bg-indigo-600 text-white shadow' : 'text-slate-400 hover:text-slate-600'"
                                                    class="px-2 py-1 text-[9px] font-black tracking-wide uppercase transition-all">AM</button>
                                            <button type="button" @@click="setPM(false)" 
                                                    :class="!isAM(selectedTask?.dueDateTime) ? 'bg-indigo-600 text-white shadow' : 'text-slate-400 hover:text-slate-600'"
                                                    class="px-2 py-1 text-[9px] font-black tracking-wide uppercase transition-all">PM</button>
                                        </div>
                                    </div>

                                    <!-- Shortcuts panel -->
                                    <div class="grid grid-cols-2 gap-1 border-t border-slate-100 pt-2 text-[8px] font-bold text-slate-400">
                                        <button type="button" @@click="selectedTask.dueDateTime = '09:00'" class="p-1 bg-slate-50 hover:bg-slate-100 rounded text-center">09:00 AM</button>
                                        <button type="button" @@click="selectedTask.dueDateTime = '12:00'" class="p-1 bg-slate-50 hover:bg-slate-100 rounded text-center">12:00 PM</button>
                                        <button type="button" @@click="selectedTask.dueDateTime = '14:00'" class="p-1 bg-slate-50 hover:bg-slate-100 rounded text-center">02:00 PM</button>
                                        <button type="button" @@click="selectedTask.dueDateTime = '17:00'" class="p-1 bg-slate-50 hover:bg-slate-100 rounded text-center">05:00 PM</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" name="editTaskDueDate" :value="selectedTask.dueDateDate ? (selectedTask.dueDateTime ? (selectedTask.dueDateDate + 'T' + selectedTask.dueDateTime) : selectedTask.dueDateDate) : ''">
                    </div>
                </div>

                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Assignee</label>
                    <select name="editTaskAssigneeId" x-model="selectedTask.assigneeId"
                            :disabled="currentUserRole !== 'Owner' && currentUserRole !== 'Manager'"
                            class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all disabled:bg-slate-100 disabled:text-slate-500 disabled:cursor-not-allowed">
                        <option value="">Unassigned</option>
                        @foreach (var m in Model.Members)
                        {
                            <option value="@m.UserId">@m.User.FullName</option>
                        }
                    </select>
                </div>

                <div class="flex gap-3 pt-2">
                    <button type="submit" class="flex-1 py-3 bg-indigo-600 text-white rounded-xl text-xs font-bold shadow hover:bg-indigo-700 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                        <i data-lucide="save" class="w-4 h-4"></i> Save Changes
                    </button>
                    <button type="button" @@click="isEditing = false" class="flex-1 py-3 border border-slate-200 text-slate-500 rounded-xl text-xs font-bold hover:bg-slate-50 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                        Cancel
                    </button>
                </div>
            </form>

            <!-- Task Comments Feed -->
            <div class="space-y-3">
                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Comments Timeline</h4>
                
                <div class="space-y-3 max-h-[220px] overflow-y-auto pr-1">
                    <template x-if="!selectedTask?.taskComments || selectedTask.taskComments.length === 0">
                        <p class="text-xs font-bold text-slate-400 italic">No comments yet. Start the conversation!</p>
                    </template>
                    <template x-for="comment in selectedTask?.taskComments" :key="comment.id">
                        <div class="p-3 bg-slate-50 border border-slate-100 rounded-2xl flex gap-3 text-xs leading-relaxed">
                            <div class="h-6 w-6 rounded-full bg-slate-200 flex items-center justify-center font-bold text-[9px] uppercase text-slate-500 shrink-0" 
                                 x-text="comment.user?.fullName ? comment.user.fullName.split(' ').map(n => n[0]).join('') : 'U'"></div>
                            <div class="min-w-0 flex-1">
                                <p class="font-bold text-slate-700" x-text="comment.user?.fullName"></p>
                                <div class="text-slate-500 mt-0.5 break-words" x-html="parseCommentContent(comment.content)"></div>
                                
                                <!-- Render Comment Attachment Box if comment has an attachment -->
                                <template x-if="getCommentAttachment(comment.content)">
                                    <div class="mt-2.5 p-2.5 border border-slate-200 bg-white rounded-xl flex items-center justify-between gap-4 max-w-sm text-slate-700 shadow-sm">
                                        <div class="flex items-center gap-2.5 min-w-0">
                                            <div class="h-8 w-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
                                            </div>
                                            <div class="min-w-0">
                                                <p class="text-[11px] font-bold truncate text-slate-800" x-text="getCommentAttachment(comment.content).fileName"></p>
                                                <p class="text-[9px] font-bold text-slate-400 uppercase" x-text="Math.round(getCommentAttachment(comment.content).fileSize / 1024) + ' KB'"></p>
                                            </div>
                                        </div>
                                        <a :href="'/' + getCommentAttachment(comment.content).fileUrl" class="h-7 w-7 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-650 flex items-center justify-center shrink-0 transition-colors cursor-pointer" download>
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                        </a>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </template>
                </div>

                <!-- Add Comment Form -->
                <div class="relative w-full">
                    <!-- Comment Autocomplete Popover Box -->
                    <div x-show="showCommentSuggestions" 
                         class="absolute bottom-full left-0 right-0 mb-2 p-2 bg-white border border-slate-200 rounded-2xl shadow-2xl flex flex-col gap-1.5 max-h-40 overflow-y-auto transition-all z-50 text-left"
                         x-transition x-cloak>
                        <div class="px-3 py-1 text-[9px] font-black text-slate-400 uppercase tracking-widest border-b border-slate-100">
                            Mentions suggestions (Type <span x-text="showCommentSuggestions?.type"></span>)
                        </div>
                        <div class="space-y-0.5">
                            <!-- Member Suggestions -->
                            <template x-if="showCommentSuggestions?.type === '@@'">
                                <div>
                                    <template x-for="member in filteredCommentMembers" :key="member.id">
                                        <button type="button" 
                                                @@click="insertCommentSuggestion('@@' + member.fullName)"
                                                class="w-full text-left px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 rounded-xl flex items-center gap-2 transition-all">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 opacity-60"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                            <span x-text="member.fullName"></span>
                                        </button>
                                    </template>
                                    <template x-if="filteredCommentMembers.length === 0">
                                        <div class="px-3 py-1.5 text-xs font-bold text-slate-400 italic">No matching members found.</div>
                                    </template>
                                </div>
                            </template>
                            
                            <!-- Task Suggestions -->
                            <template x-if="showCommentSuggestions?.type === '#'">
                                <div>
                                    <template x-for="task in filteredCommentTasks" :key="task.id">
                                        <button type="button" 
                                                @@click="insertCommentSuggestion('#' + task.title)"
                                                class="w-full text-left px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-amber-50 hover:text-amber-600 rounded-xl flex items-center gap-2 transition-all">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 opacity-60"><line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/></svg>
                                            <span x-text="task.title"></span>
                                        </button>
                                    </template>
                                    <template x-if="filteredCommentTasks.length === 0">
                                        <div class="px-3 py-1.5 text-xs font-bold text-slate-400 italic">No matching tasks found.</div>
                                    </template>
                                </div>
                            </template>
                        </div>
                    </div>

                    <!-- Selected Comment Attachment Status Indicator Box -->
                    <div x-show="selectedCommentFileName" 
                         class="mb-2 p-2 bg-indigo-50 border border-indigo-100 rounded-xl flex items-center justify-between text-[10px] font-bold text-indigo-700 transition-all"
                         x-transition x-cloak>
                        <span class="flex items-center gap-1.5 truncate">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-indigo-600"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9 15 2 2 4-4"/></svg>
                            <span>Attachment: </span>
                            <strong class="truncate" x-text="selectedCommentFileName"></strong>
                        </span>
                        <button type="button" @@click="clearCommentFile()" class="text-indigo-400 hover:text-indigo-600 transition-colors cursor-pointer flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>

                    <template x-if="currentUserRole !== 'Viewer'">
                        <form @@submit.prevent="sendTaskCommentViaAjax()" class="flex gap-2 pt-2" enctype="multipart/form-data">
                            <input type="hidden" name="commentTaskId" :value="selectedTask?.id">
                            
                            <!-- Paperclip Button -->
                            <button type="button" 
                                    @@click="document.getElementById('task-comment-file-input').click()" 
                                    :class="selectedCommentFileName ? 'bg-indigo-50 text-indigo-600 border border-indigo-250' : 'bg-slate-50 text-slate-400 hover:text-slate-600 border border-slate-200'"
                                    class="p-2.5 rounded-xl flex items-center justify-center transition-all shrink-0 cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                            </button>
                            <input type="file" id="task-comment-file-input" class="hidden" @@change="handleCommentFileChange($event)">

                            <input type="text" id="task-comment-field" asp-for="CommentContent" x-model="newCommentContent" placeholder="Post a comment..." :required="!selectedCommentFileName" autocomplete="off"
                                   class="flex-1 px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-[11px] focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                            <button type="submit" class="bg-indigo-600 text-white px-4 py-2.5 rounded-xl hover:bg-indigo-700 shadow shadow-indigo-100 flex items-center justify-center transition-all shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                            </button>
                        </form>
                    </template>
                    <template x-if="currentUserRole === 'Viewer'">
                        <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl text-center text-xs text-slate-400 font-bold italic">
                            You are viewing as a Viewer. Cannot add comments.
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════ -->
    <!-- ─── TAB 6: KPI DASHBOARD ─── -->
    <!-- ════════════════════════════════════════ -->
    @if (packageTier == "Business" || Model.Workspace.FederationId != null)
    {
        <div x-show="activeTab === 'kpi'" class="space-y-6" x-transition>
        <!-- Controls & Filter -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-6 rounded-[2.5rem] border border-slate-200 bg-white shadow-sm">
            <div>
                <h2 class="text-lg font-black text-slate-800">Workspace KPI Performance</h2>
                <p class="text-xs font-semibold text-slate-400">Monitor and compare member contributions by category.</p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <template x-if="currentUserRole === 'Owner' || currentUserRole === 'Manager'">
                    <div class="flex gap-2">
                        <button type="button" @@click="assignKpiOpen = true"
                                class="text-xs font-bold bg-indigo-600 text-white hover:bg-indigo-700 px-4 py-2.5 rounded-xl shadow shadow-indigo-150 transition-all flex items-center gap-1.5 cursor-pointer">
                            <i data-lucide="plus" class="w-4 h-4"></i> Assign KPI
                        </button>
                        <button type="button" @@click="manageCategoriesOpen = true"
                                class="text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2.5 rounded-xl border border-slate-200 transition-all flex items-center gap-1.5 cursor-pointer">
                            <i data-lucide="settings" class="w-4 h-4"></i> KPI Settings
                        </button>
                    </div>
                </template>
                <div class="h-6 w-px bg-slate-200"></div>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Category:</span>
                <select x-model="selectedKpiCategoryFilter" 
                        class="bg-slate-50 text-slate-700 hover:bg-slate-100 border border-slate-200/50 text-xs font-bold px-3 py-1.5 rounded-lg outline-none transition-all cursor-pointer">
                    <option value="all">All Categories</option>
                    <template x-for="cat in demoCategories" :key="cat.id">
                        <option :value="cat.id" x-text="cat.name"></option>
                    </template>
                </select>

                <div class="h-6 w-px bg-slate-200"></div>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Period:</span>
                <div class="flex gap-1.5">
                    <template x-for="period in ['Daily', 'Weekly', 'Monthly']" :key="period">
                        <button type="button" @@click="selectedKpiPeriodFilter = period"
                                :class="selectedKpiPeriodFilter === period ? 'bg-indigo-600 text-white shadow' : 'bg-slate-50 text-slate-600 hover:bg-slate-100 border border-slate-200/50'"
                                class="text-xs font-bold px-3 py-1.5 rounded-lg transition-all" x-text="period"></button>
                    </template>
                </div>
                
                <div class="h-6 w-px bg-slate-200"></div>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Timeframe:</span>
                <div class="flex gap-1.5">
                    <button type="button" @@click="selectedKpiTimeframe = 'current'"
                            :class="selectedKpiTimeframe === 'current' ? 'bg-indigo-600 text-white shadow' : 'bg-slate-50 text-slate-600 hover:bg-slate-100 border border-slate-200/50'"
                            class="text-xs font-bold px-3 py-1.5 rounded-lg transition-all"
                            x-text="selectedKpiPeriodFilter === 'Daily' ? 'Today' : selectedKpiPeriodFilter === 'Weekly' ? 'This Week' : 'This Month'"></button>
                    <button type="button" @@click="selectedKpiTimeframe = 'previous'"
                            :class="selectedKpiTimeframe === 'previous' ? 'bg-indigo-600 text-white shadow' : 'bg-slate-50 text-slate-600 hover:bg-slate-100 border border-slate-200/50'"
                            class="text-xs font-bold px-3 py-1.5 rounded-lg transition-all"
                            x-text="selectedKpiPeriodFilter === 'Daily' ? 'Yesterday' : selectedKpiPeriodFilter === 'Weekly' ? 'Last Week' : 'Last Month'"></button>
                </div>
            </div>
        </div>

        <!-- Grid Layout: Main Charts & Leaderboard -->
        <div class="grid lg:grid-cols-3 gap-6">
            <!-- KPI Performance Chart (Left & Mid) -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Overall performance comparison -->
                <div class="bg-white rounded-[2.5rem] border border-slate-200 p-8 shadow-sm">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-base font-black text-slate-800 flex items-center gap-2">
                            <i data-lucide="trending-up" class="w-5 h-5 text-indigo-600"></i>
                            Compare Achieved KPI vs Target (By Member)
                        </h3>
                    </div>
                    
                    <div class="w-full">
                        <template x-if="workspaceMembers.filter(m => m.id.toLowerCase() !== workspaceOwnerId.toLowerCase() && m.role !== 'Owner').length === 0">
                            <div class="text-xs text-slate-400 text-center py-10 font-bold italic">No members in this workspace to assign KPIs.</div>
                        </template>
                        
                        <template x-if="workspaceMembers.filter(m => m.id.toLowerCase() !== workspaceOwnerId.toLowerCase() && m.role !== 'Owner').length > 0">
                            <div class="grid sm:grid-cols-2 gap-4">
                                <template x-for="m in workspaceMembers.filter(m => m.id.toLowerCase() !== workspaceOwnerId.toLowerCase() && m.role !== 'Owner')" :key="m.id">
                                    <div class="p-5 rounded-2xl border border-slate-100 bg-slate-50/50 space-y-4" x-data="{ get metrics() { return getMemberKpiMetrics(m.id, selectedKpiPeriodFilter, selectedKpiTimeframe, selectedKpiCategoryFilter); } }">
                                        <div class="flex items-center gap-2.5">
                                            <div class="h-7 w-7 rounded-full bg-indigo-50 flex items-center justify-center text-[10px] font-black text-indigo-600"
                                                 x-text="m.fullName.split(' ').map(n => n[0]).join('')"></div>
                                            <span class="text-xs font-bold text-slate-700" x-text="m.fullName"></span>
                                        </div>
                                        
                                        <div class="space-y-3">
                                            <!-- Target vs Achieved -->
                                            <div class="space-y-1">
                                                <div class="flex justify-between text-[10px] font-bold text-slate-400 uppercase tracking-wide">
                                                    <span>Target Value</span>
                                                    <span class="text-slate-700 font-bold" x-text="metrics.targetSum"></span>
                                                </div>
                                                <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden">
                                                    <div class="h-full bg-indigo-600 rounded-full transition-all duration-500"
                                                         :style="'width: ' + (metrics.targetSum > 0 ? '100%' : '0%')"></div>
                                                </div>
                                            </div>
                                            
                                            <div class="space-y-1">
                                                <div class="flex justify-between text-[10px] font-bold text-slate-400 uppercase tracking-wide">
                                                    <span>Actual Achieved</span>
                                                    <span class="text-slate-700 font-bold" x-text="metrics.achievedSum"></span>
                                                </div>
                                                <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden">
                                                    <div class="h-full bg-emerald-500 rounded-full transition-all duration-500"
                                                         :style="'width: ' + (metrics.targetSum > 0 ? Math.min(100, metrics.rate) + '%' : '0%')"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- KPI List by Employee -->
                <div class="bg-white rounded-[2.5rem] border border-slate-200 p-8 shadow-sm">
                    <div class="mb-6">
                        <h3 class="text-base font-black text-slate-800 flex items-center gap-2">
                            <i data-lucide="users" class="w-5 h-5 text-indigo-600"></i>
                            KPIs by Employee
                        </h3>
                    </div>
                    
                    <div class="space-y-6">
                        <template x-for="m in workspaceMembers.filter(m => (m.id.toLowerCase() !== workspaceOwnerId.toLowerCase() && m.role !== 'Owner') && ((currentUserRole === 'Owner' || currentUserRole === 'Manager') || m.id.toLowerCase() === currentUserId.toLowerCase()))" :key="m.id">
                            <div class="p-5 rounded-[2rem] border border-slate-100 bg-slate-50/50 space-y-4">
                                <div class="flex items-center gap-3">
                                    <div class="h-8 w-8 rounded-full bg-indigo-100/50 flex items-center justify-center text-[10px] font-black text-indigo-700"
                                         x-text="m.fullName.split(' ').map(n => n[0]).join('')"></div>
                                    <div>
                                        <h4 class="text-xs font-black text-slate-700" x-text="m.fullName"></h4>
                                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider" x-text="m.role"></p>
                                    </div>
                                </div>
                                
                                <div class="grid sm:grid-cols-2 gap-4">
                                    <!-- List member targets -->
                                    <template x-for="target in kpiTargets.filter(t => t.userId === m.id && (selectedKpiCategoryFilter === 'all' || t.categoryId === selectedKpiCategoryFilter)).sort((a, b) => {
                                        const order = { 'Daily': 1, 'Weekly': 2, 'Monthly': 3 };
                                        return (order[a.periodType] || 99) - (order[b.periodType] || 99);
                                    })" :key="target.id">
                                        <div class="p-4 rounded-2xl border border-slate-150/70 bg-white space-y-3 relative overflow-hidden shadow-sm">
                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center gap-1.5 flex-wrap">
                                                    <span :style="'background-color: ' + (demoCategories.find(c => c.id === target.categoryId)?.color || '#94a3b8')" class="h-2 w-2 rounded-full"></span>
                                                    <span class="text-xs font-black text-slate-700" x-text="demoCategories.find(c => c.id === target.categoryId)?.name || 'Category'"></span>
                                                    <span class="text-[9px] font-bold px-1.5 py-0.5 rounded"
                                                          :class="target.periodType === 'Daily' ? 'bg-rose-50 text-rose-600 border border-rose-100/50' : 
                                                                  target.periodType === 'Weekly' ? 'bg-indigo-50 text-indigo-600 border border-indigo-100/50' : 
                                                                  'bg-purple-50 text-purple-600 border border-purple-100/50'"
                                                          x-text="target.periodType"></span>
                                                </div>
                                                <span class="text-xs font-black text-slate-800" x-text="(selectedKpiTimeframe === 'previous' ? (target.prevAchievedValue !== undefined ? target.prevAchievedValue : Math.round(target.targetValue * 0.7)) : target.achievedValue) + ' / ' + target.targetValue"></span>
                                            </div>
                                            
                                            <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden">
                                                <div class="h-full bg-indigo-600 rounded-full transition-all duration-300"
                                                     :style="'width: ' + Math.min(100, Math.round(((selectedKpiTimeframe === 'previous' ? (target.prevAchievedValue !== undefined ? target.prevAchievedValue : Math.round(target.targetValue * 0.7)) : target.achievedValue) * 100) / target.targetValue)) + '%'"></div>
                                            </div>
                                            
                                            <div class="flex items-center justify-between pt-1">
                                                <template x-if="selectedKpiTimeframe === 'current' && kpiRequests.find(r => r.userId === m.id && r.categoryId === target.categoryId && r.periodType === target.periodType && r.status === 'pending')">
                                                    <span class="px-2 py-0.5 rounded text-[9px] font-black uppercase bg-amber-50 text-amber-600 border border-amber-100 animate-pulse">
                                                        Pending Approval (<span x-text="kpiRequests.find(r => r.userId === m.id && r.categoryId === target.categoryId && r.periodType === target.periodType && r.status === 'pending').requestType === 'increment' ? '+' + (kpiRequests.find(r => r.userId === m.id && r.categoryId === target.categoryId && r.periodType === target.periodType && r.status === 'pending').incrementValue || 1) : 'Done'"></span>)
                                                    </span>
                                                </template>
                                                
                                                <template x-if="selectedKpiTimeframe === 'current' && currentUserRole !== 'Owner' && currentUserRole !== 'Manager' && m.id.toLowerCase() === currentUserId.toLowerCase() && !kpiRequests.find(r => r.userId === m.id && r.categoryId === target.categoryId && r.periodType === target.periodType && r.status === 'pending')">
                                                    <div class="flex items-center gap-2" x-data="{ count: Math.min(1, target.targetValue - target.achievedValue) }">
                                                        <div class="flex items-center border border-slate-200 rounded-lg bg-slate-50 overflow-hidden h-7">
                                                            <button type="button" @@click="if (count > 1) count--" class="px-2.5 py-0.5 text-xs font-black text-slate-500 hover:bg-slate-100 transition-all select-none">-</button>
                                                            <span class="px-1.5 text-xs font-black text-slate-700 w-5 text-center" x-text="count"></span>
                                                            <button type="button" @@click="if (count < (target.targetValue - target.achievedValue)) count++" class="px-2.5 py-0.5 text-xs font-black text-slate-500 hover:bg-slate-100 transition-all select-none">+</button>
                                                        </div>
                                                        <button type="button" 
                                                                @@click="handleRequestKpiUpdate(m.id, target.categoryId, target.periodType, 'increment', count)"
                                                                :disabled="target.achievedValue >= target.targetValue"
                                                                class="text-[9px] font-black px-2.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg disabled:opacity-50 disabled:cursor-not-allowed uppercase transition-all shadow-sm">
                                                            Request +<span x-text="count"></span>
                                                        </button>
                                                    </div>
                                                </template>
                                                
                                                <span class="text-[10px] font-bold text-slate-400" x-text="Math.min(100, Math.round(((selectedKpiTimeframe === 'previous' ? (target.prevAchievedValue !== undefined ? target.prevAchievedValue : Math.round(target.targetValue * 0.7)) : target.achievedValue) * 100) / target.targetValue)) + '%'"></span>
                                            </div>
                                        </div>
                                    </template>
                                    
                                    <template x-if="kpiTargets.filter(t => t.userId === m.id && (selectedKpiCategoryFilter === 'all' || t.categoryId === selectedKpiCategoryFilter)).length === 0">
                                        <div class="col-span-2 text-xs text-slate-400 italic py-2">No KPIs assigned.</div>
                                    </template>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <!-- KPI Leaderboard & Approval Panel (Right) -->
            <div class="space-y-6">
                <!-- Approval Panel (Corporate Verification) -->
                <template x-if="currentUserRole === 'Owner' || currentUserRole === 'Manager'">
                    <div class="bg-amber-50/25 border border-amber-100 rounded-[2.5rem] p-6 shadow-sm bg-white">
                        <div class="flex items-center gap-2 pb-3 border-b border-amber-100/50 mb-4 text-amber-600">
                            <i data-lucide="clock" class="w-5 h-5"></i>
                            <h3 class="text-sm font-black uppercase tracking-wider">Pending KPI Verifications</h3>
                        </div>
                        
                        <div class="space-y-3 max-h-[300px] overflow-y-auto pr-1">
                            <template x-for="req in kpiRequests.filter(r => r.status === 'pending')" :key="req.id">
                                <div class="p-4 bg-white border border-slate-200/60 rounded-2xl space-y-2.5 text-xs shadow-sm">
                                    <div class="flex items-center justify-between">
                                        <span class="font-black text-slate-700" x-text="req.userName"></span>
                                        <span class="text-[9px] font-bold text-slate-400" x-text="req.timestamp"></span>
                                    </div>
                                    <p class="text-[11px] font-semibold text-slate-500 leading-normal">
                                        Requested approval to mark <strong class="text-slate-800" x-text="demoCategories.find(c => c.id === req.categoryId)?.name"></strong> KPI (<span class="font-bold text-indigo-600" x-text="req.periodType || 'Weekly'"></span>) as <span x-text="req.requestType === 'increment' ? 'progress +' + (req.incrementValue || 1) : 'fully completed'"></span>.
                                    </p>
                                    <div class="flex gap-1.5 justify-end pt-1 border-t border-slate-50">
                                        <button type="button" @@click="handleRejectKpi(req.id)"
                                                class="text-[9px] font-black px-2.5 py-1.5 border border-rose-200 text-rose-600 hover:bg-rose-50 rounded-lg uppercase transition-all">
                                            Reject
                                        </button>
                                        <button type="button" @@click="handleApproveKpi(req.id)"
                                                class="text-[9px] font-black px-2.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg uppercase shadow-sm shadow-emerald-100 transition-all">
                                            Approve
                                        </button>
                                    </div>
                                </div>
                            </template>
                            
                            <template x-if="kpiRequests.filter(r => r.status === 'pending').length === 0">
                                <p class="text-xs text-slate-400 text-center py-8 font-bold italic">No pending KPI verifications.</p>
                            </template>
                        </div>
                    </div>
                </template>

                <!-- Leaderboard Card -->
                <div class="bg-white rounded-[2.5rem] border border-slate-200 p-8 shadow-sm">
                    <div class="mb-6 flex items-center gap-2 text-indigo-600">
                        <i data-lucide="crown" class="w-5 h-5 text-amber-500"></i>
                        <h3 class="text-base font-black text-slate-800">KPI Leaderboard</h3>
                    </div>
                    
                    <div class="space-y-3">
                        <template x-for="(m, idx) in workspaceMembers.filter(m => m.role !== 'Owner').map(m => {
                            const metrics = getMemberKpiMetrics(m.id, selectedKpiPeriodFilter, selectedKpiTimeframe, selectedKpiCategoryFilter);
                            return { id: m.id, fullName: m.fullName, targetSum: metrics.targetSum, actualSum: metrics.achievedSum, rate: metrics.rate };
                        }).sort((a, b) => b.rate - a.rate)" :key="m.id">
                            <div class="flex items-center gap-3 p-3.5 rounded-2xl border border-slate-100 bg-slate-50/50">
                                <span class="text-xs font-black w-5 shrink-0 text-center"
                                      :class="idx === 0 ? 'text-amber-500 text-sm' : idx === 1 ? 'text-slate-400' : idx === 2 ? 'text-amber-700' : 'text-slate-400'"
                                      x-text="'#' + (idx + 1)"></span>
                                <div class="h-7 w-7 rounded-full bg-indigo-50 border border-slate-100 flex items-center justify-center text-[10px] font-black text-indigo-650"
                                     x-text="m.fullName.split(' ').map(n => n[0]).join('')"></div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-xs font-black text-slate-700 truncate leading-none mb-1" x-text="m.fullName"></p>
                                    <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wide" x-text="m.actualSum + ' / ' + m.targetSum + ' KPI'"></span>
                                </div>
                                <div class="text-right shrink-0">
                                    <p class="text-xs font-black text-indigo-600" x-text="m.rate + '%'"></p>
                                    <div class="h-1 w-12 bg-slate-100 rounded-full mt-1 overflow-hidden">
                                        <div class="h-full bg-indigo-600 rounded-full" :style="'width: ' + m.rate + '%'"></div>
                                    </div>
                                </div>
                            </div>
                        </template>
                        
                        <template x-if="workspaceMembers.filter(m => m.id.toLowerCase() !== workspaceOwnerId.toLowerCase() && m.role !== 'Owner').length === 0">
                            <p class="text-xs text-slate-400 text-center py-6 font-bold italic">No members to rank.</p>
                        </template>
                    </div>
                </div>
            </div>
        </div>

        <!-- Task-to-KPI Conversion & Productivity Analysis Panel -->
        <div class="bg-white rounded-[2.5rem] border border-slate-200 p-8 shadow-sm">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
                <div>
                    <h3 class="text-base font-black text-slate-800 flex items-center gap-2">
                        <i data-lucide="shuffle" class="w-5 h-5 text-indigo-600 animate-pulse"></i>
                        Task-to-KPI Conversion & Productivity Analysis
                    </h3>
                    <p class="text-xs font-semibold text-slate-400">Evaluate conversion rates from task completions (Công việc) into KPI achievements (Thành quả).</p>
                </div>
                <div class="text-[10px] font-black uppercase bg-indigo-50 border border-indigo-100/50 text-indigo-600 px-3 py-1.5 rounded-xl self-start">
                    Active Filters applied
                </div>
            </div>

            <template x-if="workspaceMembers.filter(m => m.id.toLowerCase() !== workspaceOwnerId.toLowerCase() && m.role !== 'Owner').length === 0">
                <p class="text-xs text-slate-400 text-center py-10 font-bold italic">No member conversion data available.</p>
            </template>

            <template x-if="workspaceMembers.filter(m => m.id.toLowerCase() !== workspaceOwnerId.toLowerCase() && m.role !== 'Owner').length > 0">
                <div class="grid md:grid-cols-2 gap-6">
                    <template x-for="m in workspaceMembers.filter(m => m.id.toLowerCase() !== workspaceOwnerId.toLowerCase() && m.role !== 'Owner')" :key="m.id">
                        <div class="p-6 rounded-[2rem] border border-slate-150/70 bg-slate-50/20 shadow-sm flex flex-col justify-between" 
                             x-data="{ get conv() { return getMemberConversionMetrics(m.id, selectedKpiPeriodFilter, selectedKpiTimeframe, selectedKpiCategoryFilter); } }">
                            
                            <!-- Member Header -->
                            <div class="flex items-center justify-between pb-4 border-b border-slate-100/50 mb-4">
                                <div class="flex items-center gap-2.5">
                                    <div class="h-8 w-8 rounded-full bg-indigo-50 border border-indigo-100/30 flex items-center justify-center text-xs font-black text-indigo-600"
                                         x-text="m.fullName.split(' ').map(n => n[0]).join('')"></div>
                                    <div>
                                        <span class="text-xs font-black text-slate-700 block leading-tight" x-text="m.fullName"></span>
                                        <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest" x-text="m.role"></span>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <span class="text-[10px] font-black text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-100/55" 
                                          x-text="conv.efficiency + ' KPI/Task'"></span>
                                    <span class="block text-[8px] font-bold text-slate-400 uppercase tracking-wider mt-0.5">Efficiency Ratio</span>
                                </div>
                            </div>

                            <!-- Conversion Metrics Comparison -->
                            <div class="space-y-4">
                                <div class="grid grid-cols-2 gap-4">
                                    <!-- Task completion widget -->
                                    <div class="p-4 bg-white border border-slate-150/55 rounded-2xl space-y-2 relative overflow-hidden shadow-sm">
                                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider block">Task Completion (Công việc)</span>
                                        <div class="flex items-baseline gap-1.5">
                                            <span class="text-xl font-black text-slate-800" x-text="conv.completedTasks"></span>
                                            <span class="text-xs font-semibold text-slate-400" x-text="'/ ' + conv.totalTasks + ' assigned'"></span>
                                        </div>
                                        <div class="flex items-center justify-between pt-1">
                                            <span class="text-[10px] font-black text-indigo-600" x-text="conv.taskCompletionRate + '%'"></span>
                                            <div class="h-1.5 w-16 bg-slate-100 rounded-full overflow-hidden">
                                                <div class="h-full bg-indigo-600 rounded-full" :style="'width: ' + conv.taskCompletionRate + '%'"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- KPI achievement widget -->
                                    <div class="p-4 bg-white border border-slate-150/55 rounded-2xl space-y-2 relative overflow-hidden shadow-sm">
                                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider block">KPI Achievement (Thành quả)</span>
                                        <div class="flex items-baseline gap-1.5">
                                            <span class="text-xl font-black text-slate-800" x-text="conv.kpiAchieved"></span>
                                            <span class="text-xs font-semibold text-slate-400" x-text="'/ ' + conv.kpiTarget + ' target'"></span>
                                        </div>
                                        <div class="flex items-center justify-between pt-1">
                                            <span class="text-[10px] font-black text-emerald-600" x-text="conv.kpiAchievementRate + '%'"></span>
                                            <div class="h-1.5 w-16 bg-slate-100 rounded-full overflow-hidden">
                                                <div class="h-full bg-emerald-500 rounded-full" :style="'width: ' + Math.min(100, conv.kpiAchievementRate) + '%'"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Conversion Rate visual bar -->
                                <div class="bg-white border border-slate-150/60 p-4 rounded-2xl space-y-2.5 shadow-sm">
                                    <div class="flex items-center justify-between text-[10px] font-black uppercase tracking-wider">
                                        <span class="text-slate-400">Task-to-KPI Conversion Progress</span>
                                        <span class="text-indigo-600" x-text="conv.totalTasks > 0 ? Math.round((conv.kpiAchieved * 100) / (conv.totalTasks + conv.kpiTarget)) + '%' : '0%'"></span>
                                    </div>
                                    <div class="h-3 w-full bg-slate-100 rounded-full p-0.5 overflow-hidden flex">
                                        <!-- Completed Tasks block -->
                                        <div class="h-full bg-indigo-600 rounded-l-full transition-all duration-300" 
                                             :style="'width: ' + (conv.totalTasks > 0 ? (conv.completedTasks * 100 / (conv.totalTasks + conv.kpiTarget)) + '%' : '0%')"></div>
                                        <!-- Achieved KPI block -->
                                        <div class="h-full bg-emerald-500 rounded-r-full transition-all duration-300 border-l border-white" 
                                             :style="'width: ' + (conv.totalTasks > 0 ? (conv.kpiAchieved * 100 / (conv.totalTasks + conv.kpiTarget)) + '%' : '0%')"></div>
                                    </div>
                                    <div class="flex justify-between text-[8px] font-bold text-slate-400 uppercase tracking-widest pt-0.5">
                                        <span class="flex items-center gap-1"><span class="h-1.5 w-1.5 bg-indigo-600 rounded-full inline-block"></span> Tasks Completed</span>
                                        <span class="flex items-center gap-1"><span class="h-1.5 w-1.5 bg-emerald-500 rounded-full inline-block"></span> KPI Achieved</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Conversion Advice & Insights -->
                            <div class="mt-4 p-3.5 bg-indigo-50/30 border border-indigo-100/50 rounded-2xl flex items-start gap-2.5">
                                <i data-lucide="lightbulb" class="w-4 h-4 text-indigo-500 shrink-0 mt-0.5"></i>
                                <div>
                                    <span class="text-[9px] font-black text-indigo-650 uppercase tracking-widest block mb-0.5">Productivity Alignment Advice</span>
                                    <p class="text-[10px] font-semibold text-slate-500 leading-normal" x-text="conv.advice"></p>
                                </div>
                            </div>

                        </div>
                    </template>
                </div>
            </template>
        </div>
    </div>
    }

    <!-- ════════════════════════════════════════ -->
    <!-- ─── CREATE TASK DIALOG MODAL ─── -->
    <!-- ════════════════════════════════════════ -->
    <div x-show="createOpen" 
         class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" 
         style="display: none;"
         x-transition>
        
        <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-2xl w-full max-w-2xl p-8 relative flex flex-col gap-6"
             @@click.away="createOpen = false">
            
            <button @@click="createOpen = false" class="absolute top-6 right-6 h-8 w-8 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 transition-all">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <h3 class="text-xl font-black text-slate-800">Create New Task</h3>

            <form method="post" asp-page-handler="CreateTask" class="space-y-4" enctype="multipart/form-data">
                <input type="hidden" asp-for="NewTaskStatus" :value="createTaskStatus">

                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Task Title</label>
                    <input type="text" asp-for="NewTaskTitle" placeholder="e.g. Design DB entities" required
                           class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                </div>

                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Description</label>
                    <textarea asp-for="NewTaskDescription" placeholder="Provide task context..." rows="3"
                              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all"></textarea>
                </div>

                <!--
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Attachment</label>
                    <div class="relative group">
                        <input type="file" asp-for="NewTaskFile" 
                               class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 outline-none transition-all file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-[10px] file:font-black file:uppercase file:bg-indigo-50 file:text-indigo-600 file:hover:bg-indigo-100 cursor-pointer">
                    </div>
                </div>
                -->

                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Priority</label>
                        <select asp-for="NewTaskPriority" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                            <option value="1">Low</option>
                            <option value="2">Medium</option>
                            <option value="3">High</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Due Date & Time</label>
                        <div class="grid grid-cols-2 gap-2">
                            <!-- Date Selector -->
                            <input type="date" x-model="createTaskDate"
                                   class="w-full px-3 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                            
                            <!-- Custom Time Picker Selector -->
                            <div class="relative" x-data="{ showDropdown: false }">
                                <button type="button" @@click="showDropdown = !showDropdown"
                                        class="w-full px-3 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 text-left focus:ring-2 focus:ring-indigo-500 outline-none transition-all flex items-center justify-between">
                                    <span x-text="formatTimeDisplay(createTaskTime)"></span>
                                    <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
                                </button>
                                
                                <!-- Dropdown list -->
                                <div x-show="showDropdown" @@click.away="showDropdown = false" x-transition
                                     class="absolute right-0 mt-2 p-4 bg-white border border-slate-200 rounded-2xl shadow-xl z-50 w-56 space-y-3">
                                    <div class="flex items-center justify-between border-b border-slate-100 pb-1.5 mb-1.5">
                                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Set Custom Time</span>
                                        <div class="flex gap-2">
                                            <button type="button" @@click="createTaskTime = ''; showDropdown = false" class="text-[9px] font-black text-rose-600 hover:text-rose-700 uppercase">Clear</button>
                                            <button type="button" @@click="showDropdown = false" class="text-[9px] font-black text-indigo-600 hover:text-indigo-700 uppercase">Done</button>
                                        </div>
                                    </div>
                                    
                                    <div class="flex items-center justify-center gap-2">
                                        <!-- Hours -->
                                        <div class="flex flex-col items-center">
                                            <button type="button" @@click="incrementHour(true)" class="p-1 hover:bg-slate-50 text-slate-500 rounded"><i data-lucide="chevron-up" class="w-4 h-4"></i></button>
                                            <span class="text-sm font-black text-slate-800 my-1" x-text="getDisplayHour(createTaskTime)"></span>
                                            <button type="button" @@click="decrementHour(true)" class="p-1 hover:bg-slate-50 text-slate-500 rounded"><i data-lucide="chevron-down" class="w-4 h-4"></i></button>
                                        </div>
                                        <span class="text-slate-400 font-bold text-sm">:</span>
                                        <!-- Minutes -->
                                        <div class="flex flex-col items-center">
                                            <button type="button" @@click="incrementMinute(true)" class="p-1 hover:bg-slate-50 text-slate-500 rounded"><i data-lucide="chevron-up" class="w-4 h-4"></i></button>
                                            <span class="text-sm font-black text-slate-800 my-1" x-text="getDisplayMinute(createTaskTime)"></span>
                                            <button type="button" @@click="decrementMinute(true)" class="p-1 hover:bg-slate-50 text-slate-500 rounded"><i data-lucide="chevron-down" class="w-4 h-4"></i></button>
                                        </div>
                                        
                                        <!-- AM / PM Toggle strictly AM/PM -->
                                        <div class="flex flex-col justify-center ml-2 border border-slate-100 rounded-hidden overflow-hidden bg-slate-50">
                                            <button type="button" @@click="setAM(true)" 
                                                    :class="isAM(createTaskTime) ? 'bg-indigo-600 text-white shadow' : 'text-slate-400 hover:text-slate-600'"
                                                    class="px-2 py-1 text-[9px] font-black tracking-wide uppercase transition-all">AM</button>
                                            <button type="button" @@click="setPM(true)" 
                                                    :class="!isAM(createTaskTime) ? 'bg-indigo-600 text-white shadow' : 'text-slate-400 hover:text-slate-600'"
                                                    class="px-2 py-1 text-[9px] font-black tracking-wide uppercase transition-all">PM</button>
                                        </div>
                                    </div>

                                    <!-- Shortcuts -->
                                    <div class="grid grid-cols-2 gap-1 border-t border-slate-100 pt-2 text-[8px] font-bold text-slate-400">
                                        <button type="button" @@click="createTaskTime = '09:00'" class="p-1 bg-slate-50 hover:bg-slate-100 rounded text-center">09:00 AM</button>
                                        <button type="button" @@click="createTaskTime = '12:00'" class="p-1 bg-slate-50 hover:bg-slate-100 rounded text-center">12:00 PM</button>
                                        <button type="button" @@click="createTaskTime = '14:00'" class="p-1 bg-slate-50 hover:bg-slate-100 rounded text-center">02:00 PM</button>
                                        <button type="button" @@click="createTaskTime = '17:00'" class="p-1 bg-slate-50 hover:bg-slate-100 rounded text-center">05:00 PM</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" name="NewTaskDueDate" :value="createTaskDate ? (createTaskTime ? (createTaskDate + 'T' + createTaskTime) : createTaskDate) : ''">
                    </div>
                </div>

                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Category</label>
                    <select asp-for="NewTaskCategoryId" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                        <option value="">No Category</option>
                        @foreach (var cat in Model.WorkspaceCategories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>

                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Assignee</label>
                    <select asp-for="NewTaskAssigneeId" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                        <option value="">Unassigned</option>
                        @foreach (var m in Model.Members)
                        {
                            <option value="@m.UserId">@m.User.FullName</option>
                        }
                    </select>
                </div>

                <button type="submit" class="w-full py-4 mt-2 bg-indigo-600 text-white rounded-2xl font-bold shadow-xl shadow-indigo-100 hover:bg-indigo-700 hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2">
                    Create Workspace Task
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- ════════════════════════════════════════ -->
    <!-- ─── INVITE MEMBER DIALOG MODAL ─── -->
    <!-- ════════════════════════════════════════ -->
    <div x-show="inviteOpen" 
         class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" 
         style="display: none;"
         x-transition>
        
        <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-2xl w-full max-w-sm p-8 relative flex flex-col gap-6"
             @@click.away="inviteOpen = false">
            
            <button @@click="inviteOpen = false" class="absolute top-6 right-6 h-8 w-8 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 transition-all">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <h3 class="text-xl font-black text-slate-800">Invite Workspace Member</h3>

            <form method="post" asp-page-handler="InviteMember" class="space-y-4">
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Invitee Email</label>
                    <input type="email" asp-for="InviteEmail" placeholder="e.g. member@student.edu" required
                           x-model="inviteEmail" @@input.debounce.500ms="checkInviteEmail()"
                           class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                </div>

                <!-- User Found Card -->
                <div x-show="checkingEmail" class="flex items-center gap-2 text-xs font-bold text-slate-400 py-1" x-cloak>
                    <div class="animate-spin h-4 w-4 border-2 border-indigo-600 border-t-transparent rounded-full"></div>
                    <span>Checking user existence...</span>
                </div>

                <div x-show="userFound === true" x-cloak class="p-3.5 bg-indigo-50/50 rounded-2xl border border-indigo-100 flex items-center gap-3">
                    <div class="h-9 w-9 rounded-full bg-indigo-100 border border-indigo-200 flex items-center justify-center overflow-hidden">
                        <template x-if="inviteeAvatar">
                            <img :src="inviteeAvatar" class="h-full w-full object-cover">
                        </template>
                        <template x-if="!inviteeAvatar">
                            <div class="text-[10px] font-black text-indigo-600" x-text="inviteeName.charAt(0)"></div>
                        </template>
                    </div>
                    <div>
                        <div class="text-xs font-black text-slate-800" x-text="inviteeName"></div>
                        <div class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">UniGrid User</div>
                    </div>
                    <span class="ml-auto text-[8px] bg-green-100 text-green-700 px-2 py-0.5 rounded font-black uppercase tracking-wider">Registered</span>
                </div>

                <!-- User Not Found Warning -->
                <div x-show="userFound === false" x-cloak class="p-3.5 bg-amber-50/50 rounded-2xl border border-amber-100 flex gap-2.5 items-start">
                    <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-600 shrink-0 mt-0.5"></i>
                    <div>
                        <div class="text-xs font-black text-amber-800">Email not registered on UniGrid</div>
                        <p class="text-[9px] font-semibold text-slate-500 leading-normal mt-0.5">An invitation will be sent to this email. The new member can click the link in the email or log in with Google to join after registration.</p>
                    </div>
                </div>

                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Workspace Role</label>
                    <select asp-for="InviteRole" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all cursor-pointer">
                        <option value="Member">Member (default)</option>
                        <option value="Vice Manager">Vice Manager</option>
                        <option value="Viewer">Viewer</option>
                    </select>
                </div>

                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Display Role (Title)</label>
                    <input type="text" asp-for="InviteDisplayRole" placeholder="e.g. Tech Lead, BA, HR, ML Specialist"
                           class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                </div>

                <button type="submit" class="w-full py-4 mt-2 bg-indigo-600 text-white rounded-2xl font-bold shadow-xl shadow-indigo-100 hover:bg-indigo-700 hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2">
                    Send Member Invite
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- ════════════════════════════════════════ -->
    <!-- ─── KANBAN STATUS VERIFY MODAL DIALOG ─── -->
    <!-- ════════════════════════════════════════ -->
    <div x-show="confirmKanbanOpen" 
         class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" 
         style="display: none;"
         x-transition>
        
        <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-2xl w-full max-w-md p-8 relative flex flex-col gap-6"
             @@click.away="confirmKanbanOpen = false">
            
            <button @@click="confirmKanbanOpen = false" class="absolute top-6 right-6 h-8 w-8 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 transition-all">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-full bg-amber-50 border border-amber-100 flex items-center justify-center text-amber-600">
                    <i data-lucide="help-circle" class="w-5 h-5"></i>
                </div>
                <h3 class="text-lg font-black text-slate-800">Confirm Status Change</h3>
            </div>

            <div class="text-xs font-bold text-slate-500 space-y-3 leading-relaxed">
                <p>Are you sure you want to change the status of this task?</p>
                <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4 space-y-2">
                    <div>
                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block mb-0.5">Task Title</span>
                        <span class="text-slate-800 text-sm font-black break-words" x-text="pendingKanbanTaskTitle"></span>
                    </div>
                    <div>
                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block mb-0.5">New Status</span>
                        <span class="px-2.5 py-0.5 rounded text-[10px] font-black uppercase bg-indigo-50 text-indigo-600 inline-block mt-0.5" x-text="statusLabel(pendingKanbanStatus)"></span>
                    </div>
                </div>
            </div>

            <div class="flex gap-3">
                <button type="button" 
                        @@click="updateTaskStatus(pendingKanbanTaskId, pendingKanbanStatus); confirmKanbanOpen = false;" 
                        class="flex-1 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl font-bold shadow-md shadow-indigo-100 transition-all flex items-center justify-center gap-1.5">
                    Confirm Move
                </button>
                <button type="button" 
                        @@click="confirmKanbanOpen = false" 
                        class="flex-1 py-3.5 border border-slate-200 hover:bg-slate-50 text-slate-500 rounded-2xl font-bold transition-all">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════ -->
    <!-- ─── LEAVE WORKSPACE CONFIRM DIALOG ───── -->
    <!-- ════════════════════════════════════════ -->
    <div x-show="leaveDialogOpen" 
         class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[100] flex items-center justify-center p-4" 
         style="display: none;"
         x-transition x-cloak>
        
        <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-2xl w-full max-w-md p-8 relative flex flex-col gap-6"
             @@click.away="leaveDialogOpen = false">
            
            <button @@click="leaveDialogOpen = false" class="absolute top-6 right-6 h-8 w-8 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 transition-all">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-full bg-rose-50 border border-rose-100 flex items-center justify-center text-rose-600">
                    <i data-lucide="log-out" class="w-5 h-5"></i>
                </div>
                <h3 class="text-lg font-black text-slate-800">Leave Workspace</h3>
            </div>

            <div class="text-xs font-bold text-slate-500 leading-relaxed">
                <p>Are you sure you want to leave this workspace?</p>
                <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4 mt-3">
                    <span class="text-rose-600 text-[11px] font-black uppercase tracking-wider block mb-1">WARNING</span>
                    <p class="text-slate-655 font-semibold leading-relaxed">If you are the only manager in this workspace, workspace management rights will be automatically transferred to another active member. This action cannot be undone.</p>
                </div>
            </div>

            <div class="flex gap-3">
                <button type="submit" 
                        form="leave-workspace-form"
                        @@click="leaveDialogOpen = false" 
                        class="flex-1 py-3.5 bg-rose-500 hover:bg-rose-650 text-white rounded-2xl font-bold shadow-md shadow-rose-100 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                    Leave Workspace
                </button>
                <button type="button" 
                        @@click="leaveDialogOpen = false" 
                        class="flex-1 py-3.5 border border-slate-200 hover:bg-slate-50 text-slate-500 rounded-2xl font-bold transition-all">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <form id="leave-workspace-form" method="post" asp-page-handler="LeaveWorkspace" asp-route-joinCode="@Model.Workspace.JoinCode">
        @Html.AntiForgeryToken()
    </form>

    <!-- ════════════════════════════════════════ -->
    <!-- ─── CREATE VIRTUAL CHANNEL MODAL DIALOG ─── -->
    <!-- ════════════════════════════════════════ -->
    <div x-show="createChannelOpen" 
         class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" 
         style="display: none;"
         x-transition>
        
        <form @@submit.prevent="createChannel()" class="bg-white rounded-[2.5rem] border border-slate-100 shadow-2xl w-full max-w-sm p-8 relative flex flex-col gap-6"
             @@click.away="createChannelOpen = false">
            
            <button type="button" @@click="createChannelOpen = false" class="absolute top-6 right-6 h-8 w-8 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 transition-all">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600">
                    <i data-lucide="message-square" class="w-5 h-5"></i>
                </div>
                <h3 class="text-lg font-black text-slate-800">Create New Chat Channel</h3>
            </div>

            <div class="space-y-4">
                <div class="space-y-1">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest block">New Channel Name</label>
                    <input type="text" x-model="newChannelName" placeholder="e.g. database-design, tasks"
                           class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                </div>
                <p class="text-[10px] font-bold text-slate-400 leading-normal">New channel will be initialized in Workspace memory. Once you send the first message, the channel will be saved permanently.</p>
            </div>

            <div class="flex gap-3">
                <button type="submit" 
                        class="flex-1 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl font-bold shadow-md shadow-indigo-100 transition-all flex items-center justify-center gap-1.5">
                    Create New Channel
                </button>
                <button type="button" 
                        @@click="createChannelOpen = false" 
                        class="flex-1 py-3.5 border border-slate-200 hover:bg-slate-50 text-slate-500 rounded-2xl font-bold transition-all">
                    Cancel
                </button>
            </div>
        </form>
    </div>

    <!-- ════════════════════════════════════════ -->
    <!-- ─── MANAGE CHANNEL ACCESS MODAL ─── -->
    <!-- ════════════════════════════════════════ -->
    <div x-show="inviteChannelOpen" 
         class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" 
         style="display: none;"
         x-transition x-cloak>
        
        <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-2xl w-full max-w-md p-8 relative flex flex-col gap-6"
             @@click.away="inviteChannelOpen = false">
            
            <button @@click="inviteChannelOpen = false" class="absolute top-6 right-6 h-8 w-8 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>

            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-full bg-amber-50 border border-amber-100 flex items-center justify-center text-amber-600">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-800">Manage Channel Access</h3>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider mt-0.5" x-text="'Channel: #' + activeChannel"></p>
                </div>
            </div>

            <div class="space-y-4">
                <p class="text-[11px] font-bold text-slate-400 leading-normal">
                    Select the workspace members who are allowed to see and chat in this private channel.
                </p>

                <!-- Members List with checkboxes -->
                <div class="border border-slate-100 rounded-2xl p-4 max-h-60 overflow-y-auto space-y-2.5">
                    <template x-for="member in workspaceMembers" :key="member.id">
                        <label class="flex items-center justify-between p-2.5 hover:bg-slate-50 rounded-xl transition-all cursor-pointer select-none">
                            <span class="flex items-center gap-2">
                                <div class="h-7 w-7 rounded-full bg-indigo-50 border border-indigo-150 flex items-center justify-center text-[9px] font-black text-indigo-650"
                                     x-text="member.fullName.split(' ').map(n => n[0]).join('')"></div>
                                <span class="text-xs font-bold text-slate-700" x-text="member.fullName"></span>
                            </span>
                            <input type="checkbox" :value="member.id" x-model="selectedChannelMembers"
                                   class="h-5 w-5 rounded-lg border-slate-350 text-indigo-600 focus:ring-indigo-500 transition-all">
                        </label>
                    </template>
                </div>
            </div>

            <div class="flex gap-3">
                <button type="button" 
                        @@click="saveChannelInvite()"
                        class="flex-1 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl font-bold shadow-md shadow-indigo-100 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                    Save Changes
                </button>
                <button type="button" 
                        @@click="inviteChannelOpen = false" 
                        class="flex-1 py-3.5 border border-slate-200 hover:bg-slate-50 text-slate-500 rounded-2xl font-bold transition-all cursor-pointer">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════ -->
    <!-- ─── ASSIGN KPI DIALOG MODAL ──────────── -->
    <!-- ════════════════════════════════════════ -->
    <div x-show="assignKpiOpen" 
         class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" 
         style="display: none;"
         x-transition x-cloak>
        
        <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-2xl w-full max-w-md p-8 relative flex flex-col gap-6"
             @@click.away="assignKpiOpen = false">
            
            <button @@click="assignKpiOpen = false" class="absolute top-6 right-6 h-8 w-8 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 transition-all">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600">
                    <i data-lucide="bar-chart-3" class="w-5 h-5"></i>
                </div>
                <h3 class="text-lg font-black text-slate-800">Assign KPI Target</h3>
            </div>

            <div class="space-y-4">
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">KPI Category</label>
                    <select x-model="kpiFormCategory" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all cursor-pointer">
                        <template x-for="cat in demoCategories" :key="cat.id">
                            <option :value="cat.id" x-text="cat.name"></option>
                        </template>
                    </select>
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Target Value</label>
                        <input type="number" min="1" x-model.number="kpiFormTarget" placeholder="e.g. 10"
                               class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                    </div>
                    
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Period Type</label>
                        <select x-model="kpiFormPeriod" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all cursor-pointer">
                            <option value="Daily">Daily</option>
                            <option value="Weekly">Weekly</option>
                            <option value="Monthly">Monthly</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Select Members</label>
                        <button type="button" @@click="toggleSelectAllKpiFormMembers()"
                                class="text-[10px] font-black text-indigo-650 hover:text-indigo-700 uppercase tracking-wider">
                            <span x-text="kpiFormMembers.length === workspaceMembers.filter(m => m.id.toLowerCase() !== workspaceOwnerId.toLowerCase() && m.role !== 'Owner').length ? 'Deselect All' : 'Select All'"></span>
                        </button>
                    </div>
                    <div class="space-y-2 max-h-40 overflow-y-auto border border-slate-100 rounded-2xl p-4 bg-slate-50/50">
                        <template x-for="m in workspaceMembers.filter(m => m.id.toLowerCase() !== workspaceOwnerId.toLowerCase() && m.role !== 'Owner')" :key="m.id">
                            <label class="flex items-center gap-2.5 p-1.5 rounded-lg hover:bg-white transition-all cursor-pointer select-none">
                                <input type="checkbox" :value="m.id" x-model="kpiFormMembers"
                                       class="h-5 w-5 rounded-lg border-slate-350 text-indigo-650 focus:ring-indigo-500 transition-all">
                                <span class="text-xs font-bold text-slate-700" x-text="m.fullName + ' (' + m.role + ')'"></span>
                            </label>
                        </template>
                    </div>
                </div>
            </div>

            <div class="flex gap-3">
                <button type="button" @@click="handleAssignKpi()" :disabled="kpiFormMembers.length === 0"
                        class="flex-1 py-3.5 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed text-white rounded-2xl font-bold shadow shadow-indigo-150 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                    Assign KPI Targets
                </button>
                <button type="button" @@click="assignKpiOpen = false" 
                        class="flex-1 py-3.5 border border-slate-200 hover:bg-slate-50 text-slate-500 rounded-2xl font-bold transition-all cursor-pointer">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════ -->
    <!-- ─── MANAGE KPI CATEGORIES DIALOG MODAL ─ -->
    <!-- ════════════════════════════════════════ -->
    <div x-show="manageCategoriesOpen" 
         class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" 
         style="display: none;"
         x-transition x-cloak>
         
        <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-2xl w-full max-w-md p-8 relative flex flex-col gap-6"
             @@click.away="manageCategoriesOpen = false">
            
            <button @@click="manageCategoriesOpen = false" class="absolute top-6 right-6 h-8 w-8 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 transition-all">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-700">
                    <i data-lucide="settings" class="w-5 h-5"></i>
                </div>
                <h3 class="text-lg font-black text-slate-800">Manage Task Categories</h3>
            </div>

            <!-- List Categories -->
            <div class="space-y-3">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest block pb-1 border-b border-slate-100/50">Current Categories</label>
                <div class="space-y-2 max-h-48 overflow-y-auto pr-1">
                    @if (!Model.WorkspaceCategories.Any())
                    {
                        <div class="text-xs text-slate-400 italic p-3">No categories created yet.</div>
                    }
                    @foreach (var cat in Model.WorkspaceCategories)
                    {
                        <div class="flex items-center justify-between p-3 bg-slate-50/50 border border-slate-100 rounded-xl hover:bg-white hover:border-slate-250 transition-all">
                            <div class="flex items-center gap-2">
                                <span style="background-color: @cat.ColorHex" class="h-3 w-3 rounded-full border border-slate-200/55"></span>
                                <span class="text-xs font-black text-slate-700">@cat.Name</span>
                            </div>
                            <form method="post" asp-page-handler="DeleteCategory" asp-route-joinCode="@Model.Workspace.JoinCode" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="categoryId" value="@cat.Id" />
                                <button type="submit" class="text-rose-500 hover:text-rose-650 p-1 rounded-lg hover:bg-rose-50/50 transition-all cursor-pointer">
                                    <i data-lucide="trash" class="w-4 h-4"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>

            <!-- Add New Category Form -->
            <form method="post" asp-page-handler="CreateCategory" asp-route-joinCode="@Model.Workspace.JoinCode" class="space-y-3 pt-2 border-t border-slate-100" x-data="{ newCatName: '', newCatColor: '#3B82F6', colors: ['#3B82F6', '#EC4899', '#10B981', '#F59E0B', '#8B5CF6', '#EF4444', '#14B8A6'] }">
                @Html.AntiForgeryToken()
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest block">Add New Category</label>
                <div class="space-y-3">
                    <div class="space-y-1">
                        <input type="text" name="NewCategoryName" x-model="newCatName" placeholder="e.g., Code Review, Documentation" required
                               class="w-full px-4 py-2.5 bg-slate-50 border border-slate-250 rounded-xl text-xs font-semibold focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                    </div>
                    <div class="space-y-1">
                        <input type="hidden" name="NewCategoryColorHex" :value="newCatColor" />
                        <label class="text-[10px] font-bold text-slate-400">Select Color Theme</label>
                        <div class="flex gap-2.5 pt-1">
                            <template x-for="color in colors" :key="color">
                                <button type="button" @@click="newCatColor = color"
                                        :style="'background-color: ' + color"
                                        :class="newCatColor === color ? 'ring-2 ring-offset-2 ring-indigo-500 scale-110' : 'opacity-80 hover:opacity-100 hover:scale-105'"
                                        class="h-6 w-6 rounded-full border border-white/20 transition-all shadow-sm cursor-pointer"></button>
                            </template>
                        </div>
                    </div>
                    <button type="submit" 
                            :disabled="!newCatName.trim()"
                            class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white rounded-xl text-xs font-black shadow-sm transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                        <i data-lucide="plus" class="w-4 h-4"></i> Add Category
                    </button>
                </div>
            </form>

            <div class="flex justify-end pt-2 border-t border-slate-100">
                <button type="button" @@click="manageCategoriesOpen = false" 
                        class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-black transition-all cursor-pointer">
                    Done
                </button>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        function initAlpineWorkspaceDetail() {
            Alpine.data('workspaceDetail', () => ({
                activeTab: (() => {
                    const savedTab = localStorage.getItem('unigrid_workspace_tab_' + '@Model.Workspace.JoinCode') || 'dashboard';
                    const isPersonal = '@(isPersonalWs)' === 'True';
                    if (isPersonal && (savedTab === 'chat' || savedTab === 'members')) {
                        return 'dashboard';
                    }
                    const isKpiEnabled = '@(packageTier == "Business" || Model.Workspace.FederationId != null)' === 'True';
                    if (!isKpiEnabled && savedTab === 'kpi') {
                        return 'dashboard';
                    }
                    return savedTab;
                })(),
                hoveredSegment: '',
                hoveredMemberIndex: null,
                hoveredMemberText: '',
                hoveredMemberAssigned: 0,
                hoveredMemberCompleted: 0,
                hoveredRateIndex: null,
                hoveredRateName: '',
                hoveredRatePercent: 0,
                searchQuery: sessionStorage.getItem('unigrid_kanban_searchQuery_' + '@Model.Workspace.JoinCode') || '',
                filterPriority: sessionStorage.getItem('unigrid_kanban_filterPriority_' + '@Model.Workspace.JoinCode') || '',
                filterAssignee: sessionStorage.getItem('unigrid_kanban_filterAssignee_' + '@Model.Workspace.JoinCode') || '',
                filterDate: '@Model.DateFilter',
                calendarOpen: false,
                calendarYear: new Date().getFullYear(),
                calendarMonth: new Date().getMonth(),
                calendarDays: [],
                initCalendar() {
                    const initialDate = this.filterDate ? new Date(this.filterDate) : new Date();
                    if (!isNaN(initialDate.getTime())) {
                        this.calendarYear = initialDate.getFullYear();
                        this.calendarMonth = initialDate.getMonth();
                    }
                    this.generateCalendarDays();
                },
                generateCalendarDays() {
                    const year = this.calendarYear;
                    const month = this.calendarMonth;
                    const firstDayIndex = new Date(year, month, 1).getDay();
                    const lastDay = new Date(year, month + 1, 0).getDate();
                    const prevLastDay = new Date(year, month, 0).getDate();
                    const days = [];
                    for (let x = firstDayIndex; x > 0; x--) {
                        days.push({ day: prevLastDay - x + 1, month: month === 0 ? 11 : month - 1, year: month === 0 ? year - 1 : year, isCurrentMonth: false });
                    }
                    for (let i = 1; i <= lastDay; i++) {
                        days.push({ day: i, month: month, year: year, isCurrentMonth: true });
                    }
                    const totalDays = days.length;
                    const nextDays = 42 - totalDays;
                    for (let j = 1; j <= nextDays; j++) {
                        days.push({ day: j, month: month === 11 ? 0 : month + 1, year: month === 11 ? year + 1 : year, isCurrentMonth: false });
                    }
                    this.calendarDays = days;
                },
                prevMonth() {
                    if (this.calendarMonth === 0) { this.calendarMonth = 11; this.calendarYear--; }
                    else { this.calendarMonth--; }
                    this.generateCalendarDays();
                },
                nextMonth() {
                    if (this.calendarMonth === 11) { this.calendarMonth = 0; this.calendarYear++; }
                    else { this.calendarMonth++; }
                    this.generateCalendarDays();
                },
                selectDay(dayObj) {
                    const y = dayObj.year;
                    const m = (dayObj.month + 1).toString().padStart(2, '0');
                    const d = dayObj.day.toString().padStart(2, '0');
                    this.filterDate = `${y}-${m}-${d}`;
                    this.calendarOpen = false;
                },
                getMonthName(m) {
                    return ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'][m];
                },
                detailOpen: false,
                isEditing: false,
                createOpen: false,
                inviteOpen: false,
                inviteEmail: '',
                checkingEmail: false,
                userFound: null,
                inviteeName: '',
                inviteeAvatar: '',
                previewFile: null,
                renameOpen: false,
                renameFileId: null,
                renameFileName: '',
                selectedCommentFileName: '',
                selectedTask: { taskComments: [] },
                createTaskDate: '',
                createTaskTime: '09:00',
                timeSlots: [],
                createTaskStatus: 0,
                activeFileSection: 'files',
                viewMode: 'grid',
                newCommentContent: '',
                newChatContent: '',
                draggedTaskId: null,
                draggedTaskTitle: '',
                confirmKanbanOpen: false,
                pendingKanbanTaskId: null,
                pendingKanbanStatus: null,
                currentUserRole: '@Model.CurrentUserRole',
                currentUserId: '@Model.CurrentUser.Id',
                workspaceOwnerId: '@Model.Workspace.OwnerId',

                pendingKanbanTaskTitle: '',
                leaveDialogOpen: false,

                // Rich Discord-like chat state
                activeChannel: localStorage.getItem('unigrid_active_channel_' + '@Model.Workspace.JoinCode') || 'general',
                chatInput: '',
                channels: [],
                newChannelName: '',
                createChannelOpen: false,
                attachFileOpen: false,
                selectedAttachmentId: null,
                selectedAttachmentName: '',
                // Initial rules states from database Workspace.SettingsJson
                initialLockedChannels: @Html.Raw(Model.GetLockedChannelsJson()),
                initialChannelOwners: @Html.Raw(Model.GetChannelOwnersJson()),
                initialChannelModerators: @Html.Raw(Model.GetChannelModeratorsJson()),
                initialDisabledCreateChannelUsers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Members.Where(m => !Model.IsMemberAllowed(m.UserId, "disabledCreateChannelUsers", m.Role)).Select(m => m.UserId.ToString().ToLower()).ToList())),
                initialDisabledCreateTaskUsers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Members.Where(m => !Model.IsMemberAllowed(m.UserId, "disabledCreateTaskUsers", m.Role)).Select(m => m.UserId.ToString().ToLower()).ToList())),
                initialDisabledEditTaskUsers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Members.Where(m => !Model.IsMemberAllowed(m.UserId, "disabledEditTaskUsers", m.Role)).Select(m => m.UserId.ToString().ToLower()).ToList())),
                initialDisabledDeleteFileUsers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Members.Where(m => !Model.IsMemberAllowed(m.UserId, "disabledDeleteFileUsers", m.Role)).Select(m => m.UserId.ToString().ToLower()).ToList())),
                initialDisabledDeleteTaskUsers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Members.Where(m => !Model.IsMemberAllowed(m.UserId, "disabledDeleteTaskUsers", m.Role)).Select(m => m.UserId.ToString().ToLower()).ToList())),
                initialChannels: @Html.Raw(Model.GetChannelsJson()),

                lockedChannels: {},
                channelOwners: {},
                channelModerators: {},
                disabledCreateChannelUsers: [],
                disabledCreateTaskUsers: [],
                disabledEditTaskUsers: [],
                disabledDeleteFileUsers: [],
                disabledDeleteTaskUsers: [],
                selectedChannelMembers: [],
                selectedChannelMods: [],
                tempChannelOwner: '',
                inviteChannelOpen: false,

                // Bootstrap data sets serialized from C# models
                chatMessages: JSON.parse(atob('@Model.SerializeChatMessagesBase64()')),
                workspaceMembers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Members.Select(m => new { id = m.UserId.ToString(), fullName = m.User.FullName, role = m.Role }).ToList())),
                workspaceTasks: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WorkspaceTasks.Select(t => new { 
                    id = t.Id.ToString(), 
                    title = t.Title, 
                    status = t.Status,
                    assigneeId = t.AssigneeId.HasValue ? t.AssigneeId.Value.ToString().ToLower() : null,
                    categoryId = t.CategoryId.HasValue ? t.CategoryId.Value.ToString() : null,
                    dueDate = t.DueDate.HasValue ? t.DueDate.Value.ToString("yyyy-MM-dd") : null,
                    isCounterTask = t.IsCounterTask,
                    targetCount = t.TargetCount,
                    currentCount = t.CurrentCount
                }).ToList())),
                workspaceFiles: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Files.Select(f => new { id = f.Id.ToString(), fileName = f.FileName, fileUrl = f.FileUrl, fileSize = f.FileSize, fileType = f.FileType }).ToList())),

                // KPI States & Handlers
                kpiTargets: [],
                kpiRequests: [],
                assignKpiOpen: false,
                manageCategoriesOpen: false,
                kpiFormCategory: 'cat-1',
                kpiFormTarget: 10,
                kpiFormPeriod: 'Weekly',
                kpiFormMembers: [],
                selectedKpiPeriodFilter: 'Weekly',
                selectedKpiTimeframe: 'current',
                selectedKpiCategoryFilter: 'all',
                demoCategories: [
                    { id: 'cat-1', name: 'Development', color: '#3B82F6' },
                    { id: 'cat-2', name: 'Design', color: '#EC4899' },
                    { id: 'cat-3', name: 'DevOps', color: '#10B981' },
                    { id: 'cat-4', name: 'Content/Doc', color: '#F59E0B' },
                ],
                saveKpiState() {
                    const wsCode = '@Model.Workspace.JoinCode';
                    localStorage.setItem('unigrid_kpi_targets_' + wsCode, JSON.stringify(this.kpiTargets));
                    localStorage.setItem('unigrid_kpi_requests_' + wsCode, JSON.stringify(this.kpiRequests));
                    localStorage.setItem('unigrid_kpi_categories_' + wsCode, JSON.stringify(this.demoCategories));
                },
                getMemberKpiMetrics(memberId, periodFilter, timeframe, categoryFilter = 'all') {
                    const targets = this.kpiTargets.filter(t => t.userId === memberId && (categoryFilter === 'all' || t.categoryId === categoryFilter));
                    let targetSum = 0;
                    let achievedSum = 0;

                    targets.forEach(t => {
                        const val = (timeframe === 'previous') ? (t.prevAchievedValue !== undefined ? t.prevAchievedValue : Math.round(t.targetValue * 0.7)) : t.achievedValue;
                        if (periodFilter === 'Daily') {
                            if (t.periodType === 'Daily') {
                                targetSum += t.targetValue;
                                achievedSum += val;
                            }
                        } else if (periodFilter === 'Weekly') {
                            if (t.periodType === 'Weekly' || t.periodType === 'Daily') {
                                targetSum += t.targetValue;
                                achievedSum += val;
                            }
                        } else if (periodFilter === 'Monthly') {
                            if (t.periodType === 'Monthly' || t.periodType === 'Weekly' || t.periodType === 'Daily') {
                                targetSum += t.targetValue;
                                achievedSum += val;
                            }
                        }
                    });

                    const rate = targetSum > 0 ? Math.round((achievedSum * 100) / targetSum) : 0;
                    return { targetSum, achievedSum, rate };
                },
                getMemberConversionMetrics(memberId, periodFilter, timeframe, categoryFilter = 'all') {
                    const tasks = this.workspaceTasks.filter(t => {
                        const matchesAssignee = t.assigneeId === memberId.toLowerCase();
                        let matchesCategory = true;
                        
                        // Map local storage demoCategories (cat-1, cat-2 etc) to task category names/indices if possible
                        // Or if categoryFilter is 'all', matches is true.
                        // Let's do a smart match: if categoryFilter !== 'all', let's see if the category matches.
                        if (categoryFilter !== 'all') {
                            const catObj = this.demoCategories.find(c => c.id === categoryFilter);
                            if (catObj && t.categoryId) {
                                // Real task categories in workspace models are GUIDs. But we can map by Name!
                                // Let's check: if there is a category in Model.WorkspaceCategories that has the same name as the demo category name,
                                // we can match by that C# Category's Id.
                                // Let's find the matching GUID category from C#
                                const dbCats = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WorkspaceCategories.Select(c => new { id = c.Id.ToString(), name = c.Name }).ToList()));
                                const dbCat = dbCats.find(c => c.name.toLowerCase() === catObj.name.toLowerCase());
                                if (dbCat) {
                                    matchesCategory = t.categoryId.toLowerCase() === dbCat.id.toLowerCase();
                                } else {
                                    // Fallback: match by prefix/suffix or index
                                    matchesCategory = false;
                                }
                            } else {
                                matchesCategory = false;
                            }
                        }
                        
                        let matchesPeriod = true;
                        if (t.dueDate) {
                            const taskDate = new Date(t.dueDate);
                            let startDate, endDate;
                            if (periodFilter === 'Daily') {
                                const target = new Date();
                                if (timeframe === 'previous') target.setDate(target.getDate() - 1);
                                startDate = new Date(target.setHours(0,0,0,0));
                                endDate = new Date(target.setHours(23,59,59,999));
                            } else if (periodFilter === 'Weekly') {
                                const target = new Date();
                                if (timeframe === 'previous') target.setDate(target.getDate() - 7);
                                const diff = (7 + (target.getDay() - 1)) % 7;
                                startDate = new Date(target.setDate(target.getDate() - diff));
                                startDate.setHours(0,0,0,0);
                                endDate = new Date(startDate.getTime());
                                endDate.setDate(endDate.getDate() + 7);
                                endDate.setHours(23,59,59,999);
                            } else { // Monthly
                                const target = new Date();
                                if (timeframe === 'previous') target.setMonth(target.getMonth() - 1);
                                startDate = new Date(target.getFullYear(), target.getMonth(), 1);
                                endDate = new Date(target.getFullYear(), target.getMonth() + 1, 0, 23, 59, 59, 999);
                            }
                            matchesPeriod = (taskDate >= startDate && taskDate <= endDate);
                        }
                        
                        return matchesAssignee && matchesCategory && matchesPeriod;
                    });

                    const totalTasks = tasks.length;
                    const completedTasks = tasks.filter(t => t.status === 3).length;
                    const taskCompletionRate = totalTasks > 0 ? Math.round((completedTasks * 100) / totalTasks) : 0;

                    const kpi = this.getMemberKpiMetrics(memberId, periodFilter, timeframe, categoryFilter);
                    
                    const efficiency = completedTasks > 0 ? Math.round((kpi.achievedSum * 10) / completedTasks) / 10 : 0.0;

                    let advice = "No tasks assigned in this timeframe.";
                    if (totalTasks > 0) {
                        if (taskCompletionRate >= 70 && kpi.rate >= 70) {
                            advice = "Excellent alignment! Tasks completed directly converted to KPI success.";
                        } else if (taskCompletionRate >= 70 && kpi.rate < 40) {
                            advice = "High completion rate, but low KPI contribution. Focus on higher-impact tasks.";
                        } else if (taskCompletionRate < 45 && kpi.rate >= 70) {
                            advice = "High efficiency! Achieved targets despite low task volume.";
                        } else {
                            advice = "Productivity gap. Align task execution with defined KPI metrics.";
                        }
                    }

                    return {
                        totalTasks,
                        completedTasks,
                        taskCompletionRate,
                        kpiTarget: kpi.targetSum,
                        kpiAchieved: kpi.achievedSum,
                        kpiAchievementRate: kpi.rate,
                        efficiency,
                        advice
                    };
                },
                initKpiData() {
                    const wsCode = '@Model.Workspace.JoinCode';
                    const savedTargets = localStorage.getItem('unigrid_kpi_targets_' + wsCode);
                    const savedRequests = localStorage.getItem('unigrid_kpi_requests_' + wsCode);
                    const savedCategories = localStorage.getItem('unigrid_kpi_categories_' + wsCode);

                    if (savedCategories) {
                        try {
                            this.demoCategories = JSON.parse(savedCategories);
                        } catch(e) {}
                    }
                    
                    let needReseed = true;
                    if (savedTargets) {
                        try {
                            const parsed = JSON.parse(savedTargets);
                            if (parsed.length > 0 && parsed.some(t => t.periodType === 'Daily')) {
                                this.kpiTargets = parsed;
                                needReseed = false;
                            }
                        } catch(e) {}
                    }

                    if (needReseed) {
                        const assignable = this.workspaceMembers.filter(m => m.id.toLowerCase() !== this.workspaceOwnerId.toLowerCase() && m.role !== 'Owner');
                        if (assignable.length >= 2) {
                            const m1 = assignable[0];
                            const m2 = assignable[1];
                            this.kpiTargets = [
                                { id: 'kt-1', userId: m1.id, userName: m1.fullName, categoryId: 'cat-1', targetValue: 10, achievedValue: 6, periodType: 'Weekly' },
                                { id: 'kt-2', userId: m1.id, userName: m1.fullName, categoryId: 'cat-3', targetValue: 5, achievedValue: 3, periodType: 'Weekly' },
                                { id: 'kt-daily-1', userId: m1.id, userName: m1.fullName, categoryId: 'cat-2', targetValue: 1, achievedValue: 1, periodType: 'Daily' },
                                { id: 'kt-monthly-1', userId: m1.id, userName: m1.fullName, categoryId: 'cat-4', targetValue: 2, achievedValue: 1, periodType: 'Monthly' },
                                { id: 'kt-3', userId: m2.id, userName: m2.fullName, categoryId: 'cat-1', targetValue: 5, achievedValue: 4, periodType: 'Weekly' },
                                { id: 'kt-4', userId: m2.id, userName: m2.fullName, categoryId: 'cat-2', targetValue: 8, achievedValue: 5, periodType: 'Weekly' },
                                { id: 'kt-daily-2', userId: m2.id, userName: m2.fullName, categoryId: 'cat-2', targetValue: 1, achievedValue: 1, periodType: 'Daily' }
                            ];
                            if (assignable.length >= 3) {
                                const m3 = assignable[2];
                                this.kpiTargets.push(
                                    { id: 'kt-5', userId: m3.id, userName: m3.fullName, categoryId: 'cat-4', targetValue: 12, achievedValue: 8, periodType: 'Weekly' },
                                    { id: 'kt-daily-3', userId: m3.id, userName: m3.fullName, categoryId: 'cat-1', targetValue: 2, achievedValue: 2, periodType: 'Daily' }
                                );
                            }
                        } else {
                            this.kpiTargets = [];
                        }
                    }

                    if (savedRequests) {
                        try {
                            this.kpiRequests = JSON.parse(savedRequests);
                        } catch(e) {}
                    } else {
                        const assignable = this.workspaceMembers.filter(m => m.id.toLowerCase() !== this.workspaceOwnerId.toLowerCase() && m.role !== 'Owner');
                        if (assignable.length >= 1) {
                            const m1 = assignable[0];
                            this.kpiRequests = [
                                { id: 'kr-1', userId: m1.id, userName: m1.fullName, categoryId: 'cat-1', periodType: 'Weekly', requestType: 'increment', incrementValue: 2, timestamp: '10 mins ago', status: 'pending' }
                            ];
                        } else {
                            this.kpiRequests = [];
                        }
                    }

                    this.saveKpiState();

                    if (this.demoCategories.length > 0) {
                        this.kpiFormCategory = this.demoCategories[0].id;
                    }
                },
                handleAssignKpi() {
                    if (this.kpiFormMembers.length === 0) return;
                    this.kpiFormMembers.forEach(memberId => {
                        const member = this.workspaceMembers.find(m => m.id === memberId);
                        if (!member) return;
                        const existingIdx = this.kpiTargets.findIndex(t => t.userId === memberId && t.categoryId === this.kpiFormCategory && t.periodType === this.kpiFormPeriod);
                        if (existingIdx !== -1) {
                            this.kpiTargets[existingIdx].targetValue = this.kpiFormTarget;
                        } else {
                            this.kpiTargets.push({
                                id: 'kt-' + Date.now() + '-' + Math.random(),
                                userId: memberId,
                                userName: member.fullName,
                                categoryId: this.kpiFormCategory,
                                targetValue: this.kpiFormTarget,
                                achievedValue: 0,
                                periodType: this.kpiFormPeriod
                            });
                        }
                    });
                    this.assignKpiOpen = false;
                    this.kpiFormMembers = [];
                    this.saveKpiState();
                },
                toggleSelectAllKpiFormMembers() {
                    const assignable = this.workspaceMembers.filter(m => m.id.toLowerCase() !== this.workspaceOwnerId.toLowerCase() && m.role !== 'Owner').map(m => m.id);
                    if (this.kpiFormMembers.length === assignable.length) {
                        this.kpiFormMembers = [];
                    } else {
                        this.kpiFormMembers = [...assignable];
                    }
                },
                handleRequestKpiUpdate(userId, categoryId, periodType, type, incrementValue) {
                    const member = this.workspaceMembers.find(m => m.id === userId);
                    if (!member) return;
                    const existing = this.kpiRequests.find(r => r.userId === userId && r.categoryId === categoryId && r.periodType === periodType && r.status === 'pending');
                    if (existing) return;
                    const val = incrementValue || 1;
                    this.kpiRequests.push({
                        id: 'kr-' + Date.now(),
                        userId: userId,
                        userName: member.fullName,
                        categoryId: categoryId,
                        periodType: periodType,
                        requestType: type,
                        incrementValue: val,
                        timestamp: 'Just now',
                        status: 'pending'
                    });
                    this.saveKpiState();
                },
                handleApproveKpi(reqId) {
                    const req = this.kpiRequests.find(r => r.id === reqId);
                    if (!req) return;
                    const targetIdx = this.kpiTargets.findIndex(t => t.userId === req.userId && t.categoryId === req.categoryId && t.periodType === req.periodType);
                    if (targetIdx !== -1) {
                        const target = this.kpiTargets[targetIdx];
                        if (req.requestType === 'increment') {
                            target.achievedValue = Math.min(target.targetValue, target.achievedValue + (req.incrementValue || 1));
                        } else if (req.requestType === 'complete') {
                            target.achievedValue = target.targetValue;
                        }
                    }
                    this.kpiRequests = this.kpiRequests.filter(r => r.id !== reqId);
                    this.saveKpiState();
                },
                handleRejectKpi(reqId) {
                    this.kpiRequests = this.kpiRequests.filter(r => r.id !== reqId);
                    this.saveKpiState();
                },

                get canCurrentUserCreateChannel() {
                    const isOwnerOrManager = this.currentUserRole === 'Owner' || this.currentUserRole === 'Manager';
                    if (isOwnerOrManager) return true;
                    if (this.currentUserRole === 'Viewer') return false;
                    if (!this.disabledCreateChannelUsers) return true;
                    return !this.disabledCreateChannelUsers.map(id => id.toLowerCase()).includes(this.currentUserId.toLowerCase());
                },

                get currentUserCanDeleteFile() {
                    const isOwnerOrManager = this.currentUserRole === 'Owner' || this.currentUserRole === 'Manager';
                    if (isOwnerOrManager) return true;
                    if (this.currentUserRole === 'Viewer') return false;
                    if (!this.disabledDeleteFileUsers) return true;
                    return !this.disabledDeleteFileUsers.map(id => id.toLowerCase()).includes(this.currentUserId.toLowerCase());
                },

                get currentUserCanCreateTask() {
                    const isOwnerOrManager = this.currentUserRole === 'Owner' || this.currentUserRole === 'Manager';
                    if (isOwnerOrManager) return true;
                    if (this.currentUserRole === 'Viewer') return false;
                    if (!this.disabledCreateTaskUsers) return true;
                    return !this.disabledCreateTaskUsers.map(id => id.toLowerCase()).includes(this.currentUserId.toLowerCase());
                },

                get currentUserCanEditTask() {
                    const isOwnerOrManager = this.currentUserRole === 'Owner' || this.currentUserRole === 'Manager';
                    if (isOwnerOrManager) return true;
                    if (this.currentUserRole === 'Viewer') return false;
                    if (!this.disabledEditTaskUsers) return true;
                    return !this.disabledEditTaskUsers.map(id => id.toLowerCase()).includes(this.currentUserId.toLowerCase());
                },

                get currentUserCanDeleteTask() {
                    const isOwnerOrManager = this.currentUserRole === 'Owner' || this.currentUserRole === 'Manager';
                    if (isOwnerOrManager) return true;
                    if (this.currentUserRole === 'Viewer') return false;
                    if (!this.disabledDeleteTaskUsers) return true;
                    return !this.disabledDeleteTaskUsers.map(id => id.toLowerCase()).includes(this.currentUserId.toLowerCase());
                },

                statusLabel(status) {
                    if (status === 0) return 'To Do';
                    if (status === 1) return 'In Progress';
                    if (status === 2) return 'Review';
                    if (status === 3) return 'Done';
                    return 'Unknown';
                },

                updateTaskStatus(taskId, newStatus) {
                    fetch(`/api/tasks/${taskId}/status`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ status: newStatus })
                    })
                    .then(async res => {
                        if (res.ok) {
                            window.location.reload();
                        } else {
                            const data = await res.json().catch(() => ({}));
                            alert(data.message || 'Could not update task status. Please check your permissions.');
                            window.location.reload();
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        alert('An error occurred while connecting to the server.');
                        window.location.reload();
                    });
                },

                async checkInviteEmail() {
                    const email = this.inviteEmail.trim();
                    if (!email || !email.includes('@@')) {
                        this.userFound = null;
                        this.inviteeName = "";
                        this.inviteeAvatar = "";
                        return;
                    }
                    this.checkingEmail = true;
                    try {
                        const res = await fetch(`/api/notifications/search-by-email?email=${encodeURIComponent(email)}`);
                        if (res.ok) {
                            const data = await res.json();
                            if (data.exists) {
                                this.userFound = true;
                                this.inviteeName = data.fullName;
                                this.inviteeAvatar = data.avatarUrl;
                            } else {
                                this.userFound = false;
                                this.inviteeName = "";
                                this.inviteeAvatar = "";
                            }
                        } else {
                            this.userFound = false;
                        }
                    } catch (err) {
                        console.error(err);
                        this.userFound = false;
                    } finally {
                        this.checkingEmail = false;
                    }
                    this.$nextTick(() => {
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    });
                },

                scrollChatToBottom() {
                    this.$nextTick(() => {
                        const el = document.getElementById('chat-messages-container');
                        if (el) el.scrollTop = el.scrollHeight;
                    });
                },

                get visibleChannels() {
                    return this.channels.filter(chan => {
                        if (chan === 'general') return true;
                        if (!this.lockedChannels[chan] || this.lockedChannels[chan].length === 0) return true;
                        
                        const isOwnerOrManager = this.currentUserRole === 'Owner' || this.currentUserRole === 'Manager';
                        if (isOwnerOrManager) return true;
                        
                        return this.lockedChannels[chan].includes(this.currentUserId);
                    });
                },

                get filteredMessages() {
                    return this.chatMessages
                        .filter(msg => msg.channel === this.activeChannel && !msg.rawContent.startsWith('[system:'))
                        .map(msg => {
                            let attachment = null;
                            const fileRegex = /\[file:([a-f0-9-]{36})\]/i;
                            const match = msg.rawContent.match(fileRegex);
                            if (match) {
                                const fileId = match[1];
                                attachment = this.workspaceFiles.find(f => f.id === fileId);
                            }
                            return { ...msg, attachment };
                        });
                },

                parseSystemRules() {
                    this.lockedChannels = JSON.parse(JSON.stringify(this.initialLockedChannels || {}));
                    this.channelOwners = JSON.parse(JSON.stringify(this.initialChannelOwners || {}));
                    this.channelModerators = JSON.parse(JSON.stringify(this.initialChannelModerators || {}));
                    this.disabledCreateChannelUsers = [...(this.initialDisabledCreateChannelUsers || [])];
                    this.disabledCreateTaskUsers = [...(this.initialDisabledCreateTaskUsers || [])];
                    this.disabledEditTaskUsers = [...(this.initialDisabledEditTaskUsers || [])];
                    this.disabledDeleteFileUsers = [...(this.initialDisabledDeleteFileUsers || [])];
                    this.disabledDeleteTaskUsers = [...(this.initialDisabledDeleteTaskUsers || [])];
                    let parsedChannels = [...(this.initialChannels || ['general'])];

                    const sorted = [...this.chatMessages].sort((a, b) => new Date(a.sentAt) - new Date(b.sentAt));
                    sorted.forEach(msg => {
                        if (msg.rawContent && msg.rawContent.startsWith('[system:channel_rules]')) {
                            try {
                                const jsonStr = msg.rawContent.substring('[system:channel_rules]'.length);
                                const payload = JSON.parse(jsonStr);
                                if (payload) {
                                    if (payload.lockedChannels) {
                                        this.lockedChannels = payload.lockedChannels;
                                    }
                                    if (payload.channelOwners) {
                                        this.channelOwners = payload.channelOwners;
                                    }
                                    if (payload.channelModerators) {
                                        this.channelModerators = payload.channelModerators;
                                    }
                                    if (payload.disabledCreateChannelUsers) {
                                        this.disabledCreateChannelUsers = payload.disabledCreateChannelUsers;
                                    }
                                    if (payload.disabledCreateTaskUsers) {
                                        this.disabledCreateTaskUsers = payload.disabledCreateTaskUsers;
                                    }
                                    if (payload.disabledEditTaskUsers) {
                                        this.disabledEditTaskUsers = payload.disabledEditTaskUsers;
                                    }
                                    if (payload.disabledDeleteFileUsers) {
                                        this.disabledDeleteFileUsers = payload.disabledDeleteFileUsers;
                                    }
                                    if (payload.disabledDeleteTaskUsers) {
                                        this.disabledDeleteTaskUsers = payload.disabledDeleteTaskUsers;
                                    }
                                    if (payload.allChannels) {
                                        parsedChannels = payload.allChannels;
                                    }
                                }
                            } catch (e) {
                                console.error("Failed to parse system channel rules:", e);
                            }
                        }
                    });
                    this.channels = parsedChannels;
                    if (!this.visibleChannels.includes(this.activeChannel)) {
                        this.activeChannel = 'general';
                    }
                },

                toggleChannelLock() {
                    if (this.lockedChannels[this.activeChannel]) {
                        delete this.lockedChannels[this.activeChannel];
                    } else {
                        this.lockedChannels[this.activeChannel] = [this.currentUserId];
                    }
                    this.saveChannelRules();
                },

                canManageChannelRules() {
                    if (this.activeChannel === 'general') return false;
                    return this.currentUserRole === 'Owner' || 
                           this.currentUserRole === 'Manager' || 
                           (this.channelOwners[this.activeChannel] && this.channelOwners[this.activeChannel].toLowerCase() === this.currentUserId.toLowerCase());
                },

                canManageChannelAccess() {
                    if (this.activeChannel === 'general') return false;
                    if (this.canManageChannelRules()) return true;
                    const mods = this.channelModerators[this.activeChannel] || [];
                    return mods.map(id => id.toLowerCase()).includes(this.currentUserId.toLowerCase());
                },

                openChannelInvite() {
                    this.selectedChannelMembers = this.lockedChannels[this.activeChannel] ? [...this.lockedChannels[this.activeChannel]] : [this.currentUserId];
                    if (!this.channelModerators) this.channelModerators = {};
                    this.selectedChannelMods = this.channelModerators[this.activeChannel] ? [...this.channelModerators[this.activeChannel]] : [];
                    this.tempChannelOwner = this.channelOwners[this.activeChannel] || this.currentUserId;
                    this.inviteChannelOpen = true;
                },

                saveChannelInvite() {
                    const cleanList = this.selectedChannelMembers.map(id => id.toString().toLowerCase());
                    if (this.workspaceOwnerId && !cleanList.includes(this.workspaceOwnerId.toLowerCase())) {
                        this.selectedChannelMembers.push(this.workspaceOwnerId.toLowerCase());
                    }
                    if (this.tempChannelOwner && !cleanList.includes(this.tempChannelOwner.toLowerCase())) {
                        this.selectedChannelMembers.push(this.tempChannelOwner.toLowerCase());
                    }
                    this.lockedChannels[this.activeChannel] = [...this.selectedChannelMembers].map(id => id.toString().toLowerCase());
                    
                    // Save mods
                    if (!this.channelModerators) this.channelModerators = {};
                    this.channelModerators[this.activeChannel] = this.selectedChannelMods.map(id => id.toString().toLowerCase());
                    
                    // Save owner
                    if (this.tempChannelOwner) {
                        this.channelOwners[this.activeChannel] = this.tempChannelOwner.toLowerCase();
                    }
                    
                    this.inviteChannelOpen = false;
                    this.saveChannelRules();
                },

                saveChannelRules() {
                    const payload = '[system:channel_rules]' + JSON.stringify({ 
                        lockedChannels: this.lockedChannels,
                        channelOwners: this.channelOwners,
                        channelModerators: this.channelModerators,
                        allChannels: this.channels,
                        disabledCreateChannelUsers: this.disabledCreateChannelUsers || [],
                        disabledCreateTaskUsers: this.disabledCreateTaskUsers || [],
                        disabledEditTaskUsers: this.disabledEditTaskUsers || [],
                        disabledDeleteFileUsers: this.disabledDeleteFileUsers || [],
                        disabledDeleteTaskUsers: this.disabledDeleteTaskUsers || []
                    });
                    const formData = new FormData();
                    formData.append('ChatContent', payload);
                    formData.append('activeChannel', 'general');

                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (tokenInput) {
                        formData.append('__RequestVerificationToken', tokenInput.value);
                    }

                    const joinCode = '@Model.Workspace.JoinCode';

                    return fetch(`/WorkspaceDetail/${joinCode}?handler=SendChatMessage`, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(async res => {
                        if (!res.ok) {
                            console.error('Failed to save channel rules.');
                        }
                    })
                    .catch(err => {
                        console.error('Error saving channel rules:', err);
                    });
                },

                deleteTask(taskId) {
                    if (!confirm('Are you sure you want to permanently delete this task? This will remove all personal calendar events associated with it, delete all task comments, and cannot be undone.')) {
                        return;
                    }

                    const formData = new FormData();
                    formData.append('taskId', taskId);

                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (tokenInput) {
                        formData.append('__RequestVerificationToken', tokenInput.value);
                    }

                    const joinCode = '@Model.Workspace.JoinCode';

                    fetch(`/WorkspaceDetail/${joinCode}?handler=DeleteTask`, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(async res => {
                        if (res.ok) {
                            this.detailOpen = false;
                            this.workspaceTasks = this.workspaceTasks.filter(t => t.id !== taskId);
                        } else {
                            const errData = await res.json().catch(() => ({}));
                            alert(errData.message || 'Failed to delete task.');
                        }
                    })
                    .catch(err => {
                        console.error('Error deleting task:', err);
                        alert('An error occurred while deleting task.');
                    });
                },

                deleteMessage(messageId) {
                    if (!confirm('Are you sure you want to revoke this message? This cannot be undone.')) {
                        return;
                    }

                    const formData = new FormData();
                    formData.append('messageId', messageId);

                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (tokenInput) {
                        formData.append('__RequestVerificationToken', tokenInput.value);
                    }

                    const joinCode = '@Model.Workspace.JoinCode';

                    fetch(`/WorkspaceDetail/${joinCode}?handler=DeleteChatMessage`, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(async res => {
                        if (res.ok) {
                            const index = this.chatMessages.findIndex(m => m.id === messageId);
                            if (index !== -1) {
                                this.chatMessages[index].rawContent = '[deleted_message]';
                                this.chatMessages[index].content = '[deleted_message]';
                            }
                        } else {
                            const errData = await res.json().catch(() => ({}));
                            alert(errData.message || 'Failed to revoke message.');
                        }
                    })
                    .catch(err => {
                        console.error('Error revoking message:', err);
                        alert('An error occurred while revoking message.');
                    });
                },

                createChannel() {
                    const clean = this.newChannelName.trim().toLowerCase().replace(/[^a-z0-9-_]/g, '-');
                    if (clean) {
                        if (!this.channels.includes(clean)) {
                            this.channels.push(clean);
                            this.channelOwners[clean] = this.currentUserId;
                            this.saveChannelRules().catch(err => {
                                console.error('Failed to persist channel rules to database:', err);
                            });
                        }
                        this.activeChannel = clean;
                        this.createChannelOpen = false;
                        this.newChannelName = '';
                        localStorage.setItem('unigrid_active_channel_' + '@Model.Workspace.JoinCode', clean);
                        this.$nextTick(() => {
                            this.scrollChatToBottom();
                        });
                    } else {
                        this.createChannelOpen = false;
                    }
                },

                uploadFileDirectly(event) {
                    const file = event.target.files[0];
                    if (!file) return;

                    const formData = new FormData();
                    formData.append('UploadedFile', file);

                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (tokenInput) {
                        formData.append('__RequestVerificationToken', tokenInput.value);
                    }

                    const joinCode = '@Model.Workspace.JoinCode';

                    fetch(`/WorkspaceDetail/${joinCode}?handler=UploadFile`, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(async res => {
                        if (res.ok) {
                            const data = await res.json();
                            if (data && data.success && data.file) {
                                this.workspaceFiles.unshift(data.file);
                                this.selectedAttachmentId = data.file.id;
                                this.selectedAttachmentName = data.file.fileName;
                                this.attachFileOpen = false;
                            }
                        } else {
                            const errData = await res.json().catch(() => ({}));
                            alert(errData.message || 'File upload failed. Ensure the file is not too large and the name is valid.');
                        }
                        event.target.value = '';
                    })
                    .catch(err => {
                        console.error('Error uploading file directly:', err);
                        alert('An error occurred during upload.');
                        event.target.value = '';
                    });
                },

                handleCommentFileChange(event) {
                    const file = event.target.files[0];
                    if (!file) return;

                    const maxSize = 10 * 1024 * 1024;
                    if (file.size > maxSize) {
                        alert("File size exceeds the 10 MB limit. Please select a smaller file.");
                        event.target.value = '';
                        this.selectedCommentFileName = '';
                        return;
                    }

                    this.selectedCommentFileName = file.name;
                },
                clearCommentFile() {
                    const input = document.getElementById('task-comment-file-input');
                    if (input) input.value = '';
                    this.selectedCommentFileName = '';
                },
                getCommentAttachment(content) {
                    if (!content) return null;
                    const fileRegex = /\[file:([a-f0-9-]{36})\]/i;
                    const match = content.match(fileRegex);
                    if (match) {
                        const fileId = match[1];
                        return this.workspaceFiles.find(f => f.id === fileId);
                    }
                    return null;
                },
                parseCommentContent(content) {
                    if (!content) return '';
                    let text = content.replace(/\[file:[a-f0-9-]{36}\]/gi, '').trim();
                    if (!text) return '<span class="italic text-slate-400 text-xs inline-flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg> Shared document</span>';
                    
                    let html = text
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;');
                    
                    return html;
                },

                parseMessageContent(content) {
                    if (content && content.startsWith('[deleted_message]')) {
                        return '<span class="italic text-slate-400 text-xs inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg> Message revoked</span>';
                    }
                    let text = content.replace(/\[file:[a-f0-9-]{36}\]/gi, '').trim();
                    if (!text) return '<span class="italic text-slate-400 text-xs inline-flex items-center gap-1"><i data-lucide="file-text" class="w-4 h-4"></i> Shared document</span>';

                    let html = text
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#039;');

                    // 1. Parse Member Name mentions
                    this.workspaceMembers.forEach(m => {
                        const escapeName = m.fullName.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
                        const regex = new RegExp('@@' + escapeName, 'g');
                        html = html.replace(regex, `<span class="px-1.5 py-0.5 rounded-md bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-extrabold text-[10px] inline-flex items-center gap-0.5 select-all"><i data-lucide="at-sign" class="w-3 h-3"></i>` + m.fullName + `</span>`);
                    });

                    // 2. Parse #Task Title mentions
                    this.workspaceTasks.forEach(t => {
                        const escapeTitle = t.title.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
                        const regex = new RegExp('#' + escapeTitle, 'g');
                        html = html.replace(regex, `<span class="px-1.5 py-0.5 rounded-md bg-amber-50 text-amber-600 dark:bg-amber-950/30 dark:text-amber-400 font-extrabold text-[10px] inline-flex items-center gap-0.5 cursor-pointer hover:bg-amber-100 dark:hover:bg-amber-900/20 transition-all select-all" onclick="window.dispatchEvent(new CustomEvent('open-task-detail', {detail: '` + t.id + `'}))"><i data-lucide="hash" class="w-3 h-3"></i>` + t.title + `</span>`);
                    });

                    setTimeout(() => { if (typeof lucide !== 'undefined') lucide.createIcons(); }, 50);
                    return html;
                },

                formatTime(dateStr) {
                    if (!dateStr) return '';
                    const d = new Date(dateStr);
                    return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
                },

                formatTimeDisplay(timeStr) {
                    if (!timeStr) return 'No Time';
                    const parts = timeStr.split(':');
                    let h = parseInt(parts[0]);
                    let m = parts[1];
                    let suffix = h >= 12 ? 'PM' : 'AM';
                    let displayHour = h % 12 === 0 ? 12 : h % 12;
                    return `${displayHour.toString().padStart(2, '0')}:${m} ${suffix}`;
                },

                getDisplayHour(timeStr) {
                    if (!timeStr) return '09';
                    const parts = timeStr.split(':');
                    let h = parseInt(parts[0]) % 12;
                    if (h === 0) h = 12;
                    return h.toString().padStart(2, '0');
                },

                getDisplayMinute(timeStr) {
                    if (!timeStr) return '00';
                    const parts = timeStr.split(':');
                    return parts[1];
                },

                isAM(timeStr) {
                    if (!timeStr) return true;
                    const parts = timeStr.split(':');
                    let h = parseInt(parts[0]);
                    return h < 12;
                },

                incrementHour(isCreate) {
                    let cur = isCreate ? this.createTaskTime : this.selectedTask.dueDateTime;
                    if (!cur) cur = '09:00';
                    const parts = cur.split(':');
                    let h = (parseInt(parts[0]) + 1) % 24;
                    let newTime = `${h.toString().padStart(2, '0')}:${parts[1]}`;
                    if (isCreate) this.createTaskTime = newTime;
                    else this.selectedTask.dueDateTime = newTime;
                },

                decrementHour(isCreate) {
                    let cur = isCreate ? this.createTaskTime : this.selectedTask.dueDateTime;
                    if (!cur) cur = '09:00';
                    const parts = cur.split(':');
                    let h = (parseInt(parts[0]) - 1 + 24) % 24;
                    let newTime = `${h.toString().padStart(2, '0')}:${parts[1]}`;
                    if (isCreate) this.createTaskTime = newTime;
                    else this.selectedTask.dueDateTime = newTime;
                },

                incrementMinute(isCreate) {
                    let cur = isCreate ? this.createTaskTime : this.selectedTask.dueDateTime;
                    if (!cur) cur = '09:00';
                    const parts = cur.split(':');
                    let m = (parseInt(parts[1]) + 1) % 60;
                    let newTime = `${parts[0]}:${m.toString().padStart(2, '0')}`;
                    if (isCreate) this.createTaskTime = newTime;
                    else this.selectedTask.dueDateTime = newTime;
                },

                decrementMinute(isCreate) {
                    let cur = isCreate ? this.createTaskTime : this.selectedTask.dueDateTime;
                    if (!cur) cur = '09:00';
                    const parts = cur.split(':');
                    let m = (parseInt(parts[1]) - 1 + 60) % 60;
                    let newTime = `${parts[0]}:${m.toString().padStart(2, '0')}`;
                    if (isCreate) this.createTaskTime = newTime;
                    else this.selectedTask.dueDateTime = newTime;
                },

                setAM(isCreate) {
                    let cur = isCreate ? this.createTaskTime : this.selectedTask.dueDateTime;
                    if (!cur) cur = '09:00';
                    const parts = cur.split(':');
                    let h = parseInt(parts[0]);
                    if (h >= 12) h -= 12;
                    let newTime = `${h.toString().padStart(2, '0')}:${parts[1]}`;
                    if (isCreate) this.createTaskTime = newTime;
                    else this.selectedTask.dueDateTime = newTime;
                },

                setPM(isCreate) {
                    let cur = isCreate ? this.createTaskTime : this.selectedTask.dueDateTime;
                    if (!cur) cur = '09:00';
                    const parts = cur.split(':');
                    let h = parseInt(parts[0]);
                    if (h < 12) h += 12;
                    let newTime = `${h.toString().padStart(2, '0')}:${parts[1]}`;
                    if (isCreate) this.createTaskTime = newTime;
                    else this.selectedTask.dueDateTime = newTime;
                },

                get showSuggestions() {
                    if (!this.chatInput) return null;
                    const words = this.chatInput.split(' ');
                    const lastWord = words[words.length - 1];
                    if (lastWord.startsWith('@@')) {
                        return { type: '@@', query: lastWord.substring(1).toLowerCase() };
                    }
                    if (lastWord.startsWith('#')) {
                        return { type: '#', query: lastWord.substring(1).toLowerCase() };
                    }
                    return null;
                },

                get showCommentSuggestions() {
                    if (!this.newCommentContent) return null;
                    const words = this.newCommentContent.split(' ');
                    const lastWord = words[words.length - 1];
                    if (lastWord.startsWith('@@')) {
                        return { type: '@@', query: lastWord.substring(1).toLowerCase() };
                    }
                    if (lastWord.startsWith('#')) {
                        return { type: '#', query: lastWord.substring(1).toLowerCase() };
                    }
                    return null;
                },

                get filteredMembers() {
                    const sug = this.showSuggestions;
                    if (!sug || sug.type !== '@@') return [];
                    return this.workspaceMembers.filter(m => m.fullName.toLowerCase().includes(sug.query));
                },

                get filteredCommentMembers() {
                    const sug = this.showCommentSuggestions;
                    if (!sug || sug.type !== '@@') return [];
                    return this.workspaceMembers.filter(m => m.fullName.toLowerCase().includes(sug.query));
                },

                get filteredTasks() {
                    const sug = this.showSuggestions;
                    if (!sug || sug.type !== '#') return [];
                    return this.workspaceTasks.filter(t => t.title.toLowerCase().includes(sug.query));
                },

                get filteredCommentTasks() {
                    const sug = this.showCommentSuggestions;
                    if (!sug || sug.type !== '#') return [];
                    return this.workspaceTasks.filter(t => t.title.toLowerCase().includes(sug.query));
                },

                insertSuggestion(suggestionText) {
                    const words = this.chatInput.split(' ');
                    words[words.length - 1] = suggestionText + ' ';
                    this.chatInput = words.join(' ');
                    this.$nextTick(() => {
                        const el = document.getElementById('chat-input-field');
                        if (el) el.focus();
                    });
                },

                insertCommentSuggestion(suggestionText) {
                    const words = this.newCommentContent.split(' ');
                    words[words.length - 1] = suggestionText + ' ';
                    this.newCommentContent = words.join(' ');
                    this.$nextTick(() => {
                        const el = document.getElementById('task-comment-field');
                        if (el) el.focus();
                    });
                },

                generateTimeSlots() {
                    let slots = [];
                    for (let slot = 0; slot < 34; slot++) {
                        let h = 7 + Math.floor(slot / 2);
                        let m = slot % 2 === 0 ? '00' : '30';
                        let suffix = h >= 12 ? 'PM' : 'AM';
                        let displayHour = h % 12 === 0 ? 12 : h % 12;
                        let label = displayHour.toString().padStart(2, '0') + ':' + m + ' ' + suffix;
                        let value = h.toString().padStart(2, '0') + ':' + m;
                        slots.push({ value: value, label: label });
                    }
                    return slots;
                },

                openCreateModal(status) {
                    this.createTaskStatus = status;
                    let d = new Date();
                    let year = d.getFullYear();
                    let month = (d.getMonth() + 1).toString().padStart(2, '0');
                    let date = d.getDate().toString().padStart(2, '0');
                    this.createTaskDate = `${year}-${month}-${date}`;
                    
                    this.createTaskTime = '';
                    
                    this.createOpen = true;
                },

                selectTask(taskJsonBase64) {
                    this.selectedCommentFileName = '';
                    const commentInput = document.getElementById('task-comment-file-input');
                    if (commentInput) commentInput.value = '';
                    let task = JSON.parse(atob(taskJsonBase64));
                    this.selectedTask = task;
                    if (task) {
                        task.assigneeId = task.assignee ? task.assignee.id : '';
                        if (task.dueDate) {
                            let d = new Date(task.dueDate);
                            
                            // If time is exactly midnight 12:00 AM (00:00:00), normalize it to 23:50 (11:50 PM)
                            // so that all tasks without a set time display consistently as 11:50 PM in the detail modal.
                            if (d.getHours() === 0 && d.getMinutes() === 0 && d.getSeconds() === 0) {
                                d.setHours(23);
                                d.setMinutes(50);
                                let year = d.getFullYear();
                                let month = (d.getMonth() + 1).toString().padStart(2, '0');
                                let date = d.getDate().toString().padStart(2, '0');
                                task.dueDate = `${year}-${month}-${date}T23:50:00`;
                            }

                            let year = d.getFullYear();
                            let month = (d.getMonth() + 1).toString().padStart(2, '0');
                            let date = d.getDate().toString().padStart(2, '0');
                            task.dueDateDate = `${year}-${month}-${date}`;
                            
                            let hours = d.getHours();
                            let minutes = d.getMinutes();
                            if ((hours === 0 && minutes === 0) || (hours === 23 && minutes === 50) || (hours === 23 && minutes === 59)) {
                                task.dueDateTime = '';
                            } else {
                                let hoursStr = hours.toString().padStart(2, '0');
                                let minutesStr = minutes.toString().padStart(2, '0');
                                let minNum = parseInt(minutesStr);
                                if (minNum >= 45) {
                                    let hNum = parseInt(hoursStr) + 1;
                                    hoursStr = hNum.toString().padStart(2, '0');
                                    minutesStr = '00';
                                } else if (minNum >= 15) {
                                    minutesStr = '30';
                                } else {
                                    minutesStr = '00';
                                }
                                task.dueDateTime = `${hoursStr}:${minutesStr}`;
                            }
                        } else {
                            task.dueDateDate = '';
                            task.dueDateTime = '';
                        }
                    }
                    this.isEditing = false;
                    this.detailOpen = true;
                    this.$nextTick(() => {
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    });
                },

                sendChatMessageViaAjax() {
                    if (!this.chatInput.trim() && !this.selectedAttachmentId) return;

                    const formData = new FormData();
                    formData.append('ChatContent', this.chatInput);
                    formData.append('activeChannel', this.activeChannel);
                    if (this.selectedAttachmentId) {
                        formData.append('selectedFileId', this.selectedAttachmentId);
                    }

                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (tokenInput) {
                        formData.append('__RequestVerificationToken', tokenInput.value);
                    }

                    const joinCode = '@Model.Workspace.JoinCode';

                    fetch(`/WorkspaceDetail/${joinCode}?handler=SendChatMessage`, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(async res => {
                        if (res.ok) {
                            this.chatInput = '';
                            this.selectedAttachmentId = null;
                            this.selectedAttachmentName = '';
                        } else {
                            console.error('Failed to send chat message.');
                        }
                    })
                    .catch(err => {
                        console.error('Error sending chat message:', err);
                    });
                },

                sendTaskCommentViaAjax() {
                    const fileInput = document.getElementById('task-comment-file-input');
                    const hasFile = fileInput && fileInput.files.length > 0;
                    if (!this.newCommentContent.trim() && !hasFile) return;

                    const formData = new FormData();
                    formData.append('CommentContent', this.newCommentContent);
                    formData.append('commentTaskId', this.selectedTask.id);
                    if (hasFile) {
                        formData.append('CommentFile', fileInput.files[0]);
                    }

                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (tokenInput) {
                        formData.append('__RequestVerificationToken', tokenInput.value);
                    }

                    const joinCode = '@Model.Workspace.JoinCode';
                    const content = this.newCommentContent;
                    this.newCommentContent = '';
                    this.clearCommentFile();

                    fetch(`/WorkspaceDetail/${joinCode}?handler=AddTaskComment`, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(async res => {
                        if (res.ok) {
                            const data = await res.json();
                            if (data && data.id) {
                                if (data.uploadedFile) {
                                    if (!this.workspaceFiles.some(f => f.id === data.uploadedFile.id)) {
                                        this.workspaceFiles.unshift(data.uploadedFile);
                                    }
                                }
                                if (!this.selectedTask.taskComments) this.selectedTask.taskComments = [];
                                if (!this.selectedTask.taskComments.some(c => c.id === data.id)) {
                                    this.selectedTask.taskComments.push({
                                        id: data.id,
                                        content: data.content,
                                        createdAt: data.createdAt,
                                        user: { fullName: data.userName }
                                    });
                                    this.$nextTick(() => {
                                        const commentsContainer = document.querySelector('.max-h-\\[220px\\].overflow-y-auto');
                                        if (commentsContainer) {
                                            commentsContainer.scrollTop = commentsContainer.scrollHeight;
                                        }
                                    });
                                }
                            }
                        } else {
                            const errData = await res.json().catch(() => ({}));
                            alert(errData.message || 'Failed to post task comment.');
                            this.newCommentContent = content; // restore on error
                        }
                    })
                    .catch(err => {
                        console.error('Error posting task comment:', err);
                        this.newCommentContent = content;
                    });
                },

                init() {
                    this.timeSlots = this.generateTimeSlots();
                    this.scrollChatToBottom();
                    this.parseSystemRules();
                    this.initKpiData();
                    this.initCalendar();
                    this.$watch('globalSearchQuery', value => this.searchQuery = value);
                    this.$watch('searchQuery', value => {
                        sessionStorage.setItem('unigrid_kanban_searchQuery_' + '@Model.Workspace.JoinCode', value);
                    });
                    this.$watch('filterPriority', value => {
                        sessionStorage.setItem('unigrid_kanban_filterPriority_' + '@Model.Workspace.JoinCode', value);
                    });
                    this.$watch('filterAssignee', value => {
                        sessionStorage.setItem('unigrid_kanban_filterAssignee_' + '@Model.Workspace.JoinCode', value);
                    });
                    this.$watch('filterDate', value => {
                        if (value !== '@Model.DateFilter') {
                            const joinCode = '@Model.Workspace.JoinCode';
                            window.location.href = value ? `/WorkspaceDetail/${joinCode}?DateFilter=${value}` : `/WorkspaceDetail/${joinCode}`;
                        }
                    });
                    this.$watch('activeTab', value => {
                        localStorage.setItem('unigrid_workspace_tab_' + '@Model.Workspace.JoinCode', value);
                        if (value === 'chat') this.scrollChatToBottom();
                    });
                    this.$watch('activeChannel', value => {
                        localStorage.setItem('unigrid_active_channel_' + '@Model.Workspace.JoinCode', value);
                        this.scrollChatToBottom();
                    });
                    // Initialize SignalR Connection
                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl("/chatHub")
                        .withAutomaticReconnect()
                        .build();

                    connection.on("ReceiveChatMessage", (payload) => {
                        console.log("SignalR Chat Msg:", payload);
                        if (!this.chatMessages.some(m => m.id === payload.id)) {
                            this.chatMessages.push(payload);
                            if (payload.rawContent && payload.rawContent.startsWith('[system:channel_rules]')) {
                                this.parseSystemRules();
                            } else {
                                if (this.activeTab === 'chat' && this.activeChannel === payload.channel) {
                                    this.scrollChatToBottom();
                                }
                            }
                        }
                    });

                    connection.on("ReceiveTaskDeletion", (payload) => {
                        console.log("SignalR Task Deletion:", payload);
                        this.workspaceTasks = this.workspaceTasks.filter(t => t.id !== payload.taskId);
                        if (this.selectedTask && this.selectedTask.id === payload.taskId) {
                            this.detailOpen = false;
                        }
                    });

                    connection.on("ReceiveMessageDeletion", (payload) => {
                        console.log("SignalR Msg Deletion:", payload);
                        const index = this.chatMessages.findIndex(m => m.id === payload.messageId);
                        if (index !== -1) {
                            this.chatMessages[index].rawContent = '[deleted_message]';
                            this.chatMessages[index].content = '[deleted_message]';
                        }
                    });

                    connection.on("ReceiveTaskComment", (payload) => {
                        console.log("SignalR Comment:", payload);
                        
                        // 1. Update comments count badge on Kanban card in real-time
                        const badge = document.getElementById(`task-comments-badge-${payload.taskId}`);
                        const countSpan = document.getElementById(`task-comments-count-${payload.taskId}`);
                        if (countSpan) {
                            if (!this.countedCommentIds) this.countedCommentIds = [];
                            if (!this.countedCommentIds.includes(payload.id)) {
                                this.countedCommentIds.push(payload.id);
                                let count = parseInt(countSpan.innerText) || 0;
                                countSpan.innerText = count + 1;
                                if (badge) badge.style.display = '';
                            }
                        }

                        // 2. Update comments inside active modal
                        if (this.selectedTask && this.selectedTask.id === payload.taskId) {
                            if (!this.selectedTask.taskComments) this.selectedTask.taskComments = [];
                            if (!this.selectedTask.taskComments.some(c => c.id === payload.id)) {
                                if (payload.uploadedFile) {
                                    if (!this.workspaceFiles.some(f => f.id === payload.uploadedFile.id)) {
                                        this.workspaceFiles.unshift(payload.uploadedFile);
                                    }
                                }
                                this.selectedTask.taskComments.push({
                                    id: payload.id,
                                    content: payload.content,
                                    createdAt: payload.createdAt,
                                    user: { fullName: payload.userName }
                                });
                                
                                this.$nextTick(() => {
                                    const commentsContainer = document.querySelector('.max-h-\\[220px\\].overflow-y-auto');
                                    if (commentsContainer) {
                                        commentsContainer.scrollTop = commentsContainer.scrollHeight;
                                    }
                                });
                            }
                        }
                    });

                    connection.start()
                        .then(() => {
                            console.log("SignalR connected!");
                            connection.invoke("JoinWorkspace", "@Model.Workspace.Id.ToString()")
                                .catch(err => console.error("Error joining workspace group:", err));
                        })
                        .catch(err => console.error("SignalR Connection Error: ", err));

                    this.signalrConnection = connection;
                }
            }));
        }

        if (window.Alpine) {
            initAlpineWorkspaceDetail();
        } else {
            document.addEventListener('alpine:init', initAlpineWorkspaceDetail);
        }
    </script>
</div>

