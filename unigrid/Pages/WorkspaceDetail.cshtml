                                                      <div>Mo</div>
                                                      <div>Tu</div>
                                                      <div>We</div>
                                                      <div>Th</div>
                                                      <div>Fr</div>
                                                      <div>Sa</div>
                                                  </div>
                                                  
                                                  <!-- Days Grid -->
                                                  <div class="grid grid-cols-7 gap-1 text-center">
