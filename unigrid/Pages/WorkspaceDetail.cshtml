                                                                  class="h-7 w-7 rounded-lg text-xs font-semibold flex items-center justify-center transition-all cursor-pointer"
                                                                  :class="
                                                                      filterDate === `${dayObj.year}-${(dayObj.month+1).toString().padStart(2,'0')}-${dayObj.day.toString().padStart(2,'0')}`
                                                                          ? 'bg-indigo-600 text-white font-black shadow-md shadow-indigo-150' 
                                                                          : (dayObj.isCurrentMonth ? 'text-slate-700 hover:bg-indigo-50 hover:text-indigo-650' : 'text-slate-300 hover:bg-slate-50')
                                                                  "
