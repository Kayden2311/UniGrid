@page
@model unigrid.Pages.SignupModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "_Layout";
}

<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center bg-slate-50/50 p-6">
    <div class="w-full max-w-[440px] glass p-10 rounded-[3rem] shadow-2xl border border-white/50 relative overflow-hidden">
        <!-- Decoration -->
        <div class="absolute -right-10 -top-10 h-32 w-32 bg-indigo-500/5 rounded-full blur-3xl"></div>
        
        <div class="text-center mb-8">
            <img src="/assets/official-logo-256.png" alt="UniGrid Logo" class="h-14 w-14 rounded-2xl object-contain shadow-xl shadow-indigo-100 mx-auto mb-6" />
            <h2 class="text-3xl font-black text-slate-800 tracking-tight">Create your account</h2>
            <p class="text-slate-500 mt-2 text-sm font-medium">Start managing your team projects effectively.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-6 p-4 bg-rose-50 border border-rose-100 rounded-2xl flex items-center gap-3 text-rose-600 animate-shake">
                <i data-lucide="alert-circle" class="w-5 h-5"></i>
                <p class="text-sm font-bold">@Model.ErrorMessage</p>
            </div>
        }

        <form method="post" asp-page="/Signup" class="space-y-5">
            <input type="hidden" asp-for="Tier" />
            <div class="space-y-1.5">
                <label class="text-xs font-bold text-slate-400 uppercase tracking-widest ml-1">Full Name</label>
                <div class="relative">
                    <i data-lucide="user" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                    <input asp-for="FullName" type="text" placeholder="John Doe" required
                           class="w-full pl-12 pr-4 py-3.5 bg-white/50 border border-slate-200 rounded-2xl outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all font-medium">
                </div>
            </div>

            <div class="space-y-1.5">
                <label class="text-xs font-bold text-slate-400 uppercase tracking-widest ml-1">Email Address</label>
                <div class="relative">
                    <i data-lucide="mail" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                    <input asp-for="Email" type="email" placeholder="you@university.edu" required
                           class="w-full pl-12 pr-4 py-3.5 bg-white/50 border border-slate-200 rounded-2xl outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all font-medium">
                </div>
            </div>

            <div class="space-y-1.5">
                <label class="text-xs font-bold text-slate-400 uppercase tracking-widest ml-1">Password</label>
                <div class="relative">
                    <i data-lucide="lock" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                    <input asp-for="Password" type="password" placeholder="At least 8 characters" required
                           class="w-full pl-12 pr-4 py-3.5 bg-white/50 border border-slate-200 rounded-2xl outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all font-medium">
                </div>
            </div>

            <button type="submit" class="w-full py-4 mt-2 bg-indigo-600 text-white rounded-2xl font-bold shadow-xl shadow-indigo-100 hover:bg-indigo-700 hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2">
                Create Account
                <i data-lucide="arrow-right" class="w-5 h-5"></i>
            </button>
        </form>

        <div class="relative flex items-center justify-center my-6">
            <div class="border-t border-slate-200 w-full"></div>
            <span class="absolute px-3 bg-white text-[10px] font-bold text-slate-400 uppercase tracking-widest">Or continue with</span>
        </div>

        <a href="/api/auth/google-login" 
           class="w-full py-3.5 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 active:scale-[0.99] rounded-2xl font-bold shadow-sm transition-all flex items-center justify-center gap-3 no-underline">
            <svg class="h-5 w-5" viewBox="0 0 24 24">
                <path fill="#EA4335" d="M12 5.04c1.62 0 3.08.56 4.22 1.65l3.15-3.15C17.45 1.71 14.93 1 12 1 7.37 1 3.4 3.63 1.45 7.45l3.79 2.93C6.18 7.33 8.87 5.04 12 5.04z" />
                <path fill="#4285F4" d="M23.49 12.27c0-.81-.07-1.59-.2-2.36H12v4.47h6.44c-.28 1.47-1.11 2.71-2.36 3.55l3.67 2.84c2.15-1.98 3.39-4.9 3.39-8.5z" />
                <path fill="#FBBC05" d="M5.24 14.62c-.24-.73-.38-1.5-.38-2.31s.14-1.58.38-2.31L1.45 7.07C.52 8.94 0 11.02 0 13.23s.52 4.29 1.45 6.16l3.79-2.93z" />
                <path fill="#34A853" d="M12 23c3.24 0 5.96-1.08 7.95-2.93l-3.67-2.84c-1.02.68-2.33 1.09-3.8 1.09-3.13 0-5.82-2.29-6.77-5.34L.92 15.92C2.87 19.74 6.84 23 12 23z" />
            </svg>
            <span class="text-sm">Sign up with Google</span>
        </a>

        <p class="text-center text-[11px] text-slate-400 mt-6 leading-relaxed">
            By signing up, you agree to our <span class="font-semibold text-slate-500 hover:underline cursor-pointer">Terms of Service</span> and <span class="font-semibold text-slate-500 hover:underline cursor-pointer">Privacy Policy</span>.
        </p>

        <div class="mt-6 text-center pt-6 border-t border-slate-100">
            <p class="text-sm text-slate-500 font-medium">
                Already have an account? 
                <a href="/Login" class="text-indigo-600 font-bold hover:underline">Log in</a>
            </p>
        </div>
    </div>
</div>
