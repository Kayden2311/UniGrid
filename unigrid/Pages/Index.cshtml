@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<div class="relative overflow-hidden min-h-[calc(100vh-4rem)] flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8 bg-white">
    <!-- Background Decor -->
    <div class="absolute top-0 right-0 -mt-20 -mr-20 w-[500px] h-[500px] bg-indigo-50 rounded-full blur-[100px] opacity-50"></div>
    <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-[400px] h-[400px] bg-violet-50 rounded-full blur-[80px] opacity-50"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative">
        <!-- Text Content -->
        <div class="space-y-8 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-50 text-emerald-600 rounded-full border border-emerald-100">
                <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-xs font-bold uppercase tracking-wider">Built for students & small teams</span>
            </div>
            
            <h1 class="text-5xl lg:text-7xl font-black text-slate-900 leading-[1.1] tracking-tight">
                Manage teamwork <br />
                <span class="bg-gradient-to-r from-indigo-600 to-indigo-500 bg-clip-text text-transparent italic">clearly & efficiently</span>
            </h1>

            <p class="text-lg text-slate-500 max-w-lg mx-auto lg:mx-0 leading-relaxed">
                UniGrid brings all your tasks, deadlines, files and discussions into one place. 
                Assign clearly, track progress, and never lose sight of what matters.
            </p>

            <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start pt-4">
                <a asp-page="/Workspaces" class="group relative px-8 py-4 bg-indigo-600 text-white rounded-2xl font-bold shadow-xl shadow-indigo-200 hover:bg-indigo-700 transition-all flex items-center gap-2 overflow-hidden">
                    <span class="relative z-10">Create a free workspace</span>
                    <i data-lucide="arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform relative z-10"></i>
                    <div class="absolute inset-0 bg-gradient-to-r from-indigo-500 to-violet-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                </a>
                <button class="px-8 py-4 bg-slate-100 text-slate-700 rounded-2xl font-bold hover:bg-slate-200 transition-all">
                    I have an account
                </button>
            </div>
        </div>

        <!-- Image Mockup -->
        <div class="relative group">
            <div class="absolute inset-0 bg-indigo-500/10 rounded-[3rem] blur-3xl group-hover:blur-[120px] transition-all duration-700"></div>
            <div class="relative glass rounded-[3rem] p-4 shadow-2xl border border-white/40 overflow-hidden transform group-hover:-translate-y-2 transition-transform duration-500">
                <img src="/assets/hero-dashboard.png" alt="UniGrid Dashboard" class="rounded-[2rem] shadow-lg w-full" onerror="this.src='/placeholder.svg'">
                
                <!-- Floating Element -->
                <div class="absolute bottom-10 left-10 glass p-4 rounded-2xl shadow-xl flex items-center gap-3 animate-bounce">
                    <div class="h-8 w-8 bg-emerald-500 rounded-full flex items-center justify-center text-white">
                        <i data-lucide="check" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-800">3 tasks completed today</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
