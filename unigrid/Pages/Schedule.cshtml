@page
@model unigrid.Pages.ScheduleModel
@{
    ViewData["Title"] = "Schedule";
    
    var serializerSettings = new System.Text.Json.JsonSerializerOptions 
    { 
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase 
    };
    var jsonEvents = System.Text.Json.JsonSerializer.Serialize(Model.PersonalEvents.Select(e => new {
        id = e.Id,
        title = e.Title,
        description = e.Description ?? "",
        startTime = e.StartTime.ToString("yyyy-MM-ddTHH:mm:ssZ"),
        endTime = e.EndTime.ToString("yyyy-MM-ddTHH:mm:ssZ")
    }), serializerSettings);

    var jsonTasks = System.Text.Json.JsonSerializer.Serialize(Model.WorkspaceTasks.Select(t => new {
        id = t.Id,
        title = t.Title,
        workspaceName = t.Workspace?.Name ?? "Workspace",
        dueDate = t.DueDate?.ToString("yyyy-MM-ddTHH:mm:ssZ"),
        priority = t.Priority == 3 ? "high" : (t.Priority == 2 ? "medium" : "low")
    }), serializerSettings);
}

<link rel="stylesheet" href="~/css/schedule.css" asp-append-version="true" />
<div class="space-y-4" x-data="scheduleComponent()">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-display text-2xl font-bold text-slate-800">Schedule</h1>
            <p class="text-sm text-slate-500">Plan your week — drag to create, pick & slide personal events, resize from edges</p>
        </div>
        <div class="flex items-center gap-2">
            <button @@click="weekOffset--" class="px-3 py-1.5 border border-slate-200 text-slate-600 hover:bg-slate-50 rounded-lg text-xs font-semibold flex items-center gap-1 transition-colors">
                <i data-lucide="chevron-left" class="w-3.5 h-3.5 mr-0.5"></i> Prev
            </button>
            <span class="text-sm font-semibold min-w-[140px] text-center text-slate-700" x-text="weekLabel"></span>
            <button @@click="weekOffset++" class="px-3 py-1.5 border border-slate-200 text-slate-600 hover:bg-slate-50 rounded-lg text-xs font-semibold flex items-center gap-1 transition-colors">
                Next <i data-lucide="chevron-right" class="w-3.5 h-3.5 ml-0.5"></i>
            </button>
            <button @@click="weekOffset = 0" class="px-3 py-1.5 text-slate-400 hover:text-slate-600 rounded-lg text-xs font-semibold transition-colors">
                Today
            </button>
        </div>
    </div>

    <!-- How to use Guidelines Card -->
    <div class="border border-indigo-100 bg-indigo-50/15 rounded-xl p-4 flex items-start gap-3 shadow-sm">
        <i data-lucide="info" class="w-5 h-5 text-indigo-500 shrink-0 mt-0.5"></i>
        <div class="text-xs text-slate-500 space-y-1">
            <p><strong class="text-slate-700">Create:</strong> Click & drag on empty grid slots (drag up or down).</p>
            <p><strong class="text-slate-700">Move:</strong> Click and drag the event card to any day or time slot.</p>
            <p><strong class="text-slate-700">Resize:</strong> Drag the top or bottom edge of an event block to change duration.</p>
            <p><strong class="text-slate-700">Edit/Delete/Copy:</strong> Click on an event to open the edit dialog.</p>
        </div>
    </div>

    <!-- Antiforgery Input Token for AJAX Posts -->
    @Html.AntiForgeryToken()

    <!-- Main Grid and Widget Panel -->
    <div class="flex gap-4">
        
        <!-- Left Side: Interactive Calendar Sheet -->
        <div class="flex-1 overflow-auto rounded-xl border border-slate-200 bg-white shadow-sm">
            <div style="min-width: 800px;">
                <!-- Day Headers -->
                <div class="sticky top-0 z-10 border-b border-slate-200 bg-white"
                     style="display: grid; grid-template-columns: 64px repeat(7, 1fr);">
                    <div class="border-r border-slate-200"></div>
                    @for (int idx = 0; idx < 7; idx++)
                    {
                        var dayName = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" }[idx];
                        <div class="px-2 py-3 text-center border-r border-slate-200 last:border-r-0">
                            <span class="text-xs font-medium text-slate-400 block">@dayName</span>
                            <span class="inline-flex items-center justify-center h-8 w-8 rounded-full text-base mt-1" 
                                  :class="isToday(@idx) ? 'today-badge-active' : 'today-badge-inactive'"
                                  x-text="weekDates[@idx].getDate()"></span>
                        </div>
                    }
                </div>

                <!-- Calendar Content Sheet -->
                <div @@mouseup="handleMouseUp()" 
                     @@mouseleave="handleMouseLeave()" 
                     class="relative select-none" 
                     :class="mode === 'moving' ? 'cursor-grabbing' : ''"
                     style="display: grid; grid-template-columns: 64px repeat(7, 1fr); height: 1632px;"
                     id="grid-container">
                    
                    <!-- Vertical Time Grid Rails -->
                    <div class="border-r border-slate-200">
                        @for (int i = 0; i < 34; i++)
                        {
                            var slotLabelIdx = i;
                            <div class="flex items-start justify-end pr-2 text-[11px] text-slate-400 font-medium" 
                                 style="height: 48px;">
                                <span class="-mt-1.5" x-text="@slotLabelIdx % 2 === 0 ? slotToTime(@slotLabelIdx) : ''"></span>
                            </div>
                        }
                    </div>

                    <!-- Seven columns for Mon to Sun -->
                    @for (int dayIdx = 0; dayIdx < 7; dayIdx++)
                    {
                        var dIdx = dayIdx;
                        <div class="border-r border-slate-200 last:border-r-0 relative h-full bg-white">
                             
                             <!-- Half-hour grid lines and triggers -->
                             @for (int slotIdx = 0; slotIdx < 34; slotIdx++)
                             {
                                 var sIdx = slotIdx;
                                 <div @@mousedown="handleCellMouseDown(@dIdx, @sIdx)" 
                                      @@mouseenter="handleCellMouseEnter(@dIdx, @sIdx)" 
                                      class="border-b transition-colors"
                                      :class="[
                                          @sIdx % 2 === 0 ? 'border-slate-100' : 'border-slate-100/40',
                                          mode === 'moving' && movingTask && movingTask.currentDayIdx === @dIdx && movingTask.currentStartSlot <= @sIdx && @sIdx < (movingTask.currentStartSlot + (events.find(x => x.id === movingTask.taskId)?.duration || 2)) ? 'grid-cell-active-hover' : (mode === 'moving' ? 'hover:bg-slate-50/30' : 'hover:bg-slate-50'),
                                          mode === 'idle' ? 'cursor-crosshair' : 'cursor-grabbing'
                                      ]"
                                      style="height: 48px;"></div>
                             }

                             <!-- Dashed New Event Selection Preview -->
                             <div x-show="createPreview && createPreview.dayIdx === @dIdx" x-cloak
                                  class="absolute left-1 right-1 rounded-lg bg-indigo-500/10 border-2 border-dashed border-indigo-500/50 z-10 pointer-events-none"
                                  :style="'top: ' + (createPreview ? createPreview.startSlot * 48 : 0) + 'px; height: ' + (createPreview ? createPreview.duration * 48 : 0) + 'px;'">
                                 <span class="text-[10px] text-indigo-600 font-semibold px-2 pt-1 block" 
                                       x-text="createPreview ? (slotToTime(createPreview.startSlot) + ' – ' + slotToTime(createPreview.startSlot + createPreview.duration)) : ''"></span>
                             </div>

                             <!-- Rendered Event Cards -->
                             <template x-for="ev in getEventsForDay(@dIdx)" :key="ev.id">
                                 <div :id="'ev-' + ev.id" 
                                      @@mousedown.stop="startMoveTask($event, ev, @dIdx)"
                                      class="event-card absolute rounded-lg border-l-[3px] px-2 py-1.5 text-xs leading-tight cursor-pointer overflow-hidden z-20 shadow-sm hover:shadow-md select-none flex flex-col justify-between"
                                      :class="[
                                          ['bg-indigo-50 border-indigo-200 text-indigo-700',
                                           'bg-teal-50 border-teal-200 text-teal-700',
                                           'bg-amber-50 border-amber-200 text-amber-700',
                                           'bg-rose-50 border-rose-200 text-rose-700',
                                           'bg-slate-50 border-slate-200 text-slate-700'][ev.colorIdx] || 'bg-indigo-50 border-indigo-200 text-indigo-700',
                                          ev.priority === 'high' ? 'ring-1 ring-rose-500/20' : '',
                                          mode === 'moving' && movingTask && movingTask.taskId === ev.id ? 'event-card-dragging' : ''
                                      ]"
                                      :style="'top: ' + (ev.startSlot * 48 + 1) + 'px; height: ' + (ev.duration * 48 - 2) + 'px; left: ' + (ev.left + 2) + '%; width: ' + (ev.width - 4) + '%;' + (mode === 'moving' && movingTask && movingTask.taskId === ev.id ? ' transform: translate3d(' + dragTranslateX + 'px, ' + dragTranslateY + 'px, 0px) scale(1.025) rotate(1.2deg);' : '')">
                                      
                                      <!-- Resize Handle Top -->
                                      <div @@mousedown.stop.prevent="startResize($event, ev, 'top')"
                                           class="absolute top-0 left-0 right-0 h-2 cursor-n-resize rounded-t hover:bg-slate-800/10 flex items-center justify-center">
                                           <div class="h-0.5 w-6 rounded-full bg-slate-800/20"></div>
                                      </div>

                                      <!-- Content -->
                                      <div class="flex items-center gap-1.5 mt-1">
                                          <span class="h-1.5 w-1.5 rounded-full shrink-0" 
                                                :class="{
                                                    'bg-slate-400': ev.priority === 'low',
                                                    'bg-amber-500': ev.priority === 'medium',
                                                    'bg-rose-500': ev.priority === 'high'
                                                }"></span>
                                          <span class="font-semibold truncate" x-text="ev.title"></span>
                                      </div>

                                      <!-- Scheduled Time Indicator -->
                                      <template x-if="ev.duration >= 2">
                                          <span class="text-[10px] opacity-70 block ml-3" 
                                                x-text="slotToTime(ev.startSlot) + ' – ' + slotToTime(ev.startSlot + ev.duration)"></span>
                                      </template>

                                      <!-- Description Details -->
                                      <template x-if="ev.duration >= 4 && ev.description">
                                          <span class="text-[10px] opacity-60 block ml-3 line-clamp-2" x-text="ev.description"></span>
                                      </template>

                                      <!-- Resize Handle Bottom -->
                                      <div @@mousedown.stop.prevent="startResize($event, ev, 'bottom')"
                                           class="absolute bottom-0 left-0 right-0 h-2 cursor-s-resize rounded-b hover:bg-slate-800/10 flex items-center justify-center">
                                           <div class="h-0.5 w-6 rounded-full bg-slate-800/20"></div>
                                      </div>
                                 </div>
                             </template>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Side: Deadlines Widget Panel -->
        <div class="w-72 shrink-0 self-start border border-slate-200 bg-white rounded-xl shadow-sm overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex items-center gap-2">
                <i data-lucide="clock" class="w-4 h-4 text-rose-500"></i>
                <h3 class="text-sm font-semibold text-slate-800">Deadlines This Week</h3>
            </div>
            
            <div class="p-4 space-y-3">
                <template x-show="weeklyDeadlines.length === 0">
                    <div class="text-center py-6 text-xs font-medium text-slate-400">No deadlines due this week.</div>
                </template>

                <template x-for="dl in weeklyDeadlines" :key="dl.id">
                    <div class="rounded-lg border p-3 space-y-1 transition-all"
                         :class="{
                             'border-rose-100 bg-rose-50/20': dl.priority === 'high',
                             'border-amber-100 bg-amber-50/15': dl.priority === 'medium',
                             'border-slate-100 bg-slate-50/50': dl.priority === 'low'
                         }">
                        <div class="flex items-center gap-2">
                            <template x-if="dl.priority === 'high'">
                                <i data-lucide="alert-triangle" class="w-3.5 h-3.5 text-rose-500"></i>
                            </template>
                            <p class="text-sm font-semibold text-slate-800" x-text="dl.title"></p>
                        </div>
                        <p class="text-xs text-slate-400 font-medium" x-text="dl.workspaceName"></p>
                        <div class="inline-flex items-center px-2 py-0.5 border rounded-full text-[9px] font-bold mt-1"
                             :class="{
                                 'border-rose-200 text-rose-600 bg-white': dl.priority === 'high',
                                 'border-amber-200 text-amber-600 bg-white': dl.priority === 'medium',
                                 'border-slate-200 text-slate-500 bg-white': dl.priority === 'low'
                             }" x-text="dl.formattedDate"></div>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <!-- Create/Edit Task Dialog Modal -->
    <div x-show="dialogOpen" 
         class="fixed inset-0 z-50 flex items-center justify-center p-6 bg-slate-900/40 backdrop-blur-sm"
         x-transition x-cloak>
        
        <div @@click.away="dialogOpen = false" 
             class="w-full max-w-md bg-white p-6 rounded-xl border border-slate-200 shadow-2xl space-y-4 relative animate-in fade-in zoom-in-95 duration-200">
            
            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                <h3 class="text-lg font-bold text-slate-800" x-text="isEdit ? 'Edit Personal Event' : 'Create Personal Event'"></h3>
                <button @@click="dialogOpen = false" class="p-1 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-50 transition-colors">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <div class="space-y-4">
                <!-- Title -->
                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-slate-700">Title</label>
                    <input type="text" x-model="formTitle" placeholder="Event title"
                           class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all font-semibold text-sm text-slate-700">
                </div>

                <!-- Description -->
                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-slate-700">Description</label>
                    <textarea x-model="formDesc" placeholder="Optional description" rows="2"
                              class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all font-medium text-sm text-slate-700"></textarea>
                </div>

                <!-- Priority & Color selector Row -->
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-700">Priority</label>
                        <select x-model="formPriority" 
                                class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none bg-white font-medium text-sm text-slate-700">
                            <option value="low">Low</option>
                            <option value="medium">Medium</option>
                            <option value="high">High</option>
                        </select>
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-700">Color</label>
                        <div class="flex gap-1.5 pt-1">
                            <template x-for="(dotClass, idx) in ['bg-indigo-600', 'bg-teal-600', 'bg-amber-500', 'bg-rose-600', 'bg-slate-500']">
                                <button type="button" 
                                        class="h-7 w-7 rounded-full border-2 transition-all cursor-pointer"
                                        :class="[dotClass, formColor === idx ? 'scale-110 border-slate-800 ring-2 ring-slate-800/10' : 'border-transparent']"
                                        @@click="formColor = idx"
                                        :title="['Indigo', 'Teal', 'Yellow', 'Red', 'Gray'][idx]"></button>
                            </template>
                        </div>
                    </div>
                </div>

                <!-- Time Details indicator -->
                <div class="text-xs font-medium text-slate-400 bg-slate-50 p-3 rounded-lg border border-slate-100 flex items-center gap-1.5">
                    <i data-lucide="clock" class="w-3.5 h-3.5 text-indigo-500 shrink-0"></i>
                    <span x-text="['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'][formDayIdx] + ' · ' + slotToTime(formStartSlot) + ' – ' + slotToTime(formStartSlot + formDuration)"></span>
                </div>
            </div>

            <!-- Footer Action buttons -->
            <div class="flex items-center justify-between border-t border-slate-100 pt-3 mt-4">
                <div>
                    <template x-if="isEdit">
                        <div class="flex gap-2">
                            <button @@click="deleteEvent()" 
                                    class="px-3 py-1.5 bg-rose-50 text-rose-600 border border-rose-100 hover:bg-rose-100 rounded-lg text-xs font-semibold flex items-center gap-1 transition-colors">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Delete
                            </button>
                            <button @@click="duplicateEvent()" 
                                    class="px-3 py-1.5 bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 rounded-lg text-xs font-semibold flex items-center gap-1 transition-colors">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i> Duplicate
                            </button>
                        </div>
                    </template>
                </div>
                <div class="flex items-center gap-2">
                    <button @@click="dialogOpen = false" 
                            class="px-4 py-2 border border-slate-200 text-slate-500 rounded-lg text-xs font-medium hover:bg-slate-50 transition-colors">Cancel</button>
                    <button @@click="saveEvent()" :disabled="!formTitle.trim()" 
                            class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-xs font-semibold hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all">
                        <span x-text="isEdit ? 'Save' : 'Create'"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.scheduleRawEvents = @Html.Raw(jsonEvents);
        window.scheduleRawTasks = @Html.Raw(jsonTasks);
    </script>
    <script src="~/js/schedule.js" asp-append-version="true"></script>
}
