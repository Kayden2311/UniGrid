                                </div>
                                <!-- Divider -->
                                <div class="w-px bg-slate-100 self-stretch my-2"></div>
                                <!-- Minute Column -->
                                <div class="flex-1 flex flex-col items-center">
                                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider mb-1.5">MM</span>
                                    <div class="w-full h-36 overflow-y-auto scrollbar-thin flex flex-col gap-0.5">
                                        <template x-for="m in ['00','05','10','15','20','25','30','35','40','45','50','55']">
                                            <button type="button" @@click="startMinute = m; updateStartTimeFromCustom()"
                                                    class="w-full py-1 text-xs font-semibold rounded-lg text-center transition-all"
                                                    :class="startMinute === m ? 'bg-indigo-600 text-white shadow-sm font-bold' : 'text-slate-600 hover:bg-slate-50'"
                                                    x-text="m"></button>
                                        </template>
                                    </div>
                                </div>
                                <!-- Divider -->
                                <div class="w-px bg-slate-100 self-stretch my-2"></div>
                                <!-- AM/PM Column -->
                                <div class="w-12 flex flex-col items-center">
                                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider mb-1.5">AM/PM</span>
                                    <div class="w-full flex flex-col gap-1 mt-2">
                                        <button type="button" @@click="startAmpm = 'AM'; updateStartTimeFromCustom()"
                                                class="w-full py-1.5 text-xs font-bold rounded-lg text-center transition-all"
                                                :class="startAmpm === 'AM' ? 'bg-indigo-600 text-white shadow-sm font-bold' : 'text-slate-600 hover:bg-slate-50'">AM</button>
                                        <button type="button" @@click="startAmpm = 'PM'; updateStartTimeFromCustom()"
                                                class="w-full py-1.5 text-xs font-bold rounded-lg text-center transition-all"
                                                :class="startAmpm === 'PM' ? 'bg-indigo-600 text-white shadow-sm font-bold' : 'text-slate-600 hover:bg-slate-50'">PM</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="space-y-1.5 relative" @@click.away="endTimeDropdownOpen = false">
