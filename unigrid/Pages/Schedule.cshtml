                </div>

                <!-- Description -->
                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-slate-700">Description</label>
                    <textarea x-model="formDesc" placeholder="Optional description" rows="2" :disabled="isTaskForm"
                              class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all font-medium text-sm text-slate-700 disabled:bg-slate-50 disabled:text-slate-500 disabled:cursor-not-allowed"></textarea>
                </div>

                <!-- Priority & Color selector Row -->
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-700">Priority</label>
                        <select x-model="formPriority" :disabled="isTaskForm"
                                class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none bg-white font-medium text-sm text-slate-700 disabled:bg-slate-50 disabled:text-slate-500 disabled:cursor-not-allowed">
                            <option value="low">Low</option>
                            <option value="medium">Medium</option>
                            <option value="high">High</option>
                        </select>
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-700">Color</label>
                        <div class="flex gap-1.5 pt-1">
                            <template x-for="(dotClass, idx) in ['bg-indigo-600', 'bg-teal-600', 'bg-amber-500', 'bg-rose-600', 'bg-slate-500']">
                                <button type="button" :disabled="isTaskForm"
                                        class="h-7 w-7 rounded-full border-2 transition-all disabled:opacity-85 disabled:cursor-not-allowed"
                                        :class="[dotClass, formColor === idx ? 'scale-110 border-slate-800 ring-2 ring-slate-800/10' : 'border-transparent']"
                                        @@click="formColor = idx"
                                        :title="['Indigo', 'Teal', 'Yellow', 'Red', 'Gray'][idx]"></button>
                            </template>
                        </div>
                    </div>
                </div>

                <!-- Scheduled Time and Timezone Controls -->
                <div class="border-t border-slate-100 pt-4 space-y-3">
                    <h4 class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                        <i data-lucide="calendar" class="w-3.5 h-3.5 text-indigo-500"></i>
                        Personal Schedule Details
                    </h4>
                    
                    <div class="grid grid-cols-2 gap-3.5">
                        <div class="space-y-1.5 col-span-2">
                            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Scheduled Date</label>
                            <div class="relative rounded-xl shadow-sm">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i data-lucide="calendar" class="h-4 w-4 text-slate-400"></i>
                                </div>
                                <input type="date" x-model="formDate"
                                       class="block w-full pl-10 pr-3 py-2.5 border border-slate-200 rounded-xl bg-slate-50/50 hover:bg-slate-50 focus:bg-white text-slate-700 text-sm font-semibold outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all">
                            </div>
                        </div>
                        
                        <div class="space-y-1.5 relative" @@click.away="startTimeDropdownOpen = false">
                            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Start Time</label>
