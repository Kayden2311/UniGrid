@page
@model unigrid.Pages.ScheduleModel
@{
    ViewData["Title"] = "Schedule";
    
    var serializerSettings = new System.Text.Json.JsonSerializerOptions 
    { 
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase 
    };
    var jsonEvents = System.Text.Json.JsonSerializer.Serialize(Model.PersonalEvents.Select(e => new {
        id = e.Id,
        title = e.Title,
        description = e.Description ?? "",
        startTime = e.StartTime.ToString("yyyy-MM-ddTHH:mm:ssZ"),
        endTime = e.EndTime.ToString("yyyy-MM-ddTHH:mm:ssZ"),
        taskId = e.TaskId,
        timeZone = e.TimeZone ?? "UTC"
    }), serializerSettings);

    var jsonTasks = System.Text.Json.JsonSerializer.Serialize(Model.WorkspaceTasks.Select(t => {
        var finalDueDate = t.DueDate;
        if (finalDueDate.HasValue)
        {
            if (finalDueDate.Value.Hour == 0 && finalDueDate.Value.Minute == 0 && finalDueDate.Value.Second == 0)
            {
                finalDueDate = finalDueDate.Value.Date.AddHours(23).AddMinutes(50);
            }
        }
        return new {
            id = t.Id,
            title = t.Title,
            description = t.Description ?? "",
            workspaceName = t.Workspace?.Name ?? "Workspace",
            workspaceJoinCode = t.Workspace?.JoinCode ?? "",
            dueDate = finalDueDate?.ToString("yyyy-MM-ddTHH:mm:ssZ"),
            priority = t.Priority == 3 ? "high" : (t.Priority == 2 ? "medium" : "low")
        };
    }), serializerSettings);
}

<link rel="stylesheet" href="~/css/schedule.css" asp-append-version="true" />
<div class="space-y-4" x-data="scheduleComponent()">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-display text-2xl font-bold text-slate-800">Schedule</h1>
            <p class="text-sm text-slate-500">Plan your week — drag to create, pick & slide personal events, resize from edges</p>
        </div>
        <div class="flex items-center gap-2">
            <button @@click="weekOffset--" class="px-3 py-1.5 border border-slate-200 text-slate-600 hover:bg-slate-50 rounded-lg text-xs font-semibold flex items-center gap-1 transition-colors">
                <i data-lucide="chevron-left" class="w-3.5 h-3.5 mr-0.5"></i> Prev
            </button>
            <span class="text-sm font-semibold min-w-[140px] text-center text-slate-700" x-text="weekLabel"></span>
            <button @@click="weekOffset++" class="px-3 py-1.5 border border-slate-200 text-slate-600 hover:bg-slate-50 rounded-lg text-xs font-semibold flex items-center gap-1 transition-colors">
                Next <i data-lucide="chevron-right" class="w-3.5 h-3.5 ml-0.5"></i>
            </button>
            <button @@click="weekOffset = 0" class="px-3 py-1.5 text-slate-400 hover:text-slate-600 rounded-lg text-xs font-semibold transition-colors">
                Today
            </button>
        </div>
    </div>

    <!-- How to use Guidelines Card -->
    <div class="border border-indigo-100 bg-indigo-50/15 rounded-xl p-4 flex items-start gap-3 shadow-sm">
        <i data-lucide="info" class="w-5 h-5 text-indigo-500 shrink-0 mt-0.5"></i>
        <div class="text-xs text-slate-500 space-y-1">
            <p><strong class="text-slate-700">Create:</strong> Click & drag on empty grid slots (drag up or down).</p>
            <p><strong class="text-slate-700">Move:</strong> Click and drag a personal event card to reschedule (requires confirmation).</p>
            <p><strong class="text-slate-700">Resize:</strong> Drag the top or bottom edge of a personal block to change duration.</p>
            <p><strong class="text-slate-700">Lane Separation:</strong> Personal events render on the left half of the column; Workspace Tasks are pinned on the right.</p>
        </div>
    </div>

    <!-- Antiforgery Input Token for AJAX Posts -->
    @Html.AntiForgeryToken()

    <!-- Main Grid and Widget Panel -->
    <div class="flex gap-4">
        
        <!-- Left Side: Interactive Calendar Sheet -->
        <div class="flex-1 overflow-auto rounded-xl border border-slate-200 bg-white shadow-sm" style="max-height: calc(100vh - 220px);">
            <div style="min-width: 800px;">
                <!-- Day Headers -->
                <div class="sticky top-0 z-[50] border-b border-slate-200 bg-white"
                     style="display: grid; grid-template-columns: 80px repeat(7, 1fr);">
                    <div class="border-r border-slate-200"></div>
                    @for (int idx = 0; idx < 7; idx++)
                    {
                        var dayName = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" }[idx];
                        <div class="px-2 py-3 text-center border-r border-slate-200 last:border-r-0">
                            <span class="text-xs font-medium text-slate-400 block">@dayName</span>
                            <span class="inline-flex items-center justify-center h-8 w-8 rounded-full text-base mt-1" 
                                  :class="isToday(@idx) ? 'today-badge-active' : 'today-badge-inactive'"
                                  x-text="weekDates[@idx].getDate()"></span>
                        </div>
                    }
                </div>

                <!-- Calendar Content Sheet -->
                <div @@mouseup="handleMouseUp()" 
                     @@mouseleave="handleMouseLeave()" 
                     class="relative select-none" 
                     :class="mode === 'moving' ? 'cursor-grabbing' : ''"
                     style="display: grid; grid-template-columns: 80px repeat(7, 1fr); height: 1728px;"
                     id="grid-container">
                    
                    <!-- Vertical Time Grid Rails -->
                    <div class="border-r border-slate-200">
                        @for (int i = 0; i < 48; i++)
                        {
                            var slotLabelIdx = i;
                            <div class="flex items-start justify-end pr-2 text-[11px] text-slate-400 font-medium" 
                                 style="height: 36px;">
                                 <span :class="@slotLabelIdx === 0 ? 'mt-1' : '-mt-1.5'" x-text="@slotLabelIdx % 2 === 0 ? slotToTime(@slotLabelIdx) : ''"></span>
                             </div>
                        }
                    </div>

                    <!-- Seven columns for Mon to Sun -->
                    @for (int dayIdx = 0; dayIdx < 7; dayIdx++)
                    {
                        var dIdx = dayIdx;
                        <div class="border-r border-slate-200 last:border-r-0 relative h-full bg-white overflow-hidden">
                             
                             <!-- Half-hour grid lines and triggers -->
                             @for (int slotIdx = 0; slotIdx < 48; slotIdx++)
                             {
                                 var sIdx = slotIdx;
                                 <div @@mousedown="handleCellMouseDown(@dIdx, @sIdx)" 
                                      @@mouseenter="handleCellMouseEnter(@dIdx, @sIdx)" 
                                      @@dragover.prevent
                                      @@drop="handleDeadlineDrop($event, @dIdx, @sIdx)"
                                      class="border-b transition-colors"
                                      :class="[
                                          @sIdx % 2 === 0 ? 'border-slate-100' : 'border-slate-100/40',
                                          mode === 'moving' && movingTask && movingTask.currentDayIdx === @dIdx && movingTask.currentStartSlot <= @sIdx && @sIdx < (movingTask.currentStartSlot + (events.find(x => x.id === movingTask.taskId)?.duration || 2)) ? 'grid-cell-active-hover' : (mode === 'moving' ? 'hover:bg-slate-50/30' : 'hover:bg-slate-50'),
                                          mode === 'idle' ? 'cursor-crosshair' : 'cursor-grabbing'
                                      ]"
                                      style="height: 36px;"></div>
                             }

                             <!-- Dashed New Event Selection Preview -->
                             <div x-show="createPreview && createPreview.dayIdx === @dIdx" x-cloak
                                  class="absolute left-1 right-1 rounded-lg bg-indigo-500/10 border-2 border-dashed border-indigo-500/50 z-10 pointer-events-none"
                                  :style="'top: ' + (createPreview ? createPreview.startSlot * 36 : 0) + 'px; height: ' + (createPreview ? createPreview.duration * 36 : 0) + 'px;'">
                                 <span class="text-[10px] text-indigo-600 font-semibold px-2 pt-1 block" 
                                       x-text="createPreview ? (slotToTime(createPreview.startSlot) + ' – ' + slotToTime(createPreview.startSlot + createPreview.duration)) : ''"></span>
                             </div>

                             <!-- Personal Events (Left Lane: 0% to 48%) -->
                             <template x-for="ev in getPersonalEventsForDay(@dIdx)" :key="ev.id">
                                 <div :id="'ev-' + ev.id" 
                                      @@click="openEdit(ev)"
                                      @@mouseenter="hoveredId = ev.id" 
                                      @@mouseleave="hoveredId = null"
                                      class="event-card absolute rounded-lg border-l-[3px] text-xs leading-normal z-20 shadow-sm hover:shadow-md select-none flex flex-col cursor-pointer group transition-shadow"
                                      :class="[
                                          ['bg-indigo-50 border-indigo-200 text-indigo-700',
                                           'bg-teal-50 border-teal-200 text-teal-700',
                                           'bg-amber-50 border-amber-200 text-amber-700',
                                           'bg-rose-50 border-rose-200 text-rose-700',
                                           'bg-slate-50 border-slate-200 text-slate-700'][ev.colorIdx] || 'bg-indigo-50 border-indigo-200 text-indigo-700',
                                          ev.priority === 'high' ? 'ring-1 ring-rose-500/20' : '',
                                          mode === 'moving' && movingTask && movingTask.taskId === ev.id ? 'event-card-dragging' : '',
                                          ev.duration === 1 ? 'py-0.5 px-1.5 justify-center gap-0' : 'py-1 px-2 justify-start gap-0.5'
                                      ]"
                                      :style="'top: ' + (ev.startSlot * 36 + 1) + 'px; height: ' + (ev.duration * 36 - 2) + 'px; left: ' + (ev.left + 1) + '%; width: ' + (ev.width - 2) + '%;' + (mode === 'moving' && movingTask && movingTask.taskId === ev.id ? ' transform: translate3d(' + dragTranslateX + 'px, ' + dragTranslateY + 'px, 0px) scale(1.02) rotate(1.2deg);' : '')">
                                      
                                      <!-- When duration is 1 (30 minutes) -->
                                      <template x-if="ev.duration === 1">
                                          <div class="flex flex-col justify-center gap-0 w-full min-w-0">
                                              <!-- Row 1: Grip + Dot + Title inline -->
                                              <div class="flex items-center gap-1 select-none w-full shrink-0 min-w-0">
                                                  <!-- 3x3 Dot Grid Overlay (acts as GRIP handle) -->
                                                  <div @@mousedown.stop.prevent="startMoveTask($event, ev, @dIdx)"
                                                       class="flex flex-wrap w-[11px] h-[11px] gap-[1.5px] opacity-[0.4] hover:opacity-[0.9] pointer-events-auto shrink-0 text-current cursor-grab active:cursor-grabbing">
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                  </div>
                                                  <!-- Priority Dot -->
                                                  <span class="h-1.5 w-1.5 rounded-full shrink-0" 
                                                        :class="{
                                                            'bg-slate-400': ev.priority === 'low',
                                                            'bg-amber-500': ev.priority === 'medium',
                                                            'bg-rose-500': ev.priority === 'high'
                                                        }"></span>
                                                  <!-- Title -->
                                                  <div class="font-bold text-slate-700 truncate text-[11px] select-none leading-none flex-1 min-w-0" 
                                                       x-text="ev.title"></div>
                                              </div>
                                              <!-- Row 2: Time range -->
                                              <div class="text-[9px] font-bold text-slate-450 uppercase tracking-tight select-none leading-none mt-0.5 shrink-0"
                                                   x-text="formatExactTimeRange(ev.startDate, ev.endDate)"></div>
                                          </div>
                                      </template>

                                      <!-- When duration is > 1 (longer events) -->
                                      <template x-if="ev.duration > 1">
                                          <div class="flex flex-col justify-start gap-0.5 w-full min-w-0">
                                              <!-- Row 1: Grip + Dot -->
                                              <div class="flex items-center gap-1.5 select-none w-full shrink-0">
                                                  <!-- 3x3 Dot Grid Overlay (acts as GRIP handle) -->
                                                  <div @@mousedown.stop.prevent="startMoveTask($event, ev, @dIdx)"
                                                       class="flex flex-wrap w-[11px] h-[11px] gap-[1.5px] opacity-[0.4] hover:opacity-[0.9] pointer-events-auto shrink-0 text-current cursor-grab active:cursor-grabbing">
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                  </div>
                                                  <!-- Priority Dot -->
                                                  <span class="h-1.5 w-1.5 rounded-full shrink-0" 
                                                        :class="{
                                                            'bg-slate-400': ev.priority === 'low',
                                                            'bg-amber-500': ev.priority === 'medium',
                                                            'bg-rose-500': ev.priority === 'high'
                                                        }"></span>
                                              </div>
                                              <!-- Row 2: Title (Full Width) -->
                                              <div class="font-bold text-slate-700 truncate text-[11px] select-none leading-none w-full min-w-0" 
                                                   x-text="ev.title"></div>
                                              <!-- Row 3: Time details -->
                                              <div class="text-[9px] font-bold text-slate-450 uppercase tracking-tight select-none leading-none"
                                                   x-text="formatExactTimeRange(ev.startDate, ev.endDate)"></div>
                                          </div>
                                      </template>

                                      <!-- Resize Handle Top -->
                                      <div @@mousedown.stop.prevent="startResize($event, ev, 'top')"
                                           class="absolute top-0 left-0 right-0 h-1.5 cursor-n-resize rounded-t hover:bg-slate-800/10 flex items-center justify-center">
                                           <div class="h-0.5 w-6 rounded-full bg-slate-800/20"></div>
                                      </div>

                                      <!-- Resize Handle Bottom -->
                                      <div @@mousedown.stop.prevent="startResize($event, ev, 'bottom')"
                                           class="absolute bottom-0 left-0 right-0 h-1.5 cursor-s-resize rounded-b hover:bg-slate-800/10 flex items-center justify-center">
                                           <div class="h-0.5 w-6 rounded-full bg-slate-800/20"></div>
                                      </div>

                                      <!-- Hover Tooltip Popover (Floating centered above card) -->
                                      <div x-show="hoveredId === ev.id" x-cloak
                                           class="absolute z-50 min-w-[200px] max-w-[280px] bg-white border border-slate-100 rounded-2xl p-4 shadow-xl text-xs text-left cursor-default pointer-events-none transition-all duration-200"
                                           :class="'left-1/2 -translate-x-1/2 bottom-full mb-2'"
                                           x-transition>
                                          <div class="space-y-1">
                                              <h4 class="font-bold text-slate-800 text-xs leading-snug" x-text="ev.title"></h4>
                                              <p class="text-slate-550 font-semibold text-[10px] tracking-tight mt-0.5" 
                                                 x-text="formatExactTimeRange(ev.startDate, ev.endDate) + ' · ' + ev.priority + ' priority'"></p>
                                          </div>
                                      </div>
                                 </div>
                             </template>

                             <!-- Workspace Tasks (Right Lane: 52% to 100%) -->
                             <template x-for="task in getTasksForDay(@dIdx)" :key="task.id">
                                 <div :id="'task-' + task.id" 
                                      @@click="openEdit(task)"
                                      @@mouseenter="hoveredId = task.id" 
                                      @@mouseleave="hoveredId = null"
                                      class="event-card absolute rounded-lg border-l-[3px] text-xs leading-normal z-20 shadow-sm hover:shadow-md select-none flex flex-col cursor-pointer group transition-shadow animate-fade-in"
                                      :class="[
                                          ['bg-indigo-50 border-indigo-200 text-indigo-700',
                                           'bg-teal-50 border-teal-200 text-teal-700',
                                           'bg-amber-50 border-amber-200 text-amber-700',
                                           'bg-rose-50 border-rose-200 text-rose-700',
                                           'bg-slate-50 border-slate-200 text-slate-700'][task.colorIdx] || 'bg-indigo-50 border-indigo-200 text-indigo-700',
                                          task.priority === 'high' ? 'ring-1 ring-rose-500/20' : '',
                                          mode === 'moving' && movingTask && movingTask.taskId === task.id ? 'event-card-dragging' : '',
                                          task.duration === 1 ? 'py-0.5 px-1.5 justify-center gap-0' : 'py-1 px-2 justify-start gap-0.5'
                                      ]"
                                      :style="'top: ' + (task.startSlot * 36 + 1) + 'px; height: ' + (task.duration * 36 - 2) + 'px; left: ' + (task.left + 1) + '%; width: ' + (task.width - 2) + '%;' + (mode === 'moving' && movingTask && movingTask.taskId === task.id ? ' transform: translate3d(' + dragTranslateX + 'px, ' + dragTranslateY + 'px, 0px) scale(1.02) rotate(1.2deg);' : '')">
                                      
                                      <!-- When duration is 1 (30 minutes) -->
                                      <template x-if="task.duration === 1">
                                          <div class="flex flex-col justify-center gap-0 w-full min-w-0">
                                              <!-- Row 1: Grip + Dot + Title inline -->
                                              <div class="flex items-center gap-1 select-none w-full shrink-0 min-w-0">
                                                  <!-- 3x3 Dot Grid Overlay (acts as GRIP handle) -->
                                                  <div @@mousedown.stop.prevent="startMoveTask($event, task, @dIdx)"
                                                       class="flex flex-wrap w-[11px] h-[11px] gap-[1.5px] opacity-[0.4] hover:opacity-[0.9] pointer-events-auto shrink-0 text-current cursor-grab active:cursor-grabbing">
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                  </div>
                                                  <!-- Priority Dot -->
                                                  <span class="h-1.5 w-1.5 rounded-full shrink-0" 
                                                        :class="{
                                                            'bg-slate-400': task.priority === 'low',
                                                            'bg-amber-500': task.priority === 'medium',
                                                            'bg-rose-500': task.priority === 'high'
                                                        }"></span>
                                                  <!-- Title -->
                                                  <div class="font-bold text-slate-700 truncate text-[11px] select-none leading-none flex-1 min-w-0" 
                                                       x-text="task.title"></div>
                                              </div>
                                              <!-- Row 2: Time range -->
                                              <div class="text-[9px] font-bold text-slate-450 uppercase tracking-tight select-none leading-none mt-0.5 shrink-0 pl-[17px]"
                                                   x-text="formatExactTimeRange(task.startDate, task.endDate)"></div>
                                          </div>
                                      </template>

                                      <!-- When duration is > 1 (longer events) -->
                                      <template x-if="task.duration > 1">
                                          <div class="flex flex-col justify-start gap-1.5 w-full min-w-0">
                                              <!-- Row 1: Grip + Priority Dot -->
                                              <div class="flex items-center gap-1.5 select-none w-full shrink-0 h-[11px]">
                                                  <!-- 3x3 Dot Grid Overlay (acts as GRIP handle) -->
                                                  <div @@mousedown.stop.prevent="startMoveTask($event, task, @dIdx)"
                                                       class="flex flex-wrap w-[11px] h-[11px] gap-[1.5px] opacity-[0.4] hover:opacity-[0.9] pointer-events-auto shrink-0 text-current cursor-grab active:cursor-grabbing">
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                      <span class="w-[2.5px] h-[2.5px] rounded-full bg-current"></span>
                                                  </div>
                                                  <!-- Priority Dot -->
                                                  <span class="h-1.5 w-1.5 rounded-full shrink-0" 
                                                        :class="{
                                                            'bg-slate-400': task.priority === 'low',
                                                            'bg-amber-500': task.priority === 'medium',
                                                            'bg-rose-500': task.priority === 'high'
                                                        }"></span>
                                              </div>
                                              <!-- Row 2: Title (Full Width) -->
                                              <div class="font-bold text-slate-700 truncate text-[11px] select-none leading-none w-full min-w-0" 
                                                   x-text="task.title"></div>
                                              <!-- Row 3: Time details -->
                                              <div class="text-[9px] font-bold text-slate-450 uppercase tracking-tight select-none leading-none"
                                                   x-text="formatExactTimeRange(task.startDate, task.endDate)"></div>
                                          </div>
                                      </template>

                                      <!-- Top/Bottom Resize handles for workspace tasks -->
                                      <div @@mousedown.stop.prevent="startResize($event, task, 'top')" class="absolute top-0 left-0 right-0 h-1.5 cursor-ns-resize z-30 group-hover:bg-slate-300/30"></div>
                                      <div @@mousedown.stop.prevent="startResize($event, task, 'bottom')" class="absolute bottom-0 left-0 right-0 h-1.5 cursor-ns-resize z-30 group-hover:bg-slate-300/30"></div>

                                      <!-- Hover Tooltip Popover (Floating centered above card) -->
                                      <div x-show="hoveredId === task.id" x-cloak
                                           class="absolute z-50 min-w-[200px] max-w-[280px] bg-white border border-slate-100 rounded-2xl p-4 shadow-xl text-xs text-left cursor-default pointer-events-none transition-all duration-200"
                                           :class="'left-1/2 -translate-x-1/2 bottom-full mb-2'"
                                           x-transition>
                                          <div class="space-y-1">
                                              <h4 class="font-bold text-slate-800 text-xs leading-snug" x-text="task.title"></h4>
                                              <p class="text-slate-550 font-semibold text-[10px] tracking-tight mt-0.5" 
                                                 x-text="formatExactTimeRange(task.startDate, task.endDate) + ' · ' + task.priority + ' priority'"></p>
                                          </div>
                                      </div>
                                 </div>
                             </template>

                        </div>
                    }
                </div>
            </div>
        </div>
        <!-- Right Side: Deadlines Widget Panel -->
        <div class="w-72 shrink-0 self-start border border-slate-200 bg-white rounded-xl shadow-sm overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex items-center gap-2">
                <i data-lucide="clock" class="w-4 h-4 text-indigo-650 animate-pulse"></i>
                <h3 class="text-sm font-semibold text-slate-800">Workspace Deadlines</h3>
            </div>
            
            <div class="p-4 space-y-5 max-h-[600px] overflow-y-auto">
                <!-- Section 1: Due This Week -->
                <div class="space-y-2.5">
                    <h4 class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Due This Week</h4>
                    <div x-show="weeklyDeadlines.length === 0" class="text-center py-4 text-xs font-semibold text-slate-400 bg-slate-50 rounded-xl border border-dashed border-slate-100">
                        No deadlines due this week.
                    </div>
                    <div class="space-y-2">
                        <template x-for="dl in weeklyDeadlines" :key="dl.id">
                            <div draggable="true" 
                                 @@dragstart="handleDeadlineDragStart($event, dl)"
                                 @@click="openEdit(dl)"
                                 class="rounded-lg border border-l-[4px] p-3 space-y-1.5 transition-all duration-300 transform hover:-translate-y-0.5 hover:shadow-md cursor-pointer"
                                 :class="{
                                     'border-l-rose-500 bg-rose-50/20 border-y-rose-100/50 border-r-rose-100/50 shadow-rose-100/10': dl.priority === 'high',
                                     'border-l-amber-500 bg-amber-50/20 border-y-amber-100/50 border-r-amber-100/50 shadow-amber-100/10': dl.priority === 'medium',
                                     'border-l-indigo-400 bg-indigo-50/20 border-y-indigo-100/50 border-r-indigo-100/50 shadow-indigo-100/10': dl.priority === 'low'
                                 }">
                                <div class="flex items-start gap-2">
                                    <template x-if="dl.priority === 'high'">
                                        <i data-lucide="alert-triangle" class="w-3.5 h-3.5 text-rose-600 mt-0.5 shrink-0"></i>
                                    </template>
                                    <p class="text-xs font-bold text-slate-800 leading-tight" x-text="dl.title"></p>
                                </div>
                                <div class="flex items-center justify-between pt-1">
                                    <span class="text-[10px] text-slate-500 font-bold tracking-tight uppercase" x-text="dl.workspaceName"></span>
                                    <div class="inline-flex items-center px-2 py-0.5 border rounded-full text-[9px] font-bold"
                                         :class="{
                                             'border-rose-200 text-rose-700 bg-white/80': dl.priority === 'high',
                                             'border-amber-200 text-amber-700 bg-white/80': dl.priority === 'medium',
                                             'border-indigo-200 text-indigo-700 bg-white/80': dl.priority === 'low'
                                         }" x-text="dl.formattedDate"></div>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Section 2: Unscheduled Tasks -->
                <div class="space-y-2.5 pt-3 border-t border-slate-100">
                    <h4 class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Unscheduled Tasks</h4>
                    <div x-show="unscheduledTasks.length === 0" class="text-center py-4 text-xs font-semibold text-slate-400 bg-slate-50 rounded-xl border border-dashed border-slate-100">
                        No unscheduled tasks.
                    </div>
                    <div class="space-y-2">
                        <template x-for="dl in unscheduledTasks" :key="dl.id">
                            <div draggable="true" 
                                 @@dragstart="handleDeadlineDragStart($event, dl)"
                                 @@click="openEdit(dl)"
                                 class="rounded-lg border border-l-[4px] p-3 space-y-1.5 transition-all duration-300 transform hover:-translate-y-0.5 hover:shadow-md cursor-pointer border-l-slate-350 bg-slate-50/40 border-y-slate-200/50 border-r-slate-200/50 shadow-slate-100/5 hover:bg-slate-100/70 hover:border-slate-300">
                                <div class="flex items-start gap-2">
                                    <p class="text-xs font-bold text-slate-650 leading-tight" x-text="dl.title"></p>
                                </div>
                                <div class="flex items-center justify-between pt-1">
                                    <span class="text-[10px] text-slate-400 font-bold tracking-tight uppercase" x-text="dl.workspaceName"></span>
                                    <div class="inline-flex items-center px-2 py-0.5 border rounded-full text-[9px] font-bold border-slate-200 text-slate-500 bg-white/80" x-text="dl.formattedDate"></div>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>
        </div></div>

    <!-- Confirm Schedule Change Dialog Modal -->
    <div x-show="confirmDialogOpen" 
         class="fixed inset-0 z-[200] flex items-center justify-center p-6 bg-slate-900/40 backdrop-blur-sm"
         x-transition x-cloak>
        
        <div @@click.away="cancelPendingChange()" 
             class="w-full max-w-sm bg-white p-6 rounded-xl border border-slate-200 shadow-2xl space-y-4 relative animate-in fade-in zoom-in-95 duration-200">
            
            <div class="flex items-center gap-3 pb-2 border-b border-slate-100 text-indigo-600">
                <i data-lucide="calendar-clock" class="w-5 h-5"></i>
                <h3 class="text-base font-bold text-slate-800" x-text="pendingChange && pendingChange.isResize ? 'Confirm Duration Change' : 'Confirm Schedule Change'"></h3>
            </div>

            <div class="space-y-3 py-1">
                <p class="text-xs text-slate-500 leading-normal">
                    Are you sure you want to <span x-text="pendingChange && pendingChange.isResize ? 'change the duration of' : 'reschedule'"></span> <strong class="text-slate-800 font-semibold" x-text="pendingChange ? pendingChange.title : ''"></strong>?
                </p>

                <div class="p-3 bg-slate-50 border border-slate-150 rounded-lg space-y-2 text-xs">
                    <!-- From original time -->
                    <div class="flex items-center justify-between text-slate-500 font-medium">
                        <span>Original Time:</span>
                        <span class="font-bold text-slate-700" 
                              x-text="pendingChange ? (pendingChange.originalDayIdx !== null && pendingChange.originalDayIdx !== undefined ? (['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'][pendingChange.originalDayIdx] + ' @@ ' + formatTimeRange(pendingChange.originalStartSlot, pendingChange.originalDuration)) : 'Unscheduled') : ''"></span>
                    </div>
                    <!-- Arrow Down visual -->
                    <div class="flex justify-center text-indigo-500">
                        <i data-lucide="arrow-down" class="w-3.5 h-3.5"></i>
                    </div>
                    <!-- To new time -->
                    <div class="flex items-center justify-between text-slate-500 font-medium">
                        <span>New Proposed:</span>
                        <span class="font-bold text-indigo-600" 
                              x-text="pendingChange ? (['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'][pendingChange.newDayIdx] + ' @@ ' + formatTimeRange(pendingChange.newStartSlot, pendingChange.newDuration)) : ''"></span>
                    </div>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
                <button @@click="cancelPendingChange()" 
                        class="px-4 py-2 border border-slate-200 text-slate-500 hover:bg-slate-50 rounded-lg text-xs font-semibold transition-colors"
                        x-text="pendingChange && pendingChange.isResize ? 'Cancel Resize' : 'Cancel Move'">
                </button>
                <button @@click="confirmPendingChange()" 
                        class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold shadow-sm transition-all"
                        x-text="pendingChange && pendingChange.isResize ? 'Confirm Resize' : 'Confirm Move'">
                </button>
            </div>
        </div>
    </div>

    <!-- Custom Glassmorphic Warning Alert Modal -->
    <div x-show="alertModalOpen" 
         class="fixed inset-0 z-[100] flex items-center justify-center p-6 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200"
         x-transition x-cloak>
        <div @@click.away="alertModalOpen = false" 
             class="w-full max-w-sm bg-white p-6 rounded-2xl border border-slate-200 shadow-2xl space-y-4 relative animate-in fade-in zoom-in-95 duration-200">
            <div class="flex items-center gap-3 text-rose-500 pb-2 border-b border-slate-100">
                <div class="p-2 bg-rose-50 rounded-xl">
                    <i data-lucide="alert-triangle" class="w-5 h-5 text-rose-600"></i>
                </div>
                <h3 class="text-base font-black text-slate-800" x-text="alertModalTitle"></h3>
            </div>
            
            <p class="text-xs font-semibold text-slate-650 leading-relaxed" x-html="alertModalMessage"></p>
            
            <div class="flex justify-end pt-2">
                <button @@click="alertModalOpen = false" 
                        class="px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-bold transition-all shadow-md active:scale-95 cursor-pointer">
                    Got it
                </button>
            </div>
        </div>
    </div>

    <!-- Create/Edit Task Dialog Modal -->
    <div x-show="dialogOpen" 
         class="fixed inset-0 z-[200] flex items-center justify-center p-6 bg-slate-900/40 backdrop-blur-sm"
         x-transition x-cloak>
        
        <div @@click.away="dialogOpen = false" 
             class="w-full max-w-md bg-white p-6 rounded-xl border border-slate-200 shadow-2xl space-y-4 relative animate-in fade-in zoom-in-95 duration-200">
            
            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                <h3 class="text-lg font-bold text-slate-800" x-text="isTaskForm ? 'Schedule Workspace Task' : (isEdit ? 'Edit Personal Event' : 'Create Personal Event')"></h3>
                <button @@click="dialogOpen = false" class="p-1 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-50 transition-colors">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <div class="space-y-4 max-h-[60vh] overflow-y-auto pr-1.5 scrollbar-thin">
                <!-- Workspace Task Info Banner -->
                <template x-if="isTaskForm">
                    <div class="space-y-3">
                        <div class="text-xs text-indigo-700 bg-indigo-50 border border-indigo-100 rounded-lg p-3 flex items-start gap-2.5">
                            <i data-lucide="info" class="w-4.5 h-4.5 text-indigo-500 shrink-0 mt-0.5"></i>
                            <div>
                                <p class="font-bold">Workspace Task Information</p>
                                <p class="mt-0.5 text-[11px] text-indigo-600/90 leading-normal font-medium">This task is synced with the <strong x-text="formWorkspaceName"></strong> workspace. You can schedule it on your personal calendar below. Title, description, and priority are managed on the workspace board.</p>
                            </div>
                        </div>
                        <a :href="'/WorkspaceDetail/' + formWorkspaceJoinCode" 
                           class="w-full py-2 bg-indigo-50 text-indigo-700 border border-indigo-200 hover:bg-indigo-100 rounded-lg text-xs font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                            <i data-lucide="external-link" class="w-3.5 h-3.5"></i> Go to Workspace Task Board
                        </a>
