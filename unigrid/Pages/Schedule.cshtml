                                <!-- Hour Column -->
                                <div class="flex-1 flex flex-col items-center">
                                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider mb-1.5">HH</span>
                                    <div class="w-full h-36 overflow-y-auto scrollbar-thin flex flex-col gap-0.5">
                                        <template x-for="h in ['01','02','03','04','05','06','07','08','09','10','11','12']">
                                            <button type="button" @@click="endHour = h; updateEndTimeFromCustom()"
                                                    class="w-full py-1 text-xs font-semibold rounded-lg text-center transition-all"
                                                    :class="endHour === h ? 'bg-indigo-600 text-white shadow-sm font-bold' : 'text-slate-600 hover:bg-slate-50'"
                                                    x-text="h"></button>
                                        </template>
                                    </div>
                                </div>
                                <!-- Divider -->
                                <div class="w-px bg-slate-100 self-stretch my-2"></div>
                                <!-- Minute Column -->
                                <div class="flex-1 flex flex-col items-center">
                                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider mb-1.5">MM</span>
                                    <div class="w-full h-36 overflow-y-auto scrollbar-thin flex flex-col gap-0.5">
                                        <template x-for="m in ['00','05','10','15','20','25','30','35','40','45','50','55']">
                                            <button type="button" @@click="endMinute = m; updateEndTimeFromCustom()"
                                                    class="w-full py-1 text-xs font-semibold rounded-lg text-center transition-all"
                                                    :class="endMinute === m ? 'bg-indigo-600 text-white shadow-sm font-bold' : 'text-slate-600 hover:bg-slate-50'"
                                                    x-text="m"></button>
                                        </template>
                                    </div>
                                </div>
                                <!-- Divider -->
                                <div class="w-px bg-slate-100 self-stretch my-2"></div>
                                <!-- AM/PM Column -->
                                <div class="w-12 flex flex-col items-center">
                                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider mb-1.5">AM/PM</span>
                                    <div class="w-full flex flex-col gap-1 mt-2">
                                        <button type="button" @@click="endAmpm = 'AM'; updateEndTimeFromCustom()"
                                                class="w-full py-1.5 text-xs font-bold rounded-lg text-center transition-all"
                                                :class="endAmpm === 'AM' ? 'bg-indigo-600 text-white shadow-sm font-bold' : 'text-slate-600 hover:bg-slate-50'">AM</button>
                                        <button type="button" @@click="endAmpm = 'PM'; updateEndTimeFromCustom()"
                                                class="w-full py-1.5 text-xs font-bold rounded-lg text-center transition-all"
                                                :class="endAmpm === 'PM' ? 'bg-indigo-650 text-white shadow-sm font-bold' : 'text-slate-600 hover:bg-slate-50'">PM</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-1.5 col-span-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Time Zone</label>
                            <select x-model="formTimeZone"
                                    class="w-full px-3 py-1.5 border border-slate-200 rounded-lg outline-none bg-white font-medium text-xs text-slate-700 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all">
                                <option value="UTC">UTC</option>
                                <option value="Asia/Ho_Chi_Minh">Asia/Ho_Chi_Minh (UTC+7)</option>
                                <option value="Asia/Tokyo">Asia/Tokyo (UTC+9)</option>
                                <option value="Europe/London">Europe/London (UTC+0)</option>
                                <option value="America/New_York">America/New_York (UTC-5)</option>
                                <option value="America/Los_Angeles">America/Los_Angeles (UTC-8)</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Action buttons -->
            <div class="flex items-center justify-between border-t border-slate-100 pt-3 mt-4">
                <div>
                    <template x-if="isEdit && !isTaskForm">
                        <div class="flex gap-2">
                            <button @@click="deleteEvent()" 
                                    class="px-3 py-1.5 bg-rose-50 text-rose-600 border border-rose-100 hover:bg-rose-100 rounded-lg text-xs font-semibold flex items-center gap-1 transition-colors">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Delete
                            </button>
                            <button @@click="duplicateEvent()" 
                                    class="px-3 py-1.5 bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 rounded-lg text-xs font-semibold flex items-center gap-1 transition-colors">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i> Duplicate
                            </button>
                        </div>
                    </template>
                    <template x-if="isTaskForm && isEdit">
