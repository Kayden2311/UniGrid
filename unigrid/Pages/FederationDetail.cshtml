@page
@model unigrid.Pages.FederationDetailModel
@{
    ViewData["Title"] = $"Joint Control Center - {Model.Federation.Name}";
    Layout = "_Layout";
}

<div class="space-y-8 py-6 px-4 md:px-8 max-w-7xl mx-auto overflow-y-auto h-[calc(100vh-4rem)] scrollbar-thin">
    
    <!-- ─── Premium Glassmorphic Header ─── -->
    <div class="glass p-8 rounded-[3rem] border border-slate-200/60 shadow-lg relative overflow-hidden bg-gradient-to-r from-violet-500/10 via-indigo-500/5 to-transparent">
        <div class="absolute -right-24 -top-24 w-96 h-96 bg-violet-400/20 rounded-full blur-[100px] pointer-events-none"></div>
        <div class="absolute -left-24 -bottom-24 w-96 h-96 bg-indigo-400/10 rounded-full blur-[100px] pointer-events-none"></div>
        
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex items-center gap-5">
                <div class="h-16 w-16 rounded-3xl bg-gradient-to-tr from-violet-600 to-indigo-600 flex items-center justify-center text-white shadow-xl shadow-indigo-200">
                    <i data-lucide="globe" class="w-9 h-9"></i>
                </div>
                <div>
                    <h2 class="text-3xl font-black text-slate-800 tracking-tight font-display">🌐 Joint Control Center</h2>
                    <p class="text-slate-500 text-sm mt-1 leading-relaxed">
                        Federation: <span class="font-extrabold text-violet-600">@Model.Federation.Name</span> 
                        • Join Code: <span class="font-mono font-bold bg-slate-100 text-slate-700 px-2 py-0.5 rounded">@Model.Federation.JoinCode</span>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <a href="/Workspaces" class="px-5 py-3 border border-slate-200 hover:bg-slate-50 text-slate-600 rounded-2xl text-xs font-black shadow-sm transition-all flex items-center gap-2">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Hub
                </a>
            </div>
        </div>
    </div>

    <!-- ─── Alert Feed ─── -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-100 text-rose-600 rounded-2xl text-xs font-bold flex items-center gap-2.5 shadow-sm animate-pulse">
            <i data-lucide="alert-triangle" class="w-5 h-5 shrink-0"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-green-50 border border-green-100 text-green-600 rounded-2xl text-xs font-bold flex items-center gap-2.5 shadow-sm">
            <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- ─── Aggregate Analytics Grid ─── -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Portals Count -->
        <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm flex items-center gap-4 hover:shadow transition-all group">
            <div class="h-12 w-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                <i data-lucide="layers" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-2xl font-black text-slate-800">@Model.TotalChildWorkspaces</p>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-0.5">Child Portals</p>
            </div>
        </div>

        <!-- Active Members -->
        <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm flex items-center gap-4 hover:shadow transition-all group">
            <div class="h-12 w-12 rounded-2xl bg-violet-50 text-violet-600 flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                <i data-lucide="users" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-2xl font-black text-slate-800">@Model.TotalActiveMembers</p>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-0.5">Federated Members</p>
            </div>
        </div>

        <!-- Tasks Completed -->
        <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm flex items-center gap-4 hover:shadow transition-all group">
            <div class="h-12 w-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                <i data-lucide="check-circle" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-2xl font-black text-slate-800">@Model.TotalTasksDone</p>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-0.5">Tasks Completed</p>
            </div>
        </div>

        <!-- Shared Documents Count -->
        <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm flex items-center gap-4 hover:shadow transition-all group">
            <div class="h-12 w-12 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                <i data-lucide="file-text" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-2xl font-black text-slate-800">@Model.TotalFilesCount</p>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-0.5">Shared Documents</p>
            </div>
        </div>
    </div>

    <!-- ─── Core Content Sections ─── -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left 2 Columns: Child Portals Grid -->
        <div class="lg:col-span-2 space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-black text-slate-800 tracking-tight">Affiliated Child Portals</h3>
                    <p class="text-xs text-slate-500 mt-0.5">All workspaces linked and controlled within this federation.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                @if (!Model.ChildWorkspaces.Any())
                {
                    <div class="col-span-2 glass p-12 text-center text-slate-400 font-bold rounded-[2.5rem] border border-slate-200/50">
                        <i data-lucide="folder-open" class="w-12 h-12 text-slate-350 mx-auto mb-3"></i>
                        <p class="text-sm">No child portals connected yet.</p>
                        <p class="text-xs text-slate-400 mt-1 font-medium">Use the panel on the right to link owned workspaces or create new ones.</p>
                    </div>
                }
                @foreach (var ws in Model.ChildWorkspaces)
                {
                    var isGroup = ws.WorkspaceType == "Group";
                    var initials = ws.Name.Substring(0, 1).ToUpper();
                    var badgeBg = isGroup ? "bg-indigo-50 text-indigo-600 border border-indigo-100" : "bg-teal-50 text-teal-600 border border-teal-100";
                    
                    <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm flex flex-col justify-between h-56 hover:shadow-lg transition-all relative overflow-hidden group">
                        <!-- BG subtle glow -->
                        <div class="absolute -right-12 -top-12 w-28 h-28 bg-indigo-50/40 rounded-full blur-[30px] pointer-events-none group-hover:scale-110 transition-transform"></div>
                        
                        <div class="space-y-4">
                            <!-- Top row: initial avatar and type badge -->
                            <div class="flex items-center justify-between">
                                <div class="h-10 w-10 rounded-2xl bg-slate-100 flex items-center justify-center font-black text-slate-600 text-sm shadow-inner">
                                    @initials
                                </div>
                                <span class="px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider @badgeBg">
                                    @(isGroup ? "Group Board" : "Solo Portal")
                                </span>
                            </div>

                            <!-- Title and Join Code -->
                            <div>
                                <h4 class="font-black text-slate-800 text-base truncate group-hover:text-indigo-600 transition-colors">@ws.Name</h4>
                                <p class="text-[10px] text-slate-400 font-mono mt-1">Code: #@ws.JoinCode • @(ws.PackageTier ?? "Free") Plan</p>
                            </div>
                        </div>

                        <!-- Footer Actions -->
                        <div class="flex items-center justify-between pt-4 border-t border-slate-100/50 mt-auto">
                            <span class="text-[10px] font-bold text-slate-400">Owner: @(ws.OwnerId == Model.CurrentUser.Id ? "You" : "Co-member")</span>
                            <a href="/WorkspaceDetail/@ws.JoinCode" class="h-9 px-4 bg-slate-900 text-white text-xs font-black rounded-xl hover:bg-indigo-600 shadow shadow-slate-200 hover:shadow-indigo-100 transition-all flex items-center gap-1.5 cursor-pointer">
                                <span>Manage Portal</span>
                                <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- ─── Shared Document Portal ─── -->
            <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm space-y-4">
                <div class="flex items-center justify-between border-b border-slate-150/50 pb-4">
                    <div class="flex items-center gap-2">
                        <i data-lucide="folder-git-2" class="w-5 h-5 text-indigo-600 animate-pulse"></i>
                        <h3 class="text-base font-black text-slate-800 tracking-tight">Federated Document Portal</h3>
                    </div>
                    <span class="px-2.5 py-0.5 bg-violet-50 text-violet-600 border border-violet-100 text-[10px] font-black rounded-md uppercase tracking-wider">Projected View</span>
                </div>

                <div class="space-y-2.5 max-h-[300px] overflow-y-auto pr-1">
                    @if (!Model.SharedFiles.Any())
                    {
                        <div class="text-center py-10 text-slate-400 font-bold text-xs select-none">
                            No shared files across portals yet.
                        </div>
                    }
                    @foreach (var file in Model.SharedFiles)
                    {
                        var fileIcon = file.FileType == "pdf" ? "file-text" : file.FileType == "doc" ? "file-text" : file.FileType == "spreadsheet" ? "file-spreadsheet" : "image";
                        var fileIconColor = file.FileType == "pdf" ? "text-rose-500 bg-rose-50 border-rose-100" : file.FileType == "doc" ? "text-indigo-600 bg-indigo-50 border-indigo-100" : file.FileType == "spreadsheet" ? "text-green-600 bg-green-50 border-green-100" : "text-purple-500 bg-purple-50 border-purple-100";

                        <div class="p-4 bg-slate-50/50 hover:bg-slate-50 border border-slate-100 rounded-2xl flex items-center justify-between transition-all group">
                            <div class="flex items-center gap-3.5 min-w-0">
                                <div class="h-10 w-10 rounded-xl flex items-center justify-center shrink-0 border @fileIconColor">
                                    <i data-lucide="@fileIcon" class="w-5 h-5"></i>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-xs font-black text-slate-700 truncate leading-snug">@file.FileName</p>
                                    <p class="text-[9px] font-bold text-slate-400 mt-0.5">
                                        Portal: <strong class="text-slate-500 font-extrabold">@file.Workspace.Name</strong> 
                                        • By: <span class="font-extrabold text-indigo-500">@file.User.FullName</span>
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                <span class="text-[9px] font-bold text-slate-400 uppercase mr-1">@(file.FileSize / 1024) KB</span>
                                <a href="/@file.FileUrl" class="h-8 w-8 rounded-lg hover:bg-slate-200/60 flex items-center justify-center text-slate-500 transition-colors shadow-sm" download>
                                    <i data-lucide="download" class="w-4 h-4"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right 1 Column: Administration Actions Panel -->
        <div class="space-y-6">
            
            <!-- Panel Header -->
            <div>
                <h3 class="text-xl font-black text-slate-800 tracking-tight">Joint Controls</h3>
                <p class="text-xs text-slate-500 mt-0.5">Administrative workspace links and deployment forms.</p>
            </div>

            <!-- Form A: Link Existing Workspace -->
            <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm space-y-4">
                <div class="flex items-center gap-2 pb-2 border-b border-slate-100">
                    <i data-lucide="link" class="w-4.5 h-4.5 text-indigo-500"></i>
                    <h4 class="text-xs font-black text-slate-800 uppercase tracking-widest">Link Existing Portal</h4>
                </div>
                
                <p class="text-[10px] text-slate-400 leading-relaxed">
                    Connect an owned Solo Personal workspace as a child workspace inside this enterprise federation.
                </p>

                @if (!Model.EligibleWorkspacesToLink.Any())
                {
                    <div class="p-4 bg-slate-50 border border-slate-150/60 rounded-2xl text-center text-[10px] font-bold text-slate-400 italic">
                        No eligible personal workspaces available to link. All owned personal workspaces are already affiliated.
                    </div>
                }
                else
                {
                    <form method="post" asp-page-handler="LinkChildWorkspace" asp-route-joinCode="@Model.Federation.JoinCode" class="space-y-3.5">
                        @Html.AntiForgeryToken()
                        <div class="space-y-1">
                            <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Select Personal Workspace</label>
                            <select name="workspaceId" required class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all cursor-pointer">
                                @foreach (var ws in Model.EligibleWorkspacesToLink)
                                {
                                    <option value="@ws.Id">@ws.Name (Code: #@ws.JoinCode)</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="w-full py-3.5 bg-slate-900 text-white rounded-2xl text-xs font-black shadow hover:bg-indigo-600 transition-all flex items-center justify-center gap-1.5">
                            <i data-lucide="plus-circle" class="w-4 h-4"></i> Link Selected Workspace
                        </button>
                    </form>
                }
            </div>

            <!-- Form B: Create New Child Workspace -->
            <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm space-y-4">
                <div class="flex items-center gap-2 pb-2 border-b border-slate-100">
                    <i data-lucide="plus" class="w-4.5 h-4.5 text-violet-500"></i>
                    <h4 class="text-xs font-black text-slate-800 uppercase tracking-widest">Deploy New Child Portal</h4>
                </div>
                
                <p class="text-[10px] text-slate-400 leading-relaxed">
                    Deploy a clean Group workspace directly affiliated with this federation. ProPlus package limits will apply.
                </p>

                <form method="post" asp-page-handler="AddChildWorkspace" asp-route-joinCode="@Model.Federation.JoinCode" class="space-y-3.5">
                    @Html.AntiForgeryToken()
                    <div class="space-y-1">
                        <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Workspace Name</label>
                        <input type="text" asp-for="NewChildWorkspaceName" placeholder="e.g. BA Department, Marketing Branch" required
                               class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                    </div>
                    <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-violet-600 to-indigo-600 text-white rounded-2xl text-xs font-black shadow-lg shadow-indigo-150 hover:from-violet-750 hover:to-indigo-750 transition-all flex items-center justify-center gap-1.5">
                        <i data-lucide="arrow-right-circle" class="w-4 h-4 animate-pulse"></i> Deploy Child Workspace
                    </button>
                </form>
            </div>
            
            <!-- Premium Federation Information Card -->
            <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm bg-gradient-to-br from-violet-50/30 to-indigo-50/20 space-y-4">
                <div class="flex items-center gap-2">
                    <i data-lucide="shield-check" class="w-4.5 h-4.5 text-emerald-500"></i>
                    <h4 class="text-xs font-black text-slate-800 uppercase tracking-widest">Enterprise Compliance</h4>
                </div>
                <ul class="space-y-3 text-[10px] text-slate-500 font-bold">
                    <li class="flex items-start gap-2">
                        <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5"></i>
                        <span>Unified Document Indexing operates under encrypted storage protocols.</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5"></i>
                        <span>High-level managers maintain supreme visibility controls.</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5"></i>
                        <span>Personal collaboration is completely isolated to secure workspace child environments.</span>
                    </li>
                </ul>
            </div>

        </div>

    </div>

</div>

<script>
    setTimeout(() => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }, 100);
</script>
