@page
@model unigrid.Pages.FederationDetailModel
@{
    ViewData["Title"] = $"Joint Control Center - {Model.Federation.Name}";
    Layout = "_Layout";

    // Compute Metrics across Federation and Children
    var totalTasks = Model.FederationTasks.Count + Model.ChildTasks.Count;
    var inProgressTasks = Model.FederationTasks.Count(t => t.Status == 1) + Model.ChildTasks.Count(t => t.Status == 1);
    var reviewTasks = Model.FederationTasks.Count(t => t.Status == 2) + Model.ChildTasks.Count(t => t.Status == 2);
    var completedTasks = Model.FederationTasks.Count(t => t.Status == 3) + Model.ChildTasks.Count(t => t.Status == 3);
    var todoTasks = Model.FederationTasks.Count(t => t.Status == 0) + Model.ChildTasks.Count(t => t.Status == 0);
    var overdueTasks = Model.FederationTasks.Count(t => t.Status != 3 && t.DueDate < DateTime.UtcNow) + Model.ChildTasks.Count(t => t.Status != 3 && t.DueDate < DateTime.UtcNow);

    // Dynamic Color Palette for SVGs
    var todoColor = "#94a3b8"; // Slate
    var inProgressColor = "#4f46e5"; // Indigo
    var reviewColor = "#a855f7"; // Purple
    var doneColor = "#22c55e"; // Green

    // Member data serialization for charts
    var memberChartData = Model.FederationUsers.Select(u => {
        var assigned = Model.FederationTasks.Count(t => t.AssigneeId == u.Id) + Model.ChildTasks.Count(t => t.AssigneeId == u.Id);
        var completed = Model.FederationTasks.Count(t => t.AssigneeId == u.Id && t.Status == 3) + Model.ChildTasks.Count(t => t.AssigneeId == u.Id && t.Status == 3);
        var rate = assigned > 0 ? (int)Math.Round((double)completed / assigned * 100) : 0;
        return new {
            Name = u.FullName.Split(' ')[0],
            FullName = u.FullName,
            Assigned = assigned,
            Completed = completed,
            Rate = rate
        };
    }).OrderByDescending(m => m.Completed).ToList();
}

<div class="space-y-8 py-6 px-4 md:px-8 max-w-7xl mx-auto overflow-y-auto h-[calc(100vh-4rem)] scrollbar-thin">
    
    <!-- ─── Premium Glassmorphic Header ─── -->
    <div class="glass p-8 rounded-[3rem] border border-slate-200/60 shadow-lg relative overflow-hidden bg-gradient-to-r from-violet-500/10 via-indigo-500/5 to-transparent">
        <div class="absolute -right-24 -top-24 w-96 h-96 bg-violet-400/20 rounded-full blur-[100px] pointer-events-none"></div>
        <div class="absolute -left-24 -bottom-24 w-96 h-96 bg-indigo-400/10 rounded-full blur-[100px] pointer-events-none"></div>
        
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex items-center gap-5">
                <div class="h-16 w-16 rounded-3xl bg-gradient-to-tr from-violet-600 to-indigo-600 flex items-center justify-center text-white shadow-xl shadow-indigo-200">
                    <i data-lucide="globe" class="w-9 h-9"></i>
                </div>
                <div>
                    <h2 class="text-3xl font-black text-slate-800 tracking-tight font-display">🌐 Joint Control Center</h2>
                    <p class="text-slate-500 text-sm mt-1 leading-relaxed">
                        Federation: <span class="font-extrabold text-violet-600">@Model.Federation.Name</span> 
                        • Join Code: <span class="font-mono font-bold bg-slate-100 text-slate-700 px-2 py-0.5 rounded">@Model.Federation.JoinCode</span>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <a href="/Workspaces" class="px-5 py-3 border border-slate-200 hover:bg-slate-50 text-slate-600 rounded-2xl text-xs font-black shadow-sm transition-all flex items-center gap-2">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Hub
                </a>
            </div>
        </div>
    </div>

    <!-- ─── Alert Feed ─── -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-100 text-rose-600 rounded-2xl text-xs font-bold flex items-center gap-2.5 shadow-sm animate-pulse">
            <i data-lucide="alert-triangle" class="w-5 h-5 shrink-0"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-green-50 border border-green-100 text-green-600 rounded-2xl text-xs font-bold flex items-center gap-2.5 shadow-sm">
            <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- ─── Aggregate Analytics Grid ─── -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Portals Count -->
        <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm flex items-center gap-4 hover:shadow transition-all group">
            <div class="h-12 w-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                <i data-lucide="layers" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-2xl font-black text-slate-800">@Model.TotalChildWorkspaces</p>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-0.5">Child Portals</p>
            </div>
        </div>

        <!-- Active Members -->
        <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm flex items-center gap-4 hover:shadow transition-all group">
            <div class="h-12 w-12 rounded-2xl bg-violet-50 text-violet-600 flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                <i data-lucide="users" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-2xl font-black text-slate-800">@Model.TotalActiveMembers</p>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-0.5">Federated Members</p>
            </div>
        </div>

        <!-- Tasks Completed -->
        <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm flex items-center gap-4 hover:shadow transition-all group">
            <div class="h-12 w-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                <i data-lucide="check-circle" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-2xl font-black text-slate-800">@Model.TotalTasksDone</p>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-0.5">Tasks Completed</p>
            </div>
        </div>

        <!-- Shared Documents Count -->
        <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm flex items-center gap-4 hover:shadow transition-all group">
            <div class="h-12 w-12 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                <i data-lucide="file-text" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-2xl font-black text-slate-800">@Model.TotalFilesCount</p>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-0.5">Shared Documents</p>
            </div>
        </div>
    </div>

    <!-- ─── Tab-Based Navigation Wrapper ─── -->
    <div x-data="federationDetail" class="space-y-8">
        
        <!-- Tab Navigation Buttons -->
        <div class="flex items-center gap-2 p-1.5 glass rounded-2xl border border-slate-200/60 shadow-xs max-w-xl">
            <button @@click="activeTab = 'overview'" :class="activeTab === 'overview' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100/50'" class="flex-1 py-2.5 rounded-xl text-xs font-black transition-all flex items-center justify-center gap-2 cursor-pointer border-0 outline-none">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Overview
            </button>
            <button @@click="activeTab = 'tasks'" :class="activeTab === 'tasks' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100/50'" class="flex-1 py-2.5 rounded-xl text-xs font-black transition-all flex items-center justify-center gap-2 cursor-pointer border-0 outline-none">
                <i data-lucide="kanban" class="w-4 h-4"></i> Tasks
            </button>
            <button @@click="activeTab = 'kpis'" :class="activeTab === 'kpis' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100/50'" class="flex-1 py-2.5 rounded-xl text-xs font-black transition-all flex items-center justify-center gap-2 cursor-pointer border-0 outline-none">
                <i data-lucide="award" class="w-4 h-4"></i> KPIs
            </button>
            <button @@click="activeTab = 'chat'" :class="activeTab === 'chat' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100/50'" class="flex-1 py-2.5 rounded-xl text-xs font-black transition-all flex items-center justify-center gap-2 cursor-pointer border-0 outline-none">
                <i data-lucide="message-square" class="w-4 h-4"></i> Chat Hub
            </button>
            <button @@click="activeTab = 'members'" :class="activeTab === 'members' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100/50'" class="flex-1 py-2.5 rounded-xl text-xs font-black transition-all flex items-center justify-center gap-2 cursor-pointer border-0 outline-none">
                <i data-lucide="users" class="w-4 h-4"></i> Members
            </button>
            @if (Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "HeadPresident")
            {
                <button @@click="activeTab = 'settings'" :class="activeTab === 'settings' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100/50'" class="flex-1 py-2.5 rounded-xl text-xs font-black transition-all flex items-center justify-center gap-2 cursor-pointer border-0 outline-none">
                    <i data-lucide="settings" class="w-4 h-4"></i> Settings
                </button>
            }
        </div>

        <!-- ─── TAB 1: OVERVIEW ─── -->
        <div x-show="activeTab === 'overview'" class="space-y-6" x-transition>
            
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-black text-slate-800 tracking-tight">Affiliated Child Portals</h3>
                    <p class="text-xs text-slate-500 mt-0.5">All workspaces linked and controlled within this federation.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                @if (!Model.ChildWorkspaces.Any())
                {
                    <div class="col-span-full glass p-12 text-center text-slate-400 font-bold rounded-[2.5rem] border border-slate-200/50">
                        <i data-lucide="folder-open" class="w-12 h-12 text-slate-350 mx-auto mb-3"></i>
                        <p class="text-sm">No child portals connected yet.</p>
                        <p class="text-xs text-slate-400 mt-1 font-medium">Use the settings panel to link owned workspaces or create new ones.</p>
                    </div>
                }
                @foreach (var ws in Model.ChildWorkspaces)
                {
                    var isGroup = ws.WorkspaceType == "Group";
                    var initials = ws.Name.Substring(0, 1).ToUpper();
                    var badgeBg = isGroup ? "bg-indigo-50 text-indigo-600 border border-indigo-100" : "bg-teal-50 text-teal-600 border border-teal-100";
                    
                    <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm flex flex-col justify-between h-56 hover:shadow-lg transition-all relative overflow-hidden group">
                        <div class="absolute -right-12 -top-12 w-28 h-28 bg-indigo-50/40 rounded-full blur-[30px] pointer-events-none group-hover:scale-110 transition-transform"></div>
                        
                        <div class="space-y-4">
                            <div class="flex items-center justify-between">
                                <div class="h-10 w-10 rounded-2xl bg-slate-100 flex items-center justify-center font-black text-slate-600 text-sm shadow-inner">
                                    @initials
                                </div>
                                <span class="px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider @badgeBg">
                                    @(isGroup ? "Group Board" : "Solo Portal")
                                </span>
                            </div>

                            <div>
                                <h4 class="font-black text-slate-800 text-base truncate group-hover:text-indigo-600 transition-colors">@ws.Name</h4>
                                <p class="text-[10px] text-slate-400 font-mono mt-1">Code: #@ws.JoinCode • @(ws.PackageTier ?? "Free") Plan</p>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-4 border-t border-slate-100/50 mt-auto">
                            <span class="text-[10px] font-bold text-slate-400">Owner: @(ws.OwnerId == Model.CurrentUser.Id ? "You" : "Co-member")</span>
                            <a href="/WorkspaceDetail/@ws.JoinCode" class="h-9 px-4 bg-slate-900 text-white text-xs font-black rounded-xl hover:bg-indigo-600 shadow shadow-slate-200 hover:shadow-indigo-100 transition-all flex items-center gap-1.5 cursor-pointer">
                                <span>Manage Portal</span>
                                <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- Charts Row -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- 1. Task Distribution Semi-Circle Donut Chart -->
                <div class="glass p-6 rounded-[2.5rem] shadow-sm flex flex-col justify-between relative overflow-hidden transition-all duration-300 transform hover:scale-[1.03] hover:-translate-y-1 hover:shadow-lg cursor-pointer border border-transparent hover:border-indigo-200 select-none">
                    <div class="flex items-center gap-2 mb-4">
                        <i data-lucide="bar-chart-3" class="w-5 h-5 text-indigo-600"></i>
                        <h3 class="text-base font-black text-slate-800">Task Distribution</h3>
                    </div>
                    
                    <div class="flex items-center justify-center py-4 relative">
                        <!-- Centered Donut Pop-up Tooltip -->
                        <div class="absolute bg-white border border-slate-150 shadow-lg px-6 py-3.5 rounded-2xl text-center z-10 text-xs font-black text-slate-800 transition-all duration-300 pointer-events-none select-none"
                             style="top: 48%; left: 50%; transform: translate(-50%, -50%); min-width: 140px; border-radius: 1rem;"
                             x-show="hoveredSegment !== ''" x-transition x-cloak>
                             <span x-text="hoveredSegment"></span>
                        </div>

                        <!-- Rotated 135deg clockwise so the 25% gap is perfectly centered at the bottom -->
                        <svg viewBox="0 0 42 42" class="w-60 h-60 transform rotate-[135deg]">
                            <!-- Background arc (75% length, 25% gap at bottom) -->
                            <circle cx="21" cy="21" r="15.915" fill="none" stroke="#f1f5f9" stroke-width="4.2" stroke-dasharray="75 25" stroke-dashoffset="0"></circle>
                            
                            @{
                                double total = totalTasks == 0 ? 1 : totalTasks;
                                // Scale active segments within the 75 units active arc
                                double pTodo = ((double)todoTasks / total) * 75;
                                double pInProg = ((double)inProgressTasks / total) * 75;
                                double pReview = ((double)reviewTasks / total) * 75;
                                double pDone = ((double)completedTasks / total) * 75;

                                double offset = 0;
                            }

                            @if (todoTasks > 0)
                            {
                                <circle cx="21" cy="21" r="15.915" fill="none" stroke="@todoColor" stroke-width="4.2" 
                                        stroke-dasharray="@pTodo @(100 - pTodo)" stroke-dashoffset="@offset"
                                        class="cursor-pointer transition-all duration-300 hover:stroke-[5.5]"
                                        @@mouseenter="hoveredSegment = 'To Do : @todoTasks'"
                                        @@mouseleave="hoveredSegment = ''"></circle>
                                offset -= pTodo;
                            }
                            @if (inProgressTasks > 0)
                            {
                                <circle cx="21" cy="21" r="15.915" fill="none" stroke="@inProgressColor" stroke-width="4.2" 
                                        stroke-dasharray="@pInProg @(100 - pInProg)" stroke-dashoffset="@offset"
                                        class="cursor-pointer transition-all duration-300 hover:stroke-[5.5]"
                                        @@mouseenter="hoveredSegment = 'In Progress : @inProgressTasks'"
                                        @@mouseleave="hoveredSegment = ''"></circle>
                                offset -= pInProg;
                            }
                            @if (reviewTasks > 0)
                            {
                                <circle cx="21" cy="21" r="15.915" fill="none" stroke="@reviewColor" stroke-width="4.2" 
                                        stroke-dasharray="@pReview @(100 - pReview)" stroke-dashoffset="@offset"
                                        class="cursor-pointer transition-all duration-300 hover:stroke-[5.5]"
                                        @@mouseenter="hoveredSegment = 'Review : @reviewTasks'"
                                        @@mouseleave="hoveredSegment = ''"></circle>
                                offset -= pReview;
                            }
                            @if (completedTasks > 0)
                            {
                                <circle cx="21" cy="21" r="15.915" fill="none" stroke="@doneColor" stroke-width="4.2" 
                                        stroke-dasharray="@pDone @(100 - pDone)" stroke-dashoffset="@offset"
                                        class="cursor-pointer transition-all duration-300 hover:stroke-[5.5]"
                                        @@mouseenter="hoveredSegment = 'Done : @completedTasks'"
                                        @@mouseleave="hoveredSegment = ''"></circle>
                            }
                        </svg>
                    </div>
                    
                    <!-- Legend -->
                    <div class="flex items-center justify-center gap-4 text-xs font-bold text-slate-500 mt-4">
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span> To Do</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span> In Progress</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span> Review</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-green-500"></span> Done</span>
                    </div>
                </div>

                <!-- Member Contributions Chart -->
                <div class="glass p-6 rounded-[2.5rem] shadow-sm flex flex-col justify-between transition-all duration-300 transform hover:scale-[1.03] hover:-translate-y-1 hover:shadow-lg cursor-pointer border border-transparent hover:border-indigo-200 select-none relative">
                    <div class="flex items-center gap-2 mb-4">
                        <i data-lucide="trending-up" class="w-5 h-5 text-indigo-600"></i>
                        <h3 class="text-base font-black text-slate-800">Member Contributions</h3>
                    </div>
                    
                    <!-- Floating tooltip pop-up style box -->
                    <div class="absolute bg-white border border-slate-150 shadow-xl p-4 rounded-2xl transition-all duration-300 pointer-events-none z-20 w-44 flex flex-col gap-1 text-left"
                         x-show="hoveredMemberIndex !== null"
                         :style="'left: calc(' + ((55 + hoveredMemberIndex * 48) / 300 * 100) + '% - 88px); top: 50px; border-radius: 1rem;'"
                         x-transition x-cloak>
                         <p class="text-xs font-black text-slate-700" x-text="hoveredMemberText"></p>
                         <p class="text-[11px] font-bold text-indigo-650 flex justify-between mt-1.5">
                             <span>Assigned :</span>
                             <span x-text="hoveredMemberAssigned"></span>
                         </p>
                         <p class="text-[11px] font-bold text-emerald-600 flex justify-between">
                             <span>Completed :</span>
                             <span x-text="hoveredMemberCompleted"></span>
                         </p>
                    </div>

                    <div class="flex-1 flex flex-col justify-center py-2">
                        @{
                            int maxTasks = memberChartData.Any() ? memberChartData.Max(m => Math.Max(m.Assigned, 1)) : 5;
                        }
                        <svg viewBox="0 0 300 200" class="w-full h-60">
                            <!-- Grid Lines -->
                            <line x1="30" y1="30" x2="280" y2="30" stroke="#e2e8f0" stroke-dasharray="3" stroke-width="0.75" />
                            <line x1="30" y1="70" x2="280" y2="70" stroke="#e2e8f0" stroke-dasharray="3" stroke-width="0.75" />
                            <line x1="30" y1="110" x2="280" y2="110" stroke="#e2e8f0" stroke-dasharray="3" stroke-width="0.75" />
                            <line x1="30" y1="150" x2="280" y2="150" stroke="#cbd5e1" stroke-width="1.5" />
                            
                            <!-- Y-Axis Labels -->
                            <text x="20" y="34" text-anchor="end" class="text-[9px] font-bold text-slate-400 fill-current">@maxTasks</text>
                            <text x="20" y="74" text-anchor="end" class="text-[9px] font-bold text-slate-400 fill-current">@(maxTasks * 3 / 4)</text>
                            <text x="20" y="114" text-anchor="end" class="text-[9px] font-bold text-slate-400 fill-current">@(maxTasks / 2)</text>
                            <text x="20" y="154" text-anchor="end" class="text-[9px] font-bold text-slate-400 fill-current">0</text>
                            
                            @for (int i = 0; i < Math.Min(memberChartData.Count, 5); i++)
                            {
                                var m = memberChartData[i];
                                double hAssigned = ((double)m.Assigned / maxTasks) * 120;
                                double hCompleted = ((double)m.Completed / maxTasks) * 120;
                                
                                double xBase = 55 + i * 48;
                                string xLabelStr = xBase.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
                                string nameStr = m.Name;
                                
                                <!-- Column Hover Background (Gray highlight) -->
                                <rect x="@(xBase - 18)" y="15" width="36" height="135" fill="#e2e8f0" rx="4"
                                      class="transition-opacity duration-200 pointer-events-none"
                                      :style="hoveredMemberIndex === @i ? 'opacity: 0.6;' : 'opacity: 0;'" />

                                <!-- Assigned Bar (Indigo) -->
                                <rect x="@(xBase - 8)" y="@(150 - hAssigned)" width="10" height="@hAssigned" fill="#4f46e5" rx="1.5"
                                      class="transition-all duration-300 pointer-events-none" />
                                
                                <!-- Completed Bar (Green) -->
                                <rect x="@(xBase + 4)" y="@(150 - hCompleted)" width="10" height="@hCompleted" fill="#22c55e" rx="1.5"
                                      class="transition-all duration-300 pointer-events-none" />

                                <!-- Column Hover Target (Transparent overlay for massive hover area) -->
                                <rect x="@(xBase - 18)" y="15" width="36" height="150" fill="transparent" class="cursor-pointer"
                                      @@mouseenter="hoveredMemberIndex = @i; hoveredMemberText = '@m.FullName'; hoveredMemberAssigned = @m.Assigned; hoveredMemberCompleted = @m.Completed"
                                      @@mouseleave="hoveredMemberIndex = null" />

                                <!-- X Axis Label (First Name) -->
                                @Html.Raw("<text x='" + xLabelStr + "' y='166' text-anchor='middle' class='text-[9px] font-bold text-slate-500 fill-current'>" + nameStr + "</text>")
                            }
                        </svg>
                    </div>
                    <!-- Legend -->
                    <div class="flex items-center gap-4 mt-2 justify-center text-[10px] font-bold text-slate-500">
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-indigo-600 inline-block"></span> Assigned</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span> Completed</span>
                    </div>
                </div>
            </div>

            <!-- Shared Document Portal -->
            <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm space-y-4">
                <div class="flex items-center justify-between border-b border-slate-150/50 pb-4">
                    <div class="flex items-center gap-2">
                        <i data-lucide="folder-git-2" class="w-5 h-5 text-indigo-600 animate-pulse"></i>
                        <h3 class="text-base font-black text-slate-800 tracking-tight">Federated Document Portal</h3>
                    </div>
                    <span class="px-2.5 py-0.5 bg-violet-50 text-violet-600 border border-violet-100 text-[10px] font-black rounded-md uppercase tracking-wider">Projected View</span>
                </div>

                <div class="space-y-2.5 max-h-[300px] overflow-y-auto pr-1">
                    @if (!Model.SharedFiles.Any())
                    {
                        <div class="text-center py-10 text-slate-400 font-bold text-xs select-none">
                            No shared files across portals yet.
                        </div>
                    }
                    @foreach (var file in Model.SharedFiles)
                    {
                        var fileIcon = file.FileType == "pdf" ? "file-text" : file.FileType == "doc" ? "file-text" : file.FileType == "spreadsheet" ? "file-spreadsheet" : "image";
                        var fileIconColor = file.FileType == "pdf" ? "text-rose-500 bg-rose-50 border-rose-100" : file.FileType == "doc" ? "text-indigo-600 bg-indigo-50 border-indigo-100" : file.FileType == "spreadsheet" ? "text-green-600 bg-green-50 border-green-100" : "text-purple-500 bg-purple-50 border-purple-100";

                        <div class="p-4 bg-slate-50/50 hover:bg-slate-50 border border-slate-100 rounded-2xl flex items-center justify-between transition-all group">
                            <div class="flex items-center gap-3.5 min-w-0">
                                <div class="h-10 w-10 rounded-xl flex items-center justify-center shrink-0 border @fileIconColor">
                                    <i data-lucide="@fileIcon" class="w-5 h-5"></i>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-xs font-black text-slate-700 truncate leading-snug">@file.FileName</p>
                                    <p class="text-[9px] font-bold text-slate-400 mt-0.5">
                                        Portal: <strong class="text-slate-500 font-extrabold">@(file.Workspace?.Name ?? "Federation Direct")</strong> 
                                        • By: <span class="font-extrabold text-indigo-500">@file.User.FullName</span>
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                <span class="text-[9px] font-bold text-slate-400 uppercase mr-1">@(file.FileSize / 1024) KB</span>
                                <a href="/@file.FileUrl" class="h-8 w-8 rounded-lg hover:bg-slate-200/60 flex items-center justify-center text-slate-500 transition-colors shadow-sm" download>
                                    <i data-lucide="download" class="w-4 h-4"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <!-- Direct Upload Form & Push Action -->
                @if (Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "HeadPresident" || Model.CurrentUserRole == "DepartmentManager" || (await Model.GetSettingValueAsync(Model.Federation.JoinCode, "allowMemberPushFile", true)))
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                        @if (Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "HeadPresident" || Model.CurrentUserRole == "DepartmentManager")
                        {
                            <form method="post" asp-page-handler="UploadFederationFile" asp-route-joinCode="@Model.Federation.JoinCode" enctype="multipart/form-data" class="flex flex-col gap-2 p-4 bg-slate-50/50 border border-slate-150/40 rounded-2xl">
                                @Html.AntiForgeryToken()
                                <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider block">Direct Upload to Federation</label>
                                <div class="flex items-center gap-2">
                                    <input type="file" name="UploadedFederationFile" required class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-[10px] file:font-black file:bg-slate-900 file:text-white hover:file:bg-indigo-600 transition-all cursor-pointer">
                                    <button type="submit" class="h-8 px-3.5 bg-slate-900 text-white text-[10px] font-black rounded-xl hover:bg-indigo-600 transition-all flex items-center gap-1 cursor-pointer shrink-0">
                                        <i data-lucide="upload-cloud" class="w-3.5 h-3.5"></i> Upload
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="p-4 bg-slate-50/30 border border-dashed border-slate-200 rounded-2xl flex flex-col justify-center items-center text-center">
                                <i data-lucide="lock" class="w-5 h-5 text-slate-400 mb-1"></i>
                                <h4 class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Direct Upload Locked</h4>
                                <p class="text-[9px] text-slate-400 mt-0.5 leading-relaxed">Direct file uploading is restricted to executives and managers.</p>
                            </div>
                        }

                        <div class="p-4 bg-indigo-50/20 border border-indigo-100/50 rounded-2xl flex flex-col justify-between">
                            <div>
                                <h4 class="text-[10px] font-black text-indigo-600 uppercase tracking-wider">Push from Child Workspaces</h4>
                                <p class="text-[10px] text-slate-400 mt-1 leading-relaxed">Share files securely from the workspaces you belong to.</p>
                            </div>
                            <button @@click="showPushModal = true" type="button" class="h-8 px-4 bg-indigo-600 hover:bg-indigo-700 text-white text-[10px] font-black rounded-xl transition-all flex items-center justify-center gap-1.5 cursor-pointer mt-3">
                                <i data-lucide="share-2" class="w-3.5 h-3.5 animate-pulse"></i> Push File
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex items-center justify-center gap-2 p-4 bg-slate-50/50 border border-dashed border-slate-200 rounded-2xl text-slate-400 text-xs font-bold mt-2">
                        <i data-lucide="lock" class="w-4 h-4 text-slate-400"></i>
                        <span>File push and upload operations have been disabled by the administrator.</span>
                    </div>
                }
            </div>
        </div>

        <!-- ─── TAB 6: MEMBERS (ACCESSIBLE TO ALL) ─── -->
        <div x-show="activeTab === 'members'" x-data="{ searchQuery: '' }" class="space-y-6" x-transition>
            
            <!-- Header and Search Section -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h3 class="text-xl font-black text-slate-800 tracking-tight">Active Federation Members</h3>
                    <p class="text-xs text-slate-500 mt-0.5">List of all active accounts in this federation and their roles.</p>
                </div>
                <div class="relative w-full sm:w-80">
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 flex items-center text-slate-400">
                        <i data-lucide="search" class="w-4 h-4"></i>
                    </span>
                    <input type="text" x-model="searchQuery" placeholder="Search members by name or email..." class="w-full pl-10 pr-4 py-2.5 bg-slate-50/50 border border-slate-200 rounded-2xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                </div>
            </div>

            <div class="glass rounded-[2.5rem] border border-slate-200/60 shadow-sm overflow-hidden bg-white/80 w-full">
                <div class="overflow-x-auto font-display">
                    <table class="w-full text-left border-collapse min-w-[700px]">
                        <thead>
                            <tr class="bg-slate-50 text-[10px] font-black text-slate-400 uppercase tracking-widest border-b border-slate-100">
                                <th class="px-6 py-4">Member Name</th>
                                <th class="px-6 py-4">Role</th>
                                <th class="px-6 py-4">Linked Portal</th>
                                <th class="px-6 py-4 text-center">Fed Tasks</th>
                                <th class="px-6 py-4 text-center">Child Tasks</th>
                                <th class="px-6 py-4">Completion Rate</th>
                                @if (Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "HeadPresident")
                                {
                                    <th class="px-6 py-4 text-right">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-xs font-bold text-slate-600">
                            @foreach (var member in Model.ActiveFederationMembers)
                            {
                                var memberUserFullName = member.User?.FullName ?? "Unknown Member";
                                var initials = string.Concat(memberUserFullName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "U")).ToUpper();
                                var isOwner = member.UserId == Model.Federation.OwnerId;

                                var fedTasks = Model.FederationTasks.Where(t => t.AssigneeId == member.UserId).ToList();
                                var childTasks = Model.ChildTasks.Where(t => t.AssigneeId == member.UserId).ToList();

                                var fedAssigned = fedTasks.Count;
                                var fedCompleted = fedTasks.Count(t => t.Status == 3);
                                var childAssigned = childTasks.Count;
                                var childCompleted = childTasks.Count(t => t.Status == 3);

                                var totalAssigned = fedAssigned + childAssigned;
                                var totalCompleted = fedCompleted + childCompleted;
                                var rate = totalAssigned > 0 ? (int)Math.Round((double)totalCompleted / totalAssigned * 100) : 0;

                                var roleColor = isOwner ? "bg-amber-50 text-amber-600 border border-amber-100"
                                                : member.Role == "HeadPresident" ? "bg-purple-50 text-purple-600 border border-purple-100"
                                                : member.Role == "DepartmentManager" ? "bg-emerald-50 text-emerald-600 border border-emerald-100"
                                                : "bg-blue-50 text-blue-600 border border-blue-100";

                                <tr x-show="searchQuery === '' || '@memberUserFullName.ToLower().Replace("'", "\\'")'.includes(searchQuery.toLowerCase()) || '@(member.User?.Account?.Email?.ToLower() ?? "")'.includes(searchQuery.toLowerCase())" class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="h-9 w-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-black text-xs shrink-0 shadow-inner">
                                                @initials
                                            </div>
                                            <div>
                                                <p class="font-black text-slate-800 text-sm">@memberUserFullName</p>
                                                <p class="text-[10px] text-slate-400 font-medium">@member.User?.Account?.Email</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider @roleColor">
                                            @(isOwner ? "Owner" : member.Role)
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-slate-400">
                                        @if (member.PersonalWorkspace != null)
                                        {
                                            <a href="/WorkspaceDetail/@member.PersonalWorkspace.JoinCode" class="text-indigo-650 hover:text-indigo-800 underline font-black">
                                                @member.PersonalWorkspace.Name
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-[10px] font-medium text-slate-400">N/A (Group Portal)</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-center text-slate-700">
                                        <span class="text-xs font-black">@fedCompleted</span><span class="text-slate-400 font-medium">/@fedAssigned</span>
                                    </td>
                                    <td class="px-6 py-4 text-center text-slate-700">
                                        <span class="text-xs font-black">@childCompleted</span><span class="text-slate-400 font-medium">/@childAssigned</span>
                                    </td>
                                    <td class="px-6 py-4 flex-1">
                                        <div class="flex items-center gap-2 mt-1.5">
                                            <div class="w-16 bg-slate-100 h-1.5 rounded-full overflow-hidden shrink-0">
                                                <div class="bg-indigo-600 h-full rounded-full" style="width: @rate%"></div>
                                            </div>
                                            <span class="text-[10px] font-black text-indigo-650">@rate%</span>
                                        </div>
                                    </td>
                                    @if (Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "HeadPresident")
                                    {
                                        <td class="px-6 py-4 text-right">
                                            @if (!isOwner)
                                            {
                                                <div class="flex items-center justify-end gap-2.5">
                                                    @if (Model.CurrentUserRole == "HeadPresident" && (member.Role == "HeadPresident" || member.Role == "Owner"))
                                                    {
                                                        <span class="text-[10px] text-slate-400 font-medium italic">Restricted</span>
                                                    }
                                                    else
                                                    {
                                                        <!-- Custom Role and Permissions Dropdown Button -->
                                                        <div class="relative inline-block text-left" x-data="{ open: false, selectedRole: '@member.Role', canCreateTask: @(Model.IsMemberAllowed(member.UserId, "disabledCreateTaskUsers", member.Role) ? "true" : "false"), canPushFile: @(Model.IsMemberAllowed(member.UserId, "disabledPushFileUsers", member.Role) ? "true" : "false"), canChat: @(Model.IsMemberAllowed(member.UserId, "disabledChatUsers", member.Role) ? "true" : "false"), canCreateChannel: @(Model.IsMemberAllowed(member.UserId, "disabledCreateChannelUsers", member.Role) ? "true" : "false") }">
                                                            <button type="button" @@click="open = !open" 
                                                                    class="px-3 py-1.5 rounded-xl text-[10px] font-black transition-all flex items-center justify-between gap-1.5 cursor-pointer outline-none w-36 shadow-sm border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100"
                                                                    :class="selectedRole === 'HeadPresident' ? 'bg-purple-50 text-purple-650 border-purple-250' 
                                                                           : selectedRole === 'DepartmentManager' ? 'bg-emerald-50 text-emerald-650 border-emerald-255' 
                                                                           : 'bg-blue-50 text-blue-655 border-blue-250'">
                                                                <span class="truncate" x-text="selectedRole === 'DepartmentManager' ? 'Dept Manager' : (selectedRole === 'HeadPresident' ? 'Head President' : selectedRole)"></span>
                                                                <i data-lucide="chevron-down" class="w-3 h-3 transition-transform" :class="[open ? 'rotate-180' : '']"></i>
                                                            </button>
                                                            
                                                            <!-- Dropdown Panel -->
                                                            <div x-show="open" @@click.away="open = false" x-transition x-cloak
                                                                 class="absolute right-0 mt-2 w-64 bg-white border border-slate-150 rounded-2xl shadow-xl z-50 p-4 flex flex-col gap-4 text-left">
                                                                
                                                                <!-- Section 1: Role Selection -->
                                                                <div class="space-y-1.5">
                                                                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block pb-1 border-b border-slate-100/50">Change Role</span>
                                                                    <div class="space-y-1 pt-1">
                                                                        <!-- Member -->
                                                                        <form method="post" asp-page-handler="UpdateFederationMemberRole" asp-route-joinCode="@Model.Federation.JoinCode" class="inline">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="userId" value="@member.UserId" />
                                                                            <input type="hidden" name="role" value="Member" />
                                                                            <input type="hidden" name="canCreateTask" :value="canCreateTask" />
                                                                            <input type="hidden" name="canPushFile" :value="canPushFile" />
                                                                            <input type="hidden" name="canChat" :value="canChat" />
                                                                            <input type="hidden" name="canCreateChannel" :value="canCreateChannel" />
                                                                            <button type="submit" :class="selectedRole === 'Member' ? 'bg-indigo-50 text-indigo-650 font-extrabold shadow-sm' : 'hover:bg-slate-50 text-slate-700'" class="w-full text-left px-3 py-2 rounded-xl text-xs font-semibold flex items-center justify-between transition-all border-0 bg-transparent cursor-pointer">
                                                                                <span>Member</span>
                                                                                @if (member.Role == "Member") {
                                                                                    <i data-lucide="check" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
                                                                                }
                                                                            </button>
                                                                        </form>

                                                                        <!-- Department Manager -->
                                                                        <form method="post" asp-page-handler="UpdateFederationMemberRole" asp-route-joinCode="@Model.Federation.JoinCode" class="inline">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="userId" value="@member.UserId" />
                                                                            <input type="hidden" name="role" value="DepartmentManager" />
                                                                            <input type="hidden" name="canCreateTask" :value="canCreateTask" />
                                                                            <input type="hidden" name="canPushFile" :value="canPushFile" />
                                                                            <input type="hidden" name="canChat" :value="canChat" />
                                                                            <input type="hidden" name="canCreateChannel" :value="canCreateChannel" />
                                                                            <button type="submit" :class="selectedRole === 'DepartmentManager' ? 'bg-indigo-50 text-indigo-655 font-extrabold shadow-sm' : 'hover:bg-slate-50 text-slate-700'" class="w-full text-left px-3 py-2 rounded-xl text-xs font-semibold flex items-center justify-between transition-all border-0 bg-transparent cursor-pointer">
                                                                                <span>Dept Manager</span>
                                                                                @if (member.Role == "DepartmentManager") {
                                                                                    <i data-lucide="check" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
                                                                                }
                                                                            </button>
                                                                        </form>

                                                                        <!-- Head President (Only Owner can promote to Head President) -->
                                                                        @if (Model.CurrentUserRole == "Owner")
                                                                        {
                                                                            <form method="post" asp-page-handler="UpdateFederationMemberRole" asp-route-joinCode="@Model.Federation.JoinCode" class="inline">
                                                                                @Html.AntiForgeryToken()
                                                                                <input type="hidden" name="userId" value="@member.UserId" />
                                                                                <input type="hidden" name="role" value="HeadPresident" />
                                                                                <input type="hidden" name="canCreateTask" :value="canCreateTask" />
                                                                                <input type="hidden" name="canPushFile" :value="canPushFile" />
                                                                                <input type="hidden" name="canChat" :value="canChat" />
                                                                                <input type="hidden" name="canCreateChannel" :value="canCreateChannel" />
                                                                                <button type="submit" :class="selectedRole === 'HeadPresident' ? 'bg-indigo-50 text-indigo-650 font-extrabold shadow-sm' : 'hover:bg-slate-50 text-slate-700'" class="w-full text-left px-3 py-2 rounded-xl text-xs font-semibold flex items-center justify-between transition-all border-0 bg-transparent cursor-pointer">
                                                                                    <span>Head President</span>
                                                                                    @if (member.Role == "HeadPresident") {
                                                                                        <i data-lucide="check" class="w-3.5 h-3.5 text-indigo-600 shrink-0"></i>
                                                                                    }
                                                                                </button>
                                                                            </form>
                                                                        }
                                                                    </div>
                                                                </div>
                                                                
                                                                <!-- Section 2: Permissions Overrides -->
                                                                <div class="space-y-3 pt-2 border-t border-slate-100">
                                                                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block pb-1 border-b border-slate-100/50">Permissions</span>
                                                                    
                                                                    <div class="space-y-2.5 pt-1">
                                                                        <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                                                            <input type="checkbox" x-model="canCreateTask" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 h-3.5 w-3.5 cursor-pointer" />
                                                                            <span class="text-xs font-bold text-slate-600">Create Tasks</span>
                                                                        </label>
                                                                        <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                                                            <input type="checkbox" x-model="canPushFile" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 h-3.5 w-3.5 cursor-pointer" />
                                                                            <span class="text-xs font-bold text-slate-600">Push Files</span>
                                                                        </label>
                                                                        <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                                                            <input type="checkbox" x-model="canChat" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 h-3.5 w-3.5 cursor-pointer" />
                                                                            <span class="text-xs font-bold text-slate-600">Real-time Chat</span>
                                                                        </label>
                                                                        <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                                                            <input type="checkbox" x-model="canCreateChannel" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 h-3.5 w-3.5 cursor-pointer" />
                                                                            <span class="text-xs font-bold text-slate-600">Create Channels</span>
                                                                        </label>
                                                                    </div>

                                                                    <!-- Submit Changes Form for checkboxes -->
                                                                    <div class="pt-2 border-t border-slate-100/50">
                                                                        <form method="post" asp-page-handler="UpdateFederationMemberRole" asp-route-joinCode="@Model.Federation.JoinCode">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="userId" value="@member.UserId" />
                                                                            <input type="hidden" name="role" value="@member.Role" />
                                                                            <input type="hidden" name="canCreateTask" :value="canCreateTask" />
                                                                            <input type="hidden" name="canPushFile" :value="canPushFile" />
                                                                            <input type="hidden" name="canChat" :value="canChat" />
                                                                            <input type="hidden" name="canCreateChannel" :value="canCreateChannel" />
                                                                            <button type="submit" class="w-full py-2 bg-indigo-600 text-white rounded-xl text-xs font-black shadow shadow-indigo-100 hover:bg-indigo-700 transition-all flex items-center justify-center gap-1 cursor-pointer border-0">
                                                                                <i data-lucide="save" class="w-3.5 h-3.5"></i> Save Permissions
                                                                            </button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Kick Member Form -->
                                                        <form method="post" asp-page-handler="RemoveFederationMember" asp-route-joinCode="@Model.Federation.JoinCode" asp-route-userId="@member.UserId" onsubmit="return confirm('Are you sure you want to remove this member from the federation? All of their linked child workspaces will be disconnected.')" class="inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="h-8 w-8 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 flex items-center justify-center border-0 cursor-pointer transition-colors shadow-sm" title="Remove Member">
                                                                <i data-lucide="user-minus" class="w-4 h-4"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-[10px] text-slate-400 font-medium italic">Creator</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ─── TAB 5: SETTINGS (ONLY OWNER & HEADPRESIDENT) ─── -->
        @if (Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "HeadPresident")
        {
            <div x-show="activeTab === 'settings'" class="grid grid-cols-1 lg:grid-cols-3 gap-8" x-transition>
                
                <!-- Left 2 Columns: Requests & Deployments -->
                <div class="lg:col-span-2 space-y-6">
                    <!-- Pending Requests -->
                    <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                            <div class="flex items-center gap-2">
                                <i data-lucide="clock" class="w-5 h-5 text-amber-500"></i>
                                <h3 class="text-base font-black text-slate-800 tracking-tight">Pending Workspace Link Requests</h3>
                            </div>
                            <span class="px-2.5 py-0.5 bg-amber-100 text-amber-800 text-[9px] font-black rounded-md uppercase tracking-wider">Awaiting Action</span>
                        </div>

                        <div class="space-y-3">
                            @if (!Model.PendingFederationLinks.Any())
                            {
                                <div class="text-center py-6 text-slate-450 font-bold text-xs italic">
                                    No pending link requests.
                                </div>
                            }
                            else
                            {
                                @foreach (var req in Model.PendingFederationLinks)
                                {
                                    <div class="p-4 bg-white/80 border border-slate-100 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
                                        <div class="flex items-center gap-3">
                                            <div class="h-9 w-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-black">
                                                <i data-lucide="folder-lock" class="w-5 h-5"></i>
                                            </div>
                                            <div>
                                                <h4 class="text-sm font-bold text-slate-800">@req.PersonalWorkspace?.Name</h4>
                                                <p class="text-[10px] text-slate-400 font-medium">Owner: <strong class="text-slate-500">@req.User.FullName</strong> (@req.User.Account?.Email)</p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-2 self-end sm:self-auto flex-row">
                                            <form method="post" asp-page-handler="ApprovePersonalWorkspace" asp-route-joinCode="@Model.Federation.JoinCode" asp-route-personalWorkspaceId="@req.PersonalWorkspaceId" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="h-8 px-3.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-black rounded-xl transition-all flex items-center gap-1 cursor-pointer border-0">
                                                    <i data-lucide="check" class="w-3.5 h-3.5"></i> Approve
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="RejectPersonalWorkspace" asp-route-joinCode="@Model.Federation.JoinCode" asp-route-personalWorkspaceId="@req.PersonalWorkspaceId" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="h-8 px-3.5 bg-rose-500 hover:bg-rose-600 text-white text-xs font-black rounded-xl transition-all flex items-center gap-1 cursor-pointer border-0">
                                                    <i data-lucide="x" class="w-3.5 h-3.5"></i> Reject
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>



                    <!-- Deploy Child Workspace -->
                    <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm space-y-4">
                        <div class="flex items-center gap-2 pb-2 border-b border-slate-100">
                            <i data-lucide="plus" class="w-4.5 h-4.5 text-violet-500"></i>
                            <h4 class="text-xs font-black text-slate-800 uppercase tracking-widest">Deploy New Child Portal</h4>
                        </div>
                        <p class="text-[10px] text-slate-400 leading-relaxed">Deploy a clean Group workspace directly affiliated with this federation. ProPlus package limits will apply.</p>

                        <form method="post" asp-page-handler="AddChildWorkspace" asp-route-joinCode="@Model.Federation.JoinCode" class="space-y-3.5">
                            @Html.AntiForgeryToken()
                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Workspace Name</label>
                                <input type="text" asp-for="NewChildWorkspaceName" placeholder="e.g. BA Department, Marketing Branch" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                            </div>
                            <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-violet-600 to-indigo-600 text-white rounded-2xl text-xs font-black shadow-lg shadow-indigo-150 hover:from-violet-750 hover:to-indigo-750 transition-all flex items-center justify-center gap-1.5 cursor-pointer border-0">
                                <i data-lucide="arrow-right-circle" class="w-4 h-4 animate-pulse"></i> Deploy Child Workspace
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Right 1 Column: Linking Forms & Info -->
                <div class="space-y-6">
                    <!-- Federation Permissions Configuration -->
                    <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm space-y-4">
                        <div class="flex items-center gap-2 pb-2 border-b border-slate-100">
                            <i data-lucide="sliders" class="w-4.5 h-4.5 text-indigo-500"></i>
                            <h4 class="text-xs font-black text-slate-800 uppercase tracking-widest">Federation Permissions</h4>
                        </div>
                        <p class="text-[10px] text-slate-400 leading-relaxed">Configure virtual constraints and action locks across the federation portal.</p>

                        @{
                            var currentSettings = await Model.GetFederationSettingsAsync(Model.Federation.JoinCode);
                            bool allowMemberCreateTask = currentSettings["allowMemberCreateTask"]?.GetValue<bool>() ?? false;
                            bool allowManagerSetKpi = currentSettings["allowManagerSetKpi"]?.GetValue<bool>() ?? true;
                            bool allowMemberPushFile = currentSettings["allowMemberPushFile"]?.GetValue<bool>() ?? true;
                            bool allowMemberChat = currentSettings["allowMemberChat"]?.GetValue<bool>() ?? true;
                        }

                        <form method="post" asp-page-handler="UpdateFederationSettings" asp-route-joinCode="@Model.Federation.JoinCode" class="space-y-4">
                            @Html.AntiForgeryToken()
                            
                            <div class="flex items-center justify-between p-2 hover:bg-slate-50 rounded-xl transition-all">
                                <div class="space-y-0.5">
                                    <label class="text-xs font-bold text-slate-700 select-none cursor-pointer" for="allowMemberCreateTask">Create Tasks</label>
                                    <p class="text-[9px] text-slate-400">Allow standard members to create federation tasks.</p>
                                </div>
                                <input type="checkbox" name="allowMemberCreateTask" id="allowMemberCreateTask" value="true" checked="@(allowMemberCreateTask ? "checked" : null)" class="h-4.5 w-4.5 rounded-lg border-slate-350 text-indigo-650 focus:ring-indigo-500 cursor-pointer">
                                <input type="hidden" name="allowMemberCreateTask" value="false">
                            </div>

                            <div class="flex items-center justify-between p-2 hover:bg-slate-50 rounded-xl transition-all">
                                <div class="space-y-0.5">
                                    <label class="text-xs font-bold text-slate-700 select-none cursor-pointer" for="allowManagerSetKpi">Set KPIs</label>
                                    <p class="text-[9px] text-slate-400">Allow department managers to set child KPI targets.</p>
                                </div>
                                <input type="checkbox" name="allowManagerSetKpi" id="allowManagerSetKpi" value="true" checked="@(allowManagerSetKpi ? "checked" : null)" class="h-4.5 w-4.5 rounded-lg border-slate-350 text-indigo-650 focus:ring-indigo-500 cursor-pointer">
                                <input type="hidden" name="allowManagerSetKpi" value="false">
                            </div>

                            <div class="flex items-center justify-between p-2 hover:bg-slate-50 rounded-xl transition-all">
                                <div class="space-y-0.5">
                                    <label class="text-xs font-bold text-slate-700 select-none cursor-pointer" for="allowMemberPushFile">Push Files</label>
                                    <p class="text-[9px] text-slate-400">Allow child portal members to push files to federation.</p>
                                </div>
                                <input type="checkbox" name="allowMemberPushFile" id="allowMemberPushFile" value="true" checked="@(allowMemberPushFile ? "checked" : null)" class="h-4.5 w-4.5 rounded-lg border-slate-350 text-indigo-650 focus:ring-indigo-500 cursor-pointer">
                                <input type="hidden" name="allowMemberPushFile" value="false">
                            </div>

                            <div class="flex items-center justify-between p-2 hover:bg-slate-50 rounded-xl transition-all">
                                <div class="space-y-0.5">
                                    <label class="text-xs font-bold text-slate-700 select-none cursor-pointer" for="allowMemberChat">Real-time Chat</label>
                                    <p class="text-[9px] text-slate-400">Allow standard members to participate in the chat room.</p>
                                </div>
                                <input type="checkbox" name="allowMemberChat" id="allowMemberChat" value="true" checked="@(allowMemberChat ? "checked" : null)" class="h-4.5 w-4.5 rounded-lg border-slate-350 text-indigo-650 focus:ring-indigo-500 cursor-pointer">
                                <input type="hidden" name="allowMemberChat" value="false">
                            </div>

                            <button type="submit" class="w-full py-3 bg-indigo-600 text-white rounded-2xl text-xs font-black shadow hover:bg-indigo-700 transition-all flex items-center justify-center gap-1.5 cursor-pointer border-0">
                                <i data-lucide="save" class="w-4 h-4"></i> Save Settings
                            </button>
                        </form>
                    </div>

                    <!-- Link Group Workspace by Invite Code -->
                    <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm space-y-4">
                        <div class="flex items-center gap-2 pb-2 border-b border-slate-100">
                            <i data-lucide="link" class="w-4.5 h-4.5 text-indigo-500"></i>
                            <h4 class="text-xs font-black text-slate-800 uppercase tracking-widest">Link Group Workspace</h4>
                        </div>
                        <p class="text-[10px] text-slate-400 leading-relaxed">Connect an owned Group workspace by entering its secret invite code.</p>

                        <form method="post" asp-page-handler="LinkChildWorkspace" asp-route-joinCode="@Model.Federation.JoinCode" class="space-y-3.5">
                            @Html.AntiForgeryToken()
                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Workspace Invite Code</label>
                                <input type="text" name="inviteCode" required placeholder="Paste group workspace invite code (UUID)" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                            </div>
                            <button type="submit" class="w-full py-3.5 bg-slate-900 text-white rounded-2xl text-xs font-black shadow hover:bg-indigo-600 transition-all flex items-center justify-center gap-1.5 cursor-pointer border-0">
                                <i data-lucide="plus-circle" class="w-4 h-4"></i> Link Workspace
                            </button>
                        </form>
                    </div>

                    <!-- Link Personal Workspace by Invite Code -->
                    <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm space-y-4">
                        <div class="flex items-center gap-2 pb-2 border-b border-slate-100">
                            <i data-lucide="key" class="w-4.5 h-4.5 text-emerald-500"></i>
                            <h4 class="text-xs font-black text-slate-800 uppercase tracking-widest">Link Personal Portal</h4>
                        </div>
                        <p class="text-[10px] text-slate-400 leading-relaxed">Personal plan workspaces must be connected by manually entering their private invite code. Requires approval from the Federation Owner.</p>

                        <form method="post" asp-page-handler="LinkPersonalWorkspaceByCode" asp-route-joinCode="@Model.Federation.JoinCode" class="space-y-3.5">
                            @Html.AntiForgeryToken()
                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Workspace Invite Code</label>
                                <input type="text" name="inviteCode" required placeholder="Paste invite code (UUID)" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                            </div>
                            <button type="submit" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl text-xs font-black shadow transition-all flex items-center justify-center gap-1.5 cursor-pointer border-0">
                                <i data-lucide="link" class="w-4 h-4"></i> Send Linking Request
                            </button>
                        </form>
                    </div>

                    <!-- Compliance Info Card -->
                    <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm bg-gradient-to-br from-violet-50/30 to-indigo-50/20 space-y-4">
                        <div class="flex items-center gap-2">
                            <i data-lucide="shield-check" class="w-4.5 h-4.5 text-emerald-500"></i>
                            <h4 class="text-xs font-black text-slate-800 uppercase tracking-widest">Enterprise Compliance</h4>
                        </div>
                        <ul class="space-y-3 text-[10px] text-slate-500 font-bold">
                            <li class="flex items-start gap-2">
                                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5"></i>
                                <span>Unified Document Indexing operates under encrypted storage protocols.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5"></i>
                                <span>High-level managers maintain supreme visibility controls.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5"></i>
                                <span>Personal collaboration is completely isolated to secure workspace child environments.</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        }

        <!-- ─── TAB 2: TASKS (KANBAN BOARD) ─── -->
        <div x-show="activeTab === 'tasks'" class="space-y-6" x-transition>
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-black text-slate-800 tracking-tight">Federation Kanban Board</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Manage tasks and assignments assigned directly to federation levels.</p>
                </div>
                @if (Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "HeadPresident" || (await Model.GetSettingValueAsync(Model.Federation.JoinCode, "allowMemberCreateTask", false)))
                {
                    <button @@click="showTaskModal = true" class="h-10 px-4 bg-gradient-to-r from-violet-600 to-indigo-600 text-white rounded-xl text-xs font-black shadow hover:from-violet-750 hover:to-indigo-750 transition-all flex items-center gap-1.5 cursor-pointer border-0">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i> Create Task
                    </button>
                }
                else
                {
                    <button disabled class="h-10 px-4 bg-slate-100 text-slate-400 rounded-xl text-xs font-black flex items-center gap-1.5 border-0 opacity-60 cursor-not-allowed">
                        <i data-lucide="lock" class="w-4 h-4"></i> Create Task (Restricted)
                    </button>
                }
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                @for (int colIndex = 0; colIndex < 4; colIndex++)
                {
                    var statusLabel = colIndex == 0 ? "To Do" : colIndex == 1 ? "In Progress" : colIndex == 2 ? "In Review" : "Done";
                    var statusColor = colIndex == 0 ? "bg-slate-100 text-slate-700" : colIndex == 1 ? "bg-indigo-50 text-indigo-600 border border-indigo-100" : colIndex == 2 ? "bg-purple-50 text-purple-600 border border-purple-100" : "bg-emerald-50 text-emerald-600 border border-emerald-100";
                    var tasksInCol = Model.FederationTasks.Where(t => t.Status == colIndex).ToList();

                    <div class="glass p-5 rounded-[2.5rem] border border-slate-200/50 shadow-sm flex flex-col h-[600px] overflow-hidden bg-slate-50/20">
                        <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-150/40 shrink-0">
                            <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider @statusColor">@statusLabel</span>
                            <span class="text-xs font-extrabold text-slate-450 bg-white px-2.5 py-0.5 rounded-lg border border-slate-100">@tasksInCol.Count</span>
                        </div>

                        <div class="flex-1 overflow-y-auto space-y-4 pr-1.5 scrollbar-thin">
                            @if (!tasksInCol.Any())
                            {
                                <div class="text-center py-12 text-slate-400 font-bold text-xs select-none">
                                    No tasks in this column
                                </div>
                            }
                            @foreach (var task in tasksInCol)
                            {
                                var priorityLabel = task.Priority == 1 ? "Low" : task.Priority == 2 ? "Medium" : "High";
                                var priorityColor = task.Priority == 1 ? "bg-slate-100 text-slate-500" : task.Priority == 2 ? "bg-amber-50 text-amber-600" : "bg-rose-50 text-rose-600";
                                bool canEdit = Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "HeadPresident" || task.AssigneeId == Model.CurrentUser.Id;

                                <div class="glass p-4 rounded-[2rem] border border-slate-200/60 shadow-xs relative overflow-hidden group hover:shadow transition-all space-y-3.5 bg-white/80">
                                    <div class="absolute -right-6 -top-6 w-16 h-16 bg-slate-50 rounded-full blur-xl pointer-events-none"></div>
                                    
                                    <div>
                                        <div class="flex items-center justify-between mb-1.5">
                                            <span class="px-2 py-0.5 rounded text-[8px] font-black uppercase tracking-wider @priorityColor">@priorityLabel</span>
                                            @if (Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "HeadPresident")
                                            {
                                                <form method="post" asp-page-handler="DeleteFederationTask" asp-route-joinCode="@Model.Federation.JoinCode" asp-route-taskId="@task.Id" class="inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="text-slate-400 hover:text-rose-500 transition-colors border-0 bg-transparent cursor-pointer" onclick="return confirm('Are you sure you want to delete this task?')">
                                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                        <h4 class="text-xs font-black text-slate-800 leading-snug">@task.Title</h4>
                                        <p class="text-[10px] text-slate-500 mt-1 line-clamp-3 leading-relaxed">@task.Description</p>
                                    </div>

                                    <div class="space-y-2 pt-2 border-t border-slate-100/50 mt-auto">
                                        <div class="flex items-center justify-between text-[9px] text-slate-400 font-bold">
                                            <span class="flex items-center gap-1"><i data-lucide="user" class="w-3 h-3 text-slate-350"></i> @(task.Assignee?.FullName ?? "Unassigned")</span>
                                            @if (task.DueDate.HasValue)
                                            {
                                                <span class="flex items-center gap-1 @(task.Status != 3 && task.DueDate.Value < DateTime.UtcNow ? "text-rose-500" : "")">
                                                    <i data-lucide="calendar" class="w-3 h-3 text-slate-350"></i> @task.DueDate.Value.ToString("dd MMM")
                                                </span>
                                            }
                                        </div>

                                        @if (canEdit)
                                        {
                                            <form method="post" asp-page-handler="UpdateFederationTaskStatus" asp-route-joinCode="@Model.Federation.JoinCode" asp-route-taskId="@task.Id" class="flex items-center gap-1.5 mt-1 shrink-0">
                                                @Html.AntiForgeryToken()
                                                <select name="status" class="w-full px-2 py-1 bg-slate-50 border border-slate-200 rounded-lg text-[9px] font-black text-slate-600 outline-none transition-all cursor-pointer" onchange="this.form.submit()">
                                                    <option value="0" selected="@(task.Status == 0)">To Do</option>
                                                    <option value="1" selected="@(task.Status == 1)">In Progress</option>
                                                    <option value="2" selected="@(task.Status == 2)">In Review</option>
                                                    <option value="3" selected="@(task.Status == 3)">Done</option>
                                                </select>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- ─── TAB 3: KPIS ─── -->
        <div x-show="activeTab === 'kpis'" class="grid grid-cols-1 lg:grid-cols-3 gap-8" x-transition>
            
            <!-- KPI Target Cards -->
            <div class="lg:col-span-2 space-y-6">
                <div>
                    <h3 class="text-xl font-black text-slate-800 tracking-tight">Affiliated Portals Performance</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Workspace-level completion rates, task distributions, and KPI achievements.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-6 border-b border-slate-100">
                    @foreach (var ws in Model.ChildWorkspaces)
                    {
                        var wsTasks = Model.ChildTasks.Where(t => t.WorkspaceId == ws.Id).ToList();
                        var wsTotalTasks = wsTasks.Count;
                        var wsCompletedTasks = wsTasks.Count(t => t.Status == 3);
                        var wsTodo = wsTasks.Count(t => t.Status == 0);
                        var wsInProgress = wsTasks.Count(t => t.Status == 1);
                        var wsReview = wsTasks.Count(t => t.Status == 2);
                        var wsDone = wsTasks.Count(t => t.Status == 3);

                        double wsTaskCompletionRate = wsTotalTasks > 0 ? ((double)wsCompletedTasks / wsTotalTasks) * 100 : 0;

                        var wsMembers = Model.ChildWorkspaceMembers.Where(m => m.WorkspaceId == ws.Id).ToList();
                        var wsMembersCount = wsMembers.Select(m => m.UserId).Distinct().Count();
                        var wsFilesCount = Model.SharedFiles.Count(f => f.WorkspaceId == ws.Id);

                        var wsKpis = Model.ChildKpiTargets.Where(t => t.WorkspaceId == ws.Id).ToList();
                        var wsTargetKpiTotal = wsKpis.Sum(t => t.TargetValue);
                        var wsActualKpiTotal = wsKpis.Sum(t => Model.GetKpiActualValue(t));
                        double wsKpiAchievementRate = wsTargetKpiTotal > 0 ? ((double)wsActualKpiTotal / wsTargetKpiTotal) * 100 : 0;

                        <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm flex flex-col justify-between hover:shadow-lg transition-all relative overflow-hidden bg-white/65">
                            <div class="absolute -right-12 -top-12 w-28 h-28 bg-indigo-50/40 rounded-full blur-[30px] pointer-events-none"></div>
                            
                            <div class="space-y-4">
                                <!-- Title and Stats -->
                                <div class="flex items-center justify-between pb-3 border-b border-slate-100/50">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <div class="h-9 w-9 rounded-xl bg-indigo-50 text-indigo-650 flex items-center justify-center font-black text-xs shrink-0">
                                            @ws.Name.Substring(0, Math.Min(2, ws.Name.Length)).ToUpper()
                                        </div>
                                        <div class="min-w-0">
                                            <h4 class="text-sm font-black text-slate-800 truncate">@ws.Name</h4>
                                            <p class="text-[10px] text-slate-400 font-mono">Code: #@ws.JoinCode</p>
                                        </div>
                                    </div>
                                    <span class="px-2.5 py-0.5 bg-indigo-50 text-indigo-600 border border-indigo-100 text-[9px] font-black rounded-md uppercase tracking-wider shrink-0">Active</span>
                                </div>
                                
                                <!-- Task completion rate -->
                                <div class="space-y-2">
                                    <div class="flex items-center justify-between text-xs font-bold">
                                        <span class="text-slate-500">Task Completion Rate</span>
                                        <span class="text-slate-800">@wsCompletedTasks / @wsTotalTasks (@((int)wsTaskCompletionRate)%)</span>
                                    </div>
                                    <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden shadow-inner">
                                        <div class="h-full rounded-full bg-indigo-500 transition-all duration-500" style="width: @(wsTaskCompletionRate > 100 ? 100 : wsTaskCompletionRate)%"></div>
                                    </div>
                                </div>

                                <!-- KPI achievement rate -->
                                <div class="space-y-2">
                                    <div class="flex items-center justify-between text-xs font-bold">
                                        <span class="text-slate-500">KPI Target Achievement</span>
                                        <span class="text-slate-800">@wsActualKpiTotal / @wsTargetKpiTotal (@((int)wsKpiAchievementRate)%)</span>
                                    </div>
                                    <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden shadow-inner">
                                        <div class="h-full rounded-full bg-emerald-500 transition-all duration-500" style="width: @(wsKpiAchievementRate > 100 ? 100 : wsKpiAchievementRate)%"></div>
                                    </div>
                                </div>

                                <!-- Details grid -->
                                <div class="grid grid-cols-2 gap-4 pt-2 text-[10px] font-bold text-slate-450 border-t border-slate-100/50">
                                    <div class="flex flex-col">
                                        <span class="text-slate-400 uppercase tracking-widest text-[8px]">Active Members</span>
                                        <span class="text-slate-700 font-black text-[11px] mt-0.5">@wsMembersCount members</span>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-slate-400 uppercase tracking-widest text-[8px]">Shared Files</span>
                                        <span class="text-slate-700 font-black text-[11px] mt-0.5">@wsFilesCount documents</span>
                                    </div>
                                </div>

                                <!-- Task distribution list -->
                                <div class="flex justify-between items-center text-[9px] font-black uppercase tracking-wider text-slate-400 bg-slate-50 p-2 rounded-xl border border-slate-100">
                                    <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> To Do: @wsTodo</span>
                                    <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span> Prog: @wsInProgress</span>
                                    <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span> Review: @wsReview</span>
                                    <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Done: @wsDone</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div>
                    <h3 class="text-xl font-black text-slate-800 tracking-tight">Child Portals KPI Targets</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Aggregate performance metrics and achievement values from child portals.</p>
                </div>

                <div class="space-y-4">
                    @if (!Model.ChildKpiTargets.Any())
                    {
                        <div class="glass p-12 text-center text-slate-400 font-bold rounded-[2.5rem] border border-slate-200/50">
                            <i data-lucide="bar-chart-3" class="w-12 h-12 text-slate-350 mx-auto mb-3 animate-pulse"></i>
                            <p class="text-sm">No child KPI targets set yet.</p>
                            @if (Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "HeadPresident")
                            {
                                <p class="text-xs text-slate-400 mt-1 font-medium">Use the panel on the right to set strategic targets.</p>
                            }
                        </div>
                    }
                    @foreach (var target in Model.ChildKpiTargets)
                    {
                        int actualVal = Model.GetKpiActualValue(target);
                        double progressPct = target.TargetValue > 0 ? ((double)actualVal / target.TargetValue) * 100 : 0;
                        if (progressPct > 100) progressPct = 100;
                        var progressColor = progressPct >= 100 ? "bg-emerald-500" : progressPct >= 50 ? "bg-indigo-500" : "bg-amber-500";
                        var periodBadgeBg = target.PeriodType == "Weekly" ? "bg-violet-50 text-violet-600 border border-violet-100" : "bg-indigo-50 text-indigo-600 border border-indigo-100";

                        <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm flex flex-col justify-between group hover:shadow-lg transition-all relative overflow-hidden bg-white/65">
                            <div class="absolute -right-12 -top-12 w-28 h-28 bg-indigo-50/40 rounded-full blur-[30px] pointer-events-none"></div>

                            <div class="space-y-4">
                                <div class="flex items-center justify-between pb-3 border-b border-slate-100/50">
                                    <div class="flex items-center gap-2.5">
                                        <div class="h-9 w-9 rounded-xl bg-slate-100 flex items-center justify-center font-black text-slate-600 text-xs">
                                            @string.Concat(target.User.FullName.Split(' ').Select(n => n[0]))
                                        </div>
                                        <div>
                                            <h4 class="text-xs font-black text-slate-800 truncate">@target.User.FullName</h4>
                                            <p class="text-[10px] text-slate-450 font-bold">Category: <span class="text-indigo-500">@target.Category.Name</span></p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-wider @periodBadgeBg">@target.PeriodType</span>
                                        @if (Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "HeadPresident")
                                        {
                                            <form method="post" asp-page-handler="DeleteChildKpiTarget" asp-route-joinCode="@Model.Federation.JoinCode" asp-route-targetId="@target.Id" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="text-slate-400 hover:text-rose-500 transition-colors border-0 bg-transparent cursor-pointer" onclick="return confirm('Are you sure you want to delete this KPI target?')">
                                                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>

                                <div class="space-y-2">
                                    <div class="flex items-center justify-between text-xs">
                                        <span class="font-extrabold text-slate-500">Performance Progress</span>
                                        <span class="font-black text-slate-800">@actualVal / @target.TargetValue (@((int)progressPct)%)</span>
                                    </div>
                                    <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden shadow-inner">
                                        <div class="h-full rounded-full transition-all duration-500 @progressColor" style="width: @progressPct%"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center justify-between pt-3 border-t border-slate-100/50 mt-4 text-[9px] font-extrabold text-slate-400">
                                <span>Portal: @target.Category.Workspace.Name</span>
                                <span>@target.StartDate.ToString("dd MMM") - @target.EndDate.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- KPI Setting Form (Only for Owners/Presidents) -->
            <div class="space-y-6">
                <div>
                    <h3 class="text-xl font-black text-slate-800 tracking-tight">KPI Controls</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Assign goals to child portals and members.</p>
                </div>

                @if (Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "HeadPresident" || (Model.CurrentUserRole == "DepartmentManager" && (await Model.GetSettingValueAsync(Model.Federation.JoinCode, "allowManagerSetKpi", true))))
                {
                    <div class="glass p-6 rounded-[2.5rem] border border-slate-200/60 shadow-sm space-y-4">
                        <div class="flex items-center gap-2 pb-2 border-b border-slate-100">
                            <i data-lucide="award" class="w-4.5 h-4.5 text-indigo-500 animate-pulse"></i>
                            <h4 class="text-xs font-black text-slate-800 uppercase tracking-widest">Assign KPI Goal</h4>
                        </div>

                        <form method="post" asp-page-handler="CreateChildKpiTarget" asp-route-joinCode="@Model.Federation.JoinCode" class="space-y-3.5">
                            @Html.AntiForgeryToken()
                            
                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Target Workspace</label>
                                <select name="targetWorkspaceId" required class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all cursor-pointer">
                                    @foreach (var ws in Model.ChildWorkspaces)
                                    {
                                        <option value="@ws.Id">@ws.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Target User</label>
                                <select name="targetUserId" required class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all cursor-pointer">
                                    @foreach (var m in Model.ChildWorkspaceMembers.GroupBy(m => m.UserId).Select(g => g.First()))
                                    {
                                        <option value="@m.UserId">@m.User.FullName (@m.Workspace.Name)</option>
                                    }
                                </select>
                            </div>

                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Task Category</label>
                                <select name="targetCategoryId" required class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all cursor-pointer">
                                    @foreach (var cat in Model.ChildCategories)
                                    {
                                        <option value="@cat.Id">@cat.Name (@cat.Workspace.Name)</option>
                                    }
                                </select>
                            </div>

                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Period Type</label>
                                <select name="periodType" required class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all cursor-pointer">
                                    <option value="Weekly">Weekly</option>
                                    <option value="Monthly">Monthly</option>
                                </select>
                            </div>

                            <div class="grid grid-cols-2 gap-3">
                                <div class="space-y-1">
                                    <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Start Date</label>
                                    <input type="date" name="startDate" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                                </div>
                                <div class="space-y-1">
                                    <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider">End Date</label>
                                    <input type="date" name="endDate" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                                </div>
                            </div>

                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Target Value</label>
                                <input type="number" name="targetValue" min="1" required placeholder="e.g. 5 tasks" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                            </div>

                            <button type="submit" class="w-full py-3.5 bg-slate-900 text-white rounded-2xl text-xs font-black shadow hover:bg-indigo-600 transition-all flex items-center justify-center gap-1.5 cursor-pointer border-0">
                                <i data-lucide="plus-circle" class="w-4 h-4"></i> Establish KPI Target
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="glass p-6 rounded-[2.5rem] border border-amber-200 bg-amber-50/10 shadow-sm text-center space-y-4">
                        <div class="h-12 w-12 rounded-2xl bg-amber-50 text-amber-500 flex items-center justify-center mx-auto shadow-inner">
                            <i data-lucide="lock" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <h4 class="text-sm font-black text-slate-800">Goal Settings Locked</h4>
                            <p class="text-xs text-slate-400 leading-relaxed mt-1">
                                🔒 KPI Target settings and creation tools are restricted. Only authorized owners or managers with active settings permission can configure targets.
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- ─── TAB 4: CHAT HUB ─── -->
        <div x-show="activeTab === 'chat'" class="h-[calc(100vh-22rem)] min-h-[500px] border border-slate-200 rounded-[2.5rem] bg-white flex overflow-hidden shadow-sm" x-transition>
            <!-- Left panel - Channels (Discord Style) -->
            <div class="w-64 border-r border-slate-100 flex flex-col bg-slate-50/50 shrink-0 select-none">
                <div class="p-4 border-b border-slate-100 flex items-center justify-between">
                    <h3 class="text-sm font-black text-slate-700 flex items-center gap-1.5 uppercase tracking-wide">
                        <i data-lucide="message-square" class="w-4 h-4 text-indigo-500"></i>
                        <span>Federation Chats</span>
                    </h3>
                    <template x-if="canCurrentUserCreateChannel">
                        <button type="button" @@click="createChannelOpen = true" class="h-6 w-6 rounded-lg hover:bg-slate-200/60 flex items-center justify-center text-slate-500 transition-colors border-0 bg-transparent cursor-pointer" title="Create new channel">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                        </button>
                    </template>
                </div>
                <div class="flex-1 p-2 space-y-1 overflow-y-auto animate-fadeIn">
                    <template x-for="chan in visibleChannels" :key="chan">
                        <button type="button"
                                @@click="activeChannel = chan; scrollChatToBottom();"
                                :class="activeChannel === chan ? 'bg-indigo-50 border-indigo-100/50 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-800 hover:bg-slate-100/50'"
                                class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl border text-left text-xs font-bold transition-all group cursor-pointer">
                            <span class="flex items-center gap-2 truncate">
                                <template x-if="lockedChannels[chan]">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-500 shrink-0"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                </template>
                                <template x-if="!lockedChannels[chan]">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-slate-400 shrink-0"><line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/></svg>
                                </template>
                                <span class="truncate" x-text="chan"></span>
                            </span>
                            <template x-if="lockedChannels[chan]">
                                <span class="px-1.5 py-0.5 bg-amber-50 text-amber-600 rounded text-[8px] font-black uppercase tracking-wider">Private</span>
                            </template>
                        </button>
                    </template>
                </div>
            </div>

            <!-- Right panel - Chat Timeline -->
            <div class="flex-1 flex flex-col min-w-0 bg-white">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between flex-wrap gap-4">
                    <div class="flex items-center gap-2 flex-wrap">
                        <template x-if="lockedChannels[activeChannel]">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4.5 h-4.5 text-amber-500 shrink-0"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </template>
                        <template x-if="!lockedChannels[activeChannel]">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4.5 h-4.5 text-slate-400 shrink-0"><line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/></svg>
                        </template>
                        <span class="text-sm font-black text-slate-800" x-text="activeChannel"></span>
                        
                        <!-- Lock Indicator for normal users -->
                        <template x-if="lockedChannels[activeChannel]">
                            <span class="flex items-center gap-1 text-[9px] text-amber-600 bg-amber-50 border border-amber-100 px-2 py-0.5 rounded-md font-black uppercase tracking-wider">
                                Private
                            </span>
                        </template>

                        <!-- Lock / Unlock / Invite Controls for Owner/Presidents or Channel Creator -->
                        <template x-if="(currentUserRole === 'Owner' || currentUserRole === 'HeadPresident' || channelOwners[activeChannel] === currentUserId) && activeChannel !== 'general'">
                            <div class="flex items-center gap-1.5 ml-2 flex-wrap">
                                <!-- Lock/Unlock toggle -->
                                <button type="button" @@click="toggleChannelLock()" 
                                        :class="lockedChannels[activeChannel] ? 'bg-amber-50 text-amber-600 border-amber-250' : 'bg-slate-50 text-slate-500 border-slate-200'"
                                        class="h-7 px-2.5 rounded-xl border text-[9px] font-black transition-all flex items-center gap-1 cursor-pointer select-none"
                                        :title="lockedChannels[activeChannel] ? 'Unlock Channel (Make Public)' : 'Lock Channel (Make Private)'">
                                    <template x-if="lockedChannels[activeChannel]">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    </template>
                                    <template x-if="!lockedChannels[activeChannel]">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><rect width="18" height="10" x="3" y="11" rx="2" ry="2"/><path d="M12 2a5 5 0 0 0-5 5v4"/></svg>
                                    </template>
                                    <span x-text="lockedChannels[activeChannel] ? 'Private' : 'Public'"></span>
                                </button>
                                <!-- Invite members button -->
                                <template x-if="lockedChannels[activeChannel]">
                                    <button type="button" @@click="openChannelInvite()" 
                                            class="h-7 px-2.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-655 border border-indigo-200 rounded-xl text-[9px] font-black transition-all flex items-center gap-1 cursor-pointer select-none">
                                        <i data-lucide="user-plus" class="w-3.5 h-3.5"></i>
                                        <span>Manage Access</span>
                                    </button>
                                </template>
                            </div>
                        </template>
                    </div>
                    <span class="text-xs font-bold text-slate-400"><span x-text="federationMembers.length"></span> members active</span>
                </div>

                <!-- Messages Stream -->
                <div id="fed-chat-container" class="flex-1 p-6 overflow-y-auto space-y-4">
                    <!-- Empty state -->
                    <div x-show="filteredMessages.length === 0" class="text-center py-20 text-slate-400 transition-all">
                        <i data-lucide="message-square" class="w-12 h-12 text-slate-300 mx-auto mb-3"></i>
                        <p class="font-bold" x-text="'No messages in channel #' + activeChannel + '...'"></p>
                        <p class="text-xs text-slate-400 mt-1">Start the first conversation in this channel!</p>
                    </div>

                    <template x-for="msg in filteredMessages" :key="msg.id">
                        <div class="group flex gap-3 max-w-[80%] transition-all" :class="msg.senderId === currentUserId ? 'ml-auto flex-row-reverse' : ''">
                            <div class="h-8 w-8 rounded-xl bg-slate-100 border flex items-center justify-center text-[10px] font-black text-slate-500 shrink-0 select-none shadow-sm" 
                                 x-text="msg.senderName.split(' ').map(n => n[0]).join('')">
                            </div>
                            <div class="space-y-1 min-w-0">
                                <template x-if="msg.senderId !== currentUserId">
                                    <p class="text-[10px] font-bold text-slate-400 flex items-center gap-1.5">
                                        <span x-text="msg.senderName"></span>
                                        <template x-if="channelOwners[activeChannel]?.toLowerCase() === msg.senderId.toLowerCase() && activeChannel !== 'general'">
                                            <span class="text-[8px] bg-amber-50 text-amber-600 border border-amber-250 px-1 py-0.2 rounded font-black uppercase inline-flex items-center gap-0.5" title="Channel Owner">
                                                👑 Owner
                                            </span>
                                        </template>
                                        <template x-if="channelModerators[activeChannel] && channelModerators[activeChannel].map(id => id.toLowerCase()).includes(msg.senderId.toLowerCase()) && channelOwners[activeChannel]?.toLowerCase() !== msg.senderId.toLowerCase() && activeChannel !== 'general'">
                                            <span class="text-[8px] bg-indigo-50 text-indigo-655 border border-indigo-255 px-1 py-0.2 rounded font-black uppercase inline-flex items-center gap-0.5" title="Channel Moderator">
                                                🛡️ Mod
                                            </span>
                                        </template>
                                    </p>
                                </template>
                                <template x-if="msg.senderId === currentUserId">
                                    <p class="text-[10px] font-bold text-slate-400 text-right flex items-center justify-end gap-1.5">
                                        <template x-if="channelOwners[activeChannel]?.toLowerCase() === msg.senderId.toLowerCase() && activeChannel !== 'general'">
                                            <span class="text-[8px] bg-amber-50 text-amber-600 border border-amber-200 px-1 py-0.2 rounded font-black uppercase inline-flex items-center gap-0.5" title="Channel Owner">
                                                👑 Owner
                                            </span>
                                        </template>
                                        <template x-if="channelModerators[activeChannel] && channelModerators[activeChannel].map(id => id.toLowerCase()).includes(msg.senderId.toLowerCase()) && channelOwners[activeChannel]?.toLowerCase() !== msg.senderId.toLowerCase() && activeChannel !== 'general'">
                                            <span class="text-[8px] bg-indigo-50 text-indigo-655 border border-indigo-255 px-1 py-0.2 rounded font-black uppercase inline-flex items-center gap-0.5" title="Channel Moderator">
                                                🛡️ Mod
                                            </span>
                                        </template>
                                        <span>Me</span>
                                    </p>
                                </template>
                                <div class="flex items-center gap-1.5" :class="msg.senderId === currentUserId ? 'flex-row-reverse' : ''">
                                    <div class="p-3.5 rounded-2xl text-xs font-medium leading-relaxed break-words relative group/bubble" 
                                         :class="msg.rawContent.startsWith('[deleted_message]') ? 'bg-slate-50 border border-slate-150/50 text-slate-400 italic' : (msg.senderId === currentUserId ? 'bg-indigo-600 text-white rounded-tr-none' : 'bg-slate-100 text-slate-700 rounded-tl-none')">
                                        <span x-text="msg.rawContent.startsWith('[deleted_message]') ? 'This message was recalled' : msg.content"></span>
                                        
                                        <!-- Recall Button -->
                                        <template x-if="!msg.rawContent.startsWith('[deleted_message]') && (msg.senderId === currentUserId || currentUserRole === 'Owner' || currentUserRole === 'HeadPresident' || channelOwners[activeChannel]?.toLowerCase() === currentUserId || (channelModerators[activeChannel] && channelModerators[activeChannel].map(id => id.toLowerCase()).includes(currentUserId)))">
                                            <button type="button" @@click="deleteChatMessage(msg.id)" 
                                                    class="absolute -top-2.5 -right-2.5 h-6 w-6 rounded-full bg-rose-50 border border-rose-100 text-rose-500 items-center justify-center shadow-md opacity-0 group-hover:opacity-100 transition-opacity flex cursor-pointer hover:bg-rose-100 border-0 outline-none"
                                                    title="Recall Message">
                                                <i data-lucide="trash-2" class="w-3 h-3"></i>
                                            </button>
                                        </template>
                                    </div>
                                </div>
                                <p class="text-[9px] text-slate-400 font-bold" :class="msg.senderId === currentUserId ? 'text-right' : ''" 
                                   x-text="formatTime(msg.sentAt)"></p>
                            </div>
                        </div>
                    </template>
                </div>

                <!-- Input area -->
                <div class="p-4 border-t border-slate-100">
                    @if (Model.CurrentUserRole == "Owner" || Model.CurrentUserRole == "HeadPresident" || Model.CurrentUserRole == "DepartmentManager" || (await Model.GetSettingValueAsync(Model.Federation.JoinCode, "allowMemberChat", true)))
                    {
                        <form @@submit.prevent="sendChatMessage" class="flex gap-2">
                            <input type="text" x-model="chatInput" autocomplete="off"
                                   :placeholder="'Message in #' + activeChannel + '...'" required
                                   class="flex-1 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                            
                            <!-- Send Button -->
                            <button type="submit" class="bg-indigo-600 text-white px-5 py-3 rounded-xl hover:bg-indigo-700 shadow shadow-indigo-100 flex items-center justify-center transition-all shrink-0 cursor-pointer border-0">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl text-center text-xs font-bold text-slate-400 italic">
                            Chat is currently disabled for standard members by the administrator.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ─── PUSH FILE MODAL ─── -->
        <div x-show="showPushModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4" x-transition>
            <div class="glass p-8 rounded-[2.5rem] border border-slate-200/60 shadow-2xl max-w-xl w-full bg-white relative max-h-[85vh] flex flex-col" @@click.away="showPushModal = false">
                <div class="flex items-center justify-between pb-4 border-b border-slate-100 shrink-0">
                    <div class="flex items-center gap-3">
                        <div class="h-10 w-10 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shadow-inner">
                            <i data-lucide="share-2" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="text-lg font-black text-slate-800 tracking-tight">Push File to Federation</h3>
                            <p class="text-xs text-slate-450 mt-0.5">Select a file from your child workspaces to project it into the enterprise document hub.</p>
                        </div>
                    </div>
                    <button @@click="showPushModal = false" class="h-8 w-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400 hover:text-slate-600 transition-colors border-0 bg-transparent cursor-pointer">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>
                
                <div class="flex-1 overflow-y-auto py-6 space-y-3 pr-1 scrollbar-thin">
                    @if (!Model.PushableFiles.Any())
                    {
                        <div class="text-center py-10 text-slate-400 font-bold text-xs select-none">
                            No pushable files found in workspaces you belong to.
                        </div>
                    }
                    else
                    {
                        @foreach (var file in Model.PushableFiles)
                        {
                            var fileIcon = file.FileType == "pdf" ? "file-text" : file.FileType == "doc" ? "file-text" : file.FileType == "spreadsheet" ? "file-spreadsheet" : "image";
                            var fileIconColor = file.FileType == "pdf" ? "text-rose-500 bg-rose-50 border-rose-100" : file.FileType == "doc" ? "text-indigo-600 bg-indigo-50 border-indigo-100" : file.FileType == "spreadsheet" ? "text-green-600 bg-green-50 border-green-100" : "text-purple-500 bg-purple-50 border-purple-100";

                            <div class="p-3.5 bg-slate-50/50 hover:bg-slate-50 border border-slate-100 rounded-2xl flex items-center justify-between transition-all group">
                                <div class="flex items-center gap-3.5 min-w-0">
                                    <div class="h-9 w-9 rounded-xl flex items-center justify-center shrink-0 border @fileIconColor">
                                        <i data-lucide="@fileIcon" class="w-4.5 h-4.5"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-xs font-black text-slate-700 truncate leading-snug">@file.FileName</p>
                                        <p class="text-[9px] font-bold text-slate-400 mt-0.5">
                                            From: <strong class="text-slate-500 font-extrabold">@file.Workspace.Name</strong>
                                        </p>
                                    </div>
                                </div>
                                <form method="post" asp-page-handler="PushFileToFederation" asp-route-joinCode="@Model.Federation.JoinCode" asp-route-fileId="@file.Id" class="shrink-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="h-8 px-3.5 bg-slate-900 hover:bg-indigo-600 text-white text-xs font-black rounded-lg transition-all flex items-center gap-1 cursor-pointer shadow-sm border-0">
                                        Push File <i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- ─── CREATE TASK MODAL ─── -->
        <div x-show="showTaskModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4" x-transition>
            <div class="glass p-8 rounded-[2.5rem] border border-slate-200/60 shadow-2xl max-w-lg w-full bg-white relative" @@click.away="showTaskModal = false">
                <div class="flex items-center justify-between pb-4 border-b border-slate-100 shrink-0">
                    <div class="flex items-center gap-3">
                        <div class="h-10 w-10 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shadow-inner">
                            <i data-lucide="plus-circle" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="text-lg font-black text-slate-800 tracking-tight">Create Federation Task</h3>
                            <p class="text-xs text-slate-400 mt-0.5">Assign a high-level strategic task at the Federation level.</p>
                        </div>
                    </div>
                    <button @@click="showTaskModal = false" class="h-8 w-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400 hover:text-slate-600 transition-colors border-0 bg-transparent cursor-pointer">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>
                
                <form method="post" asp-page-handler="CreateFederationTask" asp-route-joinCode="@Model.Federation.JoinCode" class="py-6 space-y-4">
                    @Html.AntiForgeryToken()
                    
                    <div class="space-y-1">
                        <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider block">Title</label>
                        <input type="text" name="title" required placeholder="e.g. Prepare Enterprise Strategy Q4" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                    </div>

                    <div class="space-y-1">
                        <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider block">Description</label>
                        <textarea name="description" placeholder="Provide strategic description..." rows="3" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all resize-none"></textarea>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider block">Priority</label>
                            <select name="priority" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all cursor-pointer">
                                <option value="1">Low</option>
                                <option value="2" selected>Medium</option>
                                <option value="3">High</option>
                            </select>
                        </div>

                        <div class="space-y-1">
                            <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider block">Assignee</label>
                            <select name="assigneeId" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all cursor-pointer">
                                <option value="">Unassigned</option>
                                @foreach (var user in Model.FederationUsers)
                                {
                                    <option value="@user.Id">@user.FullName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider block">Due Date</label>
                            <input type="date" name="dueDate" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                        </div>

                        <div class="space-y-1">
                            <label class="text-[9px] font-black text-slate-400 uppercase tracking-wider block">Status</label>
                            <select name="status" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none transition-all cursor-pointer">
                                <option value="0">To Do</option>
                                <option value="1">In Progress</option>
                                <option value="2">In Review</option>
                                <option value="3">Done</option>
                            </select>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3 shrink-0">
                        <button type="button" @@click="showTaskModal = false" class="px-4 py-2.5 border border-slate-200 hover:bg-slate-50 text-slate-655 rounded-xl text-xs font-black transition-all border-solid bg-transparent cursor-pointer">Cancel</button>
                        <button type="submit" class="px-5 py-2.5 bg-slate-900 text-white rounded-xl text-xs font-black shadow hover:bg-indigo-600 transition-all flex items-center gap-1.5 cursor-pointer border-0">
                            <i data-lucide="check" class="w-4 h-4"></i> Create Task
                        </button>
                    </div>
                </form>
        </div>
    </div>

    <!-- ════════════════════════════════════════ -->
    <!-- ─── CREATE VIRTUAL CHANNEL MODAL ─── -->
    <!-- ════════════════════════════════════════ -->
    <div x-show="createChannelOpen" 
         class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" 
         style="display: none;"
         x-transition x-cloak>
        
        <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-2xl w-full max-w-sm p-8 relative flex flex-col gap-6"
             @@click.away="createChannelOpen = false">
            
            <button @@click="createChannelOpen = false" class="absolute top-6 right-6 h-8 w-8 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 transition-all border-0 bg-transparent cursor-pointer">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600">
                    <i data-lucide="message-square" class="w-5 h-5"></i>
                </div>
                <h3 class="text-lg font-black text-slate-800">Create Chat Channel</h3>
            </div>

            <div class="space-y-4">
                <div class="space-y-1">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest block">New Channel Name</label>
                    <input type="text" x-model="newChannelName" placeholder="e.g. strategic-planning, news"
                           class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                </div>
                <p class="text-[10px] font-bold text-slate-400 leading-normal">New channel will be initialized in Federation memory. Once you send the first message, the channel will be saved permanently.</p>
            </div>

            <div class="flex gap-3">
                <button type="button" 
                        @@click="
                            const clean = newChannelName.trim().toLowerCase().replace(/[^a-z0-9-_]/g, '-');
                            if (clean) {
                                if (!channels.includes(clean)) {
                                    channels.push(clean);
                                    this.channelOwners[clean] = this.currentUserId;
                                    this.saveChannelRules();
                                }
                                activeChannel = clean;
                                createChannelOpen = false;
                                newChannelName = '';
                                scrollChatToBottom();
                            }
                        "
                        class="flex-1 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl font-bold shadow-md shadow-indigo-100 transition-all flex items-center justify-center gap-1.5 cursor-pointer border-0">
                    Create Channel
                </button>
                <button type="button" 
                        @@click="createChannelOpen = false" 
                        class="flex-1 py-3.5 border border-slate-200 hover:bg-slate-50 text-slate-500 rounded-2xl font-bold transition-all cursor-pointer bg-transparent">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════ -->
    <!-- ─── MANAGE CHANNEL ACCESS MODAL ─── -->
    <!-- ════════════════════════════════════════ -->
    <div x-show="inviteChannelOpen" 
         class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" 
         style="display: none;"
         x-transition x-cloak>
        
        <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-2xl w-full max-w-md p-8 relative flex flex-col gap-6"
             @@click.away="inviteChannelOpen = false">
            
            <button @@click="inviteChannelOpen = false" class="absolute top-6 right-6 h-8 w-8 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 transition-all border-0 bg-transparent cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>

            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-full bg-amber-50 border border-amber-100 flex items-center justify-center text-amber-600">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-800">Manage Channel Access</h3>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider mt-0.5" x-text="'Channel: #' + activeChannel"></p>
                </div>
            </div>

            <div class="space-y-4">
                <p class="text-[11px] font-bold text-slate-400 leading-normal">
                    Select the federation members who are allowed to see and chat in this private channel.
                </p>

                <!-- Members List with checkboxes -->
                <div class="border border-slate-100 rounded-2xl p-4 max-h-60 overflow-y-auto space-y-2.5">
                    <template x-for="member in federationMembers" :key="member.id">
                        <label class="flex items-center justify-between p-2.5 hover:bg-slate-50 rounded-xl transition-all cursor-pointer select-none">
                            <span class="flex items-center gap-2">
                                <div class="h-7 w-7 rounded-full bg-indigo-50 border border-indigo-150 flex items-center justify-center text-[9px] font-black text-indigo-650"
                                     x-text="member.fullName.split(' ').map(n => n[0]).join('')"></div>
                                <span class="text-xs font-bold text-slate-700" x-text="member.fullName"></span>
                            </span>
                            <input type="checkbox" :value="member.id" x-model="selectedChannelMembers"
                                   class="h-4.5 w-4.5 rounded-lg border-slate-350 text-indigo-600 focus:ring-indigo-500 transition-all cursor-pointer">
                        </label>
                    </template>
                </div>
            </div>

            <div class="flex gap-3">
                <button type="button" 
                        @@click="saveChannelInvite()"
                        class="flex-1 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl font-bold shadow-md shadow-indigo-100 transition-all flex items-center justify-center gap-1.5 cursor-pointer border-0">
                    Save Changes
                </button>
                <button type="button" 
                        @@click="inviteChannelOpen = false" 
                        class="flex-1 py-3.5 border border-slate-200 hover:bg-slate-50 text-slate-500 rounded-2xl font-bold transition-all cursor-pointer bg-transparent">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('federationDetail', () => ({
            activeTab: '@(string.IsNullOrEmpty(Model.ActiveTab) ? "overview" : Model.ActiveTab)',
            showPushModal: false,
            showTaskModal: false,
            chatInput: '',
            chatMessages: JSON.parse(decodeURIComponent(escape(atob('@Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(Model.SerializeFederationChatMessages()))')))),
            signalrConnection: null,
            hoveredSegment: '',
            hoveredMemberIndex: null,
            hoveredMemberText: '',
            hoveredMemberAssigned: 0,
            hoveredMemberCompleted: 0,

            // Live Channels state
            activeChannel: 'general',
            newChannelName: '',
            createChannelOpen: false,
            inviteChannelOpen: false,
            channels: ['general'],
            lockedChannels: {},
            channelOwners: {},
            channelModerators: {},
            selectedChannelMembers: [],
            selectedChannelMods: [],
            tempChannelOwner: '',
            currentUserRole: '@Model.CurrentUserRole',
            currentUserId: '@Model.CurrentUser.Id.ToString().ToLower()',
            federationOwnerId: '@Model.Federation.OwnerId.ToString().ToLower()',
            federationMembers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActiveFederationMembers.Select(m => new { id = m.UserId.ToString().ToLower(), fullName = m.User?.FullName ?? "Unknown Member" }).ToList())),

            // Initial rules states from database settings
            initialLockedChannels: @Html.Raw(Model.GetLockedChannelsJson()),
            initialChannelOwners: @Html.Raw(Model.GetChannelOwnersJson()),
            initialChannelModerators: @Html.Raw(Model.GetChannelModeratorsJson()),
            initialDisabledCreateChannelUsers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActiveFederationMembers.Where(m => !Model.IsMemberAllowed(m.UserId, "disabledCreateChannelUsers", m.Role)).Select(m => m.UserId.ToString().ToLower()).ToList())),
            initialDisabledCreateTaskUsers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActiveFederationMembers.Where(m => !Model.IsMemberAllowed(m.UserId, "disabledCreateTaskUsers", m.Role)).Select(m => m.UserId.ToString().ToLower()).ToList())),
            initialDisabledPushFileUsers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActiveFederationMembers.Where(m => !Model.IsMemberAllowed(m.UserId, "disabledPushFileUsers", m.Role)).Select(m => m.UserId.ToString().ToLower()).ToList())),
            initialDisabledChatUsers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActiveFederationMembers.Where(m => !Model.IsMemberAllowed(m.UserId, "disabledChatUsers", m.Role)).Select(m => m.UserId.ToString().ToLower()).ToList())),
            initialChannels: @Html.Raw(Model.GetChannelsJson()),

            disabledCreateChannelUsers: [],
            disabledCreateTaskUsers: [],
            disabledPushFileUsers: [],
            disabledChatUsers: [],

            init() {
                this.parseSystemRules();
                this.scrollChatToBottom();
                this.$watch('activeTab', value => {
                    if (value === 'chat') {
                        this.scrollChatToBottom();
                    }
                });
                this.$watch('activeChannel', value => {
                    this.scrollChatToBottom();
                });

                // Start SignalR Connection
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/chatHub")
                    .withAutomaticReconnect()
                    .build();

                connection.on("ReceiveChatMessage", (payload) => {
                    console.log("Fed SignalR Chat Msg:", payload);
                    if (payload.roomId === '@Model.FederationChatRoom?.Id') {
                        if (!this.chatMessages.some(m => m.id === payload.id)) {
                            this.chatMessages.push(payload);
                            if (payload.rawContent && payload.rawContent.startsWith('[system:channel_rules]')) {
                                this.parseSystemRules();
                            } else {
                                if (this.activeTab === 'chat' && this.activeChannel === payload.channel) {
                                    this.scrollChatToBottom();
                                }
                            }
                        }
                    }
                });

                connection.on("ReceiveMessageDeletion", (payload) => {
                    console.log("Fed SignalR Msg Deletion:", payload);
                    const index = this.chatMessages.findIndex(m => m.id === payload.messageId);
                    if (index !== -1) {
                        this.chatMessages[index].rawContent = '[deleted_message]';
                        this.chatMessages[index].content = '[deleted_message]';
                    }
                });

                connection.start()
                    .then(() => {
                        console.log("Federation SignalR connected!");
                        connection.invoke("JoinWorkspace", "@Model.Federation.Id.ToString()")
                            .catch(err => console.error("Error joining federation group:", err));
                    })
                    .catch(err => console.error("Federation SignalR Connection Error: ", err));

                this.signalrConnection = connection;
            },

            parseSystemRules() {
                this.lockedChannels = JSON.parse(JSON.stringify(this.initialLockedChannels || {}));
                this.channelOwners = JSON.parse(JSON.stringify(this.initialChannelOwners || {}));
                this.channelModerators = JSON.parse(JSON.stringify(this.initialChannelModerators || {}));
                this.disabledCreateChannelUsers = [...(this.initialDisabledCreateChannelUsers || [])];
                this.disabledCreateTaskUsers = [...(this.initialDisabledCreateTaskUsers || [])];
                this.disabledPushFileUsers = [...(this.initialDisabledPushFileUsers || [])];
                this.disabledChatUsers = [...(this.initialDisabledChatUsers || [])];
                let parsedChannels = [...(this.initialChannels || ['general'])];

                const sorted = [...this.chatMessages].sort((a, b) => new Date(a.sentAt) - new Date(b.sentAt));
                sorted.forEach(msg => {
                    if (msg.rawContent && msg.rawContent.startsWith('[system:channel_rules]')) {
                        try {
                            const jsonStr = msg.rawContent.substring('[system:channel_rules]'.length);
                            const payload = JSON.parse(jsonStr);
                            if (payload) {
                                if (payload.lockedChannels) this.lockedChannels = payload.lockedChannels;
                                if (payload.channelOwners) this.channelOwners = payload.channelOwners;
                                if (payload.channelModerators) this.channelModerators = payload.channelModerators;
                                if (payload.disabledCreateChannelUsers) this.disabledCreateChannelUsers = payload.disabledCreateChannelUsers;
                                if (payload.disabledCreateTaskUsers) this.disabledCreateTaskUsers = payload.disabledCreateTaskUsers;
                                if (payload.disabledPushFileUsers) this.disabledPushFileUsers = payload.disabledPushFileUsers;
                                if (payload.disabledChatUsers) this.disabledChatUsers = payload.disabledChatUsers;
                                if (payload.allChannels) parsedChannels = payload.allChannels;
                            }
                        } catch (e) {
                            console.error("Failed to parse system channel rules:", e);
                        }
                    }
                });
                this.channels = parsedChannels;
                if (!this.visibleChannels.includes(this.activeChannel)) {
                    this.activeChannel = 'general';
                }
            },

            toggleChannelLock() {
                if (this.lockedChannels[this.activeChannel]) {
                    delete this.lockedChannels[this.activeChannel];
                } else {
                    this.lockedChannels[this.activeChannel] = [this.currentUserId];
                }
                this.saveChannelRules();
            },

            openChannelInvite() {
                this.selectedChannelMembers = this.lockedChannels[this.activeChannel] ? [...this.lockedChannels[this.activeChannel]] : [this.currentUserId];
                if (!this.channelModerators) this.channelModerators = {};
                this.selectedChannelMods = this.channelModerators[this.activeChannel] ? [...this.channelModerators[this.activeChannel]] : [];
                this.tempChannelOwner = this.channelOwners[this.activeChannel] || this.currentUserId;
                this.inviteChannelOpen = true;
            },

            saveChannelInvite() {
                const cleanList = this.selectedChannelMembers.map(id => id.toString().toLowerCase());
                if (this.federationOwnerId && !cleanList.includes(this.federationOwnerId.toLowerCase())) {
                    this.selectedChannelMembers.push(this.federationOwnerId.toLowerCase());
                }
                if (this.tempChannelOwner && !cleanList.includes(this.tempChannelOwner.toLowerCase())) {
                    this.selectedChannelMembers.push(this.tempChannelOwner.toLowerCase());
                }
                this.lockedChannels[this.activeChannel] = [...this.selectedChannelMembers].map(id => id.toString().toLowerCase());
                
                if (!this.channelModerators) this.channelModerators = {};
                this.channelModerators[this.activeChannel] = this.selectedChannelMods.map(id => id.toString().toLowerCase());
                
                if (this.tempChannelOwner) {
                    this.channelOwners[this.activeChannel] = this.tempChannelOwner.toLowerCase();
                }
                
                this.inviteChannelOpen = false;
                this.saveChannelRules();
            },

            saveChannelRules() {
                const payload = '[system:channel_rules]' + JSON.stringify({ 
                    lockedChannels: this.lockedChannels,
                    channelOwners: this.channelOwners,
                    channelModerators: this.channelModerators,
                    allChannels: this.channels,
                    disabledCreateChannelUsers: this.disabledCreateChannelUsers || [],
                    disabledCreateTaskUsers: this.disabledCreateTaskUsers || [],
                    disabledPushFileUsers: this.disabledPushFileUsers || [],
                    disabledChatUsers: this.disabledChatUsers || []
                });
                const formData = new FormData();
                formData.append('content', payload);
                formData.append('activeChannel', 'general');

                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput) {
                    formData.append('__RequestVerificationToken', tokenInput.value);
                }

                return fetch('?handler=SendFederationChatMessage&joinCode=@Model.Federation.JoinCode', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(async res => {
                    if (!res.ok) {
                        console.error('Failed to save channel rules.');
                    }
                })
                .catch(err => {
                    console.error('Error saving channel rules:', err);
                });
            },

            get canCurrentUserCreateChannel() {
                const isOwnerOrPresident = this.currentUserRole === 'Owner' || this.currentUserRole === 'HeadPresident';
                if (isOwnerOrPresident) return true;
                if (!this.disabledCreateChannelUsers) return true;
                return !this.disabledCreateChannelUsers.map(id => id.toLowerCase()).includes(this.currentUserId.toLowerCase());
            },

            get visibleChannels() {
                return this.channels.filter(chan => {
                    if (!this.lockedChannels[chan] || this.lockedChannels[chan].length === 0) return true;
                    const isOwnerOrPresident = this.currentUserRole === 'Owner' || this.currentUserRole === 'HeadPresident';
                    if (isOwnerOrPresident) return true;
                    return this.lockedChannels[chan].includes(this.currentUserId);
                });
            },

            get filteredMessages() {
                return this.chatMessages
                    .filter(msg => msg.channel === this.activeChannel && !msg.rawContent.startsWith('[system:'));
            },

            scrollChatToBottom() {
                this.$nextTick(() => {
                    const chatContainer = document.getElementById('fed-chat-container');
                    if (chatContainer) {
                        chatContainer.scrollTop = chatContainer.scrollHeight;
                    }
                });
            },

            formatTime(sentAtStr) {
                const date = new Date(sentAtStr);
                return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ' ' + date.toLocaleDateString([], { day: '2-digit', month: 'short' });
            },

            async sendChatMessage() {
                if (!this.chatInput.trim()) return;
                
                const formData = new FormData();
                formData.append('content', this.chatInput);
                formData.append('activeChannel', this.activeChannel);
                formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                const response = await fetch('?handler=SendFederationChatMessage&joinCode=@Model.Federation.JoinCode', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (response.ok) {
                    const payload = await response.json();
                    this.chatInput = '';
                    if (!this.chatMessages.some(m => m.id === payload.id)) {
                        this.chatMessages.push(payload);
                        this.scrollChatToBottom();
                    }
                } else {
                    const err = await response.json();
                    alert(err.message || 'Error sending message');
                }
            },

            async deleteChatMessage(messageId) {
                if (!confirm('Do you want to recall this message?')) return;

                const formData = new FormData();
                formData.append('messageId', messageId);
                formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                const response = await fetch('?handler=DeleteFederationChatMessage&joinCode=@Model.Federation.JoinCode', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (response.ok) {
                    const index = this.chatMessages.findIndex(m => m.id === messageId);
                    if (index !== -1) {
                        this.chatMessages[index].rawContent = '[deleted_message]';
                        this.chatMessages[index].content = '[deleted_message]';
                    }
                } else {
                    alert('Failed to recall message.');
                }
            }
        }));
    });

    setTimeout(() => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }, 100);
</script>
