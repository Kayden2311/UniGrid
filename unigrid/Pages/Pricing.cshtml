        <div class="absolute inset-0 bg-gradient-to-br from-indigo-600 via-indigo-500 to-violet-700 opacity-90"></div>
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-indigo-400 rounded-full blur-[100px] opacity-30"></div>
        
        <div class="relative z-10 max-w-2xl mx-auto space-y-6">
            @if (User.Identity?.IsAuthenticated == true && Model.GetPlanRank(Model.CurrentPlan) == 2) {
                <h2 class="font-display text-3xl font-extrabold sm:text-4xl">Ready to upgrade to Business?</h2>
                <p class="text-indigo-100 text-lg leading-relaxed">Upgrade to Business now to unlock ultimate features, unlimited chat channels, and unlimited task branches.</p>
                <div class="pt-2">
                    <button @@click="triggerBusinessUpgrade()" 
                            class="inline-flex items-center gap-2 px-8 py-4 bg-white text-indigo-600 hover:bg-indigo-50 rounded-2xl font-bold shadow-xl transition-all hover:scale-105">
                        <span>Upgrade to Business</span>
                        <i data-lucide="arrow-right" class="w-5 h-5"></i>
                    </button>
                </div>
            } else if (User.Identity?.IsAuthenticated == true && Model.GetPlanRank(Model.CurrentPlan) == 3) {
                <h2 class="font-display text-3xl font-extrabold sm:text-4xl">You're on our highest tier!</h2>
                <p class="text-indigo-100 text-lg leading-relaxed">Thank you for supporting UniGrid! You're already utilizing our maximum potential Business tier.</p>
            } else {
                <h2 class="font-display text-3xl font-extrabold sm:text-4xl">Ready to supercharge your team?</h2>
                <p class="text-indigo-100 text-lg leading-relaxed">Upgrade now to unlock advanced planning features, extra chat channels, and unlimited task branches.</p>
