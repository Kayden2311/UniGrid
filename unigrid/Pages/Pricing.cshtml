                <div class="h-9 w-9 bg-indigo-600 rounded-xl flex items-center justify-center text-white shadow-lg shadow-indigo-200">
                    <i data-lucide="sparkles" class="h-4 w-4"></i>
                </div>
                <span class="font-display text-lg font-bold text-slate-800">UniGrid</span>
            </div>
            <p class="text-sm text-slate-400">© 2026 UniGrid. Team productivity platform for students.</p>
        </div>
    </footer>
</div>

<form method="post" asp-page-handler="Upgrade" id="upgradeForm" style="display:none;">
    <input type="hidden" name="tier" id="upgradeTier" />
    @Html.AntiForgeryToken()
