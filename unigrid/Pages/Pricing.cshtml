@page
@model unigrid.Pages.PricingModel
@{
    ViewData["Title"] = "Pricing";
}

<div class="space-y-16 py-8 px-6 md:px-12 max-w-7xl mx-auto" 
     x-data="{ 
        billing: 'monthly', 
        showConfirmModal: false, 
        selectedTier: '', 
        selectedPriceMonthly: '', 
        selectedPriceYearly: '',
        selectedFeatures: [],
        triggerUpgrade(tier, priceM, priceY, features) {
            if (@(User.Identity?.IsAuthenticated == true ? "false" : "true")) {
                window.location.href = '/Signup?tier=' + tier;
                return;
            }
            this.selectedTier = tier;
            this.selectedPriceMonthly = priceM;
            this.selectedPriceYearly = priceY;
            this.selectedFeatures = features;
            this.showConfirmModal = true;
        },
        confirmUpgrade() {
            document.getElementById('upgradeTier').value = this.selectedTier;
            document.getElementById('upgradeForm').submit();
        }
     }">
    
    <!-- Header -->
    <div class="text-center space-y-4 max-w-2xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-black text-slate-800 tracking-tight font-display">Simple, transparent <span class="bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent">pricing</span></h2>
        <p class="text-slate-500 text-lg leading-relaxed">Choose the plan that fits your team. Upgrade anytime as you grow.</p>
        
        <!-- Billing Toggle -->
        <div class="flex items-center justify-center gap-3 mt-8">
            <button @@click="billing = 'monthly'" 
                    :class="billing == 'monthly' ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-white text-slate-500 hover:bg-slate-50 border border-slate-100'"
                    class="px-6 py-2.5 rounded-xl text-sm font-bold transition-all">Monthly</button>
            <button @@click="billing = 'yearly'" 
                    :class="billing == 'yearly' ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-white text-slate-500 hover:bg-slate-50 border border-slate-100'"
                    class="px-6 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2">
                Yearly <span class="px-2 py-0.5 bg-emerald-500/10 text-emerald-600 text-[10px] rounded-full font-black">-17%</span>
            </button>
        </div>
    </div>

    <!-- Plan Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Free Plan -->
        <div class="glass p-8 rounded-[3rem] flex flex-col h-full border-t-8 border-slate-200 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1 duration-300 @(Model.CurrentPlan == "Free" ? "ring-4 ring-indigo-500/20" : "")">
            <div class="mb-6">
                <h3 class="text-xl font-black text-slate-800 mb-2">Free</h3>
                <p class="text-xs text-slate-400 font-bold uppercase tracking-widest">For individuals</p>
            </div>
            <div class="mb-6">
                <div class="flex items-baseline">
                    <span class="text-4xl font-black text-slate-800">Free</span>
                </div>
                <p class="text-xs text-slate-400 font-medium mt-1">Single-user or small personal projects</p>
                <p class="text-sm text-slate-500 mt-3 leading-relaxed">For small teams getting started</p>
            </div>
            <ul class="space-y-4 mb-8 flex-1 border-t border-slate-100 pt-6">
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 1 Workspace
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 5 Members
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> Basic Analytics
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> Task Assignment
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 1 Chat Channel
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium text-slate-300">
                    <i data-lucide="x" class="w-4 h-4 text-slate-300 shrink-0"></i> No File Storage
                </li>
            </ul>
            @if(Model.CurrentPlan == "Free") {
                <button disabled class="w-full py-4 bg-slate-100 text-slate-400 rounded-2xl font-bold cursor-not-allowed">Current Plan</button>
            } else {
                <button @@click="triggerUpgrade('Free', 'Free', 'Free', ['1 Workspace', '5 Members', 'Basic Analytics', 'Task Assignment', '1 Chat Channel'])" 
                        class="w-full py-4 bg-white border border-slate-200 text-slate-700 rounded-2xl font-bold hover:bg-slate-50 transition-all">Get Started</button>
            }
        </div>

        <!-- Pro Plan -->
        <div class="glass p-8 rounded-[3rem] flex flex-col h-full border-t-8 border-indigo-400 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1 duration-300 @(Model.CurrentPlan == "Pro" ? "ring-4 ring-indigo-500/20" : "")">
            <div class="mb-6">
                <h3 class="text-xl font-black text-slate-800 mb-2">Pro</h3>
                <p class="text-xs text-indigo-600 font-bold uppercase tracking-widest">For professionals</p>
            </div>
            <div class="mb-6">
                <div class="flex items-baseline gap-1">
                    <span class="text-4xl font-black text-slate-800" x-text="billing == 'monthly' ? '299K' : '2.9M'">299K</span>
                    <span class="text-slate-400 font-bold text-sm">VND</span>
                </div>
                <p class="text-xs text-indigo-500/80 font-bold mt-1" x-text="billing == 'monthly' ? '≈ 30K VND / member' : '≈ 24K VND / member'"></p>
                <p class="text-sm text-slate-500 mt-3 leading-relaxed">More power for growing teams</p>
            </div>
            <ul class="space-y-4 mb-8 flex-1 border-t border-slate-100 pt-6">
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 1 Workspace
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 10 Members
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 20 GB Storage
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 3 Chat Channels
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 2 Task Branches
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> Basic Analytics
                </li>
            </ul>
            @if(Model.CurrentPlan == "Pro") {
                <button disabled class="w-full py-4 bg-indigo-50 text-indigo-400 rounded-2xl font-bold cursor-not-allowed">Current Plan</button>
            } else {
                <button @@click="triggerUpgrade('Pro', '299K', '2.9M', ['1 Workspace', '10 Members', '20 GB Storage', '3 Chat Channels', '2 Task Branches', 'Basic Analytics'])" 
                        class="w-full py-4 bg-indigo-600 text-white rounded-2xl font-bold shadow-lg shadow-indigo-100 hover:bg-indigo-700 transition-all">Upgrade Now</button>
            }
        </div>

        <!-- Pro+ Plan (Popular) -->
        <div class="glass p-8 rounded-[3rem] flex flex-col h-full border-t-8 border-violet-500 relative transition-all hover:shadow-2xl hover:-translate-y-1 duration-300 shadow-xl shadow-violet-500/5 @(Model.CurrentPlan == "ProPlus" ? "ring-4 ring-violet-500/20" : "")">
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-gradient-to-r from-violet-600 to-indigo-600 text-white px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest shadow-lg">Most Popular</div>
            <div class="mb-6">
                <h3 class="text-xl font-black text-slate-800 mb-2">Pro+</h3>
                <p class="text-xs text-violet-600 font-bold uppercase tracking-widest">For power users</p>
            </div>
            <div class="mb-6">
                <div class="flex items-baseline gap-1">
                    <span class="text-4xl font-black text-slate-800" x-text="billing == 'monthly' ? '449K' : '4.4M'">449K</span>
                    <span class="text-slate-400 font-bold text-sm">VND</span>
                </div>
                <p class="text-xs text-violet-500/80 font-bold mt-1" x-text="billing == 'monthly' ? '≈ 30K VND / member' : '≈ 24K VND / member'"></p>
                <p class="text-sm text-slate-500 mt-3 leading-relaxed">Advanced features for power users</p>
            </div>
            <ul class="space-y-4 mb-8 flex-1 border-t border-slate-100 pt-6">
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 1 Workspace
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 15 Members
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 40 GB Storage
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 5 Chat Channels
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 4 Task Branches
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> Advanced Analytics
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> Role Permissions
                </li>
            </ul>
            @if(Model.CurrentPlan == "ProPlus") {
                <button disabled class="w-full py-4 bg-violet-50 text-violet-400 rounded-2xl font-bold cursor-not-allowed">Current Plan</button>
            } else {
                <button @@click="triggerUpgrade('ProPlus', '449K', '4.4M', ['1 Workspace', '15 Members', '40 GB Storage', '5 Chat Channels', '4 Task Branches', 'Advanced Analytics', 'Role Permissions'])" 
                        class="w-full py-4 bg-violet-600 text-white rounded-2xl font-bold shadow-lg shadow-violet-100 hover:bg-violet-700 transition-all">Upgrade Now</button>
            }
        </div>

        <!-- Business Plan -->
        <div class="glass p-8 rounded-[3rem] flex flex-col h-full border-t-8 border-slate-850 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1 duration-300 @(Model.CurrentPlan == "Business" ? "ring-4 ring-slate-800/20" : "")">
            <div class="mb-6">
                <h3 class="text-xl font-black text-slate-800 mb-2">Business</h3>
                <p class="text-xs text-slate-400 font-bold uppercase tracking-widest">For organizations</p>
            </div>
            <div class="mb-6">
                <div class="flex items-baseline gap-1">
                    <span class="text-4xl font-black text-slate-800" x-text="billing == 'monthly' ? '899K' : '8.9M'">899K</span>
                    <span class="text-slate-400 font-bold text-sm">VND</span>
                </div>
                <p class="text-xs text-slate-500 font-bold mt-1" x-text="billing == 'monthly' ? '≈ 30K VND / member' : '≈ 24K VND / member'"></p>
                <p class="text-sm text-slate-400 mt-3 leading-relaxed">Unlimited power for organizations</p>
            </div>
            <ul class="space-y-4 mb-8 flex-1 border-t border-slate-100 pt-6">
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 1 Workspace
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 30 Members
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 80 GB Storage
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> Unlimited Chat Channels
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> Unlimited Task Branches
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> Advanced Analytics
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> Role Permissions
                </li>
            </ul>
            @if(Model.CurrentPlan == "Business") {
                <button disabled class="w-full py-4 bg-slate-800/10 text-slate-400 rounded-2xl font-bold cursor-not-allowed">Current Plan</button>
            } else {
                <button @@click="triggerUpgrade('Business', '899K', '8.9M', ['1 Workspace', '30 Members', '80 GB Storage', 'Unlimited Chat', 'Unlimited Task Branches', 'Advanced Analytics', 'Role Permissions', 'Priority Support'])" 
                        class="w-full py-4 bg-slate-800 text-white rounded-2xl font-bold shadow-lg shadow-slate-200 hover:bg-slate-900 transition-all">Contact Us</button>
            }
        </div>
    </div>

    <!-- Confirm Upgrade Modal -->
    <div x-show="showConfirmModal" x-transition x-cloak class="fixed inset-0 z-50 overflow-y-auto flex items-center justify-center p-4">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" @@click="showConfirmModal = false"></div>
        
        <!-- Modal Content -->
        <div class="bg-white rounded-[2.5rem] border border-slate-100 p-8 shadow-2xl relative z-10 w-full max-w-lg transform transition-all duration-300">
            <button @@click="showConfirmModal = false" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            
            <div class="space-y-6">
                <div class="h-12 w-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center shadow-md">
                    <svg class="w-6 h-6 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                </div>
                
                <div>
                    <h3 class="text-2xl font-black text-slate-800 tracking-tight">Confirm plan upgrade</h3>
                    <p class="text-sm text-slate-500 mt-1">You are upgrading to the <span class="font-bold text-indigo-600" x-text="selectedTier"></span> plan.</p>
                </div>
                
                <div class="p-6 bg-slate-50 rounded-3xl border border-slate-100 flex items-center justify-between">
                    <div>
                        <p class="text-xs text-slate-400 font-bold uppercase tracking-wider">Billing details</p>
                        <p class="text-lg font-bold text-slate-800 mt-1" x-text="billing == 'monthly' ? 'Monthly Billing' : 'Yearly Billing'"></p>
                    </div>
                    <div class="text-right">
                        <p class="text-2xl font-black text-slate-900">
                            <span x-text="billing == 'monthly' ? selectedPriceMonthly : selectedPriceYearly"></span>
                            <span class="text-xs text-slate-400 font-bold">VND</span>
                        </p>
                        <p class="text-[10px] text-slate-400 font-bold uppercase mt-0.5" x-text="billing == 'monthly' ? '/ month' : '/ year'"></p>
                    </div>
                </div>
                
                <div class="space-y-3">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Included features</p>
                    <ul class="grid grid-cols-2 gap-3">
                        <template x-for="feature in selectedFeatures">
                            <li class="flex items-center gap-2 text-xs text-slate-600 font-medium">
                                <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                                <span x-text="feature"></span>
                            </li>
                        </template>
                    </ul>
                </div>
                
                <div class="flex gap-4 pt-4 border-t border-slate-100">
                    <button @@click="showConfirmModal = false" class="flex-1 py-4 bg-slate-100 text-slate-700 font-bold rounded-2xl hover:bg-slate-200 transition-all">Cancel</button>
                    <button @@click="confirmUpgrade()" class="flex-1 py-4 bg-indigo-600 text-white font-bold rounded-2xl shadow-lg shadow-indigo-100 hover:bg-indigo-700 transition-all">Confirm Upgrade</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Comparison Table -->
    <div class="glass p-10 rounded-[3rem] shadow-sm overflow-hidden reveal-on-scroll">
        <h3 class="text-3xl font-black text-slate-800 mb-10 text-center font-display">Compare all features</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/50">
                        <th class="py-6 px-4 text-sm font-black text-slate-400 uppercase tracking-widest">Feature</th>
                        <th class="py-6 px-4 text-sm font-black text-slate-800">Free</th>
                        <th class="py-6 px-4 text-sm font-black text-slate-800">Pro</th>
                        <th class="py-6 px-4 text-sm font-black text-indigo-600">Pro+</th>
                        <th class="py-6 px-4 text-sm font-black text-slate-800">Business</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    <tr>
                        <td class="py-5 px-4 text-sm font-bold text-slate-700">Workspace</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">1</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">1</td>
                        <td class="py-5 px-4 text-sm text-indigo-600 font-bold">1</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">1</td>
                    </tr>
                    <tr>
                        <td class="py-5 px-4 text-sm font-bold text-slate-700">Members</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">5</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">10</td>
                        <td class="py-5 px-4 text-sm text-indigo-600 font-bold">15</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">30</td>
                    </tr>
                    <tr>
                        <td class="py-5 px-4 text-sm font-bold text-slate-700">Task Assignment</td>
                        <td class="py-5 px-4 text-sm text-emerald-500"><i data-lucide="check" class="w-5 h-5"></i></td>
                        <td class="py-5 px-4 text-sm text-emerald-500"><i data-lucide="check" class="w-5 h-5"></i></td>
                        <td class="py-5 px-4 text-sm text-emerald-500"><i data-lucide="check" class="w-5 h-5"></i></td>
                        <td class="py-5 px-4 text-sm text-emerald-500"><i data-lucide="check" class="w-5 h-5"></i></td>
                    </tr>
                    <tr>
                        <td class="py-5 px-4 text-sm font-bold text-slate-700">Deadline Notifications</td>
                        <td class="py-5 px-4 text-sm text-emerald-500"><i data-lucide="check" class="w-5 h-5"></i></td>
                        <td class="py-5 px-4 text-sm text-emerald-500"><i data-lucide="check" class="w-5 h-5"></i></td>
                        <td class="py-5 px-4 text-sm text-emerald-500"><i data-lucide="check" class="w-5 h-5"></i></td>
                        <td class="py-5 px-4 text-sm text-emerald-500"><i data-lucide="check" class="w-5 h-5"></i></td>
                    </tr>
                    <tr>
                        <td class="py-5 px-4 text-sm font-bold text-slate-700">Chat Channels</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">1</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">3</td>
                        <td class="py-5 px-4 text-sm text-indigo-600 font-bold">5</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">Unlimited</td>
                    </tr>
                    <tr>
                        <td class="py-5 px-4 text-sm font-bold text-slate-700">Task Branches</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">1</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">2</td>
                        <td class="py-5 px-4 text-sm text-indigo-600 font-bold">4</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">Unlimited</td>
                    </tr>
                    <tr>
                        <td class="py-5 px-4 text-sm font-bold text-slate-700">File Storage</td>
                        <td class="py-5 px-4 text-sm text-slate-300"><i data-lucide="x" class="w-4 h-4"></i></td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">20 GB</td>
                        <td class="py-5 px-4 text-sm text-indigo-600 font-bold">40 GB</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">80 GB</td>
                    </tr>
                    <tr>
                        <td class="py-5 px-4 text-sm font-bold text-slate-700">Analytics</td>
                        <td class="py-5 px-4 text-sm text-slate-300"><i data-lucide="x" class="w-4 h-4"></i></td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">Basic</td>
                        <td class="py-5 px-4 text-sm text-indigo-600 font-bold">Advanced</td>
                        <td class="py-5 px-4 text-sm text-slate-500 font-medium">Advanced</td>
                    </tr>
                    <tr>
                        <td class="py-5 px-4 text-sm font-bold text-slate-700">Role Permissions</td>
                        <td class="py-5 px-4 text-sm text-slate-300"><i data-lucide="x" class="w-4 h-4"></i></td>
                        <td class="py-5 px-4 text-sm text-slate-300"><i data-lucide="x" class="w-4 h-4"></i></td>
                        <td class="py-5 px-4 text-sm text-emerald-500"><i data-lucide="check" class="w-5 h-5"></i></td>
                        <td class="py-5 px-4 text-sm text-emerald-500"><i data-lucide="check" class="w-5 h-5"></i></td>
                    </tr>
                    <tr>
                        <td class="py-5 px-4 text-sm font-bold text-slate-700">Data Export</td>
                        <td class="py-5 px-4 text-sm text-slate-300"><i data-lucide="x" class="w-4 h-4"></i></td>
                        <td class="py-5 px-4 text-sm text-slate-300"><i data-lucide="x" class="w-4 h-4"></i></td>
