@page
@model unigrid.Pages.PricingModel
@{
    ViewData["Title"] = "Pricing";
}

@{
    var businessPlan = Model.Settings.Plans.FirstOrDefault(p => p.Id.Equals("Business", StringComparison.OrdinalIgnoreCase) || p.Name.Equals("Business", StringComparison.OrdinalIgnoreCase));
    var businessMonthlyVal = businessPlan?.MonthlyPrice ?? 899000;
    var businessYearlyVal = businessPlan?.YearlyPrice ?? 8900000;
    var businessFeatures = businessPlan != null ? System.Text.Json.JsonSerializer.Serialize(businessPlan.Features) : "[]";
}
<div class="space-y-16 py-8 px-6 md:px-12 max-w-7xl mx-auto" 
     x-data="{ 
        billing: 'monthly', 
        showConfirmModal: false, 
        showBusinessModal: false,
        businessName: '',
        contactPhone: '',
        federationSubmitted: false,
        selectedTier: '', 
        selectedPriceMonthly: '', 
        selectedPriceYearly: '',
        selectedFeatures: [],
        
        // Dynamic subscription plan settings from Admin panel
        businessMonthly: @businessMonthlyVal,
        businessYearly: @businessYearlyVal,

        formatPrice(val) {
            if (val >= 1000000) {
                return (val / 1000000).toFixed(1).replace('.0', '') + 'M';
            }
            return (val / 1000) + 'K';
        },

        // Checkout state variables
        checkoutLoading: false,
        paymentConfirming: false,
        paymentSuccess: false,
        checkoutUrl: '',
        txnRef: '',
        amountVnd: 0,
        errorMessage: '',

        async triggerUpgrade(tier, priceM, priceY, features) {
            if (@(User.Identity?.IsAuthenticated == true ? "false" : "true")) {
                window.location.href = '/Signup?tier=' + tier;
                return;
            }
            this.selectedTier = tier;
            this.selectedPriceMonthly = priceM;
            this.selectedPriceYearly = priceY;
            this.selectedFeatures = features;
            
            // Reset checkout state
            this.errorMessage = '';
            this.paymentSuccess = false;
            this.checkoutUrl = '';
            this.txnRef = '';
            this.amountVnd = 0;
            this.checkoutLoading = true;
            this.showConfirmModal = true;

            try {
                const response = await fetch('/api/billing/create-checkout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        tier: tier,
                        billingPeriod: this.billing,
                        joinCode: '@Model.ActiveWorkspaceJoinCode'
                    })
                });

                const data = await response.json();
                if (response.ok && data.success) {
                    this.checkoutUrl = data.checkoutUrl;
                    this.txnRef = data.transactionRef;
                    this.amountVnd = data.amount;
                } else {
                    this.errorMessage = data.message || 'Failed to register checkout.';
                }
            } catch (err) {
                this.errorMessage = 'Network error while initiating payment checkout.';
                console.error(err);
            } finally {
                this.checkoutLoading = false;
            }
        },
        triggerBusinessUpgrade() {
            if (@(User.Identity?.IsAuthenticated == true ? "false" : "true")) {
                window.location.href = '/Signup?tier=Business';
                return;
            }
            this.showBusinessModal = true;
        },
        async submitFederationRequest() {
            if (!this.businessName.trim() || !this.contactPhone.trim()) return;
            
            const formData = new FormData();
            formData.append('businessName', this.businessName);
            formData.append('contactPhone', this.contactPhone);
            formData.append('__RequestVerificationToken', document.querySelector('input[name=__RequestVerificationToken]')?.value || '');

            try {
                await fetch('?handler=SubmitFederationRequest', {
                    method: 'POST',
                    body: formData
                });
            } catch(e) {
                console.error(e);
            }
            
            this.federationSubmitted = true;
        }
     }">
    
    <!-- Header -->
    <div class="text-center space-y-4 max-w-2xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-black text-slate-800 tracking-tight font-display">Simple, transparent <span class="bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent">pricing</span></h2>
        <p class="text-slate-500 text-lg leading-relaxed">Choose the plan that fits your team. Upgrade anytime as you grow.</p>
        
        <!-- Billing Toggle -->
        <div class="flex items-center justify-center gap-3 mt-8">
            <button @@click="billing = 'monthly'" 
                    :class="billing == 'monthly' ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-white text-slate-500 hover:bg-slate-50 border border-slate-100'"
                    class="px-6 py-2.5 rounded-xl text-sm font-bold transition-all">Monthly</button>
            <button @@click="billing = 'yearly'" 
                    :class="billing == 'yearly' ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-white text-slate-500 hover:bg-slate-50 border border-slate-100'"
                    class="px-6 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2">
                Yearly <span class="px-2 py-0.5 bg-emerald-500/10 text-emerald-600 text-[10px] rounded-full font-black">-17%</span>
            </button>
        </div>
    </div>

    @if (TempData["UpgradeError"] != null)
    {
        <div class="max-w-2xl mx-auto p-4 bg-rose-50 border border-rose-100 text-rose-600 rounded-2xl text-xs font-bold flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2">
                <i data-lucide="alert-triangle" class="w-4 h-4 shrink-0"></i>
                <span>@TempData["UpgradeError"]</span>
            </div>
        </div>
    }

    <!-- Plan Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5">
        <!-- Free Plan -->
        <div class="glass p-8 rounded-[3rem] flex flex-col h-full border-t-8 border-slate-200 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1 duration-300 @(Model.CurrentPlan == "Free" ? "ring-4 ring-indigo-500/20" : "")">
            <div class="mb-6">
                <h3 class="text-xl font-black text-slate-800 mb-2">Free</h3>
                <p class="text-xs text-slate-400 font-bold uppercase tracking-widest">For individuals</p>
            </div>
            <div class="mb-6">
                <div class="flex items-baseline">
                    <span class="text-4xl font-black text-slate-800">Free</span>
                </div>
                <p class="text-xs text-slate-400 font-medium mt-1">Single-user or small personal projects</p>
                <p class="text-sm text-slate-500 mt-3 leading-relaxed">For small teams getting started</p>
            </div>
            <ul class="space-y-4 mb-8 flex-1 border-t border-slate-100 pt-6">
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 1 Workspace
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 5 Members
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> Basic Analytics
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> Task Assignment
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> 1 Chat Channel
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium text-slate-300">
                    <i data-lucide="x" class="w-4 h-4 text-slate-300 shrink-0"></i> No File Storage
                </li>
            </ul>
            @if (User.Identity?.IsAuthenticated == true) {
                @if (Model.CurrentPlan == "Free") {
                    <button disabled class="w-full py-4 bg-slate-100 text-slate-400 rounded-2xl font-bold cursor-not-allowed">Current Plan</button>
                } else if (Model.GetPlanRank(Model.CurrentPlan) > 0) {
                    <!-- Hidden for downgraded plan -->
                } else {
                    <button @@click="triggerUpgrade('Free', 'Free', 'Free', ['1 Workspace', '5 Members', 'Basic Analytics', 'Task Assignment', '1 Chat Channel'])" 
                            class="w-full py-4 bg-white border border-slate-200 text-slate-700 rounded-2xl font-bold hover:bg-slate-50 transition-all">Get Started</button>
                }
            } else {
                <button @@click="triggerUpgrade('Free', 'Free', 'Free', ['1 Workspace', '5 Members', 'Basic Analytics', 'Task Assignment', '1 Chat Channel'])" 
                        class="w-full py-4 bg-white border border-slate-200 text-slate-700 rounded-2xl font-bold hover:bg-slate-50 transition-all">Get Started</button>
            }
        </div>

        <!-- Dynamic Plans from Config -->
        @foreach (var plan in Model.Settings.Plans.Where(p => !p.IsDisabled))
        {
            var planBorder = PlanColorHelper.GetBorderClass(plan.ColorClass);
            var planText = PlanColorHelper.GetTextClass(plan.ColorClass);
            var planBg = PlanColorHelper.GetBgClass(plan.ColorClass);
            var planShadow = PlanColorHelper.GetShadowClass(plan.ColorClass);
            var planRing = PlanColorHelper.GetRingClass(plan.ColorClass);
            var isCurrent = Model.CurrentPlan.Equals(plan.Id, StringComparison.OrdinalIgnoreCase) || Model.CurrentPlan.Equals(plan.Name, StringComparison.OrdinalIgnoreCase);
            var planRank = Model.GetPlanRank(plan.Id);
            var currentRank = Model.GetPlanRank(Model.CurrentPlan);

            <div class="glass p-8 rounded-[3rem] flex flex-col h-full border-t-8 @planBorder shadow-sm transition-all hover:shadow-xl hover:-translate-y-1 duration-300 @(isCurrent ? $"ring-4 {planRing}" : "")">
                <div class="mb-6">
                    <h3 class="text-xl font-black text-slate-800 mb-2">@plan.Name</h3>
                    <p class="text-xs @planText font-bold uppercase tracking-widest">@plan.Description</p>
                </div>
                <div class="mb-6">
                    <div class="flex items-baseline gap-1">
                        <span class="text-4xl font-black text-slate-800" x-text="billing == 'monthly' ? formatPrice(@plan.MonthlyPrice) : formatPrice(@plan.YearlyPrice)"></span>
                        <span class="text-slate-400 font-bold text-sm">VND</span>
                    </div>
                    <p class="text-xs @planText font-bold mt-1" x-text="billing == 'monthly' ? '≈ ' + formatPrice(@plan.MonthlyPrice) + ' VND / month' : '≈ ' + formatPrice(Math.round(@plan.YearlyPrice/12)) + ' VND / month'"></p>
                    <p class="text-sm text-slate-500 mt-3 leading-relaxed">Workspace capacity: @plan.MemberLimit @(plan.MemberLimit == 1 ? "member" : "members")</p>
                </div>
                <ul class="space-y-4 mb-8 flex-1 border-t border-slate-100 pt-6">
                    @foreach (var feature in plan.Features)
                    {
                        <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                            <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i> @feature
                        </li>
                    }
                </ul>
                @if (User.Identity?.IsAuthenticated == true) {
                    @if (isCurrent) {
                        <button disabled class="w-full py-4 bg-slate-100 text-slate-400 rounded-2xl font-bold cursor-not-allowed">Current Plan</button>
                    } else if (plan.Id.Equals("Business", StringComparison.OrdinalIgnoreCase)) {
                        <button @@click="triggerBusinessUpgrade()" 
                                class="w-full py-4 @planBg text-white rounded-2xl font-bold shadow-lg @planShadow transition-all">Upgrade Now</button>
                    } else if (currentRank > planRank) {
                        <button @@click="triggerUpgrade('@plan.Id', formatPrice(@plan.MonthlyPrice), formatPrice(@plan.YearlyPrice), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(plan.Features).Replace("\"", "'")))" 
                                class="w-full py-4 bg-white border border-slate-200 text-slate-700 rounded-2xl font-bold hover:bg-slate-50 transition-all">Select Plan</button>
                    } else {
                        <button @@click="triggerUpgrade('@plan.Id', formatPrice(@plan.MonthlyPrice), formatPrice(@plan.YearlyPrice), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(plan.Features).Replace("\"", "'")))" 
                                class="w-full py-4 @planBg text-white rounded-2xl font-bold shadow-lg @planShadow transition-all">Upgrade Now</button>
                    }
                } else {
                    @if (plan.Id.Equals("Business", StringComparison.OrdinalIgnoreCase)) {
                        <button @@click="triggerBusinessUpgrade()" 
                                class="w-full py-4 @planBg text-white rounded-2xl font-bold shadow-lg @planShadow transition-all">Upgrade Now</button>
                    } else {
                        <button @@click="triggerUpgrade('@plan.Id', formatPrice(@plan.MonthlyPrice), formatPrice(@plan.YearlyPrice), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(plan.Features).Replace("\"", "'")))" 
                                class="w-full py-4 @planBg text-white rounded-2xl font-bold shadow-lg @planShadow transition-all">Upgrade Now</button>
                    }
                }
            </div>
        }
    </div>

    <div x-show="showConfirmModal" x-transition x-cloak class="fixed inset-0 z-50 overflow-y-auto flex items-start sm:items-center justify-center p-4">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" @@click="if (!paymentConfirming && !paymentSuccess) showConfirmModal = false"></div>
        
        <!-- Modal Content -->
        <div class="bg-white rounded-[2rem] sm:rounded-[2.5rem] border border-slate-100 p-6 sm:p-8 shadow-2xl relative z-10 w-full max-w-lg transform transition-all duration-300 my-8 sm:my-0 max-h-[90vh] flex flex-col overflow-hidden">
            <button x-show="!paymentConfirming && !paymentSuccess" @@click="showConfirmModal = false" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            
            <!-- Loading Checkout State -->
            <div x-show="checkoutLoading" class="py-12 flex flex-col items-center justify-center space-y-4">
                <div class="h-10 w-10 border-4 border-indigo-600/20 border-t-indigo-600 rounded-full animate-spin"></div>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-widest animate-pulse">Creating secure payOS checkout...</p>
            </div>

            <!-- Error State -->
            <div x-show="!checkoutLoading && errorMessage" class="py-6 space-y-6">
                <div class="h-12 w-12 bg-rose-50 text-rose-600 rounded-2xl flex items-center justify-center shadow-md">
                    <i data-lucide="alert-circle" class="w-6 h-6"></i>
                </div>
                <div>
                    <h3 class="text-xl font-black text-slate-800">Checkout Error</h3>
                    <p class="text-sm text-slate-500 mt-2" x-text="errorMessage"></p>
                </div>
                <button @@click="showConfirmModal = false" class="w-full py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-2xl transition-all">Close</button>
            </div>

            <!-- Success Redirect State -->
            <div x-show="paymentSuccess" class="py-12 flex flex-col items-center justify-center space-y-4">
                <div class="h-14 w-14 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center border border-emerald-100 shadow-lg">
                    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <h4 class="text-lg font-black text-slate-800">Payment Confirmed!</h4>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest animate-pulse">Awaiting admin confirmation, redirecting...</p>
            </div>

            <!-- Main Checkout View -->
            <div x-show="!checkoutLoading && !errorMessage && !paymentSuccess" class="space-y-6 overflow-y-auto pr-1">
                <!-- Header -->
                <div class="flex items-center gap-3">
                    <div class="h-10 w-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center shadow-sm">
                        <i data-lucide="qr-code" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-black text-slate-800 tracking-tight">Secure payment with payOS</h3>
                        <p class="text-[10px] text-slate-400 font-black uppercase tracking-wider">Automatic payment verification</p>
                    </div>
                </div>
                
                <!-- Plan Summary -->
                <div class="px-5 py-4 bg-slate-50 border border-slate-100 rounded-2xl flex items-center justify-between text-xs">
                    <div>
                        <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Plan Selected</p>
                        <p class="text-sm font-bold text-slate-800 mt-0.5" x-text="selectedTier + ' Plan (' + (billing == 'monthly' ? 'Monthly' : 'Yearly') + ')'"></p>
                    </div>
                    <div class="text-right">
                        <p class="text-lg font-black text-slate-800" x-text="amountVnd.toLocaleString('vi-VN') + ' VND'"></p>
                    </div>
                </div>

                <div class="p-4 bg-indigo-50/40 border border-indigo-100 rounded-2xl text-xs leading-relaxed text-slate-600">
                    You will be redirected to payOS to scan the VietQR code. UniGrid activates the plan automatically after payOS confirms the payment; you do not need to submit a transfer confirmation manually.
                </div>

                <!-- Action Triggers -->
                <div class="flex gap-4 pt-2">
                    <button @@click="showConfirmModal = false" class="flex-1 py-3 bg-slate-100 text-slate-700 font-bold rounded-2xl hover:bg-slate-200 transition-all text-xs">Cancel</button>
                    <button @@click="window.location.assign(checkoutUrl)" class="flex-1 py-3 bg-indigo-600 text-white font-bold rounded-2xl shadow-lg shadow-indigo-100 hover:bg-indigo-700 transition-all text-xs flex items-center justify-center gap-2">
                        Continue to payOS
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div x-show="showBusinessModal" x-transition x-cloak class="fixed inset-0 z-50 overflow-y-auto flex items-start sm:items-center justify-center p-4">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" @@click="showBusinessModal = false"></div>
        
        <!-- Modal Content -->
        <div class="bg-white rounded-[2rem] sm:rounded-[2.5rem] border border-slate-100 p-6 sm:p-8 shadow-2xl relative z-10 w-full max-w-2xl transform transition-all duration-300 my-8 sm:my-0 max-h-[90vh] flex flex-col overflow-hidden">
            <button @@click="showBusinessModal = false" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            
            <div class="space-y-6 overflow-y-auto pr-1">
                <div class="h-12 w-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center shadow-md">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                </div>
                
                <div>
                    <h3 class="text-2xl font-black text-slate-800 tracking-tight">Business & Enterprise Federation options</h3>
                    <p class="text-sm text-slate-500 mt-1">Please select the plan setup that matches your organizational workflow needs.</p>
                </div>

                <div x-show="!federationSubmitted" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Option 1: Direct 899K Workspace Upgrade -->
                    <div class="p-6 bg-slate-50 rounded-[2rem] border border-slate-100 flex flex-col justify-between hover:border-indigo-200 transition-all shadow-sm">
                        <div class="space-y-3">
                            <span class="px-2.5 py-0.5 bg-indigo-100 text-indigo-700 text-[9px] font-black rounded-full uppercase tracking-wider">Choice 1: Business Workspace</span>
                            <h4 class="text-lg font-black text-slate-850">Direct Upgrade to Business Workspace</h4>
                            <p class="text-xs text-slate-500 leading-relaxed font-semibold">Automatically upgrade the current workspace to a Business Workspace for <span class="text-indigo-600 font-bold" x-text="businessMonthly.toLocaleString('vi-VN') + ' VND / month'">899,000 VND / month</span>. Includes up to 30 members, 80 GB of storage, and instant access to premium features.</p>
                        </div>
                        <button @@click="showBusinessModal = false; triggerUpgrade('Business', formatPrice(businessMonthly), formatPrice(businessYearly), @Html.Raw(businessFeatures.Replace("\"", "'")))" 
                                class="w-full mt-6 py-3 bg-indigo-600 text-white text-xs font-black rounded-xl hover:bg-indigo-700 shadow-md shadow-indigo-100 transition-all cursor-pointer flex items-center justify-center gap-1">
                            <span>Upgrade Now (</span><span x-text="formatPrice(businessMonthly)"></span><span>/month)</span>
                        </button>
                    </div>

                    <!-- Option 2: Federation Contact Form -->
                    <div class="p-6 bg-slate-50 rounded-[2rem] border border-slate-100 flex flex-col justify-between hover:border-violet-200 transition-all shadow-sm">
                        <div class="space-y-3">
                            <span class="px-2.5 py-0.5 bg-violet-100 text-violet-700 text-[9px] font-black rounded-full uppercase tracking-wider">Choice 2: Corporate Fed</span>
                            <h4 class="text-lg font-black text-slate-850">Register Enterprise Federation</h4>
                            <p class="text-xs text-slate-500 leading-relaxed font-semibold">Enterprise Federation represents a formally registered organization or enterprise, allowing interconnectivity and cross-navigation across multiple child workspaces. <span class="text-violet-600 font-bold">Setup by System Administrator is required.</span></p>
                        </div>
                        
                        <!-- Mini Contact form -->
                        <div class="mt-4 space-y-2 border-t border-slate-200/60 pt-4">
                            <div>
                                <label class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Business / Organization Name</label>
                                <input type="text" x-model="businessName" placeholder="e.g., FPT Software" 
                                       class="w-full mt-1 px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500 transition-all">
                            </div>
                            <div>
                                <label class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Contact Phone Number</label>
                                <input type="text" x-model="contactPhone" placeholder="e.g., +84987654321" 
                                       class="w-full mt-1 px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500 transition-all">
                            </div>
                            <button @@click="submitFederationRequest()" 
                                    :disabled="!businessName || !contactPhone"
                                    class="w-full mt-2 py-3 bg-violet-600 text-white text-xs font-black rounded-xl hover:bg-violet-700 shadow-md shadow-violet-100 disabled:opacity-50 disabled:cursor-not-allowed transition-all cursor-pointer">
                                Send Federation Connection Request
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Submission Success State -->
                <div x-show="federationSubmitted" class="p-8 text-center space-y-4" x-cloak>
                    <div class="h-16 w-16 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto border border-emerald-100 shadow-sm">
                        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <h4 class="text-xl font-black text-slate-800">Request Sent to Admin Successfully!</h4>
                    <p class="text-xs text-slate-500 max-w-md mx-auto leading-relaxed font-semibold">Thank you for your interest in UniGrid's Enterprise Federation solution. The registration request for <span class="text-indigo-600 font-bold" x-text="businessName"></span> (Phone: <span x-text="contactPhone"></span>) has been recorded. UniGrid's support team will contact you to verify your organization and configure the department/workspace linkages within 24 hours.</p>
                    <button @@click="showBusinessModal = false; federationSubmitted = false; businessName = ''; contactPhone = ''" 
                            class="px-6 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-black rounded-xl transition-all cursor-pointer">
                        Close
