                    <button @@click="triggerUpgrade('ProPlus', '449K', '4.4M', ['1 Workspace', '15 Members', '40 GB Storage', '5 Chat Channels', '4 Task Branches', 'Advanced Analytics', 'Role Permissions'])" 
