<!DOCTYPE html>
<html lang="en" class="h-full bg-[#fafafa]">
<head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-1JW9TXZ0CD"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-1JW9TXZ0CD');
</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniGrid</title>
    <meta name="description" content="UniGrid is a highly visual, modern task and team management platform built for students and small teams to organize tasks, deadlines, files, and discussions clearly." />
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="shortcut icon" href="~/favicon.ico" type="image/png" />
    <link rel="icon" href="~/favicon.ico" type="image/png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { font-family: 'Inter', 'Plus Jakarta Sans', sans-serif; }
        .glass { background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.3); }
        .sidebar-gradient { background: #ffffff; }
        [x-cloak] { display: none !important; }
        /* Anti-flicker: hide html until DOM is parsed */
        html { visibility: hidden; }
    </style>
</head>
@using Microsoft.EntityFrameworkCore
@inject unigrid.Data.UniGridDbContext DbContext
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    bool isFedPage = currentPage == "/FederationDetail";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isFullPage = currentPage == "/Index" || currentPage == "/Login" || (currentPage == "/Signup" || (currentPage == "/Pricing" && !isAuthenticated));

    List<unigrid.Models.Notification> notifications = new();
    List<unigrid.Models.WorkspaceInvitation> pendingInvitations = new();
    int unreadNotificationsCount = 0;

    List<unigrid.Models.Workspace> sidebarPersonalWorkspaces = new();
    List<unigrid.Models.Workspace> sidebarGroupWorkspaces = new();
    List<unigrid.Models.WorkspaceFederation> sidebarFederations = new();
    unigrid.Models.User? currentUser = null;

    // Fallback user details from cookie claims
    var fallbackName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "User";
    ViewData["UserName"] = fallbackName;
    var fallbackInitials = string.Concat(fallbackName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "U")).ToUpper();
    ViewData["UserInitials"] = fallbackInitials.Length > 2 ? fallbackInitials.Substring(0, 2) : fallbackInitials;

    var accountIdClaim = User.FindFirst("AccountId")?.Value;
    if (!string.IsNullOrEmpty(accountIdClaim) && Guid.TryParse(accountIdClaim, out var accountId))
    {
        currentUser = DbContext.Users.FirstOrDefault(u => u.AccountId == accountId);
        if (currentUser == null)
        {
            // Self-healing: Auto-create User profile if Account exists but User profile is missing
            try
            {
                var accountRecord = DbContext.Accounts.FirstOrDefault(a => a.Id == accountId);
                if (accountRecord != null)
                {
                    currentUser = new unigrid.Models.User
                    {
                        Id = Guid.NewGuid(),
                        AccountId = accountId,
                        FullName = fallbackName,
                        SubscriptionTier = "Free"
                    };
                    DbContext.Users.Add(currentUser);
                    DbContext.SaveChanges();
                }
            }
            catch (Exception)
            {
                // Prevent crash if DB write fails during rendering
            }
        }

        if (currentUser != null)
        {
            ViewData["UserName"] = currentUser.FullName;
            var initials = string.Concat(currentUser.FullName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "U")).ToUpper();
            ViewData["UserInitials"] = initials.Length > 2 ? initials.Substring(0, 2) : initials;
            notifications = DbContext.Notifications
                .Where(n => n.UserId == currentUser.Id)
                .OrderByDescending(n => n.CreatedAt)
                .Take(8)
                .ToList();

            unreadNotificationsCount = DbContext.Notifications
                .Count(n => n.UserId == currentUser.Id && !n.IsRead);

            var accountRecord = DbContext.Accounts.FirstOrDefault(a => a.Id == accountId);
            if (accountRecord != null && !string.IsNullOrEmpty(accountRecord.Email))
            {
                pendingInvitations = DbContext.WorkspaceInvitations
                    .Include(i => i.Workspace)
                    .Include(i => i.Inviter)
                    .Where(i => i.InviteeEmail.ToLower() == accountRecord.Email.ToLower() && i.Status == "Pending")
                    .OrderByDescending(i => i.CreatedAt)
                    .ToList();
            }

            // Query user workspaces
            var userWorkspaces = DbContext.WorkspaceMembers
                .Include(m => m.Workspace)
                .Where(m => !m.IsDisabled && m.UserId == currentUser.Id && !m.Workspace.IsDisabled)
                .Select(m => m.Workspace)
                .Distinct()
                .ToList();

            sidebarPersonalWorkspaces = userWorkspaces
                .Where(w => w.WorkspaceType == "Personal" && w.FederationId == null)
                .ToList();

            sidebarGroupWorkspaces = userWorkspaces
                .Where(w => w.WorkspaceType == "Group" && w.FederationId == null)
                .ToList();

            sidebarFederations = DbContext.WorkspaceFederations
                .Include(f => f.Workspaces)
                .Include(f => f.WorkspaceFederationMembers)
                    .ThenInclude(m => m.PersonalWorkspace)
                .Where(f => f.OwnerId == currentUser.Id 
                            || f.WorkspaceFederationMembers.Any(m => m.UserId == currentUser.Id)
                            || f.Workspaces.Any(w => !w.IsDisabled && DbContext.WorkspaceMembers.Any(wm => !wm.IsDisabled && wm.WorkspaceId == w.Id && wm.UserId == currentUser.Id)))
                .Distinct()
                .ToList();
        }
    }
}
<body class="h-full overflow-hidden flex text-slate-900" 
      x-data="{ sidebarOpen: window.innerWidth > 768, notificationsOpen: false, profileOpen: false, isFullPage: @(isFullPage ? "true" : "false"), wsOpen: true, personalWsOpen: true, groupWsOpen: true, fedOpen: true, mobileNavOpen: false, globalSearchQuery: '' }">
    
    <!-- Mobile Sidebar Overlay -->
    <div x-show="!isFullPage && sidebarOpen" @@click="sidebarOpen = false" x-cloak
         class="md:hidden fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-30 transition-opacity">
    </div>

    <!-- Sidebar (Hidden on Auth/Landing) -->
    <aside x-show="!isFullPage" 
           class="sidebar-gradient border-r border-slate-200 transition-all duration-300 flex flex-col fixed md:static inset-y-0 left-0 z-40 h-full"
           :class="sidebarOpen ? 'w-64 translate-x-0' : '-translate-x-full md:translate-x-0 md:w-20'">
        <!-- Sidebar Header -->
        <div class="h-16 flex items-center px-4 mb-2">
            <div class="flex items-center gap-3">
                <img src="~/assets/official-logo-64.png" alt="UniGrid Logo" class="h-9 w-9 shrink-0 rounded-xl object-contain shadow-lg shadow-indigo-200" asp-append-version="true" />
                <span class="font-bold text-lg tracking-tight text-slate-900" x-show="sidebarOpen" x-transition>UniGrid</span>
            </div>
        </div>

        <nav class="flex-1 px-3 space-y-1 overflow-y-auto">
            <!-- Main Nav -->
            @if (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "2")
            {
                <div class="space-y-1 mb-6">
                    <a asp-page="/Dashboard" class="flex items-center gap-3 px-3 py-2 rounded-lg transition-all group"
                       :class="'@currentPage' == '/Dashboard' ? 'bg-slate-100 text-slate-900 font-semibold' : 'text-slate-500 hover:bg-slate-50 hover:text-slate-900'">
                        <i data-lucide="layout-dashboard" class="w-4 h-4 shrink-0"></i>
                        <span class="text-sm" x-show="sidebarOpen">Dashboard</span>
                    </a>
                    <a asp-page="/Schedule" class="flex items-center gap-3 px-3 py-2 rounded-lg transition-all group"
                       :class="'@currentPage' == '/Schedule' ? 'bg-slate-100 text-slate-900 font-semibold' : 'text-slate-500 hover:bg-slate-50 hover:text-slate-900'">
                        <i data-lucide="calendar-days" class="w-4 h-4 shrink-0"></i>
                        <span class="text-sm" x-show="sidebarOpen">Schedule</span>
                    </a>
                </div>
            }

            @if (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "1" || User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "3")
            {
                <!-- Admin Portal Nav -->
                <div x-show="sidebarOpen" class="space-y-1 mb-6 border-t border-slate-100 pt-4">
                    <div class="px-3 py-1.5 text-[10px] font-black text-indigo-400 uppercase tracking-widest">
                        Admin Portal
                    </div>
                    <a asp-page="/Admin/Index" class="flex items-center gap-3 px-3 py-2 rounded-lg transition-all group"
                       :class="'@currentPage' == '/Admin/Index' ? 'bg-indigo-50 text-indigo-950 font-semibold' : 'text-slate-500 hover:bg-indigo-50/20 hover:text-indigo-950'">
                        <i data-lucide="bar-chart-3" class="w-4 h-4 text-indigo-500 shrink-0"></i>
                        <span class="text-sm">Metrics & Income</span>
                    </a>
                    <a asp-page="/Admin/Users" class="flex items-center gap-3 px-3 py-2 rounded-lg transition-all group"
                       :class="'@currentPage' == '/Admin/Users' ? 'bg-indigo-50 text-indigo-950 font-semibold' : 'text-slate-500 hover:bg-indigo-50/20 hover:text-indigo-950'">
                        <i data-lucide="users" class="w-4 h-4 text-teal-500 shrink-0"></i>
                        <span class="text-sm">Control Users</span>
                    </a>
                    <a asp-page="/Admin/Subscriptions" class="flex items-center gap-3 px-3 py-2 rounded-lg transition-all group"
                       :class="'@currentPage' == '/Admin/Subscriptions' ? 'bg-indigo-50 text-indigo-950 font-semibold' : 'text-slate-500 hover:bg-indigo-50/20 hover:text-indigo-950'">
                        <i data-lucide="credit-card" class="w-4 h-4 text-amber-500 shrink-0"></i>
                        <span class="text-sm">Subscriptions</span>
                    </a>
                    <a asp-page="/Admin/Federations" class="flex items-center gap-3 px-3 py-2 rounded-lg transition-all group"
                       :class="'@currentPage' == '/Admin/Federations' ? 'bg-indigo-50 text-indigo-950 font-semibold' : 'text-slate-500 hover:bg-indigo-50/20 hover:text-indigo-950'">
                        <i data-lucide="globe" class="w-4 h-4 text-violet-500 shrink-0"></i>
                        <span class="text-sm">Federations</span>
                    </a>
                </div>
            }

            @if (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "2")
            {
                <!-- Solo Portals Collapsible -->
                <div x-show="sidebarOpen" class="space-y-1 mb-4">
                    <button @@click="personalWsOpen = !personalWsOpen" class="flex w-full items-center justify-between px-3 py-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest hover:text-slate-900 transition-colors">
                        <div class="flex items-center gap-2">
                            <i data-lucide="user" class="h-3.5 w-3.5 text-teal-500"></i>
                            <span>Solo Portals</span>
                        </div>
                        <i data-lucide="chevron-down" class="h-3.5 w-3.5 transition-transform" :class="personalWsOpen ? 'rotate-180' : ''"></i>
                    </button>
                    <div x-show="personalWsOpen" x-transition class="space-y-0.5">
                        @if (sidebarPersonalWorkspaces.Any())
                        {
                            @foreach (var ws in sidebarPersonalWorkspaces)
                            {
                                <a href="/WorkspaceDetail/@ws.JoinCode" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-all text-sm">
                                    <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded bg-teal-50 text-[10px] font-black text-teal-600">
                                        @ws.Name.Substring(0, 1)
                                    </div>
                                    <span class="truncate">@ws.Name</span>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="px-3 py-2 text-xs text-slate-400 italic">No Solo Portals</div>
                        }
                    </div>
                </div>

                <!-- Group Boards Collapsible -->
                <div x-show="sidebarOpen" class="space-y-1 mb-4">
                    <button @@click="groupWsOpen = !groupWsOpen" class="flex w-full items-center justify-between px-3 py-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest hover:text-slate-900 transition-colors">
                        <div class="flex items-center gap-2">
                            <i data-lucide="users" class="h-3.5 w-3.5 text-indigo-500"></i>
                            <span>Group Boards</span>
                        </div>
                        <i data-lucide="chevron-down" class="h-3.5 w-3.5 transition-transform" :class="groupWsOpen ? 'rotate-180' : ''"></i>
                    </button>
                    <div x-show="groupWsOpen" x-transition class="space-y-0.5">
                        @if (sidebarGroupWorkspaces.Any())
                        {
                            @foreach (var ws in sidebarGroupWorkspaces)
                            {
                                <a href="/WorkspaceDetail/@ws.JoinCode" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-all text-sm">
                                    <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded bg-indigo-50 text-[10px] font-black text-indigo-600">
                                        @ws.Name.Substring(0, 1)
                                    </div>
                                    <span class="truncate">@ws.Name</span>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="px-3 py-2 text-xs text-slate-400 italic">No Group Boards</div>
                        }
                    </div>
                </div>

                <!-- Enterprise Federations Collapsible -->
                <div x-show="sidebarOpen" class="space-y-1 mb-4">
                    <button @@click="fedOpen = !fedOpen" class="flex w-full items-center justify-between px-3 py-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest hover:text-slate-900 transition-colors">
                        <div class="flex items-center gap-2">
                            <i data-lucide="globe" class="h-3.5 w-3.5 text-violet-500"></i>
                            <span>Enterprise Federations</span>
                        </div>
                        <i data-lucide="chevron-down" class="h-3.5 w-3.5 transition-transform" :class="fedOpen ? 'rotate-180' : ''"></i>
                    </button>
                    <div x-show="fedOpen" x-transition class="space-y-0.5">
                        @if (sidebarFederations.Any())
                        {
                            @foreach (var fed in sidebarFederations)
                            {
                                var isFedMember = fed.OwnerId == currentUser.Id || fed.WorkspaceFederationMembers.Any(m => m.UserId == currentUser.Id && m.Status == "Active");
                                <div class="space-y-1 mb-2">
                                    @if (isFedMember)
                                    {
                                        <a href="/FederationDetail?joinCode=@fed.JoinCode" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-all text-sm font-semibold">
                                            <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded bg-violet-50 text-[10px] font-black text-violet-600">
                                                @fed.Name.Substring(0, 1).ToUpper()
                                            </div>
                                            <span class="truncate">@fed.Name</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-400 text-sm font-semibold select-none">
                                            <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded bg-slate-100 text-[10px] font-black text-slate-400">
                                                @fed.Name.Substring(0, 1).ToUpper()
                                            </div>
                                            <span class="truncate">@fed.Name</span>
                                        </div>
                                    }
                                    
                                    <!-- Nested Federation Workspaces -->
                                    <div class="pl-5 ml-5 border-l border-slate-100 space-y-0.5 mt-1">
                                        @{
                                            var visibleWorkspaces = fed.Workspaces ?? new List<unigrid.Models.Workspace>();
                                            if (!isFedMember)
                                            {
                                                visibleWorkspaces = visibleWorkspaces.Where(w => !w.IsDisabled && (w.OwnerId == currentUser.Id || DbContext.WorkspaceMembers.Any(wm => !wm.IsDisabled && wm.WorkspaceId == w.Id && wm.UserId == currentUser.Id))).ToList();
                                            }
                                        }
                                        @if (visibleWorkspaces.Any())
                                        {
                                            @foreach (var ws in visibleWorkspaces)
                                            {
                                                <a href="/WorkspaceDetail/@ws.JoinCode" class="flex items-center gap-3 px-3 py-1.5 rounded-lg text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-all text-xs">
                                                    <div class="flex h-4.5 w-4.5 shrink-0 items-center justify-center rounded bg-slate-50 text-[9px] font-black text-slate-500">
                                                        @ws.Name.Substring(0, 1).ToUpper()
                                                    </div>
                                                    <span class="truncate">@ws.Name</span>
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <div class="px-3 py-1 text-[10px] text-slate-400 italic">No workspaces linked</div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="px-3 py-2 text-xs text-slate-400 italic">No Active Federations</div>
                        }
                    </div>
                </div>
                
                <!-- Collapsed Workspaces Icon -->
                <div x-show="!sidebarOpen" class="pt-2">
                    <a href="/Workspaces" class="flex items-center justify-center p-2 text-slate-500 hover:bg-slate-50 rounded-lg transition-all" title="Workspaces">
                        <i data-lucide="briefcase" class="w-5 h-5"></i>
                    </a>
                </div>
            }
        </nav>

        <!-- Sidebar Footer -->
        @if (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "2")
        {
            <div class="p-3 border-t border-slate-100" x-show="sidebarOpen">
                <a href="/Workspaces" class="w-full py-2 px-3 border border-slate-200 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-50 transition-all flex items-center justify-center gap-2">
                    <i data-lucide="plus" class="w-4 h-4 text-slate-400"></i>
                    New Workspace
                </a>
            </div>
        }
        
        <div class="p-4 flex justify-center">
            <button @@click="sidebarOpen = !sidebarOpen" class="text-slate-400 hover:text-indigo-600 transition-colors hidden md:block">
                <i data-lucide="chevron-left" class="w-5 h-5" x-show="sidebarOpen"></i>
                <i data-lucide="chevron-right" class="w-5 h-5" x-show="!sidebarOpen" x-cloak></i>
            </button>
        </div>
    </aside>

    <!-- Content Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden relative">
        <!-- Landing/Auth Header -->
        <header x-show="isFullPage" class="h-20 flex items-center justify-between px-6 md:px-12 bg-white/80 backdrop-blur-md sticky top-0 z-30 border-b border-slate-100">
            <a asp-page="/Index" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
                <img src="~/assets/official-logo-64.png" alt="UniGrid Logo" class="h-9 w-9 rounded-xl object-contain shadow-lg shadow-indigo-100" asp-append-version="true" />
                <span class="text-xl font-bold tracking-tight text-slate-900 font-display">UniGrid</span>
            </a>
            <nav class="hidden md:flex items-center gap-8">
                <a asp-page="/Pricing" class="text-sm font-bold text-slate-600 hover:text-indigo-600 transition-colors">Pricing</a>
                <a asp-page="/Login" class="text-sm font-bold text-slate-600 hover:text-indigo-600 transition-colors">Log in</a>
                <a asp-page="/Signup" class="px-6 py-2.5 bg-indigo-600 text-white rounded-xl text-sm font-bold shadow-lg shadow-indigo-100 hover:bg-indigo-700 transition-all">Get Started Free</a>
            </nav>
            
            <!-- Mobile Hamburger for Landing -->
            <button @@click="mobileNavOpen = !mobileNavOpen" class="md:hidden p-2 text-slate-600 hover:text-indigo-600 rounded-xl">
                <i data-lucide="menu" class="w-6 h-6" x-show="!mobileNavOpen"></i>
                <i data-lucide="x" class="w-6 h-6" x-show="mobileNavOpen" x-cloak></i>
            </button>

            <!-- Mobile Navigation Dropdown -->
            <div x-show="mobileNavOpen" x-transition x-cloak 
                 class="md:hidden absolute top-20 left-0 right-0 bg-white border-b border-slate-200 px-6 py-6 flex flex-col gap-4 shadow-xl z-50">
                <a asp-page="/Pricing" class="text-base font-bold text-slate-700 hover:text-indigo-600 py-2 border-b border-slate-50">Pricing</a>
                <a asp-page="/Login" class="text-base font-bold text-slate-700 hover:text-indigo-600 py-2 border-b border-slate-50">Log in</a>
                <a asp-page="/Signup" class="w-full py-3 bg-indigo-600 text-white rounded-xl text-base font-bold text-center shadow-lg shadow-indigo-100 hover:bg-indigo-700">Get Started Free</a>
            </div>
        </header>

        <!-- Dashboard Header -->
        <header x-show="!isFullPage" class="h-16 glass sticky top-0 z-10 flex items-center justify-between px-4 md:px-8">
            <div class="flex items-center gap-4">
                <button @@click="sidebarOpen = !sidebarOpen" class="md:hidden p-2 text-slate-500 hover:text-indigo-600 hover:bg-slate-100 rounded-xl transition-all">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
            </div>

            <div class="flex items-center gap-3">
                <div class="relative" x-data="{ 
                    currentTab: 'notifications', 
                    unreadCount: @unreadNotificationsCount, 
                    invitationCount: @pendingInvitations.Count,
                    async markAsRead(id, elementId) {
                        try {
                            const res = await fetch(`/api/notifications/mark-read/${id}`, { method: 'POST' });
                            if (res.ok) {
                                const el = document.getElementById(elementId);
                                if (el) {
                                    el.style.opacity = '0.5';
                                    el.style.pointerEvents = 'none';
                                }
                                if (this.unreadCount > 0) this.unreadCount--;
                            }
                        } catch (err) { console.error(err); }
                    },
                    async markAllAsRead() {
                        try {
                            const res = await fetch('/api/notifications/mark-all-read', { method: 'POST' });
                            if (res.ok) {
                                window.location.reload();
                            }
                        } catch (err) { console.error(err); }
                    },
                    async acceptInvite(id, elementId) {
                        try {
                            const res = await fetch(`/api/notifications/invitations/${id}/accept`, { method: 'POST' });
                            const data = await res.json();
                            if (res.ok && data.success) {
                                alert('Invitation accepted successfully! Redirecting...');
                                window.location.href = `/WorkspaceDetail/${data.joinCode}`;
                            } else {
                                alert(data.message || 'Failed to accept invitation.');
                            }
                        } catch (err) { console.error(err); }
                    },
                    async declineInvite(id, elementId) {
                        try {
                            const res = await fetch(`/api/notifications/invitations/${id}/decline`, { method: 'POST' });
                            if (res.ok) {
                                const el = document.getElementById(elementId);
                                if (el) el.remove();
                                if (this.invitationCount > 0) this.invitationCount--;
                            } else {
                                alert('Failed to decline invitation.');
                            }
                        } catch (err) { console.error(err); }
                    }
                }">
                    <button @@click="notificationsOpen = !notificationsOpen" class="p-2.5 rounded-full text-slate-400 hover:bg-white hover:text-indigo-600 transition-all relative">
                        <i data-lucide="bell" class="w-5 h-5"></i>
                        <template x-if="unreadCount + invitationCount > 0">
                            <span class="absolute -top-1 -right-1 h-5 w-5 bg-rose-500 rounded-full border-2 border-white text-[9px] font-black text-white flex items-center justify-center animate-pulse" x-text="unreadCount + invitationCount"></span>
                        </template>
                    </button>

                    <!-- Premium Glassmorphic Dropdown Panel -->
                    <div x-show="notificationsOpen" @@click.away="notificationsOpen = false" x-cloak x-transition
                         class="absolute right-0 mt-3 w-[22rem] sm:w-[26rem] bg-white rounded-3xl shadow-2xl border border-slate-100 p-5 z-50 flex flex-col max-h-[80vh]">
                        
                        <!-- Header -->
                        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                            <h4 class="text-sm font-black text-slate-800 tracking-tight">Notification Center</h4>
                            <template x-if="currentTab === 'notifications' && unreadCount > 0">
                                <button @@click="markAllAsRead()" class="text-[9px] font-black text-indigo-600 hover:text-indigo-800 transition-colors uppercase tracking-widest cursor-pointer">Mark all as read</button>
                            </template>
                        </div>

                        <!-- Tab Switcher -->
                        <div class="flex border-b border-slate-100 my-3">
                            <button @@click="currentTab = 'notifications'" 
                                    :class="currentTab === 'notifications' ? 'border-indigo-600 text-indigo-600 font-extrabold' : 'border-transparent text-slate-400 font-semibold'"
                                    class="flex-1 py-2 text-center text-xs border-b-2 hover:text-indigo-600 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                                <i data-lucide="bell" class="w-3.5 h-3.5"></i>
                                Notifications
                                <span class="px-1.5 py-0.2 bg-slate-100 text-slate-500 rounded text-[9px] font-black" x-text="unreadCount"></span>
                            </button>
                            <button @@click="currentTab = 'invitations'" 
                                    :class="currentTab === 'invitations' ? 'border-indigo-600 text-indigo-600 font-extrabold' : 'border-transparent text-slate-400 font-semibold'"
                                    class="flex-1 py-2 text-center text-xs border-b-2 hover:text-indigo-600 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                                <i data-lucide="mail" class="w-3.5 h-3.5"></i>
                                Workspace Invites
                                <span class="px-1.5 py-0.2 bg-slate-100 text-slate-500 rounded text-[9px] font-black" x-text="invitationCount"></span>
                            </button>
                        </div>

                        <!-- Scrollable list content -->
                        <div class="flex-1 overflow-y-auto space-y-3 py-2 max-h-[300px] scrollbar-none">
                            
                            <!-- Notifications Tab -->
                            <div x-show="currentTab === 'notifications'" class="space-y-2" id="notifications-list-container">
                                @if (notifications.Count == 0)
                                {
                                    <div class="py-8 text-center text-xs text-slate-400 font-bold italic flex flex-col items-center gap-2">
                                        <i data-lucide="bell-off" class="w-8 h-8 text-slate-300"></i>
                                        No notifications yet.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var n in notifications)
                                    {
                                        var uniqueId = "notif_" + n.Id.ToString("N");
                                        var iconName = "bell";
                                        var iconColor = "text-indigo-500 bg-indigo-50";
                                        
                                        if (n.Type == "TaskAssignment") { iconName = "user-check"; iconColor = "text-blue-500 bg-blue-50"; }
                                        else if (n.Type == "TaskApproved") { iconName = "check-circle"; iconColor = "text-green-500 bg-green-50"; }
                                        else if (n.Type == "TaskRework") { iconName = "rotate-ccw"; iconColor = "text-amber-500 bg-amber-50"; }
                                        else if (n.Type == "InvitationAccepted") { iconName = "user-plus"; iconColor = "text-purple-500 bg-purple-50"; }
                                        else if (n.Type == "TaskComment") { iconName = "message-square"; iconColor = "text-sky-500 bg-sky-50"; }
                                        else if (n.Type == "TaskReviewRequest") { iconName = "eye"; iconColor = "text-orange-500 bg-orange-50"; }
                                        else if (n.Type == "SubscriptionNotification" || n.Type == "SubscriptionExpiring") { iconName = "credit-card"; iconColor = "text-emerald-500 bg-emerald-50"; }
                                        else if (n.Type == "ChatMention" || n.Type == "TaskCommentMention") { iconName = "at-sign"; iconColor = "text-pink-500 bg-pink-50"; }
                                        
                                        <div id="@uniqueId" class="p-3.5 rounded-2xl border transition-all flex gap-3 items-start relative group @(n.IsRead ? "bg-slate-50/50 border-slate-100" : "bg-indigo-50/10 border-indigo-100/50 hover:bg-indigo-50/20")">
                                            <div class="h-8 w-8 rounded-xl flex items-center justify-center shrink-0 @iconColor">
                                                <i data-lucide="@iconName" class="w-4.5 h-4.5"></i>
                                            </div>
                                            <div class="flex-1 min-w-0 pr-4">
                                                <p class="text-xs text-slate-600 leading-normal font-semibold">@n.Message</p>
                                                <span class="text-[9px] text-slate-400 font-black uppercase mt-1 block">@n.CreatedAt.ToLocalTime().ToString("g")</span>
                                            </div>
                                            
                                            @if (!n.IsRead)
                                            {
                                                <button @@click="markAsRead('@n.Id', '@uniqueId')" 
                                                        class="absolute right-3 top-3.5 h-5 w-5 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 hover:text-indigo-600 transition-colors cursor-pointer"
                                                        title="Mark as read">
                                                    <i data-lucide="check" class="w-3.5 h-3.5"></i>
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Invitations Tab (Double Opt-In) -->
                            <div x-show="currentTab === 'invitations'" class="space-y-2">
                                @if (pendingInvitations.Count == 0)
                                {
                                    <div class="py-8 text-center text-xs text-slate-400 font-bold italic flex flex-col items-center gap-2">
                                        <i data-lucide="mail-open" class="w-8 h-8 text-slate-300"></i>
                                        No pending workspace invitations.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var invite in pendingInvitations)
                                    {
                                        var uniqueId = "invite_" + invite.Id.ToString("N");
                                        <div id="@uniqueId" class="p-3.5 bg-indigo-50/20 border border-indigo-100/60 rounded-2xl flex flex-col gap-3 relative">
                                            <div class="flex gap-3 items-start">
                                                <div class="h-8 w-8 rounded-xl bg-gradient-to-tr from-indigo-500 to-violet-500 flex items-center justify-center text-white text-xs font-bold shrink-0">
                                                    @invite.Workspace.Name.Substring(0, 1).ToUpper()
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="text-xs font-black text-slate-800 truncate">Invite to @invite.Workspace.Name</div>
                                                    <p class="text-[10px] text-slate-500 mt-0.5 leading-normal font-semibold">
                                                    Invited by <span class="font-bold text-slate-700">@invite.Inviter.FullName</span>
                                                    with role <span class="px-1.5 py-0.2 bg-indigo-50 text-indigo-600 rounded text-[9px] font-black uppercase">@invite.Role</span>.
                                                    </p>
                                                </div>
                                            </div>
                                            
                                            <!-- Action Triggers -->
                                            <div class="flex gap-2">
                                                <button @@click="acceptInvite('@invite.Id', '@uniqueId')" 
                                                        class="flex-1 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-[10px] font-black uppercase shadow shadow-indigo-100 transition-all cursor-pointer">
                                                    Accept
                                                </button>
                                                <button @@click="declineInvite('@invite.Id', '@uniqueId')" 
                                                        class="flex-1 py-1.5 border border-slate-200 hover:bg-slate-50 text-slate-600 rounded-xl text-[10px] font-black uppercase transition-all cursor-pointer">
                                                    Decline
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="relative">
                    <button @@click="profileOpen = !profileOpen" class="flex items-center gap-2 p-1.5 pl-3 bg-white border border-slate-200 rounded-full hover:shadow-sm transition-all">
                        <span class="text-xs font-bold text-slate-700">@(ViewData["UserName"] ?? "User")</span>
                        <div class="h-7 w-7 rounded-full bg-gradient-to-tr from-indigo-500 to-violet-500 flex items-center justify-center text-white text-[10px] font-bold">@(ViewData["UserInitials"] ?? "U")</div>
                    </button>
                    <div x-show="profileOpen" @@click.away="profileOpen = false" x-cloak
                         class="absolute right-0 mt-3 w-56 bg-white rounded-3xl shadow-2xl border border-slate-100 p-2 z-50">
                        <a href="/Profile" class="flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 rounded-2xl transition-all">
                            <i data-lucide="user" class="w-4 h-4 text-slate-400"></i>
                            <span class="text-sm font-semibold">My Profile</span>
                        </a>
                        <a asp-page="/Pricing" class="flex items-center gap-4 px-4 py-3 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-2xl transition-all group">
                            <i data-lucide="credit-card" class="w-4 h-4 text-slate-400"></i>
                            <span class="text-sm font-semibold">Subscription</span>
                        </a>
                        <div class="h-px bg-slate-100 my-1 mx-2"></div>
                        <a asp-page="/Logout" class="flex items-center gap-3 px-4 py-3 text-rose-600 hover:bg-rose-50 rounded-2xl transition-all">
                            <i data-lucide="log-out" class="w-4 h-4"></i>
                            <span class="text-sm font-semibold">Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto" :class="isFullPage ? '' : 'p-4 md:p-8'">
            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        lucide.createIcons();
        
        document.addEventListener("DOMContentLoaded", function () {
            // Anti-flicker: reveal the html layout instantly now that DOM is parsed and Tailwind/CSS are loaded
            document.documentElement.style.setProperty("visibility", "visible", "important");
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                // Initialize SignalR Connection
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/chatHub")
                    .withAutomaticReconnect()
                    .build();

                connection.on("ReceiveNotification", (payload) => {
                    console.log("Real-time Notification Received:", payload);
                    
                    // 1. Trigger toast notification
                    showToastNotification(payload.message, payload.link);

                    // 2. Increment Alpine.js unreadCount badge
                    const bellBtn = document.querySelector('[x-data*="unreadCount"]');
                    if (bellBtn) {
                        const alpineData = Alpine.$data(bellBtn);
                        if (alpineData) {
                            alpineData.unreadCount++;
                        }
                    }

                    // 3. Prepend to DOM notifications list if user is currently looking at it
                    const container = document.getElementById("notifications-list-container");
                    if (container) {
                        // Remove empty notice if it is there
                        const noNotif = container.querySelector(".bell-off")?.closest("div");
                        if (noNotif) noNotif.remove();

                        const uniqueId = "notif_" + payload.id.replace(/-/g, "");
                        let iconName = "bell";
                        let iconColor = "text-indigo-500 bg-indigo-50";
                        
                        if (payload.type === "TaskAssignment") { 
                            iconName = "user-check"; 
                            iconColor = "text-blue-500 bg-blue-50"; 
                        } else if (payload.type === "TaskApproved") { 
                            iconName = "check-circle"; 
                            iconColor = "text-green-500 bg-green-50"; 
                        } else if (payload.type === "TaskRework") { 
                            iconName = "rotate-ccw"; 
                            iconColor = "text-amber-500 bg-amber-50"; 
                        } else if (payload.type === "InvitationAccepted") { 
                            iconName = "user-plus"; 
                            iconColor = "text-purple-500 bg-purple-50"; 
                        } else if (payload.type === "TaskComment") {
                            iconName = "message-square";
                            iconColor = "text-sky-500 bg-sky-50";
                        } else if (payload.type === "TaskReviewRequest") {
                            iconName = "eye";
                            iconColor = "text-orange-500 bg-orange-50";
                        } else if (payload.type === "SubscriptionNotification" || payload.type === "SubscriptionExpiring") {
                            iconName = "credit-card";
                            iconColor = "text-emerald-500 bg-emerald-50";
                        } else if (payload.type === "ChatMention" || payload.type === "TaskCommentMention") {
                            iconName = "at-sign";
                            iconColor = "text-pink-500 bg-pink-50";
                        }

                        const notifHtml = `
                            <div id="${uniqueId}" class="p-3.5 rounded-2xl border transition-all flex gap-3 items-start relative group bg-indigo-50/10 border-indigo-100/50 hover:bg-indigo-50/20">
                                <div class="h-8 w-8 rounded-xl flex items-center justify-center shrink-0 ${iconColor}">
                                    <i data-lucide="${iconName}" class="w-4.5 h-4.5"></i>
                                </div>
                                <div class="flex-1 min-w-0 pr-4">
                                    <p class="text-xs text-slate-600 leading-normal font-semibold">${payload.message}</p>
                                    <span class="text-[9px] text-slate-400 font-black uppercase mt-1 block">${new Date(payload.createdAt).toLocaleString()}</span>
                                </div>
                                <button onclick="markNotificationAsReadDirectly('${payload.id}', '${uniqueId}')" 
                                        class="absolute right-3 top-3.5 h-5 w-5 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 hover:text-indigo-600 transition-colors cursor-pointer"
                                        title="Mark as read">
                                    <i data-lucide="check" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>
                        `;
                        container.insertAdjacentHTML('afterbegin', notifHtml);
                        if (window.lucide) {
                            window.lucide.createIcons();
                        }
                    }
                });

                connection.start()
                    .then(() => {
                        console.log("Global Notification Hub connection active!");
                    })
                    .catch(err => console.error("Global Notification Hub connection failed:", err));
            });

            function showToastNotification(message, link) {
                let container = document.getElementById("global-toast-container");
                if (!container) {
                    container = document.createElement("div");
                    container.id = "global-toast-container";
                    container.className = "fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none";
                    document.body.appendChild(container);
                }

                const toast = document.createElement("div");
                toast.className = "bg-white border border-slate-100 shadow-2xl rounded-2xl p-4 flex gap-3 items-start pointer-events-auto transition-all duration-300 transform translate-x-full opacity-0";
                
                toast.innerHTML = `
                    <div class="h-8 w-8 rounded-xl bg-indigo-50 flex items-center justify-center shrink-0 text-indigo-600">
                        <i data-lucide="bell" class="w-4.5 h-4.5"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-xs font-semibold text-slate-800">${message}</p>
                        ${link ? `<a href="${link}" class="text-[10px] text-indigo-600 hover:underline font-bold mt-1.5 inline-block">View details &rarr;</a>` : ''}
                    </div>
                    <button class="text-slate-400 hover:text-slate-600 shrink-0" onclick="this.closest('.bg-white').remove()">
                        <i data-lucide="x" class="w-3.5 h-3.5"></i>
                    </button>
                `;

                container.appendChild(toast);
                if (window.lucide) {
                    window.lucide.createIcons();
                }

                // Transition in
                setTimeout(() => {
                    toast.classList.remove("translate-x-full", "opacity-0");
                }, 10);

                // Transition out after 6 seconds
                setTimeout(() => {
                    toast.classList.add("translate-x-full", "opacity-0");
                    setTimeout(() => toast.remove(), 300);
                }, 6000);
            }

            async function markNotificationAsReadDirectly(id, elementId) {
                try {
                    const res = await fetch(`/api/notifications/mark-read/${id}`, { method: 'POST' });
                    if (res.ok) {
                        const el = document.getElementById(elementId);
                        if (el) {
                            el.style.opacity = '0.5';
                            el.style.pointerEvents = 'none';
                        }
                        const bellBtn = document.querySelector('[x-data*="unreadCount"]');
                        if (bellBtn) {
                            const alpineData = Alpine.$data(bellBtn);
                            if (alpineData && alpineData.unreadCount > 0) {
                                alpineData.unreadCount--;
                            }
                        }
                    }
                } catch (err) {
                    console.error(err);
                }
            }
        </script>
    }

    @{
        // Only show the assistant widget when:
        // - the user is authenticated (isAuthenticated)
        // - the request path matches /Schedule (ignoring case and trailing slash)
        var showAssistant = isAuthenticated
            && (string.Equals(Context.Request.Path.Value, "/Schedule", StringComparison.OrdinalIgnoreCase)
                || string.Equals(Context.Request.Path.Value, "/Schedule/", StringComparison.OrdinalIgnoreCase));
    }

    @if (showAssistant)
    {
        <partial name="_AssistantWidget" />
        <link rel="stylesheet" href="~/css/assistant.css" asp-append-version="true" />
        <script src="~/js/assistant.js" asp-append-version="true"></script>
    }

</body>
</html>
