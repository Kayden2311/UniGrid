<!DOCTYPE html>
<html lang="en" class="h-full bg-[#fafafa]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniGrid</title>
    <meta name="description" content="UniGrid is a highly visual, modern task and team management platform built for students and small teams to organize tasks, deadlines, files, and discussions clearly." />
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { font-family: 'Inter', 'Plus Jakarta Sans', sans-serif; }
        .glass { background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.3); }
        .sidebar-gradient { background: #ffffff; }
        [x-cloak] { display: none !important; }
        /* Anti-flicker: hide html until DOM is parsed */
        html { visibility: hidden; }
    </style>
</head>
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isFullPage = currentPage == "/Index" || currentPage == "/Login" || (currentPage == "/Signup" || (currentPage == "/Pricing" && !isAuthenticated));
}
<body class="h-full overflow-hidden flex text-slate-900" 
      x-data="{ sidebarOpen: window.innerWidth > 768, notificationsOpen: false, profileOpen: false, isFullPage: @(isFullPage ? "true" : "false"), wsOpen: true, mobileNavOpen: false, globalSearchQuery: '' }">
    
    <!-- Mobile Sidebar Overlay -->
    <div x-show="!isFullPage && sidebarOpen" @@click="sidebarOpen = false" x-cloak
         class="md:hidden fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-30 transition-opacity">
    </div>

    <!-- Sidebar (Hidden on Auth/Landing) -->
    <aside x-show="!isFullPage" 
           class="sidebar-gradient border-r border-slate-200 transition-all duration-300 flex flex-col fixed md:static inset-y-0 left-0 z-40 h-full"
           :class="sidebarOpen ? 'w-64 translate-x-0' : '-translate-x-full md:translate-x-0 md:w-20'">
        <!-- Sidebar Header -->
        <div class="h-16 flex items-center px-4 mb-2">
            <div class="flex items-center gap-3">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-lg shadow-indigo-200">
                    <i data-lucide="sparkles" class="h-4 w-4"></i>
                </div>
                <span class="font-bold text-lg tracking-tight text-slate-900" x-show="sidebarOpen" x-transition>UniGrid</span>
            </div>
        </div>

        <nav class="flex-1 px-3 space-y-1 overflow-y-auto">
            <!-- Main Nav -->
            <div class="space-y-1 mb-6">
                <a asp-page="/Dashboard" class="flex items-center gap-3 px-3 py-2 rounded-lg transition-all group"
                   :class="'@currentPage' == '/Dashboard' ? 'bg-slate-100 text-slate-900 font-semibold' : 'text-slate-500 hover:bg-slate-50 hover:text-slate-900'">
                    <i data-lucide="layout-dashboard" class="w-4 h-4 shrink-0"></i>
                    <span class="text-sm" x-show="sidebarOpen">Dashboard</span>
                </a>
                <a asp-page="/Schedule" class="flex items-center gap-3 px-3 py-2 rounded-lg transition-all group"
                   :class="'@currentPage' == '/Schedule' ? 'bg-slate-100 text-slate-900 font-semibold' : 'text-slate-500 hover:bg-slate-50 hover:text-slate-900'">
                    <i data-lucide="calendar-days" class="w-4 h-4 shrink-0"></i>
                    <span class="text-sm" x-show="sidebarOpen">Schedule</span>
                </a>
            </div>

            <!-- Workspaces Collapsible -->
            <div x-show="sidebarOpen" class="space-y-1">
                <button @@click="wsOpen = !wsOpen" class="flex w-full items-center justify-between px-3 py-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest hover:text-slate-900 transition-colors">
                    <div class="flex items-center gap-2">
                        <i data-lucide="briefcase" class="h-3.5 w-3.5"></i>
                        <span>Workspaces</span>
                    </div>
                    <i data-lucide="chevron-down" class="h-3.5 w-3.5 transition-transform" :class="wsOpen ? 'rotate-180' : ''"></i>
                </button>
                <div x-show="wsOpen" x-transition class="space-y-0.5">
                    @foreach (var ws in (List<unigrid.Models.Workspace>)(ViewData["Workspaces"] ?? new List<unigrid.Models.Workspace>()))
                    {
                        <a href="/WorkspaceDetail/@ws.JoinCode" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-all text-sm">
                            <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded bg-indigo-50 text-[10px] font-black text-indigo-600">
                                @ws.Name.Substring(0, 1)
                            </div>
                            <span class="truncate">@ws.Name</span>
                        </a>
                    }
                </div>
            </div>
            
            <!-- Collapsed Workspaces Icon -->
            <div x-show="!sidebarOpen" class="pt-2">
                <a href="/Workspaces" class="flex items-center justify-center p-2 text-slate-500 hover:bg-slate-50 rounded-lg transition-all" title="Workspaces">
                    <i data-lucide="briefcase" class="w-5 h-5"></i>
                </a>
            </div>
        </nav>

        <!-- Sidebar Footer -->
        <div class="p-3 border-t border-slate-100" x-show="sidebarOpen">
            <a href="/Workspaces" class="w-full py-2 px-3 border border-slate-200 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-50 transition-all flex items-center justify-center gap-2">
                <i data-lucide="plus" class="w-4 h-4 text-slate-400"></i>
                New Workspace
            </a>
        </div>
        
        <div class="p-4 flex justify-center">
            <button @@click="sidebarOpen = !sidebarOpen" class="text-slate-400 hover:text-indigo-600 transition-colors hidden md:block">
                <i data-lucide="chevron-left" class="w-5 h-5" x-show="sidebarOpen"></i>
                <i data-lucide="chevron-right" class="w-5 h-5" x-show="!sidebarOpen" x-cloak></i>
            </button>
        </div>
    </aside>

    <!-- Content Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden relative">
        <!-- Landing/Auth Header -->
        <header x-show="isFullPage" class="h-20 flex items-center justify-between px-6 md:px-12 bg-white/80 backdrop-blur-md sticky top-0 z-30 border-b border-slate-100">
            <a asp-page="/Index" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
                <div class="h-9 w-9 bg-indigo-600 rounded-xl flex items-center justify-center text-white shadow-lg">
                    <i data-lucide="sparkles" class="h-4 w-4"></i>
                </div>
                <span class="text-xl font-bold tracking-tight text-slate-900 font-display">UniGrid</span>
            </a>
            <nav class="hidden md:flex items-center gap-8">
                <a asp-page="/Pricing" class="text-sm font-bold text-slate-600 hover:text-indigo-600 transition-colors">Pricing</a>
                <a asp-page="/Login" class="text-sm font-bold text-slate-600 hover:text-indigo-600 transition-colors">Log in</a>
                <a asp-page="/Signup" class="px-6 py-2.5 bg-indigo-600 text-white rounded-xl text-sm font-bold shadow-lg shadow-indigo-100 hover:bg-indigo-700 transition-all">Get Started Free</a>
            </nav>
            
            <!-- Mobile Hamburger for Landing -->
            <button @@click="mobileNavOpen = !mobileNavOpen" class="md:hidden p-2 text-slate-600 hover:text-indigo-600 rounded-xl">
                <i data-lucide="menu" class="w-6 h-6" x-show="!mobileNavOpen"></i>
                <i data-lucide="x" class="w-6 h-6" x-show="mobileNavOpen" x-cloak></i>
            </button>

            <!-- Mobile Navigation Dropdown -->
            <div x-show="mobileNavOpen" x-transition x-cloak 
                 class="md:hidden absolute top-20 left-0 right-0 bg-white border-b border-slate-200 px-6 py-6 flex flex-col gap-4 shadow-xl z-50">
                <a asp-page="/Pricing" class="text-base font-bold text-slate-700 hover:text-indigo-600 py-2 border-b border-slate-50">Pricing</a>
                <a asp-page="/Login" class="text-base font-bold text-slate-700 hover:text-indigo-600 py-2 border-b border-slate-50">Log in</a>
                <a asp-page="/Signup" class="w-full py-3 bg-indigo-600 text-white rounded-xl text-base font-bold text-center shadow-lg shadow-indigo-100 hover:bg-indigo-700">Get Started Free</a>
            </div>
        </header>

        <!-- Dashboard Header -->
        <header x-show="!isFullPage" class="h-16 glass sticky top-0 z-10 flex items-center justify-between px-4 md:px-8">
            <div class="flex items-center gap-4">
                <button @@click="sidebarOpen = !sidebarOpen" class="md:hidden p-2 text-slate-500 hover:text-indigo-600 hover:bg-slate-100 rounded-xl transition-all">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
                <div class="flex items-center px-3 py-1.5 bg-slate-100 rounded-full text-slate-500 border border-slate-200">
                    <i data-lucide="search" class="w-4 h-4 mr-2"></i>
                    <input type="text" x-model="globalSearchQuery" placeholder="Search tasks..." class="bg-transparent border-none outline-none text-xs w-28 sm:w-48 placeholder:text-slate-400">
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="relative">
                    <button @@click="notificationsOpen = !notificationsOpen" class="p-2.5 rounded-full text-slate-400 hover:bg-white hover:text-indigo-600 transition-all relative">
                        <i data-lucide="bell" class="w-5 h-5"></i>
                        <span class="absolute top-2 right-2 h-2 w-2 bg-rose-500 rounded-full border-2 border-white"></span>
                    </button>
                </div>

                <div class="relative">
                    <button @@click="profileOpen = !profileOpen" class="flex items-center gap-2 p-1.5 pl-3 bg-white border border-slate-200 rounded-full hover:shadow-sm transition-all">
                        <span class="text-xs font-bold text-slate-700">@(ViewData["UserName"] ?? "User")</span>
                        <div class="h-7 w-7 rounded-full bg-gradient-to-tr from-indigo-500 to-violet-500 flex items-center justify-center text-white text-[10px] font-bold">@(ViewData["UserInitials"] ?? "U")</div>
                    </button>
                    <div x-show="profileOpen" @@click.away="profileOpen = false" x-cloak
                         class="absolute right-0 mt-3 w-56 bg-white rounded-3xl shadow-2xl border border-slate-100 p-2 z-50">
                        <a href="#" class="flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 rounded-2xl transition-all">
                            <i data-lucide="user" class="w-4 h-4 text-slate-400"></i>
                            <span class="text-sm font-semibold">My Profile</span>
                        </a>
                        <a asp-page="/Pricing" class="flex items-center gap-4 px-4 py-3 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-2xl transition-all group">
                            <i data-lucide="credit-card" class="w-4 h-4 text-slate-400"></i>
                            <span class="text-sm font-semibold">Subscription</span>
                        </a>
                        <div class="h-px bg-slate-100 my-1 mx-2"></div>
                        <a asp-page="/Logout" class="flex items-center gap-3 px-4 py-3 text-rose-600 hover:bg-rose-50 rounded-2xl transition-all">
                            <i data-lucide="log-out" class="w-4 h-4"></i>
                            <span class="text-sm font-semibold">Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto" :class="isFullPage ? '' : 'p-4 md:p-8'">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        lucide.createIcons();
        
        document.addEventListener("DOMContentLoaded", function () {
            // Anti-flicker: reveal the html layout instantly now that DOM is parsed and Tailwind/CSS are loaded
            document.documentElement.style.setProperty("visibility", "visible", "important");
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
